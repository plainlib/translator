#: tformconfigtrayslate.labelheaders.caption
msgid "Additional request headers in key=value format, key: value is also supported"
msgstr "Tiêu đề yêu cầu bổ sung ở định dạng key=value, key:value cũng được hỗ trợ"

#: tformconfigtrayslate.labelinitheaders.caption
msgid "Additional initial request headers in key=value format, key: value is also supported"
msgstr "Các tiêu đề yêu cầu ban đầu bổ sung ở định dạng key=value, key:value cũng được hỗ trợ"

#: tformconfigtrayslate.labelinitheaders2.caption
msgctxt "tformconfigtrayslate.labelinitheaders2.caption"
msgid "Headers"
msgstr "Tiêu đề"

#: tformconfigtrayslate.labelinitlivetime.caption
msgid "Live time"
msgstr "Thời gian trực tiếp"

#: tformconfigtrayslate.labelinitparameters.caption
msgid "Parameters name=regexp are extracted from the response and used by name in requests"
msgstr "Các tham số name=regexp được trích xuất từ ​​phản hồi và được sử dụng theo tên trong các yêu cầu"

#: tformconfigtrayslate.labelinitparameters1.caption
msgid "Time in seconds to refresh parameters with a new request (0 = every request)"
msgstr "Thời gian tính bằng giây để làm mới tham số với yêu cầu mới (0 = mọi yêu cầu)"

#: tformconfigtrayslate.labelinitparameters2.caption
msgctxt "tformconfigtrayslate.labelinitparameters2.caption"
msgid "Parameters"
msgstr "Thông số"

#: tformconfigtrayslate.labelinitparameters4.caption
msgid "Parameters in the form key=value used by {key} in requests. If the value is omitted (key=), it will be requested from the user."
msgstr "Các tham số ở dạng key=value được {key} sử dụng trong các yêu cầu. Nếu giá trị bị bỏ qua (key=), nó sẽ được yêu cầu từ người dùng."

#: tformconfigtrayslate.labelinitparemeters.caption
msgid "Initial GET request to obtain required parameters."
msgstr "Yêu cầu GET ban đầu để có được các tham số cần thiết."

#: tformconfigtrayslate.labeliniturl.caption
msgctxt "tformconfigtrayslate.labeliniturl.caption"
msgid "URL"
msgstr "URL"

#: tformconfigtrayslate.labelinituseragent.caption
msgctxt "tformconfigtrayslate.labelinituseragent.caption"
msgid "User Agent"
msgstr "Tác nhân người dùng"

#: tformconfigtrayslate.labellanguages.caption
msgid "Supported languages e.g. en=en-US (en - internal, en-US - service). \"empty\" - do not send."
msgstr "Các ngôn ngữ được hỗ trợ, ví dụ: en=en-US (en - nội bộ, en-US - dịch vụ). \"trống\" - không gửi."

#: tformconfigtrayslate.labellanguages1.caption
msgid "Value type for populating names. None keeps originals; None and Unit are case-sensitive."
msgstr "Loại giá trị để điền tên. Không ai giữ bản gốc; Không có và Đơn vị phân biệt chữ hoa chữ thường."

#: tformconfigtrayslate.labellanguagestarget.caption
msgid ""
"Target languages e.g. en=en-US, en - internal, en-US - service code.\n"
"If not specified, both source and target languages are taken from the languages section."
msgstr ""
"Ngôn ngữ mục tiêu, ví dụ: en=en-US, en - nội bộ, en-US - mã dịch vụ.\n"
"Nếu không được chỉ định, cả ngôn ngữ nguồn và ngôn ngữ đích đều được lấy từ phần ngôn ngữ."

#: tformconfigtrayslate.labelmaxlength.caption
msgid "Max Length, bytes"
msgstr "Độ dài tối đa, byte"

#: tformconfigtrayslate.labelmethod.caption
msgid "Method"
msgstr "Phương pháp"

#: tformconfigtrayslate.labelparemeters.caption
msgid "Use parameters: {text} – input text, {source} – source language, {target} – target language. Prefix the name with ! for lowercase or ^ for uppercase value. Also supported {timestamp}, {rand}. Use {parameter} from the parameters page."
msgstr "Sử dụng các tham số: {text} – văn bản đầu vào, {source} – ngôn ngữ nguồn, {target} – ngôn ngữ đích. Tiền tố tên với ! cho chữ thường hoặc ^ cho giá trị chữ hoa. Cũng được hỗ trợ {timestamp}, {rand}. Sử dụng {parameter} từ trang thông số."

