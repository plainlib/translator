msgstr "Durata live"

#: tformconfigtrayslate.labelinitparameters.caption
msgid "Parameters name=regexp are extracted from the response and used by name in requests"
msgstr "I parametri 'name=regexp' vengono estratti dalla risposta e usati per nome nelle richieste"

#: tformconfigtrayslate.labelinitparameters1.caption
msgid "Time in seconds to refresh parameters with a new request (0 = every request)"
msgstr "Tempo in secondi per aggiornare i parametri con una nuova richiesta (0 = ogni richiesta)"

#: tformconfigtrayslate.labelinitparameters2.caption
msgctxt "tformconfigtrayslate.labelinitparameters2.caption"
msgid "Parameters"
msgstr "Parametri"

#: tformconfigtrayslate.labelinitparameters4.caption
msgid "Parameters in the form key=value used by {key} in requests. If the value is omitted (key=), it will be requested from the user."
msgstr "Parametri nel formato 'key=value' usati nelle richieste da {key}. Se il valore viene omesso (key=), verrà richiesto dall'utente."

#: tformconfigtrayslate.labelinitparemeters.caption
msgid "Initial GET request to obtain required parameters."
msgstr "Richiesta GET iniziale per ottenere i parametri necessari."

#: tformconfigtrayslate.labeliniturl.caption
msgctxt "tformconfigtrayslate.labeliniturl.caption"
msgid "URL"
msgstr "URL"

#: tformconfigtrayslate.labelinituseragent.caption
msgctxt "tformconfigtrayslate.labelinituseragent.caption"
msgid "User Agent"
msgstr "User Agent"

#: tformconfigtrayslate.labellanguages.caption
msgid "Supported languages e.g. en=en-US (en - internal, en-US - service). \"empty\" - do not send."
msgstr "Lingue supportate, ad es. en=en-US (en - interno, en-US - servizio). \"empty\" - non inviare."

#: tformconfigtrayslate.labellanguages1.caption
msgid "Value type for populating names. None keeps originals; None and Unit are case-sensitive."
msgstr "Tipo di valore per popolare i nomi. 'Nessuno' mantiene quelli originali. 'Nessuno' e 'Unità' fanno distinzione tra maiuscole e minuscole."

#: tformconfigtrayslate.labellanguagestarget.caption
msgid ""
"Target languages e.g. en=en-US, en - internal, en-US - service code.\n"
"If not specified, both source and target languages are taken from the languages section."
msgstr ""
"Lingue destinazione, ad es. en=en-US, en - interno, en-US - codice servizio.\n"
"Se non specificato, sia le lingue sorgenti che quelle destinazione vengono prese dalla sezione lingue."

#: tformconfigtrayslate.labelmaxlength.caption
msgid "Max Length, bytes"
msgstr "Lunghezza massima, byte"

#: tformconfigtrayslate.labelmethod.caption
msgid "Method"
msgstr "Metodo"

#: tformconfigtrayslate.labelparemeters.caption
msgid "Use parameters: {text} – input text, {source} – source language, {target} – target language. Prefix the name with ! for lowercase or ^ for uppercase value. Also supported {timestamp}, {rand}. Use {parameter} from the parameters page."
msgstr "Usa i parametri: {text} – testo sorgente, {source} – lingua sorgente, {target} – lingua destinazione. Anteponi '!' per il valore in minuscolo o '^' per il valore in maiuscolo. Sono supportati anche {timestamp}, {rand}. Usa {parameter} dalla pagina dei parametri."

