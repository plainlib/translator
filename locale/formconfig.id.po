#: tformconfigtrayslate.labellanguages.caption
msgid "Supported languages e.g. en=en-US (en - internal, en-US - service). \"empty\" - do not send."
msgstr "Bahasa yang didukung misalnya en=en-US (en - internal, en-US - layanan). \"empty\" - jangan kirim."

#: tformconfigtrayslate.labellanguages1.caption
msgid "Value type for populating names. None keeps originals; None and Unit are case-sensitive."
msgstr "Tipe nilai untuk mengisi nama. None mempertahankan asli; None dan Unit peka huruf besar/kecil."

#: tformconfigtrayslate.labellanguagestarget.caption
msgid ""
"Target languages e.g. en=en-US, en - internal, en-US - service code.\n"
"If not specified, both source and target languages are taken from the languages section."
msgstr ""
"Bahasa sasaran misalnya en=en-US, en - internal, en-US - kode layanan.\n"
"Jika tidak ditentukan, baik bahasa sumber maupun sasaran diambil dari bagian bahasa."

#: tformconfigtrayslate.labelmaxlength.caption
msgid "Max Length, bytes"
msgstr "Lunghezza massima, byte"

#: tformconfigtrayslate.labelmethod.caption
msgid "Method"
msgstr "Metode"

#: tformconfigtrayslate.labelparemeters.caption
msgid "Use parameters: {text} – input text, {source} – source language, {target} – target language. Prefix the name with ! for lowercase or ^ for uppercase value. Also supported {timestamp}, {rand}. Use {parameter} from the parameters page."
msgstr "Gunakan parameter: {text} – teks masukan, {source} – bahasa sumber, {target} – bahasa sasaran. Awali nama dengan ! untuk nilai huruf kecil atau ^ untuk huruf besar. Juga didukung {timestamp}, {rand}. Gunakan {parameter} dari halaman parameter."

