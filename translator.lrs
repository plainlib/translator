  +'configtrayslate.checkservicevisible.caption'#10'msgid "Visible in menu"'#10
  +'msgstr "Vis'#195#173'vel no menu"'#10#10'#: tformconfigtrayslate.combometho'
  +'d.text'#10'msgid "GET"'#10'msgstr "GET"'#10#10'#: tformconfigtrayslate.comb'
  +'ovaluetype.text'#10'msgctxt "tformconfigtrayslate.combovaluetype.text"'#10
