  +'t.hint'#10'msgid "Execute get request and view the result"'#10'msgstr "Suor'
  +'ita GET-pyynt'#195#182' ja tarkastele tulosta"'#10#10'#: tformconfigtraysla'
  +'te.caption'#10'msgctxt "tformconfigtrayslate.caption"'#10'msgid "Config Edi'
  +'tor"'#10'msgstr "Konfiguraatioeditori"'#10#10'#: tformconfigtrayslate.check'
  +'encodecustomparameters.caption'#10'msgid "Encode parameters"'#10'msgstr "Ko'
