  +#190#208#180'"'#10#10'#: tformconfigtrayslate.labelparemeters.caption'#10'ms'
  +'gid "Use parameters: {text} '#226#128#147' input text, {source} '#226#128
  +#147' source language, {target} '#226#128#147' target language. Prefix the n'
  +'ame with ! for lowercase or ^ for uppercase value. Also supported {timestam'
  +'p}, {rand}. Use {parameter} from the parameters page."'#10'msgstr "'#208#152
  +#209#129#208#191#208#190#208#187#209#140#208#183#209#131#208#185#209#130#208
  +#181' '#208#191#208#176#209#128#208#176#208#188#208#181#209#130#209#128#209
  +#139': {text} '#226#128#147' '#208#178#209#133#208#190#208#180#208#189#208
  +#190#208#185' '#209#130#208#181#208#186#209#129#209#130', {source} '#226#128
  +#147' '#208#184#209#129#209#133#208#190#208#180#208#189#209#139#208#185' '
  +#209#143#208#183#209#139#208#186', {target} '#226#128#147' '#209#134#208#181
  +#208#187#208#181#208#178#208#190#208#185' '#209#143#208#183#209#139#208#186
  +'. '#208#148#208#190#208#177#208#176#208#178#209#140#209#130#208#181' '#208
  +#191#209#128#208#181#209#132#208#184#208#186#209#129' ! '#208#180#208#187#209
  +#143' '#208#183#208#189#208#176#209#135#208#181#208#189#208#184#209#143' '
  +#208#178' '#208#189#208#184#208#182#208#189#208#181#208#188' '#209#128#208
  +#181#208#179#208#184#209#129#209#130#209#128#208#181' '#208#184#208#187#208
  +#184' ^ '#208#180#208#187#209#143' '#208#178#208#181#209#128#209#133#208#189
  +#208#181#208#179#208#190' '#209#128#208#181#208#179#208#184#209#129#209#130
  +#209#128#208#176'. '#208#162#208#176#208#186#208#182#208#181' '#208#191#208
  +#190#208#180#208#180#208#181#209#128#208#182#208#184#208#178#208#176#209#142
  +#209#130#209#129#209#143' {timestamp}, {rand}. '#208#152#209#129#208#191#208
  +#190#208#187#209#140#208#183#209#131#208#185#209#130#208#181' {parameter} '
  ,#209#129#208#190' '#209#129#209#130#209#128#208#176#208#189#208#184#209#134
  +#209#139' '#208#191#208#176#209#128#208#176#208#188#208#181#209#130#209#128
  +#208#190#208#178'."'#10#10'#: tformconfigtrayslate.labelpostdata.caption'#10
