  +#209#128#209#139':\n"'#10'"responseData/translatedText; matches/*#10/transla'
  +'tion; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/t'
  +'ranslations{Error: No data!#10}; /translations"'#10#10'#: formconfig.rscrip'
  +'thint'#10'msgid ""'#10'"The script is a standard Pascal program: optional v'
  +'ar section, then a main begin ... end. block.\n"'#10'"\n"'#10'"Example:\n"'
  +#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n'
  +'"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput('
  +'''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also use standard Pas'
  +'cal constructs (if, for, while, repeat, etc.). You can define your own func'
  +'tions and procedures before the main begin ... end. block.\n"'#10'"\n"'#10
  +'"Available functions:\n"'#10'"  GetParam(''name'') : string\n"'#10'"    Ret'
  +'rieve an input parameter value.\n"'#10'"  SetOutput(''name'', ''value'')\n"'
  +#10'"    Store an output value for the host.\n"'#10'"  GetTimestamp() : Int6'
  +'4\n"'#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#10'"  GetRa'
  +'ndom(Length) : Int64\n"'#10'"    Random integer with exactly Length decimal'
  +' digits.\n"'#10'"  Random : Extended\n"'#10'"    Random float in the range '
  +'[0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Convert inte'
  +'ger to hexadecimal string with at least Digits characters.\n"'#10'"  StrToI'
  +'nt(S) : Integer\n"'#10'"    Convert a string to an integer. Raises an excep'
  +'tion on invalid input.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Conve'
  +'rt an integer to its string representation.\n"'#10'"  Trim(S) : string\n"'
  +#10'"    Remove leading and trailing whitespace from S.\n"'#10'"  TrimLeft(S'
  +') : string\n"'#10'"    Remove leading whitespace from S.\n"'#10'"  TrimRigh'
  +'t(S) : string\n"'#10'"    Remove trailing whitespace from S.\n"'#10'"  Html'
  +'Encode(S) : string\n"'#10'"    Encode special HTML characters in S into ent'
  +'ities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HTML entities in'
  +' S back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    Percent-'
  +'encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : string\n"'#10'"  '
  +'  Decode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, OldPattern, Ne'
  +'wPattern, IgnoreCase=False) : string\n"'#10'"    Replace all occurrences of'
  +' OldPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input, Pattern, Re'
  +'placement) : string\n"'#10'"    Replace all regex matches of Pattern with R'
  +'eplacement in Input. Case-insensitive.\n"'#10'"  RegexMatch(Input, Pattern)'
  +' : Boolean\n"'#10'"    Check if Input matches the regex Pattern. Case-insen'
  +'sitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10
  +'"    Extract the substring of S between StartMarker and EndMarker.\n"'#10'"'
  ,'\n"'#10'"JSON functions (use a handle returned by JSONParse):\n"'#10'"  JSO'
  +'NParse(S) : Integer\n"'#10'"    Parse a JSON string and return a handle (>='
  +'0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Release the'
  +' handle after use.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'#10'" '
  +'   Get a string value at the specified Path.\n"'#10'"  JSONGetInt(Handle, P'
  +'ath) : Integer\n"'#10'"    Get an integer value at the specified Path.\n"'
  +#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a floating-poin'
  +'t value at the specified Path.\n"'#10'"  JSONGetBool(Handle, Path) : Boolea'
  +'n\n"'#10'"    Get a boolean value at the specified Path.\n"'#10'"  JSONGetA'
  +'rrayCount(Handle, Path) : Integer\n"'#10'"    Get the number of elements in'
  +' an array at the specified Path.\n"'#10'"  JSONGetArrayString(Handle, Path,'
  +' Index) : string\n"'#10'"    Get the string value of an array element at th'
  +'e given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'
  +#10'"    Get the integer value of an array element at the given Index.\n"'#10
  +'"  JSONGetType(Handle, Path) : string\n"'#10'"    Return the type of the va'
  +'lue at Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\'
  +'", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10'"    C'
  +'heck if the specified Path exists.\n"'#10'"  JSONResultInit\n"'#10'"    Ini'
  +'tialize an empty JSON array for building a standard error result.\n"'#10'" '
  +' JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"    Add '
  +'an error object to the result array. Replacements is a string of values sep'
  +'arated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Return the cu'
  +'rrent result array as a JSON string.\n"'#10'"  JSONResultClear\n"'#10'"    '
  +'Clear the result array.\n"'#10'"  Always call JSONFree to release the handl'
  +'e after you are done.\n"'#10'"\n"'#10'"Example of working with JSON:\n"'#10
  +'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h :'
  +'= JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    b'
  +'egin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetO'
  +'utput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  e'
  +'nd.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'#10
  +'"  text - the input text to process (possibly truncated to MaxLength)\n"'#10
  +'"  source - source language code (may be empty)\n"'#10'"  target - target l'
  +'anguage code\n"'#10'"  timestamp - current Unix timestamp in milliseconds ('
  +'string)\n"'#10'"  random  - 9-digit random number (string)\n"'#10'"  rand -'
  +' same as random\n"'#10'"  rand1..rand9 - first 1..9 digits of the random nu'
  +'mber\n"'#10'"\n"'#10'"Additional initial and custom parameters are also ava'
  +'ilable."'#10'msgstr ""'#10'"'#208#161#208#186#209#128#208#184#208#191#209
