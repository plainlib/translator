  +#198#176'u thay '#196#145#225#187#149'i?"'#13#10#13#10'#: formconfig.rrespon'
  +'sehint'#13#10'msgid ""'#13#10'"Json Pointer: Use / for levels, keys for obj'
  +'ects, and numbers for indexes.\n"'#13#10'"Use * for all items, *#10 to join'
  +' items by newline. Use ~ at the end of the path to return the raw JSON bran'
  +'ch.\n"'#13#10'"Separate multiple segments with semicolon ;.\n"'#13#10'"Lite'
  +'ral: Text block in {'#226#128#166'}. Special tag #10 for newlines. Use {{re'
  +'gex}} inside to extract data directly into the text.\n"'#13#10'"Logic: If a'
  +' Pointer in a segment is empty, the whole segment is skipped. If a segment '
  +'has no Pointer, only literal text blocks with embedded regular expressions '
  +'are processed.\n"'#13#10'"Regex: {prefix {regex[index]} suffix} inside a te'
  +'xt block. If no [index] is specified, the first match is used.\n"'#13#10'"I'
  +'ndex can be a number, [*] (join by space), or [*#10] (join by newline). If '
  +'the regex finds no match, the entire {'#226#128#166'} block is removed.\n"'
  +#13#10'"Using ~ inside a regex returns the entire text.\n"'#13#10'"Inversion'
  +': Start a segment with ! (e.g. !/path{Error}) to show its text only if the '
  +'Pointer data is missing or the JSON is invalid.\n"'#13#10'"Commenting: /* t'
  +'ext */ comments are stripped from the entire expression before any processi'
  +'ng.\n"'#13#10'"Examples:\n"'#13#10'"responseData/translatedText; matches/*#'
  ,'10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w'
  +'+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#13#10'msg'
  +'str ""'#13#10'"Json Pointer: S'#225#187#173' d'#225#187#165'ng / cho c'#195
  +#161'c c'#225#186#165'p, c'#195#161'c kh'#195#179'a cho '#196#145#225#187#145
  +'i t'#198#176#225#187#163'ng, v'#195#160' s'#225#187#145' cho c'#195#161'c c'
  +'h'#225#187#137' m'#225#187#165'c.\n"'#13#10'"S'#225#187#173' d'#225#187#165
  +'ng * cho t'#225#186#165't c'#225#186#163' c'#195#161'c m'#225#187#165'c, *#'
  +'10 '#196#145#225#187#131' n'#225#187#145'i c'#195#161'c m'#225#187#165'c th'
  +'eo d'#195#178'ng m'#225#187#155'i. S'#225#187#173' d'#225#187#165'ng ~ '#225
  +#187#159' cu'#225#187#145'i '#196#145#198#176#225#187#157'ng d'#225#186#171
  +'n '#196#145#225#187#131' tr'#225#186#163' v'#225#187#129' nh'#195#161'nh JS'
  +'ON th'#195#180'.\n"'#13#10'"T'#195#161'ch c'#195#161'c ph'#195#162'n '#196
  +#145'o'#225#186#161'n nhi'#225#187#129'u b'#225#186#177'ng d'#225#186#165'u '
  +'ch'#225#186#165'm ph'#225#186#169'y ;.\n"'#13#10'"Nguy'#195#170'n v'#196#131
  +'n: Kh'#225#187#145'i v'#196#131'n b'#225#186#163'n trong {'#226#128#166'}. '
  +'Th'#225#186#187' '#196#145#225#186#183'c bi'#225#187#135't #10 cho xu'#225
  +#187#145'ng d'#195#178'ng. S'#225#187#173' d'#225#187#165'ng {{regex}} b'#195
  +#170'n trong '#196#145#225#187#131' tr'#195#173'ch xu'#225#186#165't d'#225
  +#187#175' li'#225#187#135'u tr'#225#187#177'c ti'#225#186#191'p v'#195#160'o'
  +' v'#196#131'n b'#225#186#163'n.\n"'#13#10'"Logic: N'#225#186#191'u m'#225
  +#187#153't Pointer trong m'#225#187#153't ph'#195#162'n '#196#145'o'#225#186
  +#161'n tr'#225#187#145'ng, to'#195#160'n b'#225#187#153' ph'#195#162'n '#196
  +#145'o'#225#186#161'n s'#225#186#189' b'#225#187#139' b'#225#187#143' qua. N'
  +#225#186#191'u m'#225#187#153't ph'#195#162'n '#196#145'o'#225#186#161'n kh'
  +#195#180'ng c'#195#179' Pointer, ch'#225#187#137' c'#195#161'c kh'#225#187
  +#145'i v'#196#131'n b'#225#186#163'n nguy'#195#170'n v'#196#131'n c'#195#179
  +' bi'#225#187#131'u th'#225#187#169'c ch'#195#173'nh quy nh'#195#186'ng '#196
  +#145#198#176#225#187#163'c x'#225#187#173' l'#195#189'.\n"'#13#10'"Regex: {p'
  +'refix {regex[index]} suffix} b'#195#170'n trong m'#225#187#153't kh'#225#187
  +#145'i v'#196#131'n b'#225#186#163'n. N'#225#186#191'u kh'#195#180'ng ch'#225
  +#187#137' '#196#145#225#187#139'nh [index], k'#225#186#191't qu'#225#186#163
  +' kh'#225#187#155'p '#196#145#225#186#167'u ti'#195#170'n s'#225#186#189' '
  +#196#145#198#176#225#187#163'c s'#225#187#173' d'#225#187#165'ng.\n"'#13#10
  +'"Index c'#195#179' th'#225#187#131' l'#195#160' m'#225#187#153't s'#225#187
  +#145', [*] (n'#225#187#145'i b'#225#186#177'ng kho'#225#186#163'ng tr'#225
  +#186#175'ng), ho'#225#186#183'c [*#10] (n'#225#187#145'i b'#225#186#177'ng d'
  +#195#178'ng m'#225#187#155'i). N'#225#186#191'u regex kh'#195#180'ng t'#195
  +#172'm th'#225#186#165'y k'#225#186#191't qu'#225#186#163' kh'#225#187#155'p'
  +', to'#195#160'n b'#225#187#153' kh'#225#187#145'i {'#226#128#166'} s'#225
  +#186#189' b'#225#187#139' x'#195#179'a.\n"'#13#10'"S'#225#187#173' d'#225#187
  +#165'ng ~ b'#195#170'n trong regex s'#225#186#189' tr'#225#186#163' v'#225
  +#187#129' to'#195#160'n b'#225#187#153' v'#196#131'n b'#225#186#163'n. '#196
  +#144#225#186#163'o ng'#198#176#225#187#163'c: B'#225#186#175't '#196#145#225
  +#186#167'u m'#225#187#153't '#196#145'o'#225#186#161'n v'#225#187#155'i ! (v'
  +#195#173' d'#225#187#165': !/path{Error}) '#196#145#225#187#131' ch'#225#187
  +#137' hi'#225#187#131'n th'#225#187#139' v'#196#131'n b'#225#186#163'n c'#225
  +#187#167'a n'#195#179' n'#225#186#191'u d'#225#187#175' li'#225#187#135'u Po'
  +'inter b'#225#187#139' thi'#225#186#191'u ho'#225#186#183'c JSON kh'#195#180
  +'ng h'#225#187#163'p l'#225#187#135'.\n"'#13#10'"Ghi ch'#195#186': /* text *'
  +'/ c'#195#161'c ghi ch'#195#186' '#196#145#198#176#225#187#163'c lo'#225#186
  +#161'i b'#225#187#143' kh'#225#187#143'i to'#195#160'n b'#225#187#153' bi'
  +#225#187#131'u th'#225#187#169'c tr'#198#176#225#187#155'c khi x'#225#187#173
  +' l'#195#189'.\n"'#13#10'"V'#195#173' d'#225#187#165':\n"'#13#10'"responseDa'
  +'ta/translatedText; matches/*#10/translation; /texts/text; {literal text#10}'
  +'; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /tr'
  +'anslations/0/text"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'
  +#13#10'"The script is a standard Pascal program: optional var section, then '
  +'a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  v'
  +'ar s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'
  +#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutpu'
  +'t(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use s'
  +'tandard Pascal constructs (if, for, while, repeat, etc.). You can define yo'
  +'ur own functions and procedures before the main begin ... end. block.\n"'#13
  +#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'') : stri'
