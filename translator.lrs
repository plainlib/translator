  +' '#215#156#215#148#215#153#215#149#215#170' '#215#158#215#161#215#164#215
  ,#168', '#226#128#142'[*]'#226#128#142' ('#215#151#215#153#215#145#215#149#215
  +#168' '#215#145#215#144#215#158#215#166#215#162#215#149#215#170' '#215#168
