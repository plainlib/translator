  +#174#230#148#185#227#128#130#228#191#157#229#173#152#230#155#180#230#148#185
  +#229#144#151#239#188#159'"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'
  +#10'"Json Pointer: Use / for levels, keys for objects, and numbers for index'
  +'es.\n"'#10'"Use * for all items, *#10 to join items by newline. Use ~ at th'
  +'e end of the path to return the raw JSON branch.\n"'#10'"Separate multiple '
  +'segments with semicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}.'
  +' Special tag #10 for newlines. Use {{regex}} inside to extract data directl'
  +'y into the text.\n"'#10'"Logic: If a Pointer in a segment is empty, the who'
  +'le segment is skipped. If a segment has no Pointer, only literal text block'
  +'s with embedded regular expressions are processed.\n"'#10'"Regex: {prefix {'
  +'regex[index]} suffix} inside a text block. If no [index] is specified, the '
  +'first match is used.\n"'#10'"Index can be a number, [*] (join by space), or'
  +' [*#10] (join by newline). If the regex finds no match, the entire {'#226
  +#128#166'} block is removed.\n"'#10'"Using ~ inside a regex returns the enti'
  +'re text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to '
  +'show its text only if the Pointer data is missing or the JSON is invalid.\n'
  +'"'#10'"Commenting: /* text */ comments are stripped from the entire express'
  +'ion before any processing.\n"'#10'"Examples:\n"'#10'"responseData/translate'
  +'dText; matches/*#10/translation; /texts/text; {literal text#10}; /result/te'
  +'xt; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations/0'
  +'/text"'#10'msgstr ""'#10'"JSON Pointer'#239#188#154#228#189#191#231#148#168
  +' / '#232#161#168#231#164#186#229#177#130#231#186#167#239#188#140#228#189#191
  +#231#148#168#233#148#174#232#161#168#231#164#186#229#175#185#232#177#161#239
  +#188#140#228#189#191#231#148#168#230#149#176#229#173#151#232#161#168#231#164
  +#186#231#180#162#229#188#149#227#128#130#228#189#191#231#148#168' * '#232#161
  +#168#231#164#186#230#137#128#230#156#137#233#161#185#231#155#174#239#188#140
  +#228#189#191#231#148#168' *#10 '#233#128#154#232#191#135#230#141#162#232#161
  +#140#232#191#158#230#142#165#233#161#185#231#155#174#227#128#130#228#189#191
  +#231#148#168' ~ '#229#156#168#232#183#175#229#190#132#230#156#171#229#176#190
