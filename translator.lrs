  +'slate.labelinituseragent.caption"'#13#10'msgid "User Agent"'#13#10'msgstr "'
  +'User Agent"'#13#10#13#10'#: tformconfigtrayslate.labellanguages.caption'#13
  +#10'msgid "Supported languages e.g. en=en-US (en - internal, en-US - service'
  +'). \"empty\" - do not send."'#13#10'msgstr "Bahasa yang didukung misalnya e'
  +'n=en-US (en - internal, en-US - layanan). \"empty\" - jangan kirim."'#13#10
  +#13#10'#: tformconfigtrayslate.labellanguages1.caption'#13#10'msgid "Value t'
  +'ype for populating names. None keeps originals; None and Unit are case-sens'
  +'itive."'#13#10'msgstr "Tipe nilai untuk mengisi nama. None mempertahankan a'
