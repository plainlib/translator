  +'ai..."'#13#10#13#10'#: tformconfigtrayslate.btnclose.caption'#13#10'msgid "'
  +'Close"'#13#10'msgstr "Tutup"'#13#10#13#10'#: tformconfigtrayslate.btninitpa'
  ,'rameterstest.hint'#13#10'msgid "Execute request and view the parameters"'#13
