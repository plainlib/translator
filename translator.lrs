  +'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal'
  +' program: optional var section, then a main begin ... end. block.\n"'#10'"\'
  +'n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := '
  +'GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'
  +#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can als'
  +'o use standard Pascal constructs (if, for, while, repeat, etc.). You can de'
  +'fine your own functions and procedures before the main begin ... end. block'
  +'.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : stri'
  +'ng\n"'#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''nam'
  +'e'', ''value'')\n"'#10'"    Store an output value for the host.\n"'#10'"  G'
  +'etTimestamp() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (U'
  +'TC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with ex'
  +'actly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random'
  +' float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'
  +#10'"    Convert integer to hexadecimal string with at least Digits characte'
  +'rs.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to an inte'
  +'ger. Raises an exception on invalid input.\n"'#10'"  IntToStr(Value) : stri'
  +'ng\n"'#10'"    Convert an integer to its string representation.\n"'#10'"  T'
  +'rim(S) : string\n"'#10'"    Remove leading and trailing whitespace from S.\'
  +'n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whitespace from S'
  +'.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing whitespace fr'
  +'om S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML char'
  +'acters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Dec'
  +'ode HTML entities in S back to characters.\n"'#10'"  UrlEncode(S) : string\'
  +'n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S)'
  +' : string\n"'#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceA'
  +'ll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replac'
  +'e all occurrences of OldPattern with NewPattern in S.\n"'#10'"  RegexReplac'
  +'e(Input, Pattern, Replacement) : string\n"'#10'"    Replace all regex match'
  +'es of Pattern with Replacement in Input. Case-insensitive.\n"'#10'"  RegexM'
