  +'er com predefini'#195#167#195#181'es"'#13#10#13#10'#: tformconfigtrayslate.'
  +'labelheaders.caption'#13#10'msgid "Additional request headers in key=value '
  +'format, key: value is also supported"'#13#10'msgstr "Cabe'#195#167'alhos ad'
