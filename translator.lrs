LazarusResources.Add('formconfig.id','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: id\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Editor Konfigurasi"'#13#10#13#10'#: formconfig.rclearlanguages'#13#10'msg'
  +'id "The list is already filled. Do you want to clear it?"'#13#10'msgstr "Da'
  +'ftar sudah terisi. Apakah Anda ingin mengosongkannya?"'#13#10#13#10'#: form'
  +'config.rconfigeditor'#13#10'msgid "Config Editor..."'#13#10'msgstr "Editor '
  +'Konfigurasi..."'#13#10#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are '
  +'you sure you want to delete config"'#13#10'msgstr "Apakah Anda yakin ingin '
  +'menghapus konfigurasi"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13
  +#10'msgid "Delete config"'#13#10'msgstr "Hapus konfigurasi"'#13#10#13#10'#: '
  +'formconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Batal"'
  +#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Keep my cha'
  +'nges"'#13#10'msgstr "Pertahankan perubahan saya"'#13#10#13#10'#: formconfig'
  +'.rfilechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The file \"%s'
  +'\" has been modified by another application since it was opened."'#13#10'ms'
  +'gstr "File \"%s\" telah diubah oleh aplikasi lain sejak dibuka."'#13#10#13
  +#10'#: formconfig.rfilechangedmsgactivate'#13#10'msgid "You have unsaved cha'
  +'nges. Keep them or reload from disk?"'#13#10'msgstr "Anda memiliki perubaha'
  +'n yang belum disimpan. Pertahankan atau muat ulang dari disk?"'#13#10#13#10
  +'#: formconfig.rfilechangedreloaddisk'#13#10'msgid "Reload from disk"'#13#10
  +'msgstr "Muat ulang dari disk"'#13#10#13#10'#: formconfig.rfilechangedtitle'
  +#13#10'msgid "File changed on disk"'#13#10'msgstr "File berubah di disk"'#13
  +#10#13#10'#: formconfig.rnamequestion'#13#10'msgid "Enter new config file na'
  +'me:"'#13#10'msgstr "Masukkan nama file konfigurasi baru:"'#13#10#13#10'#: f'
  +'ormconfig.rneedsave'#13#10'msgid "The configuration was modified. Save chan'
  +'ges?"'#13#10'msgstr "Konfigurasi telah diubah. Simpan perubahan?"'#13#10#13
  +#10'#: formconfig.rresponsehint'#13#10'msgid ""'#13#10'"Json Pointer: Use / '
  +'for levels, keys for objects, and numbers for indexes.\n"'#13#10'"Use * for'
  +' all items, *#10 to join items by newline. Use ~ at the end of the path to '
  +'return the raw JSON branch.\n"'#13#10'"Separate multiple segments with semi'
  +'colon ;.\n"'#13#10'"Literal: Text block in {'#226#128#166'}. Special tag #1'
  +'0 for newlines. Use {{regex}} inside to extract data directly into the text'
  +'.\n"'#13#10'"Logic: If a Pointer in a segment is empty, the whole segment i'
  +'s skipped. If a segment has no Pointer, only literal text blocks with embed'
  +'ded regular expressions are processed.\n"'#13#10'"Regex: {prefix {regex[ind'
  +'ex]} suffix} inside a text block. If no [index] is specified, the first mat'
  +'ch is used.\n"'#13#10'"Index can be a number, [*] (join by space), or [*#10'
  +'] (join by newline). If the regex finds no match, the entire {'#226#128#166
  +'} block is removed.\n"'#13#10'"Using ~ inside a regex returns the entire te'
  +'xt.\n"'#13#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to sh'
  +'ow its text only if the Pointer data is missing or the JSON is invalid.\n"'
  +#13#10'"Commenting: /* text */ comments are stripped from the entire express'
  +'ion before any processing.\n"'#13#10'"Examples:\n"'#13#10'"responseData/tra'
  +'nslatedText; matches/*#10/translation; /texts/text; {literal text#10}; /res'
  +'ult/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translat'
  +'ions/0/text"'#13#10'msgstr ""'#13#10'"Pointer JSON: Gunakan / untuk level, '
  +'kunci untuk objek, dan angka untuk indeks. Gunakan * untuk semua item, dan '
  +'*#10 untuk menggabungkan item dengan baris baru. Gunakan ~ di akhir jalur u'
  +'ntuk mengembalikan cabang JSON mentah. Pisahkan beberapa segmen dengan titi'
  +'k koma ;.\n"'#13#10'"Literal: Blok teks di dalam {'#226#128#166'}. Tag khus'
  +'us #10 untuk baris baru. Gunakan {{regex}} di dalamnya untuk mengekstrak da'
  +'ta langsung ke dalam teks.\n"'#13#10'"Logika: Jika sebuah pointer dalam seg'
  +'men kosong, seluruh segmen dilewati. Jika sebuah segmen tidak memiliki poin'
  +'ter, hanya blok teks literal dengan ekspresi reguler yang disematkan yang d'
  +'iproses.\n"'#13#10'"Regex: {awalan {regex[index]} akhiran} di dalam blok te'
  +'ks. Jika [index] tidak ditentukan, kecocokan pertama akan digunakan. Indeks'
  +' dapat berupa angka, [*] (gabungkan dengan spasi), atau [*#10] (gabungkan d'
  +'engan baris baru). Jika ekspresi reguler tidak menemukan kecocokan, seluruh'
  +' blok {'#226#128#166'} akan dihapus. Menggunakan ~ di dalam ekspresi regule'
  ,'r akan mengembalikan seluruh teks.\n"'#13#10'"Inversi: Awali segmen dengan '
  +'! (misalnya !/path{Error}) agar teksnya hanya ditampilkan jika data pointer'
  +' tidak ada atau JSON tidak valid.\n"'#13#10'"Komentar: Komentar /* teks */ '
  +'dihapus dari seluruh ekspresi sebelum pemrosesan apa pun.\n"'#13#10'"Contoh'
  +':\n"'#13#10'"responseData/translatedText; matches/*#10/translation; /texts/'
  +'text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{E'
  +'rror: No data!#10}; /translations"'#13#10#13#10'#: formconfig.rscripthint'
  +#13#10'msgid ""'#13#10'"The script is a standard Pascal program: optional va'
  +'r section, then a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example'
  +':\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetPar'
  +'am(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13
  +#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Yo'
  +'u can also use standard Pascal constructs (if, for, while, repeat, etc.). Y'
  +'ou can define your own functions and procedures before the main begin ... e'
  +'nd. block.\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetPara'
  +'m(''name'') : string\n"'#13#10'"    Retrieve an input parameter value.\n"'
  +#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Store an output valu'
  +'e for the host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current '
  +'Unix timestamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int6'
  +'4\n"'#13#10'"    Random integer with exactly Length decimal digits.\n"'#13
  +#10'"  Random : Extended\n"'#13#10'"    Random float in the range [0, 1).\n"'
  +#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Convert integer to'
  +' hexadecimal string with at least Digits characters.\n"'#13#10'"  StrToInt('
  +'S) : Integer\n"'#13#10'"    Convert a string to an integer. Raises an excep'
  +'tion on invalid input.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"   '
  +' Convert an integer to its string representation.\n"'#13#10'"  Trim(S) : st'
  +'ring\n"'#13#10'"    Remove leading and trailing whitespace from S.\n"'#13#10
  +'"  TrimLeft(S) : string\n"'#13#10'"    Remove leading whitespace from S.\n"'
  +#13#10'"  TrimRight(S) : string\n"'#13#10'"    Remove trailing whitespace fr'
  +'om S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Encode special HTM'
  +'L characters in S into entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13
  +#10'"    Decode HTML entities in S back to characters.\n"'#13#10'"  UrlEncod'
  +'e(S) : string\n"'#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13
  +#10'"  UrlDecode(S) : string\n"'#13#10'"    Decode a percent-encoded string '
  +'S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : s'
  +'tring\n"'#13#10'"    Replace all occurrences of OldPattern with NewPattern '
  +'in S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13
  +#10'"    Replace all regex matches of Pattern with Replacement in Input. Cas'
  +'e-insensitive.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10
  +'"    Check if Input matches the regex Pattern. Case-insensitive.\n"'#13#10
  +'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extrac'
  +'t the substring of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13
  +#10'"JSON functions (use a handle returned by JSONParse):\n"'#13#10'"  JSONP'
  +'arse(S) : Integer\n"'#13#10'"    Parse a JSON string and return a handle (>'
  +'=0). Returns -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Rele'
  +'ase the handle after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string'
  +'\n"'#13#10'"    Get a string value at the specified Path.\n"'#13#10'"  JSON'
  +'GetInt(Handle, Path) : Integer\n"'#13#10'"    Get an integer value at the s'
  +'pecified Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10
  +'"    Get a floating-point value at the specified Path.\n"'#13#10'"  JSONGet'
  +'Bool(Handle, Path) : Boolean\n"'#13#10'"    Get a boolean value at the spec'
  +'ified Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10
  +'"    Get the number of elements in an array at the specified Path.\n"'#13#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#13#10'"  JSONGetAr'
  +'rayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Get the integer value '
  +'of an array element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Pa'
  +'th) : string\n"'#13#10'"    Return the type of the value at Path: \"object\'
  +'", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10
  +'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the speci'
  +'fied Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an '
  +'empty JSON array for building a standard error result.\n"'#13#10'"  JSONRes'
  +'ultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an er'
  +'ror object to the result array. Replacements is a string of values separate'
  ,'d by \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the c'
  +'urrent result array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10
  +'"    Clear the result array.\n"'#13#10'"  Always call JSONFree to release t'
  +'he handle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working wit'
  +'h JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10
  +'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"  '
  +'  if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h'
  +', ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"     '
  +' JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'Available parameters (retrieved with GetParam):\n"'#13#10'"  text - the inp'
  +'ut text to process (possibly truncated to MaxLength)\n"'#13#10'"  source - '
  +'source language code (may be empty)\n"'#13#10'"  target - target language c'
  +'ode\n"'#13#10'"  timestamp - current Unix timestamp in milliseconds (string'
  +')\n"'#13#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand -'
  +' same as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are'
  +' also available."'#13#10'msgstr ""'#13#10'"Skrip ini adalah program Pascal '
  +'standar: bagian var opsional, lalu blok utama begin ... end.\n"'#13#10'"\n"'
  +#13#10'"Contoh:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"  '
  +'  s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', '
  +'False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10
  +'"\n"'#13#10'"Anda juga dapat menggunakan konstruksi Pascal standar (if, for'
  +', while, repeat, dll.). Anda dapat mendefinisikan fungsi dan prosedur Anda '
  +'sendiri sebelum blok utama begin ... end.\n"'#13#10'"\n"'#13#10'"Fungsi yan'
  +'g tersedia:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Mengamb'
  +'il nilai parameter input.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13
  +#10'"    Menyimpan nilai output untuk host.\n"'#13#10'"  GetTimestamp() : In'
  +'t64\n"'#13#10'"    Timestamp Unix saat ini dalam milidetik (UTC).\n"'#13#10
  +'"  GetRandom(Length) : Int64\n"'#13#10'"    Bilangan bulat acak dengan tepa'
  +'t Length digit desimal.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Bilan'
  +'gan floating-point acak dalam rentang [0, 1).\n"'#13#10'"  IntToHex(Value, '
  +'Digits) : string\n"'#13#10'"    Mengonversi bilangan bulat menjadi string h'
  +'eksadesimal dengan setidaknya Digits karakter.\n"'#13#10'"  StrToInt(S) : I'
  +'nteger\n"'#13#10'"    Mengonversi string menjadi bilangan bulat. Menghasilk'
  +'an pengecualian jika input tidak valid.\n"'#13#10'"  IntToStr(Value) : stri'
  +'ng\n"'#13#10'"    Mengonversi bilangan bulat menjadi representasi string-ny'
  +'a.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Menghapus spasi di awal dan'
  +' akhir S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Menghapus spasi '
  +'di awal S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Menghapus spas'
  +'i di akhir S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Mengodekan'
  +' karakter HTML khusus dalam S menjadi entitas.\n"'#13#10'"  HtmlDecode(S) :'
  +' string\n"'#13#10'"    Mendekode entitas HTML dalam S kembali menjadi karak'
  +'ter.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Melakukan pengodean '
  +'persen pada S agar aman disertakan dalam URL.\n"'#13#10'"  UrlDecode(S) : s'
  +'tring\n"'#13#10'"    Mendekode string S yang telah dikodekan dengan pengode'
  +'an persen.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=Fa'
  +'lse) : string\n"'#13#10'"    Mengganti semua kemunculan OldPattern dengan N'
  +'ewPattern dalam S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) :'
  +' string\n"'#13#10'"    Mengganti semua kecocokan ekspresi reguler Pattern d'
  +'engan Replacement dalam Input. Tidak membedakan huruf besar-kecil.\n"'#13#10
  +'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Memeriksa apakah Inp'
  +'ut cocok dengan ekspresi reguler Pattern. Tidak membedakan huruf besar-keci'
  +'l.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10
  +'"    Mengekstrak substring dari S yang berada di antara StartMarker dan End'
  +'Marker.\n"'#13#10'"\n"'#13#10'"Fungsi JSON (gunakan handle yang dikembalika'
  +'n oleh JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Mengu'
  +'rai string JSON dan mengembalikan handle (>=0). Mengembalikan -1 jika terja'
  +'di kesalahan.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Melepaskan handl'
  +'e setelah digunakan.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'
  +#13#10'"    Mendapatkan nilai string pada Path yang ditentukan.\n"'#13#10'" '
  +' JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    Mendapatkan nilai bilang'
  +'an bulat pada Path yang ditentukan.\n"'#13#10'"  JSONGetFloat(Handle, Path)'
  +' : Extended\n"'#13#10'"    Mendapatkan nilai floating-point pada Path yang '
  +'ditentukan.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"   '
  ,' Mendapatkan nilai boolean pada Path yang ditentukan.\n"'#13#10'"  JSONGetA'
  +'rrayCount(Handle, Path) : Integer\n"'#13#10'"    Mendapatkan jumlah elemen '
  +'dalam array pada Path yang ditentukan.\n"'#13#10'"  JSONGetArrayString(Hand'
  +'le, Path, Index) : string\n"'#13#10'"    Mendapatkan nilai string elemen ar'
  +'ray pada Index yang ditentukan.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, '
  +'Index) : Integer\n"'#13#10'"    Mendapatkan nilai bilangan bulat elemen arr'
  +'ay pada Index yang ditentukan.\n"'#13#10'"  JSONGetType(Handle, Path) : str'
  +'ing\n"'#13#10'"    Mengembalikan tipe nilai pada Path: \"object\", \"array\'
  +'", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPat'
  +'hExists(Handle, Path) : Boolean\n"'#13#10'"    Memeriksa apakah Path yang d'
  +'itentukan ada.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Menginisialisasi '
  +'array JSON kosong untuk membuat hasil kesalahan standar.\n"'#13#10'"  JSONR'
  +'esultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"    Menamba'
  +'hkan objek kesalahan ke array hasil. Replacements adalah string nilai yang '
  +'dipisahkan dengan \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"   '
  +' Mengembalikan array hasil saat ini sebagai string JSON.\n"'#13#10'"  JSONR'
  +'esultClear\n"'#13#10'"    Menghapus array hasil.\n"'#13#10'"  Selalu panggi'
  +'l JSONFree untuk melepaskan handle setelah selesai menggunakannya.\n"'#13#10
  +'"\n"'#13#10'"Contoh penggunaan JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10
  +'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam'
  +'(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10
  +'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''t'
  +'ext'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  e'
  +'nd.\n"'#13#10'"\n"'#13#10'"Parameter yang tersedia (diambil dengan GetParam'
  +'):\n"'#13#10'"  text - teks input yang akan diproses (mungkin dipotong hing'
  +'ga MaxLength)\n"'#13#10'"  source - kode bahasa sumber (dapat kosong)\n"'#13
  +#10'"  target - kode bahasa target\n"'#13#10'"  timestamp - timestamp Unix s'
  +'aat ini dalam milidetik (string)\n"'#13#10'"  random  - angka acak 9 digit '
  +'(string)\n"'#13#10'"  rand - sama dengan random\n"'#13#10'"  rand1..rand9 -'
  +' 1..9 digit pertama dari angka acak\n"'#13#10'"\n"'#13#10'"Parameter awal d'
  +'an parameter kustom tambahan juga tersedia.\n"'#13#10'"Parameter awal dan p'
  +'arameter kustom tambahan juga tersedia."'#13#10#13#10'#: formconfig.rscript'
  +'responsehint'#13#10'msgid ""'#13#10'"This script processes the response dat'
  +'a. All functions and parameters described in the script hint are available '
  +'here as well.\n"'#13#10'"Use GetParam(''result'') to obtain the received te'
  +'xt.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"'
  +'  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput('
  +'''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define cus'
  +'tom parameters in the parameters script using SetParam(''name'', ''value'')'
  +',\n"'#13#10'"and then retrieve them here with GetParam(''name'')."'#13#10'm'
  +'sgstr ""'#13#10'"Skrip ini memproses data respons. Semua fungsi dan paramet'
  +'er yang dijelaskan dalam petunjuk skrip juga tersedia di sini.\n"'#13#10'"G'
  +'unakan GetParam(''result'') untuk memperoleh teks yang diterima.\n"'#13#10
  +'"\n"'#13#10'"Contoh:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13
  +#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput(''result'', s);'
  +'\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Anda dapat menentukan parameter k'
  +'husus dalam skrip parameter menggunakan SetParam(''name'', ''value''),\n"'
  +#13#10'"lalu mengambilnya di sini dengan GetParam(''name'')."'#13#10#13#10'#'
  +': formconfig.rvaluetype1'#13#10'msgctxt "formconfig.rvaluetype1"'#13#10'msg'
  +'id "None"'#13#10'msgstr "Tidak ada"'#13#10#13#10'#: formconfig.rvaluetype2'
  +#13#10'msgid "Language"'#13#10'msgstr "Bahasa"'#13#10#13#10'#: formconfig.rv'
  +'aluetype3'#13#10'msgid "Currency All"'#13#10'msgstr "Semua Mata Uang"'#13#10
  +#13#10'#: formconfig.rvaluetype4'#13#10'msgid "Currency Fiat Only"'#13#10'ms'
  +'gstr "Hanya Mata Uang Fiat"'#13#10#13#10'#: formconfig.rvaluetype5'#13#10'm'
  +'sgid "Currency Crypto Only"'#13#10'msgstr "Hanya Mata Uang Kripto"'#13#10#13
  +#10'#: formconfig.rvaluetype6'#13#10'msgid "Measurement Units"'#13#10'msgstr'
  +' "Satuan Ukur"'#13#10#13#10'#: tformconfigtrayslate.aclearicon.caption'#13
