  +#230#174#181#227#128#130#229#166#130#230#158#156#228#184#128#228#184#170#230
  +#174#181#230#178#161#230#156#137' Pointer'#239#188#140#229#136#153#229#143
  +#170#229#164#132#231#144#134#229#140#133#229#144#171#229#181#140#229#133#165
  ,#230#173#163#229#136#153#232#161#168#232#190#190#229#188#143#231#154#132#229
  +#173#151#233#157#162#233#135#143#230#150#135#230#156#172#229#157#151#227#128
  +#130'\n"'#10'"Regex'#239#188#154#230#150#135#230#156#172#229#157#151#228#184
  +#173#231#154#132' {'#229#137#141#231#188#128' {regex[index]} '#229#144#142
  +#231#188#128'}'#227#128#130#229#166#130#230#158#156#230#156#170#230#140#135
  +#229#174#154' [index]'#239#188#140#229#136#153#228#189#191#231#148#168#231
  +#172#172#228#184#128#228#184#170#229#140#185#233#133#141#231#187#147#230#158
  +#156#227#128#130#231#180#162#229#188#149#229#143#175#228#187#165#230#152#175
  +#230#149#176#229#173#151#227#128#129'[*]'#239#188#136#228#189#191#231#148#168
  +#231#169#186#230#160#188#232#191#158#230#142#165#239#188#137#230#136#150' [*'
  +'#10]'#239#188#136#228#189#191#231#148#168#230#141#162#232#161#140#232#191
  +#158#230#142#165#239#188#137#227#128#130#229#166#130#230#158#156#230#173#163
  +#229#136#153#232#161#168#232#190#190#229#188#143#230#156#170#230#137#190#229
  +#136#176#229#140#185#233#133#141#233#161#185#239#188#140#229#136#153#230#149
  +#180#228#184#170' {'#226#128#166'} '#229#157#151#228#188#154#232#162#171#229
  +#136#160#233#153#164#227#128#130#229#156#168#230#173#163#229#136#153#232#161
  +#168#232#190#190#229#188#143#228#184#173#228#189#191#231#148#168' ~ '#229#176
  +#134#232#191#148#229#155#158#229#174#140#230#149#180#230#150#135#230#156#172
  +#227#128#130'\n"'#10'"'#229#143#141#232#189#172#239#188#154#228#187#165' ! '
  +#229#188#128#229#167#139#228#184#128#228#184#170#230#174#181#239#188#136#228
  +#190#139#229#166#130' !/path{Error}'#239#188#137#239#188#140#228#187#133#229
  +#189#147' Pointer '#230#149#176#230#141#174#231#188#186#229#164#177#230#136
  +#150' JSON '#230#151#160#230#149#136#230#151#182#230#152#190#231#164#186#229
  +#133#182#230#150#135#230#156#172#227#128#130'\n"'#10'"'#230#179#168#233#135
  +#138#239#188#154'/* text */ '#230#179#168#233#135#138#228#188#154#229#156#168
  +#228#187#187#228#189#149#229#164#132#231#144#134#228#185#139#229#137#141#228
  +#187#142#230#149#180#228#184#170#232#161#168#232#190#190#229#188#143#228#184
  +#173#229#136#160#233#153#164#227#128#130'\n"'#10'"'#231#164#186#228#190#139
  +#239#188#154'\n"'#10'"responseData/translatedText; matches/*#10/translation;'
  +' /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/transl'
  +'ations{Error: No data!#10}; /translations"'#10#10'#: formconfig.rscripthint'
  +#10'msgid ""'#10'"The script is a standard Pascal program: optional var sect'
  +'ion, then a main begin ... end. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  '
  +'var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10
  +'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'
  +''', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also use standard Pascal co'
  +'nstructs (if, for, while, repeat, etc.). You can define your own functions '
  +'and procedures before the main begin ... end. block.\n"'#10'"\n"'#10'"Avail'
  +'able functions:\n"'#10'"  GetParam(''name'') : string\n"'#10'"    Retrieve '
  +'an input parameter value.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"'
  +'    Store an output value for the host.\n"'#10'"  GetTimestamp() : Int64\n"'
  +#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#10'"  GetRandom(L'
  +'ength) : Int64\n"'#10'"    Random integer with exactly Length decimal digit'
  +'s.\n"'#10'"  Random : Extended\n"'#10'"    Random float in the range [0, 1)'
  +'.\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Convert integer to'
  +' hexadecimal string with at least Digits characters.\n"'#10'"  StrToInt(S) '
  +': Integer\n"'#10'"    Convert a string to an integer. Raises an exception o'
  +'n invalid input.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Convert an '
  +'integer to its string representation.\n"'#10'"  Trim(S) : string\n"'#10'"  '
  +'  Remove leading and trailing whitespace from S.\n"'#10'"  TrimLeft(S) : st'
  +'ring\n"'#10'"    Remove leading whitespace from S.\n"'#10'"  TrimRight(S) :'
  +' string\n"'#10'"    Remove trailing whitespace from S.\n"'#10'"  HtmlEncode'
  +'(S) : string\n"'#10'"    Encode special HTML characters in S into entities.'
  +'\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HTML entities in S bac'
  +'k to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    Percent-encode'
  +' S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Deco'
  +'de a percent-encoded string S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPatte'
  +'rn, IgnoreCase=False) : string\n"'#10'"    Replace all occurrences of OldPa'
  +'ttern with NewPattern in S.\n"'#10'"  RegexReplace(Input, Pattern, Replacem'
  +'ent) : string\n"'#10'"    Replace all regex matches of Pattern with Replace'
  +'ment in Input. Case-insensitive.\n"'#10'"  RegexMatch(Input, Pattern) : Boo'
  +'lean\n"'#10'"    Check if Input matches the regex Pattern. Case-insensitive'
  +'.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10'"    '
  +'Extract the substring of S between StartMarker and EndMarker.\n"'#10'"\n"'
  ,#10'"JSON functions (use a handle returned by JSONParse):\n"'#10'"  JSONPars'
  +'e(S) : Integer\n"'#10'"    Parse a JSON string and return a handle (>=0). R'
  +'eturns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Release the hand'
  +'le after use.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'#10'"    Ge'
  +'t a string value at the specified Path.\n"'#10'"  JSONGetInt(Handle, Path) '
  +': Integer\n"'#10'"    Get an integer value at the specified Path.\n"'#10'" '
  +' JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a floating-point val'
  +'ue at the specified Path.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'
  +#10'"    Get a boolean value at the specified Path.\n"'#10'"  JSONGetArrayCo'
  +'unt(Handle, Path) : Integer\n"'#10'"    Get the number of elements in an ar'
  +'ray at the specified Path.\n"'#10'"  JSONGetArrayString(Handle, Path, Index'
  +') : string\n"'#10'"    Get the string value of an array element at the give'
  +'n Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#10'" '
  +'   Get the integer value of an array element at the given Index.\n"'#10'"  '
  +'JSONGetType(Handle, Path) : string\n"'#10'"    Return the type of the value'
  +' at Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", '
  +'\"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10'"    Chec'
  +'k if the specified Path exists.\n"'#10'"  JSONResultInit\n"'#10'"    Initia'
  +'lize an empty JSON array for building a standard error result.\n"'#10'"  JS'
  +'ONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"    Add an '
  +'error object to the result array. Replacements is a string of values separa'
  +'ted by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Return the curre'
  +'nt result array as a JSON string.\n"'#10'"  JSONResultClear\n"'#10'"    Cle'
  +'ar the result array.\n"'#10'"  Always call JSONFree to release the handle a'
  +'fter you are done.\n"'#10'"\n"'#10'"Example of working with JSON:\n"'#10'" '
  +' var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h := '
  +'JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    beg'
  +'in\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetOut'
  +'put(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  end'
  +'.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'#10'"'
  +'  text - the input text to process (possibly truncated to MaxLength)\n"'#10
  +'"  source - source language code (may be empty)\n"'#10'"  target - target l'
  +'anguage code\n"'#10'"  timestamp - current Unix timestamp in milliseconds ('
  +'string)\n"'#10'"  random  - 9-digit random number (string)\n"'#10'"  rand -'
  +' same as random\n"'#10'"  rand1..rand9 - first 1..9 digits of the random nu'
  +'mber\n"'#10'"\n"'#10'"Additional initial and custom parameters are also ava'
  +'ilable."'#10'msgstr ""'#10'"'#232#175#165#232#132#154#230#156#172#230#152
  +#175#228#184#128#228#184#170#230#160#135#229#135#134#231#154#132' Pascal '
  +#231#168#139#229#186#143#239#188#154#229#143#175#233#128#137#231#154#132' va'
  +'r '#233#131#168#229#136#134#239#188#140#231#132#182#229#144#142#230#152#175
  +#228#184#187' begin ... end. '#229#157#151#227#128#130'\n"'#10'"\n"'#10'"'
  +#231#164#186#228#190#139#239#188#154'\n"'#10'"  var s: string;\n"'#10'"  beg'
  +'in\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'
  +''', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"'#228#189#160#228#185#159#229#143#175#228#187#165#228#189#191#231
  +#148#168#230#160#135#229#135#134#231#154#132' Pascal '#231#187#147#230#158
  +#132#239#188#136'if'#227#128#129'for'#227#128#129'while'#227#128#129'repeat '
  +#231#173#137#239#188#137#227#128#130#228#189#160#229#143#175#228#187#165#229
  +#156#168#228#184#187' begin ... end. '#229#157#151#228#185#139#229#137#141
  +#229#174#154#228#185#137#232#135#170#229#183#177#231#154#132#229#135#189#230
  +#149#176#229#146#140#232#191#135#231#168#139#227#128#130'\n"'#10'"\n"'#10'"'
