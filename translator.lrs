  +': !/path{Error}'#239#188#137#227#128#130'Pointer '#227#129#174#227#131#135
  +#227#131#188#227#130#191#227#129#140#229#173#152#229#156#168#227#129#151#227
  +#129#170#227#129#132#229#160#180#229#144#136#227#128#129#227#129#190#227#129
