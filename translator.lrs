  +'yslate.checkservicevisible.caption'#10'msgid "Visible in menu"'#10'msgstr "'
  +'Vis'#195#173'vel no menu"'#10#10'#: tformconfigtrayslate.combomethod.text'
  +#10'msgid "GET"'#10'msgstr "GET"'#10#10'#: tformconfigtrayslate.combovaluety'
  +'pe.text'#10'msgctxt "tformconfigtrayslate.combovaluetype.text"'#10'msgid "N'
  +'one"'#10'msgstr "Vazio"'#10#10'#: tformconfigtrayslate.groupboxcustomparame'
  +'ters.caption'#10'msgid "Custom Parameters"'#10'msgstr "Par'#195#162'metros '
  +'Personalizados"'#10#10'#: tformconfigtrayslate.groupboxservice.caption'#10
  +'msgctxt "tformconfigtrayslate.groupboxservice.caption"'#10'msgid "Service"'
  +#10'msgstr "Servi'#195#167'o"'#10#10'#: tformconfigtrayslate.groupinitparame'
  +'ters.caption'#10'msgctxt "tformconfigtrayslate.groupinitparameters.caption"'
  +#10'msgid "Initial Request"'#10'msgstr "Requisi'#195#167#195#163'o Inicial"'
  +#10#10'#: tformconfigtrayslate.grouplanguages.caption'#10'msgctxt "tformconf'
  +'igtrayslate.grouplanguages.caption"'#10'msgid "Languages"'#10'msgstr "Idiom'
  +'as"'#10#10'#: tformconfigtrayslate.grouplanguagestarget.caption'#10'msgctxt'
  +' "tformconfigtrayslate.grouplanguagestarget.caption"'#10'msgid "Target Lang'
  +'uages"'#10'msgstr "Idiomas de Destino"'#10#10'#: tformconfigtrayslate.group'
  +'request.caption'#10'msgctxt "tformconfigtrayslate.grouprequest.caption"'#10
  +'msgid "Request"'#10'msgstr "Requisi'#195#167#195#163'o"'#10#10'#: tformconf'
  +'igtrayslate.groupresponse.caption'#10'msgid "Json Pointer Processing the Re'
  +'sponse"'#10'msgstr "Processamento do Ponteiro Json da Resposta"'#10#10'#: t'
  +'formconfigtrayslate.groupscript.caption'#10'msgid "Script Retrieved Paramet'
  +'ers"'#10'msgstr "Par'#195#162'metros Recuperados do Script"'#10#10'#: tform'
  +'configtrayslate.groupscriptresponse.caption'#10'msgid "Script Processing th'
  +'e Response"'#10'msgstr "Script de Processamento da Resposta"'#10#10'#: tfor'
  +'mconfigtrayslate.imagepreview.hint'#10'msgid "Click to select the config ic'
  +'on, Middle-Click clears the icon"'#10'msgstr "Clique para selecionar o '#195
  +#173'cone de configura'#195#167#195#163'o; clique do bot'#195#163'o do meio '
  +'para limpar o '#195#173'cone"'#10#10'#: tformconfigtrayslate.labelaccept.ca'
  +'ption'#10'msgid "Accept"'#10'msgstr "Aceitar"'#10#10'#: tformconfigtrayslat'
  +'e.labelcolorrecent.caption'#10'msgid "Recent Color"'#10'msgstr "Cor Recente'
  +'"'#10#10'#: tformconfigtrayslate.labelcontenttype.caption'#10'msgid "Conten'
  +'t Type"'#10'msgstr "Tipo de Conte'#195#186'do"'#10#10'#: tformconfigtraysla'
  +'te.labelfilllanguages.caption'#10'msgctxt "tformconfigtrayslate.labelfillla'
  +'nguages.caption"'#10'msgid "Fill with default"'#10'msgstr "Preencher com o '
  +'padr'#195#163'o"'#10#10'#: tformconfigtrayslate.labelfilltargetlanguages.ca'
  +'ption'#10'msgctxt "tformconfigtrayslate.labelfilltargetlanguages.caption"'
  +#10'msgid "Fill with default"'#10'msgstr "Preencher com o padr'#195#163'o"'
  +#10#10'#: tformconfigtrayslate.labelheaders.caption'#10'msgid "Additional re'
  ,'quest headers in key=value format, key: value is also supported"'#10'msgstr'
  +' "Cabe'#195#167'alhos de requisi'#195#167#195#163'o adicionais no formato c'
  +'have=valor; o formato chave: valor tamb'#195#169'm '#195#169' aceito"'#10#10
  +'#: tformconfigtrayslate.labelinitheaders.caption'#10'msgid "Additional init'
  +'ial request headers in key=value format, key: value is also supported"'#10
  +'msgstr "Cabe'#195#167'alhos de requisi'#195#167#195#163'o inicial adicionai'
  +'s no formato chave=valor; o formato chave: valor tamb'#195#169'm '#195#169
  +' aceito"'#10#10'#: tformconfigtrayslate.labelinitheaders2.caption'#10'msgct'
  +'xt "tformconfigtrayslate.labelinitheaders2.caption"'#10'msgid "Headers"'#10
  +'msgstr "Cabe'#195#167'alhos"'#10#10'#: tformconfigtrayslate.labelinitliveti'
  +'me.caption'#10'msgid "Live time"'#10'msgstr "Tempo de vida"'#10#10'#: tform'
  +'configtrayslate.labelinitparameters.caption'#10'msgid "Parameters name=rege'
  +'xp are extracted from the response and used by name in requests"'#10'msgstr'
  +' "Par'#195#162'metros no formato nome=express'#195#163'o_regular s'#195#163
  +'o extra'#195#173'dos da resposta e utilizados pelo nome nas requisi'#195#167
  +#195#181'es"'#10#10'#: tformconfigtrayslate.labelinitparameters1.caption'#10
  +'msgid "Time in seconds to refresh parameters with a new request (0 = every '
  +'request)"'#10'msgstr "Tempo em segundos para atualizar os par'#195#162'metr'
  +'os com uma nova requisi'#195#167#195#163'o (0 = a cada requisi'#195#167#195
  +#163'o)"'#10#10'#: tformconfigtrayslate.labelinitparameters2.caption'#10'msg'
  +'ctxt "tformconfigtrayslate.labelinitparameters2.caption"'#10'msgid "Paramet'
  +'ers"'#10'msgstr "Par'#195#162'metros"'#10#10'#: tformconfigtrayslate.labeli'
  +'nitparameters4.caption'#10'msgid "Parameters in the form key=value used by '
  +'{key} in requests. If the value is omitted (key=), it will be requested fro'
  +'m the user."'#10'msgstr "Par'#195#162'metros no formato chave=valor usados '
  +'por {chave} nas requisi'#195#167#195#181'es Se o valor for omitido (chave=)'
  +', ele ser'#195#161' solicitado ao usu'#195#161'rio."'#10#10'#: tformconfigt'
  +'rayslate.labelinitparemeters.caption'#10'msgid "Initial GET request to obta'
  +'in required parameters."'#10'msgstr "Requisi'#195#167#195#163'o GET inicial'
  +' para obter os par'#195#162'metros necess'#195#161'rios."'#10#10'#: tformco'
  +'nfigtrayslate.labeliniturl.caption'#10'msgctxt "tformconfigtrayslate.labeli'
  +'niturl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10'#: tformconfigtrays'
  +'late.labelinituseragent.caption'#10'msgctxt "tformconfigtrayslate.labelinit'
  +'useragent.caption"'#10'msgid "User Agent"'#10'msgstr "Agente de Usu'#195#161
  +'rio"'#10#10'#: tformconfigtrayslate.labellanguages.caption'#10'msgid "Suppo'
  +'rted languages e.g. en=en-US (en - internal, en-US - service). \"empty\" - '
  +'do not send."'#10'msgstr "Idiomas suportados, por exemplo, en=en-US (en - i'
  +'nterno, en-US - servi'#195#167'o). \"vazio\" - n'#195#163'o enviar."'#10#10
  +'#: tformconfigtrayslate.labellanguages1.caption'#10'msgid "Value type for p'
  +'opulating names. None keeps originals; None and Unit are case-sensitive."'
  +#10'msgstr "Tipo de valor para preenchimento de nomes. Nenhum mant'#195#169
  +'m os originais; Nenhum e Unidade diferenciam mai'#195#186'sculas de min'#195
  +#186'sculas."'#10#10'#: tformconfigtrayslate.labellanguagestarget.caption'#10
  +'msgid ""'#10'"Target languages e.g. en=en-US, en - internal, en-US - servic'
  +'e code.\n"'#10'"If not specified, both source and target languages are take'
  +'n from the languages section."'#10'msgstr ""'#10'"Idiomas de destino, por e'
  +'xemplo, en=en-US, en - interno, en-US - c'#195#179'digo do servi'#195#167'o'
  +'.\n"'#10'"Se n'#195#163'o especificado, tanto o idioma de origem quanto o d'
  +'e destino s'#195#163'o obtidos da se'#195#167#195#163'o de idiomas."'#10#10
  +'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid "Max Length, bytes'
  +'"'#10'msgstr "Comprimento M'#195#161'ximo, em bytes"'#10#10'#: tformconfigt'
  +'rayslate.labelmethod.caption'#10'msgid "Method"'#10'msgstr "M'#195#169'todo'
  +'"'#10#10'#: tformconfigtrayslate.labelparemeters.caption'#10'msgid "Use par'
  +'ameters: {text} '#226#128#147' input text, {source} '#226#128#147' source l'
  +'anguage, {target} '#226#128#147' target language. Prefix the name with ! fo'
  +'r lowercase or ^ for uppercase value. Also supported {timestamp}, {rand}. U'
  +'se {parameter} from the parameters page."'#10'msgstr "Use par'#195#162'metr'
  +'os: {text} '#226#128#147' texto de entrada, {source} '#226#128#147' idioma '
  +'de origem, {target} '#226#128#147' idioma de destino. Adicione ! antes do n'
  +'ome para valor em min'#195#186'sculas ou ^ para valor em mai'#195#186'scula'
  +'s. Tamb'#195#169'm s'#195#163'o compat'#195#173'veis {timestamp}, {rand}. U'
  +'se {par'#195#162'metro} da p'#195#161'gina de par'#195#162'metros."'#10#10
  +'#: tformconfigtrayslate.labelpostdata.caption'#10'msgid "Post Data"'#10'msg'
  +'str "Dados de Postagem"'#10#10'#: tformconfigtrayslate.labelpostdata1.capti'
  ,'on'#10'msgctxt "tformconfigtrayslate.labelpostdata1.caption"'#10'msgid "Hea'
  +'ders"'#10'msgstr "Cabe'#195#167'alhos"'#10#10'#: tformconfigtrayslate.label'
  +'servicedescription.caption'#10'msgid "Description"'#10'msgstr "Descri'#195
  +#167#195#163'o"'#10#10'#: tformconfigtrayslate.labelservicename.caption'#10
  +'msgid "Name"'#10'msgstr "Nome"'#10#10'#: tformconfigtrayslate.labelserviceo'
  +'rder.caption'#10'msgid "Order"'#10'msgstr "Ordem"'#10#10'#: tformconfigtray'
  +'slate.labelsort.caption'#10'msgctxt "tformconfigtrayslate.labelsort.caption'
  +'"'#10'msgid "Sort"'#10'msgstr "Ordenar"'#10#10'#: tformconfigtrayslate.labe'
  +'ltargetsort.caption'#10'msgctxt "tformconfigtrayslate.labeltargetsort.capti'
  +'on"'#10'msgid "Sort"'#10'msgstr "Ordenar"'#10#10'#: tformconfigtrayslate.la'
  +'belurl.caption'#10'msgctxt "tformconfigtrayslate.labelurl.caption"'#10'msgi'
  +'d "URL"'#10'msgstr "URL"'#10#10'#: tformconfigtrayslate.labeluseragent.capt'
  +'ion'#10'msgctxt "tformconfigtrayslate.labeluseragent.caption"'#10'msgid "Us'
  +'er Agent"'#10'msgstr "Agente de Usu'#195#161'rio"'#10#10'#: tformconfigtray'
  +'slate.labelvaluetype.caption'#10'msgid "Value Type"'#10'msgstr "Tipo de Val'
  +'or"'#10#10'#: tformconfigtrayslate.pageinitialrequest.caption'#10'msgctxt "'
  +'tformconfigtrayslate.pageinitialrequest.caption"'#10'msgid "Initial Request'
  +'"'#10'msgstr "Requisi'#195#167#195#163'o Inicial"'#10#10'#: tformconfigtray'
  +'slate.pagelanguages.caption'#10'msgctxt "tformconfigtrayslate.pagelanguages'
  +'.caption"'#10'msgid "Languages"'#10'msgstr "Idiomas"'#10#10'#: tformconfigt'
  +'rayslate.pagelanguagestarget.caption'#10'msgctxt "tformconfigtrayslate.page'
  +'languagestarget.caption"'#10'msgid "Target Languages"'#10'msgstr "Idiomas d'
  +'e Destino"'#10#10'#: tformconfigtrayslate.pageparameters.caption'#10'msgctx'
  +'t "tformconfigtrayslate.pageparameters.caption"'#10'msgid "Parameters"'#10
  +'msgstr "Par'#195#162'metros"'#10#10'#: tformconfigtrayslate.pagerequest.cap'
  +'tion'#10'msgctxt "tformconfigtrayslate.pagerequest.caption"'#10'msgid "Requ'
  +'est"'#10'msgstr "Requisi'#195#167#195#163'o"'#10#10'#: tformconfigtrayslate'
  +'.pageresponse.caption'#10'msgid "Response"'#10'msgstr "Resposta"'#10#10'#: '
  +'tformconfigtrayslate.pageservice.caption'#10'msgctxt "tformconfigtrayslate.'
  +'pageservice.caption"'#10'msgid "Service"'#10'msgstr "Servi'#195#167'o"'#10
  +#10'#: tformconfigtrayslate.reloadconfigs.hint'#10'msgid "Reload configurati'
  +'ons from disk"'#10'msgstr "Recarregar configura'#195#167#195#181'es do disc'
  +'o"'#10#10'#: tformconfigtrayslate.sbcopyconfig.hint'#10'msgid "Copy configu'
  +'ration"'#10'msgstr "Copiar configura'#195#167#195#163'o"'#10#10'#: tformcon'
  +'figtrayslate.sbnewconfig.hint'#10'msgid "New configuration"'#10'msgstr "Nov'
  +'a configura'#195#167#195#163'o"'#10
]);
LazarusResources.Add('formconfig.ro','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: ro\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Editor de configura'#200#155'ii"'#10#10'#: formconfig.rclearlanguag'
  +'es'#10'msgid "The list is already filled. Do you want to clear it?"'#10'msg'
  +'str "Lista este deja completat'#196#131'. Dori'#200#155'i s'#196#131' o gol'
  +'i'#200#155'i?"'#10#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure y'
  +'ou want to delete config"'#10'msgstr "Sigur dori'#200#155'i s'#196#131' '
  +#200#153'terge'#200#155'i configura'#200#155'ia"'#10#10'#: formconfig.rdelet'
  +'econfigcaption'#10'msgid "Delete config"'#10'msgstr "'#200#152'terge config'
  +'ura'#200#155'ia"'#10#10'#: formconfig.rnamequestion'#10'msgid "Enter new co'
  +'nfig file name:"'#10'msgstr "Introduce'#200#155'i numele noului fi'#200#153
  +'ier de configurare:"'#10#10'#: formconfig.rneedsave'#10'msgid "The configur'
  +'ation was modified. Save changes?"'#10'msgstr "Configura'#200#155'ia a fost'
  +' modificat'#196#131'. Salva'#200#155'i modific'#196#131'rile?"'#10#10'#: fo'
  +'rmconfig.rresponsehint'#10'msgid ""'#10'"Json Pointer: Use / for levels, ke'
  +'ys for objects, and numbers for indexes.\n"'#10'"Use * for all items, *#10 '
  +'to join items by newline. Use ~ at the end of the path to return the raw JS'
  +'ON branch.\n"'#10'"Separate multiple segments with semicolon ;.\n"'#10'"Lit'
  +'eral: Text block in {'#226#128#166'}. Special tag #10 for newlines. Use {{r'
  +'egex}} inside to extract data directly into the text.\n"'#10'"Logic: If a P'
  +'ointer in a segment is empty, the whole segment is skipped. If a segment ha'
  +'s no Pointer, only literal text blocks with embedded regular expressions ar'
  +'e processed.\n"'#10'"Regex: {prefix {regex[index]} suffix} inside a text bl'
  +'ock. If no [index] is specified, the first match is used.\n"'#10'"Index can'
  +' be a number, [*] (join by space), or [*#10] (join by newline). If the rege'
  +'x finds no match, the entire {'#226#128#166'} block is removed.\n"'#10'"Usi'
  +'ng ~ inside a regex returns the entire text.\n"'#10'"Inversion: Start a seg'
  +'ment with ! (e.g. !/path{Error}) to show its text only if the Pointer data '
  +'is missing or the JSON is invalid.\n"'#10'"Commenting: /* text */ comments '
  +'are stripped from the entire expression before any processing.\n"'#10'"Exam'
  +'ples:\n"'#10'"responseData/translatedText; matches/*#10/translation; /texts'
  +'/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{'
  +'Error: No data!#10}; /translations/0/text"'#10'msgstr ""'#10'"Pointer JSON:'
  +' Folosi'#200#155'i / pentru niveluri, chei pentru obiecte '#200#153'i numer'
  +'e pentru indec'#200#153'i. Folosi'#200#155'i * pentru toate elementele '#200
  +#153'i *#10 pentru a uni elementele prin linie nou'#196#131'. Folosi'#200#155
  +'i ~ la sf'#195#162'r'#200#153'itul c'#196#131'ii pentru a returna ramura JS'
  +'ON brut'#196#131'. Separa'#200#155'i mai multe segmente cu punct '#200#153
  +'i virgul'#196#131' ;.\n"'#10'"Literal: Bloc de text '#195#174'n {'#226#128
  +#166'}. Etichet'#196#131' special'#196#131' #10 pentru linii noi. Folosi'#200
  +#155'i {{regex}} '#195#174'n interior pentru a extrage date direct '#195#174
  +'n text.\n"'#10'"Logic'#196#131': Dac'#196#131' un Pointer dintr-un segment '
  +'este gol, '#195#174'ntregul segment este ignorat. Dac'#196#131' un segment '
  +'nu are Pointer, sunt procesate doar blocurile de text literal cu expresii r'
  +'egulate '#195#174'ncorporate.\n"'#10'"Regex: {prefix {regex[index]} sufix} '
  +#195#174'n interiorul unui bloc de text. Dac'#196#131' [index] nu este speci'
  +'ficat, este utilizat'#196#131' prima potrivire. Indexul poate fi un num'#196
  +#131'r, [*] (unire prin spa'#200#155'iu) sau [*#10] (unire prin linie nou'
  +#196#131'). Dac'#196#131' expresia regulat'#196#131' nu g'#196#131'se'#200
  +#153'te nicio potrivire, '#195#174'ntregul bloc {'#226#128#166'} este elimin'
  +'at. Utilizarea lui ~ '#195#174'n interiorul unei expresii regulate returnea'
  +'z'#196#131' '#195#174'ntregul text.\n"'#10'"Inversare: '#195#142'ncepe'#200
  +#155'i un segment cu ! (de exemplu !/path{Error}) pentru a afi'#200#153'a te'
  +'xtul acestuia doar dac'#196#131' datele Pointer lipsesc sau JSON-ul este in'
  +'valid.\n"'#10'"Comentarii: Comentariile /* text */ sunt eliminate din '#195
  +#174'ntreaga expresie '#195#174'nainte de orice procesare.\n"'#10'"Exemple:\'
  +'n"'#10'"responseData/translatedText; matches/*#10/translation; /texts/text;'
  +' {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error:'
  +' No data!#10}; /translations"'#10#10'#: formconfig.rscripthint'#10'msgid ""'
  +#10'"The script is a standard Pascal program: optional var section, then a m'
  ,'ain begin ... end. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string'
  +';\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := Rep'
  +'laceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10
  +'"  end.\n"'#10'"\n"'#10'"You can also use standard Pascal constructs (if, f'
  +'or, while, repeat, etc.). You can define your own functions and procedures '
  +'before the main begin ... end. block.\n"'#10'"\n"'#10'"Available functions:'
  +'\n"'#10'"  GetParam(''name'') : string\n"'#10'"    Retrieve an input parame'
  +'ter value.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an ou'
  +'tput value for the host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Curre'
  +'nt Unix timestamp in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int6'
  +'4\n"'#10'"    Random integer with exactly Length decimal digits.\n"'#10'"  '
  +'Random : Extended\n"'#10'"    Random float in the range [0, 1).\n"'#10'"  I'
  +'ntToHex(Value, Digits) : string\n"'#10'"    Convert integer to hexadecimal '
  +'string with at least Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'
  +#10'"    Convert a string to an integer. Raises an exception on invalid inpu'
  +'t.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Convert an integer to its'
  +' string representation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leadi'
  +'ng and trailing whitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'" '
  +'   Remove leading whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10
  +'"    Remove trailing whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'
  +#10'"    Encode special HTML characters in S into entities.\n"'#10'"  HtmlDe'
  +'code(S) : string\n"'#10'"    Decode HTML entities in S back to characters.\'
  +'n"'#10'"  UrlEncode(S) : string\n"'#10'"    Percent-encode S for safe URL i'
  +'nclusion.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-enco'
  +'ded string S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=Fa'
  +'lse) : string\n"'#10'"    Replace all occurrences of OldPattern with NewPat'
  +'tern in S.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'
  +#10'"    Replace all regex matches of Pattern with Replacement in Input. Cas'
  +'e-insensitive.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    C'
  +'heck if Input matches the regex Pattern. Case-insensitive.\n"'#10'"  Extrac'
  +'tBetween(S, StartMarker, EndMarker) : string\n"'#10'"    Extract the substr'
  +'ing of S between StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions'
  +' (use a handle returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'
  +#10'"    Parse a JSON string and return a handle (>=0). Returns -1 on error.'
  +'\n"'#10'"  JSONFree(Handle)\n"'#10'"    Release the handle after use.\n"'#10
  +'"  JSONGetString(Handle, Path) : string\n"'#10'"    Get a string value at t'
  +'he specified Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"   '
  +' Get an integer value at the specified Path.\n"'#10'"  JSONGetFloat(Handle,'
  +' Path) : Extended\n"'#10'"    Get a floating-point value at the specified P'
  +'ath.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolea'
  +'n value at the specified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : '
  +'Integer\n"'#10'"    Get the number of elements in an array at the specified'
  +' Path.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'" '
  +'   Get the string value of an array element at the given Index.\n"'#10'"  J'
  +'SONGetArrayInt(Handle, Path, Index) : Integer\n"'#10'"    Get the integer v'
  +'alue of an array element at the given Index.\n"'#10'"  JSONGetType(Handle, '
  +'Path) : string\n"'#10'"    Return the type of the value at Path: \"object\"'
  +', \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  '
  +'JSONPathExists(Handle, Path) : Boolean\n"'#10'"    Check if the specified P'
  +'ath exists.\n"'#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON a'
  +'rray for building a standard error result.\n"'#10'"  JSONResultAddError(Off'
  +'set, Length, Message, Replacements)\n"'#10'"    Add an error object to the '
  +'result array. Replacements is a string of values separated by \"|\".\n"'#10
  +'"  JSONResultGet : string\n"'#10'"    Return the current result array as a '
  +'JSON string.\n"'#10'"  JSONResultClear\n"'#10'"    Clear the result array.\'
  +'n"'#10'"  Always call JSONFree to release the handle after you are done.\n"'
  +#10'"\n"'#10'"Example of working with JSON:\n"'#10'"  var h: Integer;\n"'#10
  +'"      s: string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''res'
  +'ult''));\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JS'
  +'ONGetString(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10
  +'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Availa'
  +'ble parameters (retrieved with GetParam):\n"'#10'"  text - the input text t'
  +'o process (possibly truncated to MaxLength)\n"'#10'"  source - source langu'
  +'age code (may be empty)\n"'#10'"  target - target language code\n"'#10'"  t'
  ,'imestamp - current Unix timestamp in milliseconds (string)\n"'#10'"  random'
  +'  - 9-digit random number (string)\n"'#10'"  rand - same as random\n"'#10'"'
  +'  rand1..rand9 - first 1..9 digits of the random number\n"'#10'"\n"'#10'"Ad'
  +'ditional initial and custom parameters are also available."'#10'msgstr ""'
  +#10'"Scriptul este un program Pascal standard: o sec'#200#155'iune var op'
  +#200#155'ional'#196#131', urmat'#196#131' de un bloc principal begin ... end'
  +'.\n"'#10'"\n"'#10'"Exemplu:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10
  +'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', '
  +'False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10
  +'"De asemenea, pute'#200#155'i utiliza construc'#200#155'iile standard Pasca'
  +'l (if, for, while, repeat etc.). Pute'#200#155'i defini propriile func'#200
  +#155'ii '#200#153'i proceduri '#195#174'nainte de blocul principal begin ...'
  +' end.\n"'#10'"\n"'#10'"Func'#200#155'ii disponibile:\n"'#10'"  GetParam(''n'
  +'ame'') : string\n"'#10'"    Preia valoarea unui parametru de intrare.\n"'#10
  +'"  SetOutput(''name'', ''value'')\n"'#10'"    Stocheaz'#196#131' o valoare '
  +'de ie'#200#153'ire pentru gazd'#196#131'.\n"'#10'"  GetTimestamp() : Int64\'
  +'n"'#10'"    Timestamp-ul Unix curent '#195#174'n milisecunde (UTC).\n"'#10
  +'"  GetRandom(Length) : Int64\n"'#10'"    Num'#196#131'r '#195#174'ntreg ale'
  +'atoriu cu exact Length cifre zecimale.\n"'#10'"  Random : Extended\n"'#10'"'
  +'    Num'#196#131'r real aleatoriu '#195#174'n intervalul [0, 1).\n"'#10'"  '
  +'IntToHex(Value, Digits) : string\n"'#10'"    Converte'#200#153'te un num'
  +#196#131'r '#195#174'ntreg '#195#174'ntr-un '#200#153'ir hexazecimal cu cel '
  +'pu'#200#155'in Digits caractere.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"  '
  +'  Converte'#200#153'te un '#200#153'ir '#195#174'ntr-un num'#196#131'r '#195
  +#174'ntreg. Genereaz'#196#131' o excep'#200#155'ie dac'#196#131' intrarea nu'
  +' este valid'#196#131'.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Conve'
  +'rte'#200#153'te un num'#196#131'r '#195#174'ntreg '#195#174'n reprezentarea'
  +' sa ca '#200#153'ir.\n"'#10'"  Trim(S) : string\n"'#10'"    Elimin'#196#131
  +' spa'#200#155'iile de la '#195#174'nceputul '#200#153'i sf'#195#162'r'#200
  +#153'itul lui S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Elimin'#196#131
  +' spa'#200#155'iile de la '#195#174'nceputul lui S.\n"'#10'"  TrimRight(S) :'
  +' string\n"'#10'"    Elimin'#196#131' spa'#200#155'iile de la sf'#195#162'r'
  +#200#153'itul lui S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Codific'
  +#196#131' caracterele HTML speciale din S sub form'#196#131' de entit'#196
  +#131#200#155'i.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decodeaz'#196
  +#131' entit'#196#131#200#155'ile HTML din S '#195#174'napoi '#195#174'n cara'
  +'ctere.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    Codific'#196#131' S folo'
  +'sind codificarea procentual'#196#131' pentru includerea sigur'#196#131' '
  +#195#174'ntr-un URL.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Decodeaz'
  +#196#131' un '#200#153'ir S codificat procentual.\n"'#10'"  ReplaceAll(S, Ol'
  +'dPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    '#195#142'nloc'
  +'uie'#200#153'te toate apari'#200#155'iile lui OldPattern cu NewPattern '#195
  +#174'n S.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10
  +'"    '#195#142'nlocuie'#200#153'te toate potrivirile expresiei regulate Pat'
  +'tern cu Replacement '#195#174'n Input. Nu '#200#155'ine cont de diferen'#200
  +#155'a dintre litere mari '#200#153'i mici.\n"'#10'"  RegexMatch(Input, Patt'
  +'ern) : Boolean\n"'#10'"    Verific'#196#131' dac'#196#131' Input corespunde'
  +' expresiei regulate Pattern. Nu '#200#155'ine cont de diferen'#200#155'a di'
  +'ntre litere mari '#200#153'i mici.\n"'#10'"  ExtractBetween(S, StartMarker,'
  +' EndMarker) : string\n"'#10'"    Extrage sub'#200#153'irul din S dintre Sta'
  +'rtMarker '#200#153'i EndMarker.\n"'#10'"\n"'#10'"Func'#200#155'ii JSON (uti'
  +'liza'#200#155'i un handle returnat de JSONParse):\n"'#10'"  JSONParse(S) : '
  +'Integer\n"'#10'"    Analizeaz'#196#131' un '#200#153'ir JSON '#200#153'i re'
  +'turneaz'#196#131' un handle (>=0). Returneaz'#196#131' -1 '#195#174'n caz d'
  +'e eroare.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Elibereaz'#196#131' handle'
  +'-ul dup'#196#131' utilizare.\n"'#10'"  JSONGetString(Handle, Path) : string'
  +'\n"'#10'"    Ob'#200#155'ine o valoare de tip '#200#153'ir de caractere la '
  +'calea specificat'#196#131' Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integ'
  +'er\n"'#10'"    Ob'#200#155'ine o valoare '#195#174'ntreag'#196#131' la cale'
  +'a specificat'#196#131' Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extende'
  +'d\n"'#10'"    Ob'#200#155'ine o valoare '#195#174'n virgul'#196#131' mobil'
  +#196#131' la calea specificat'#196#131' Path.\n"'#10'"  JSONGetBool(Handle, '
  +'Path) : Boolean\n"'#10'"    Ob'#200#155'ine o valoare boolean'#196#131' la '
  +'calea specificat'#196#131' Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) '
  ,': Integer\n"'#10'"    Ob'#200#155'ine num'#196#131'rul de elemente dintr-un'
  +' array la calea specificat'#196#131' Path.\n"'#10'"  JSONGetArrayString(Han'
  +'dle, Path, Index) : string\n"'#10'"    Ob'#200#155'ine valoarea de tip '#200
  +#153'ir a unui element din array la indexul specificat Index.\n"'#10'"  JSON'
  +'GetArrayInt(Handle, Path, Index) : Integer\n"'#10'"    Ob'#200#155'ine valo'
  +'area '#195#174'ntreag'#196#131' a unui element din array la indexul specifi'
  +'cat Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Returne'
  +'az'#196#131' tipul valorii de la Path: \"object\", \"array\", \"string\", \'
  +'"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Pat'
  +'h) : Boolean\n"'#10'"    Verific'#196#131' dac'#196#131' calea specificat'
  +#196#131' Path exist'#196#131'.\n"'#10'"  JSONResultInit\n"'#10'"    Ini'#200
  +#155'ializeaz'#196#131' un array JSON gol pentru construirea unui rezultat s'
  +'tandard de eroare.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Re'
  +'placements)\n"'#10'"    Adaug'#196#131' un obiect de eroare '#195#174'n arr'
  +'ay-ul de rezultate. Replacements este un '#200#153'ir de valori separate pr'
  +'in \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Returneaz'#196#131' '
  +'array-ul de rezultate curent ca '#200#153'ir JSON.\n"'#10'"  JSONResultClea'
  +'r\n"'#10'"    Gole'#200#153'te array-ul de rezultate.\n"'#10'"  Apela'#200
  +#155'i '#195#174'ntotdeauna JSONFree pentru a elibera handle-ul dup'#196#131
  +' ce a'#200#155'i terminat de utilizat.\n"'#10'"\n"'#10'"Exemplu de utilizar'
  +'e a JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begi'
  +'n\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 t'
  +'hen\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n'
  +'"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"   '
  +' end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Parametri disponibili (ob'#200#155'in'
  +'u'#200#155'i cu GetParam):\n"'#10'"  text - textul de intrare care trebuie '
  +'procesat (poate fi trunchiat la MaxLength)\n"'#10'"  source - codul limbii '
  +'surs'#196#131' (poate fi gol)\n"'#10'"  target - codul limbii '#200#155'int'
  +#196#131'\n"'#10'"  timestamp - timestamp-ul Unix curent '#195#174'n milisec'
  +'unde ('#200#153'ir)\n"'#10'"  random  - num'#196#131'r aleatoriu de 9 cifre'
  +' ('#200#153'ir)\n"'#10'"  rand - acela'#200#153'i lucru ca random\n"'#10'" '
  +' rand1..rand9 - primele 1..9 cifre ale num'#196#131'rului aleatoriu\n"'#10
  +'"\n"'#10'"Sunt disponibili '#200#153'i parametri ini'#200#155'iali '#200#153
  +'i personaliza'#200#155'i suplimentari."'#10#10'#: formconfig.rscriptrespons'
  +'ehint'#10'msgid ""'#10'"This script processes the response data. All functi'
  +'ons and parameters described in the script hint are available here as well.'
  +'\n"'#10'"Use GetParam(''result'') to obtain the received text.\n"'#10'"\n"'
  +#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetP'
  +'aram(''result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'
  +#10'"\n"'#10'"You can define custom parameters in the parameters script usin'
  +'g SetParam(''name'', ''value''),\n"'#10'"and then retrieve them here with G'
  +'etParam(''name'')."'#10'msgstr ""'#10'"Acest script proceseaz'#196#131' dat'
  +'ele r'#196#131'spunsului. Toate func'#200#155'iile '#200#153'i parametrii d'
  +'escri'#200#153'i '#195#174'n indica'#200#155'ia scriptului sunt disponibili'
  +' '#200#153'i aici.\n"'#10'"Folosi'#200#155'i GetParam(''result'') pentru a '
  +'ob'#200#155'ine textul primit.\n"'#10'"\n"'#10'"Exemplu:\n"'#10'"  var s: s'
  +'tring;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    S'
  +'etOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Pute'#200#155'i de'
  +'fini parametri personaliza'#200#155'i '#195#174'n scriptul de parametri fol'
  +'osind SetParam(''name'', ''value''),\n"'#10'"iar apoi '#195#174'i pute'#200
  +#155'i recupera aici cu GetParam(''name'')."'#10#10'#: formconfig.rvaluetype'
  +'1'#10'msgctxt "formconfig.rvaluetype1"'#10'msgid "None"'#10'msgstr "Niciunu'
  +'l"'#10#10'#: formconfig.rvaluetype2'#10'msgid "Language"'#10'msgstr "Limb'
  +#196#131'"'#10#10'#: formconfig.rvaluetype3'#10'msgid "Currency All"'#10'msg'
  +'str "Toate monedele"'#10#10'#: formconfig.rvaluetype4'#10'msgid "Currency F'
  +'iat Only"'#10'msgstr "Doar monede fiat"'#10#10'#: formconfig.rvaluetype5'#10
  +'msgid "Currency Crypto Only"'#10'msgstr "Doar criptomonede"'#10#10'#: formc'
  +'onfig.rvaluetype6'#10'msgid "Measurement Units"'#10'msgstr "Unit'#196#131
  +#200#155'i de m'#196#131'sur'#196#131'"'#10#10'#: tformconfigtrayslate.aclea'
  +'ricon.caption'#10'msgid "Clear Icon"'#10'msgstr "'#200#152'terge pictograma'
