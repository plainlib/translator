  +#142' ('#215#151#215#153#215#145#215#149#215#168' '#215#145#215#144#215#158
  +#215#166#215#162#215#149#215#170' '#215#169#215#149#215#168#215#148' '#215
  +#151#215#147#215#169#215#148'). '#215#144#215#157' '#215#148#215#145#215#153
