  +'str "Servicio"'#10#10'#: tformconfigtrayslate.reloadconfigs.hint'#10'msgid '
  +'"Reload configurations from disk"'#10'msgstr "Volver a cargar las configura'
  +'ciones desde el disco"'#10#10'#: tformconfigtrayslate.sbcopyconfig.hint'#10
