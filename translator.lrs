  +'Languages"'#10'msgstr "Jazyky"'#10#10'#: tformconfigtrayslate.pagelanguages'
  +'target.caption'#10'msgctxt "tformconfigtrayslate.pagelanguagestarget.captio'
  +'n"'#10'msgid "Target Languages"'#10'msgstr "C'#195#173'lov'#195#169' jazyky'
