  +#13#10'"P'#197#153#195#173'klad:\n"'#13#10'"  var s: string;\n"'#13#10'"  be'
  +'gin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput(''re'
  +'sult'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"V parametrick'#195#169
  +'m skriptu m'#197#175#197#190'ete definovat vlastn'#195#173' parametry pomoc'
  +#195#173' SetParam(''name'', ''value''),\n"'#13#10'"a pot'#195#169' je zde z'
  +#195#173'skat pomoc'#195#173' GetParam(''name'')."'#13#10#13#10'#: formconfi'
