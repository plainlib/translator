LazarusResources.Add('formconfig.en','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: en\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Config Editor"'#10#10'#: formconfig.rclearlanguages'#10'msgid "The '
  +'list is already filled. Do you want to clear it?"'#10'msgstr "The list is a'
  +'lready filled. Do you want to clear it?"'#10#10'#: formconfig.rdeleteconfig'
  +#10'msgid "Are you sure you want to delete config"'#10'msgstr "Are you sure '
  +'you want to delete config"'#10#10'#: formconfig.rdeleteconfigcaption'#10'ms'
  +'gid "Delete config"'#10'msgstr "Delete config"'#10#10'#: formconfig.rnamequ'
  +'estion'#10'msgid "Enter new config file name:"'#10'msgstr "Enter new config'
  +' file name:"'#10#10'#: formconfig.rneedsave'#10'msgid "The configuration wa'
  +'s modified. Save changes?"'#10'msgstr "The configuration was modified. Save'
  +' changes?"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Pointe'
  +'r: Use / for levels, keys for objects, and numbers for indexes.\n"'#10'"Use'
  +' * for all items, *#10 to join items by newline. Use ~ at the end of the pa'
  +'th to return the raw JSON branch.\n"'#10'"Separate multiple segments with s'
  +'emicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag #1'
  +'0 for newlines. Use {{regex}} inside to extract data directly into the text'
  +'.\n"'#10'"Logic: If a Pointer in a segment is empty, the whole segment is s'
  +'kipped. If a segment has no Pointer, only literal text blocks with embedded'
  +' regular expressions are processed.\n"'#10'"Regex: {prefix {regex[index]} s'
  +'uffix} inside a text block. If no [index] is specified, the first match is '
  +'used.\n"'#10'"Index can be a number, [*] (join by space), or [*#10] (join b'
  +'y newline). If the regex finds no match, the entire {'#226#128#166'} block '
  +'is removed.\n"'#10'"Using ~ inside a regex returns the entire text.\n"'#10
  +'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show its text on'
  +'ly if the Pointer data is missing or the JSON is invalid.\n"'#10'"Commentin'
  +'g: /* text */ comments are stripped from the entire expression before any p'
  +'rocessing.\n"'#10'"Examples:\n"'#10'"responseData/translatedText; matches/*'
  +'#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\'
  +'w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#10'msgst'
  +'r ""'#10'"Json Pointer: Use / for levels, keys for objects, and numbers for'
  +' indexes.\n"'#10'"Use * for all items, *#10 to join items by newline. Use ~'
  +' at the end of the path to return the raw JSON branch.\n"'#10'"Separate mul'
  +'tiple segments with semicolon ;.\n"'#10'"Literal: Text block in {'#226#128
  +#166'}. Special tag #10 for newlines. Use {{regex}} inside to extract data d'
  +'irectly into the text.\n"'#10'"Logic: If a Pointer in a segment is empty, t'
  +'he whole segment is skipped. If a segment has no Pointer, only literal text'
  +' blocks with embedded regular expressions are processed.\n"'#10'"Regex: {pr'
  +'efix {regex[index]} suffix} inside a text block. If no [index] is specified'
  +', the first match is used.\n"'#10'"Index can be a number, [*] (join by spac'
  +'e), or [*#10] (join by newline). If the regex finds no match, the entire {'
  +#226#128#166'} block is removed.\n"'#10'"Using ~ inside a regex returns the '
  +'entire text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/path{Error})'
  +' to show its text only if the Pointer data is missing or the JSON is invali'
  +'d.\n"'#10'"Commenting: /* text */ comments are stripped from the entire exp'
  +'ression before any processing.\n"'#10'"Examples:\n"'#10'"responseData/trans'
  +'latedText; matches/*#10/translation; /texts/text; {literal text#10}; /resul'
  +'t/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translatio'
  +'ns/0/text"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is'
  +' a standard Pascal program: optional var section, then a main begin ... end'
  +'. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin'
  +'\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'','
  +' ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"'
  +'\n"'#10'"You can also use standard Pascal constructs (if, for, while, repea'
  +'t, etc.). You can define your own functions and procedures before the main '
  +'begin ... end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetPa'
  +'ram(''name'') : string\n"'#10'"    Retrieve an input parameter value.\n"'#10
  +'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an output value for the'
  +' host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timestamp '
  +'in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Rand'
  ,'om integer with exactly Length decimal digits.\n"'#10'"  Random : Extended\'
  +'n"'#10'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, Dig'
  +'its) : string\n"'#10'"    Convert integer to hexadecimal string with at lea'
  +'st Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a'
  +' string to an integer. Raises an exception on invalid input.\n"'#10'"  IntT'
  +'oStr(Value) : string\n"'#10'"    Convert an integer to its string represent'
  +'ation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailing w'
  +'hitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading'
  +' whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trai'
  +'ling whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode'
  +' special HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : stri'
  +'ng\n"'#10'"    Decode HTML entities in S back to characters.\n"'#10'"  UrlE'
  +'ncode(S) : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n"'
  +#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-encoded string S.\'
  +'n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\'
  +'n"'#10'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'
  +#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Replac'
  +'e all regex matches of Pattern with Replacement in Input. Case-insensitive.'
  +'\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if Input '
  +'matches the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, St'
  +'artMarker, EndMarker) : string\n"'#10'"    Extract the substring of S betwe'
  +'en StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle'
  +' returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse'
  +' a JSON string and return a handle (>=0). Returns -1 on error.\n"'#10'"  JS'
  +'ONFree(Handle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSONGetS'
  +'tring(Handle, Path) : string\n"'#10'"    Get a string value at the specifie'
  +'d Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an int'
  +'eger value at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Ex'
  +'tended\n"'#10'"    Get a floating-point value at the specified Path.\n"'#10
  +'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value at t'
  +'he specified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'
  +#10'"    Get the number of elements in an array at the specified Path.\n"'#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the str'
  +'ing value of an array element at the given Index.\n"'#10'"  JSONGetArrayInt'
  +'(Handle, Path, Index) : Integer\n"'#10'"    Get the integer value of an arr'
  +'ay element at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : string'
  +'\n"'#10'"    Return the type of the value at Path: \"object\", \"array\", \'
  +'"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists'
  +'(Handle, Path) : Boolean\n"'#10'"    Check if the specified Path exists.\n"'
  +#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for buildin'
  +'g a standard error result.\n"'#10'"  JSONResultAddError(Offset, Length, Mes'
  +'sage, Replacements)\n"'#10'"    Add an error object to the result array. Re'
  +'placements is a string of values separated by \"|\".\n"'#10'"  JSONResultGe'
  +'t : string\n"'#10'"    Return the current result array as a JSON string.\n"'
  +#10'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always '
  +'call JSONFree to release the handle after you are done.\n"'#10'"\n"'#10'"Ex'
  +'ample of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: stri'
  +'ng;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10
  +'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, '
  +'''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFre'
  +'e(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters'
  +' (retrieved with GetParam):\n"'#10'"  text - the input text to process (pos'
  +'sibly truncated to MaxLength)\n"'#10'"  source - source language code (may '
  +'be empty)\n"'#10'"  target - target language code\n"'#10'"  timestamp - cur'
  +'rent Unix timestamp in milliseconds (string)\n"'#10'"  random  - 9-digit ra'
  +'ndom number (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9'
  +' - first 1..9 digits of the random number\n"'#10'"\n"'#10'"Additional initi'
  +'al and custom parameters are also available."'#10'msgstr ""'#10'"The script'
  +' is a standard Pascal program: optional var section, then a main begin ... '
  +'end. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  be'
  +'gin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'
  +''', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"You can also use standard Pascal constructs (if, for, while, repe'
  +'at, etc.). You can define your own functions and procedures before the main'
  ,' begin ... end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetP'
  +'aram(''name'') : string\n"'#10'"    Retrieve an input parameter value.\n"'
  +#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an output value for '
  +'the host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timesta'
  +'mp in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    R'
  +'andom integer with exactly Length decimal digits.\n"'#10'"  Random : Extend'
  +'ed\n"'#10'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, '
  +'Digits) : string\n"'#10'"    Convert integer to hexadecimal string with at '
  +'least Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Conver'
  +'t a string to an integer. Raises an exception on invalid input.\n"'#10'"  I'
  +'ntToStr(Value) : string\n"'#10'"    Convert an integer to its string repres'
  +'entation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailin'
  +'g whitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove lead'
  +'ing whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove t'
  +'railing whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Enc'
  +'ode special HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : s'
  +'tring\n"'#10'"    Decode HTML entities in S back to characters.\n"'#10'"  U'
  +'rlEncode(S) : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n'
  +'"'#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-encoded string '
  +'S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : stri'
  +'ng\n"'#10'"    Replace all occurrences of OldPattern with NewPattern in S.\'
  +'n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Re'
  +'place all regex matches of Pattern with Replacement in Input. Case-insensit'
  +'ive.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if In'
  +'put matches the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S'
  +', StartMarker, EndMarker) : string\n"'#10'"    Extract the substring of S b'
  +'etween StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a ha'
  +'ndle returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    P'
  +'arse a JSON string and return a handle (>=0). Returns -1 on error.\n"'#10'"'
  +'  JSONFree(Handle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSON'
  +'GetString(Handle, Path) : string\n"'#10'"    Get a string value at the spec'
  +'ified Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an'
  +' integer value at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) '
  +': Extended\n"'#10'"    Get a floating-point value at the specified Path.\n"'
  +#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value a'
  +'t the specified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n'
  +'"'#10'"    Get the number of elements in an array at the specified Path.\n"'
  +#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#10'"  JSONGetArray'
  +'Int(Handle, Path, Index) : Integer\n"'#10'"    Get the integer value of an '
  +'array element at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : str'
  +'ing\n"'#10'"    Return the type of the value at Path: \"object\", \"array\"'
  +', \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExi'
  +'sts(Handle, Path) : Boolean\n"'#10'"    Check if the specified Path exists.'
  +'\n"'#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for bu'
  +'ilding a standard error result.\n"'#10'"  JSONResultAddError(Offset, Length'
  +', Message, Replacements)\n"'#10'"    Add an error object to the result arra'
  +'y. Replacements is a string of values separated by \"|\".\n"'#10'"  JSONRes'
  +'ultGet : string\n"'#10'"    Return the current result array as a JSON strin'
  +'g.\n"'#10'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  '
  +'Always call JSONFree to release the handle after you are done.\n"'#10'"\n"'
  +#10'"Example of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s'
  +': string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));'
  +'\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetStr'
  +'ing(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      '
  +'JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available par'
  +'ameters (retrieved with GetParam):\n"'#10'"  text - the input text to proce'
  +'ss (possibly truncated to MaxLength)\n"'#10'"  source - source language cod'
  +'e (may be empty)\n"'#10'"  target - target language code\n"'#10'"  timestam'
  +'p - current Unix timestamp in milliseconds (string)\n"'#10'"  random  - 9-d'
  +'igit random number (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1'
  +'..rand9 - first 1..9 digits of the random number\n"'#10'"\n"'#10'"Additiona'
  +'l initial and custom parameters are also available."'#10#10'#: formconfig.r'
  +'scriptresponsehint'#10'msgid ""'#10'"This script processes the response dat'
  ,'a. All functions and parameters described in the script hint are available '
  +'here as well.\n"'#10'"Use GetParam(''result'') to obtain the received text.'
  +'\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10
  +'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10
  +'"  end.\n"'#10'"\n"'#10'"You can define custom parameters in the parameters'
  +' script using SetParam(''name'', ''value''),\n"'#10'"and then retrieve them'
  +' here with GetParam(''name'')."'#10'msgstr ""'#10'"This script processes th'
  +'e response data. All functions and parameters described in the script hint '
  +'are available here as well.\n"'#10'"Use GetParam(''result'') to obtain the '
