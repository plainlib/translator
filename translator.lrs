  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: de\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Konfigurationseditor"'#13#10#13#10'#: formconfig.rclearlanguages'#13#10'm'
  +'sgid "The list is already filled. Do you want to clear it?"'#13#10'msgstr "'
  +'Die Liste ist bereits gef'#195#188'llt. M'#195#182'chten Sie sie leeren?"'
  +#13#10#13#10'#: formconfig.rconfigeditor'#13#10'msgid "Config Editor..."'#13
  +#10'msgstr "Konfigurationseditor..."'#13#10#13#10'#: formconfig.rdeleteconfi'
  +'g'#13#10'msgid "Are you sure you want to delete config"'#13#10'msgstr "Sind'
  +' Sie sicher, dass Sie die Konfiguration l'#195#182'schen m'#195#182'chten"'
  +#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13#10'msgid "Delete config"'
  +#13#10'msgstr "Konfiguration l'#195#182'schen"'#13#10#13#10'#: formconfig.rf'
  +'ilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Abbrechen"'#13#10#13
  +#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Keep my changes"'#13
  +#10'msgstr "Meine '#195#132'nderungen beibehalten"'#13#10#13#10'#: formconfi'
  +'g.rfilechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The file \"%'
  +'s\" has been modified by another application since it was opened."'#13#10'm'
  +'sgstr "Die Datei \"%s\" wurde seit dem '#195#150'ffnen von einer anderen An'
  +'wendung ge'#195#164'ndert."'#13#10#13#10'#: formconfig.rfilechangedmsgactiv'
  +'ate'#13#10'msgid "You have unsaved changes. Keep them or reload from disk?"'
  +#13#10'msgstr "Sie haben ungespeicherte '#195#132'nderungen. M'#195#182'chte'
  +'n Sie diese beibehalten oder die Datei von der Festplatte neu laden?"'#13#10
  +#13#10'#: formconfig.rfilechangedreloaddisk'#13#10'msgid "Reload from disk"'
  +#13#10'msgstr "Von der Festplatte neu laden"'#13#10#13#10'#: formconfig.rfil'
  +'echangedtitle'#13#10'msgid "File changed on disk"'#13#10'msgstr "Datei auf '
  +'dem Datentr'#195#164'ger ge'#195#164'ndert"'#13#10#13#10'#: formconfig.rnam'
  +'equestion'#13#10'msgid "Enter new config file name:"'#13#10'msgstr "Geben S'
  +'ie den Namen der neuen Konfigurationsdatei ein:"'#13#10#13#10'#: formconfig'
  +'.rneedsave'#13#10'msgid "The configuration was modified. Save changes?"'#13
  +#10'msgstr "Die Konfiguration wurde ge'#195#164'ndert. '#195#132'nderungen s'
  +'peichern?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgid ""'#13#10
  +'"Json Pointer: Use / for levels, keys for objects, and numbers for indexes.'
  +'\n"'#13#10'"Use * for all items, *#10 to join items by newline. Use ~ at th'
  +'e end of the path to return the raw JSON branch.\n"'#13#10'"Separate multip'
  +'le segments with semicolon ;.\n"'#13#10'"Literal: Text block in {'#226#128
  +#166'}. Special tag #10 for newlines. Use {{regex}} inside to extract data d'
  +'irectly into the text.\n"'#13#10'"Logic: If a Pointer in a segment is empty'
  +', the whole segment is skipped. If a segment has no Pointer, only literal t'
  +'ext blocks with embedded regular expressions are processed.\n"'#13#10'"Rege'
  +'x: {prefix {regex[index]} suffix} inside a text block. If no [index] is spe'
  +'cified, the first match is used.\n"'#13#10'"Index can be a number, [*] (joi'
  +'n by space), or [*#10] (join by newline). If the regex finds no match, the '
  +'entire {'#226#128#166'} block is removed.\n"'#13#10'"Using ~ inside a regex'
  +' returns the entire text.\n"'#13#10'"Inversion: Start a segment with ! (e.g'
  +'. !/path{Error}) to show its text only if the Pointer data is missing or th'
  +'e JSON is invalid.\n"'#13#10'"Commenting: /* text */ comments are stripped '
  +'from the entire expression before any processing.\n"'#13#10'"Examples:\n"'
  +#13#10'"responseData/translatedText; matches/*#10/translation; /texts/text; '
  +'{literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: '
  +'No data!#10}; /translations/0/text"'#13#10'msgstr ""'#13#10'"JSON-Zeiger: V'
  +'erwenden Sie / f'#195#188'r Ebenen, Schl'#195#188'ssel f'#195#188'r Objekte'
  +' und Zahlen f'#195#188'r Indizes. Verwenden Sie * f'#195#188'r alle Element'
  +'e und *#10, um Elemente mit einem Zeilenumbruch zu verbinden. Verwenden Sie'
  +' ~ am Ende des Pfads, um den unverarbeiteten JSON-Zweig zur'#195#188'ckzuge'
  +'ben. Trennen Sie mehrere Segmente mit einem Semikolon ;.\n"'#13#10'"Literal'
  +': Textblock in {'#226#128#166'}. Spezielles Tag #10 f'#195#188'r Zeilenumbr'
  +#195#188'che. Verwenden Sie {{regex}} innerhalb des Blocks, um Daten direkt '
  +'in den Text einzuf'#195#188'gen.\n"'#13#10'"Logik: Wenn ein Zeiger in einem'
  +' Segment leer ist, wird das gesamte Segment '#195#188'bersprungen. Wenn ein'
  +' Segment keinen Zeiger enth'#195#164'lt, werden nur Textbl'#195#182'cke mit'
  ,' eingebetteten regul'#195#164'ren Ausdr'#195#188'cken verarbeitet.\n"'#13#10
  +'"Regex: {Pr'#195#164'fix {regex[index]} Suffix} innerhalb eines Textblocks.'
  +' Wenn kein [index] angegeben ist, wird die erste '#195#156'bereinstimmung v'
  +'erwendet. Der Index kann eine Zahl, [*] (mit Leerzeichen verbinden) oder [*'
  +'#10] (mit Zeilenumbruch verbinden) sein. Findet der regul'#195#164're Ausdr'
  +'uck keine '#195#156'bereinstimmung, wird der gesamte Block {'#226#128#166'}'
  +' entfernt. Die Verwendung von ~ innerhalb eines regul'#195#164'ren Ausdruck'
  +'s gibt den gesamten Text zur'#195#188'ck.\n"'#13#10'"Invertierung: Beginnen'
  +' Sie ein Segment mit ! (z. B. !/path{Error}), damit sein Text nur angezeigt'
  +' wird, wenn die Zeigerdaten fehlen oder das JSON ung'#195#188'ltig ist.\n"'
  +#13#10'"Kommentare: Kommentare der Form /* Text */ werden vor jeder Verarbei'
  +'tung aus dem gesamten Ausdruck entfernt.\n"'#13#10'"Beispiele:\n"'#13#10'"r'
  +'esponseData/translatedText; matches/*#10/translation; /texts/text; {literal'
  +' text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!'
  +'#10}; /translations"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'
  +#13#10'"The script is a standard Pascal program: optional var section, then '
  +'a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  v'
  +'ar s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'
  +#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutpu'
  +'t(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use s'
  +'tandard Pascal constructs (if, for, while, repeat, etc.). You can define yo'
  +'ur own functions and procedures before the main begin ... end. block.\n"'#13
  +#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'') : stri'
  +'ng\n"'#13#10'"    Retrieve an input parameter value.\n"'#13#10'"  SetOutput'
  +'(''name'', ''value'')\n"'#13#10'"    Store an output value for the host.\n"'
  +#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix timestamp in mi'
  +'lliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Ran'
  +'dom integer with exactly Length decimal digits.\n"'#13#10'"  Random : Exten'
  +'ded\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10'"  IntToHex('
  +'Value, Digits) : string\n"'#13#10'"    Convert integer to hexadecimal strin'
  +'g with at least Digits characters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13
  +#10'"    Convert a string to an integer. Raises an exception on invalid inpu'
  +'t.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Convert an integer '
  +'to its string representation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    '
  +'Remove leading and trailing whitespace from S.\n"'#13#10'"  TrimLeft(S) : s'
  +'tring\n"'#13#10'"    Remove leading whitespace from S.\n"'#13#10'"  TrimRig'
  +'ht(S) : string\n"'#13#10'"    Remove trailing whitespace from S.\n"'#13#10
  +'"  HtmlEncode(S) : string\n"'#13#10'"    Encode special HTML characters in '
  +'S into entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decode '
  +'HTML entities in S back to characters.\n"'#13#10'"  UrlEncode(S) : string\n'
  +'"'#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13#10'"  UrlDeco'
  +'de(S) : string\n"'#13#10'"    Decode a percent-encoded string S.\n"'#13#10
  +'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13
  +#10'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'#13
  +#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    Rep'
  +'lace all regex matches of Pattern with Replacement in Input. Case-insensiti'
  +'ve.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Check '
  +'if Input matches the regex Pattern. Case-insensitive.\n"'#13#10'"  ExtractB'
  +'etween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extract the subst'
  +'ring of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON fu'
  +'nctions (use a handle returned by JSONParse):\n"'#13#10'"  JSONParse(S) : I'
  +'nteger\n"'#13#10'"    Parse a JSON string and return a handle (>=0). Return'
  +'s -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release the han'
  +'dle after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10
  +'"    Get a string value at the specified Path.\n"'#13#10'"  JSONGetInt(Hand'
  +'le, Path) : Integer\n"'#13#10'"    Get an integer value at the specified Pa'
  +'th.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Get a'
  +' floating-point value at the specified Path.\n"'#13#10'"  JSONGetBool(Handl'
  +'e, Path) : Boolean\n"'#13#10'"    Get a boolean value at the specified Path'
  +'.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Get'
  +' the number of elements in an array at the specified Path.\n"'#13#10'"  JSO'
  +'NGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the string'
  +' value of an array element at the given Index.\n"'#13#10'"  JSONGetArrayInt'
  +'(Handle, Path, Index) : Integer\n"'#13#10'"    Get the integer value of an '
  ,'array element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Path) : '
  +'string\n"'#13#10'"    Return the type of the value at Path: \"object\", \"a'
  +'rray\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JS'
  +'ONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the specified '
  +'Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an empty'
  +' JSON array for building a standard error result.\n"'#13#10'"  JSONResultAd'
  +'dError(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an error o'
  +'bject to the result array. Replacements is a string of values separated by '
  +'\"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the curren'
  +'t result array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10'"  '
  +'  Clear the result array.\n"'#13#10'"  Always call JSONFree to release the '
  +'handle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working with J'
  +'SON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  '
  +'begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    i'
  +'f h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, '
  +'''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      J'
  +'SONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Av'
  +'ailable parameters (retrieved with GetParam):\n"'#13#10'"  text - the input'
  +' text to process (possibly truncated to MaxLength)\n"'#13#10'"  source - so'
  +'urce language code (may be empty)\n"'#13#10'"  target - target language cod'
  +'e\n"'#13#10'"  timestamp - current Unix timestamp in milliseconds (string)\'
  +'n"'#13#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand - s'
  +'ame as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random n'
  +'umber\n"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are a'
  +'lso available."'#13#10'msgstr ""'#13#10'"Das Skript ist ein Standard-Pascal'
  +'-Programm: ein optionaler var-Abschnitt, gefolgt von einem Hauptblock begin'
  +' ... end.\n"'#13#10'"\n"'#13#10'"Beispiel:\n"'#13#10'"  var s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := '
  +'ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Sie k'#195#182'nnen auch Standard-'
  +'Pascal-Konstrukte verwenden (if, for, while, repeat usw.). Sie k'#195#182'n'
  +'nen eigene Funktionen und Prozeduren vor dem Hauptblock begin ... end defin'
  +'ieren.\n"'#13#10'"\n"'#13#10'"Verf'#195#188'gbare Funktionen:\n"'#13#10'"  '
  +'GetParam(''name'') : string\n"'#13#10'"    Ruft den Wert eines Eingabeparam'
  +'eters ab.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Speich'
  +'ert einen Ausgabewert f'#195#188'r den Host.\n"'#13#10'"  GetTimestamp() : '
  +'Int64\n"'#13#10'"    Aktueller Unix-Zeitstempel in Millisekunden (UTC).\n"'
  +#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Zuf'#195#164'llige Ganzza'
  +'hl mit genau Length Dezimalziffern.\n"'#13#10'"  Random : Extended\n"'#13#10
  +'"    Zuf'#195#164'llige Gleitkommazahl im Bereich [0, 1).\n"'#13#10'"  IntT'
  +'oHex(Value, Digits) : string\n"'#13#10'"    Konvertiert eine Ganzzahl in ei'
  +'ne hexadezimale Zeichenfolge mit mindestens Digits Zeichen.\n"'#13#10'"  St'
  +'rToInt(S) : Integer\n"'#13#10'"    Konvertiert eine Zeichenfolge in eine Ga'
  +'nzzahl. L'#195#182'st bei ung'#195#188'ltiger Eingabe eine Ausnahme aus.\n"'
  +#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Konvertiert eine Ganzzahl '
  +'in ihre Zeichenfolgendarstellung.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"'
  +'    Entfernt f'#195#188'hrende und nachfolgende Leerzeichen aus S.\n"'#13#10
  +'"  TrimLeft(S) : string\n"'#13#10'"    Entfernt f'#195#188'hrende Leerzeich'
  +'en aus S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Entfernt nachfo'
  +'lgende Leerzeichen aus S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"  '
  +'  Kodiert spezielle HTML-Zeichen in S als Entit'#195#164'ten.\n"'#13#10'"  '
  +'HtmlDecode(S) : string\n"'#13#10'"    Dekodiert HTML-Entit'#195#164'ten in '
  +'S zur'#195#188'ck in Zeichen.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10
  +'"    Prozentkodiert S f'#195#188'r die sichere Verwendung in URLs.\n"'#13#10
  +'"  UrlDecode(S) : string\n"'#13#10'"    Dekodiert eine prozentkodierte Zeic'
  +'henfolge S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=F'
  +'alse) : string\n"'#13#10'"    Ersetzt alle Vorkommen von OldPattern durch N'
  +'ewPattern in S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : st'
  +'ring\n"'#13#10'"    Ersetzt alle '#195#156'bereinstimmungen des regul'#195
  +#164'ren Ausdrucks Pattern durch Replacement in Input. Gro'#195#159'-/Kleins'
  +'chreibung wird ignoriert.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean'
  +'\n"'#13#10'"    Pr'#195#188'ft, ob Input dem regul'#195#164'ren Ausdruck Pa'
  +'ttern entspricht. Gro'#195#159'-/Kleinschreibung wird ignoriert.\n"'#13#10
  +'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extrah'
  ,'iert den Teilstring aus S zwischen StartMarker und EndMarker.\n"'#13#10'"\n'
  +'"'#13#10'"JSON-Funktionen (verwenden Sie ein von JSONParse zur'#195#188'ckg'
  +'egebenes Handle):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Analys'
  +'iert eine JSON-Zeichenfolge und gibt ein Handle (>=0) zur'#195#188'ck. Gibt'
  +' bei einem Fehler -1 zur'#195#188'ck.\n"'#13#10'"  JSONFree(Handle)\n"'#13
  +#10'"    Gibt das Handle nach der Verwendung frei.\n"'#13#10'"  JSONGetStrin'
  +'g(Handle, Path) : string\n"'#13#10'"    Ruft einen Zeichenfolgenwert am ang'
  +'egebenen Path ab.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10
  +'"    Ruft einen Ganzzahlwert am angegebenen Path ab.\n"'#13#10'"  JSONGetFl'
  +'oat(Handle, Path) : Extended\n"'#13#10'"    Ruft einen Gleitkommawert am an'
  +'gegebenen Path ab.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13
  +#10'"    Ruft einen booleschen Wert am angegebenen Path ab.\n"'#13#10'"  JSO'
  +'NGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Ruft die Anzahl der E'
  +'lemente eines Arrays am angegebenen Path ab.\n"'#13#10'"  JSONGetArrayStrin'
  +'g(Handle, Path, Index) : string\n"'#13#10'"    Ruft den Zeichenfolgenwert e'
  +'ines Array-Elements am angegebenen Index ab.\n"'#13#10'"  JSONGetArrayInt(H'
  +'andle, Path, Index) : Integer\n"'#13#10'"    Ruft den Ganzzahlwert eines Ar'
  +'ray-Elements am angegebenen Index ab.\n"'#13#10'"  JSONGetType(Handle, Path'
  +') : string\n"'#13#10'"    Gibt den Typ des Werts unter Path zur'#195#188'ck'
  +': \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\"'
  +'.\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Pr'#195
  +#188'ft, ob der angegebene Path existiert.\n"'#13#10'"  JSONResultInit\n"'#13
  +#10'"    Initialisiert ein leeres JSON-Array zum Erstellen eines Standard-Fe'
  +'hlerergebnisses.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, R'
  +'eplacements)\n"'#13#10'"    F'#195#188'gt dem Ergebnisarray ein Fehlerobjek'
  +'t hinzu. Replacements ist eine Zeichenfolge mit durch \"|\" getrennten Wert'
  +'en.\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Gibt das aktuelle Er'
  +'gebnisarray als JSON-Zeichenfolge zur'#195#188'ck.\n"'#13#10'"  JSONResultC'
  +'lear\n"'#13#10'"    Leert das Ergebnisarray.\n"'#13#10'"  Rufen Sie immer J'
  +'SONFree auf, um das Handle freizugeben, nachdem Sie es nicht mehr ben'#195
  +#182'tigen.\n"'#13#10'"\n"'#13#10'"Beispiel f'#195#188'r die Arbeit mit JSON'
  +':\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  beg'
  +'in\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h'
  +' >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''so'
  +'me.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONF'
  +'ree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Verf'
  +#195#188'gbare Parameter (abgerufen mit GetParam):\n"'#13#10'"  text - der z'
  +'u verarbeitende Eingabetext (m'#195#182'glicherweise auf MaxLength gek'#195
  +#188'rzt)\n"'#13#10'"  source - Sprachcode der Ausgangssprache (kann leer se'
  +'in)\n"'#13#10'"  target - Sprachcode der Zielsprache\n"'#13#10'"  timestamp'
  +' - aktueller Unix-Zeitstempel in Millisekunden (Zeichenfolge)\n"'#13#10'"  '
  +'random  - zuf'#195#164'llige 9-stellige Zahl (Zeichenfolge)\n"'#13#10'"  ra'
  +'nd - dasselbe wie random\n"'#13#10'"  rand1..rand9 - die ersten 1..9 Ziffer'
  +'n der Zufallszahl\n"'#13#10'"\n"'#13#10'"Zus'#195#164'tzliche initiale und '
  +'benutzerdefinierte Parameter sind ebenfalls verf'#195#188'gbar.Parameter si'
  +'nd ebenfalls verf'#195#188'gbar."'#13#10#13#10'#: formconfig.rscriptrespons'
  +'ehint'#13#10'msgid ""'#13#10'"This script processes the response data. All '
  +'functions and parameters described in the script hint are available here as'
  +' well.\n"'#13#10'"Use GetParam(''result'') to obtain the received text.\n"'
  +#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\'
  +'n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput(''result'
  +''', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define custom para'
  +'meters in the parameters script using SetParam(''name'', ''value''),\n"'#13
  +#10'"and then retrieve them here with GetParam(''name'')."'#13#10'msgstr ""'
  +#13#10'"Dieses Skript verarbeitet die Antwortdaten. Alle Funktionen und Para'
  +'meter, die im Skript-Hinweis beschrieben sind, stehen auch hier zur Verf'
  +#195#188'gung.\n"'#13#10'"Verwenden Sie GetParam(''result''), um den empfang'
  +'enen Text abzurufen.\n"'#13#10'"\n"'#13#10'"Beispiel:\n"'#13#10'"  var s: s'
  +'tring;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13
  +#10'"    SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'Sie k'#195#182'nnen benutzerdefinierte Parameter im Parameterskript mit Set'
  +'Param(''name'', ''value'') definieren\n"'#13#10'"und sie anschlie'#195#159
  +'end hier mit GetParam(''name'') abrufen."'#13#10#13#10'#: formconfig.rvalue'
  +'type1'#13#10'msgctxt "formconfig.rvaluetype1"'#13#10'msgid "None"'#13#10'ms'
  ,'gstr "Keine"'#13#10#13#10'#: formconfig.rvaluetype2'#13#10'msgid "Language"'
  +#13#10'msgstr "Sprache"'#13#10#13#10'#: formconfig.rvaluetype3'#13#10'msgid '
  +'"Currency All"'#13#10'msgstr "Alle W'#195#164'hrungen"'#13#10#13#10'#: form'
  +'config.rvaluetype4'#13#10'msgid "Currency Fiat Only"'#13#10'msgstr "Nur Fia'
  +'t-W'#195#164'hrungen"'#13#10#13#10'#: formconfig.rvaluetype5'#13#10'msgid "'
  +'Currency Crypto Only"'#13#10'msgstr "Nur Kryptow'#195#164'hrungen"'#13#10#13
  +#10'#: formconfig.rvaluetype6'#13#10'msgid "Measurement Units"'#13#10'msgstr'
  +' "Ma'#195#159'einheiten"'#13#10#13#10'#: tformconfigtrayslate.aclearicon.ca'
  +'ption'#13#10'msgid "Clear Icon"'#13#10'msgstr "Symbol l'#195#182'schen"'#13
