  +'pty\" - do not send."'#10'msgstr "'#208#159#208#190#208#180#208#180#208#181
  +#209#128#208#182#208#184#208#178#208#176#208#181#208#188#209#139#208#181' '
  +#209#143#208#183#209#139#208#186#208#184', '#208#189#208#176#208#191#209#128
  +#208#184#208#188#208#181#209#128' en=en-US (en - '#208#178#208#189#209#131
  +#209#130#209#128#208#181#208#189#208#189#208#184#208#185', en-US - '#209#129
  +#208#181#209#128#208#178#208#184#209#129#208#189#209#139#208#185'). \"empty\'
  +'" - '#208#189#208#181' '#208#190#209#130#208#191#209#128#208#176#208#178#208
  +#187#209#143#209#130#209#140'."'#10#10'#: tformconfigtrayslate.labellanguage'
  +'s1.caption'#10'msgid "Value type for populating names. None keeps originals'
  +'; None and Unit are case-sensitive."'#10'msgstr "'#208#162#208#184#208#191
  +' '#208#183#208#189#208#176#209#135#208#181#208#189#208#184#209#143' '#208
  +#180#208#187#209#143' '#208#183#208#176#208#191#208#190#208#187#208#189#208
  +#181#208#189#208#184#209#143' '#208#184#208#188#208#181#208#189'. None '#209
  +#129#208#190#209#133#209#128#208#176#208#189#209#143#208#181#209#130' '#208
  +#190#209#128#208#184#208#179#208#184#208#189#208#176#208#187#209#139'; None '
  +#208#184' Unit '#209#135#209#131#208#178#209#129#209#130#208#178#208#184#209
  +#130#208#181#208#187#209#140#208#189#209#139' '#208#186' '#209#128#208#181
  +#208#179#208#184#209#129#209#130#209#128#209#131'."'#10#10'#: tformconfigtra'
  +'yslate.labellanguagestarget.caption'#10'msgid ""'#10'"Target languages e.g.'
  +' en=en-US, en - internal, en-US - service code.\n"'#10'"If not specified, b'
  +'oth source and target languages are taken from the languages section."'#10
  +'msgstr ""'#10'"'#208#166#208#181#208#187#208#181#208#178#209#139#208#181' '
  +#209#143#208#183#209#139#208#186#208#184', '#208#189#208#176#208#191#209#128
  +#208#184#208#188#208#181#209#128' en=en-US, en - '#208#178#208#189#209#131
  +#209#130#209#128#208#181#208#189#208#189#208#184#208#185', en-US - '#209#129
  +#208#181#209#128#208#178#208#184#209#129#208#189#209#139#208#185' '#208#186
  +#208#190#208#180'.\n"'#10'"'#208#149#209#129#208#187#208#184' '#208#189#208
  +#181' '#209#131#208#186#208#176#208#183#208#176#208#189#208#190', '#208#184
  +#209#129#209#133#208#190#208#180#208#189#209#139#208#181' '#208#184' '#209
