LazarusResources.Add('formconfig.sv','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: sv\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Konfigurationsredigerare"'#10#10'#: formconfig.rclearlanguages'#10
  +'msgid "The list is already filled. Do you want to clear it?"'#10'msgstr "Li'
  +'stan '#195#164'r redan ifylld. Vill du rensa den?"'#10#10'#: formconfig.rde'
  +'leteconfig'#10'msgid "Are you sure you want to delete config"'#10'msgstr "'
  +#195#132'r du s'#195#164'ker p'#195#165' att du vill ta bort konfigurationen'
  +'"'#10#10'#: formconfig.rdeleteconfigcaption'#10'msgid "Delete config"'#10'm'
  +'sgstr "Ta bort konfiguration"'#10#10'#: formconfig.rnamequestion'#10'msgid '
  +'"Enter new config file name:"'#10'msgstr "Ange namn p'#195#165' ny konfigur'
  +'ationsfil:"'#10#10'#: formconfig.rneedsave'#10'msgid "The configuration was'
  +' modified. Save changes?"'#10'msgstr "Konfigurationen har '#195#164'ndrats.'
  +' Spara '#195#164'ndringar?"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'
  +#10'"Json Pointer: Use / for levels, keys for objects, and numbers for index'
  +'es.\n"'#10'"Use * for all items, *#10 to join items by newline. Use ~ at th'
  +'e end of the path to return the raw JSON branch.\n"'#10'"Separate multiple '
  +'segments with semicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}.'
  +' Special tag #10 for newlines. Use {{regex}} inside to extract data directl'
  +'y into the text.\n"'#10'"Logic: If a Pointer in a segment is empty, the who'
  +'le segment is skipped. If a segment has no Pointer, only literal text block'
  +'s with embedded regular expressions are processed.\n"'#10'"Regex: {prefix {'
  +'regex[index]} suffix} inside a text block. If no [index] is specified, the '
  +'first match is used.\n"'#10'"Index can be a number, [*] (join by space), or'
  +' [*#10] (join by newline). If the regex finds no match, the entire {'#226
  +#128#166'} block is removed.\n"'#10'"Using ~ inside a regex returns the enti'
  +'re text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to '
  +'show its text only if the Pointer data is missing or the JSON is invalid.\n'
  +'"'#10'"Commenting: /* text */ comments are stripped from the entire express'
  +'ion before any processing.\n"'#10'"Examples:\n"'#10'"responseData/translate'
  +'dText; matches/*#10/translation; /texts/text; {literal text#10}; /result/te'
  +'xt; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations/0'
  +'/text"'#10'msgstr ""'#10'"JSON Pointer: Anv'#195#164'nd / f'#195#182'r niv'
  +#195#165'er, nycklar f'#195#182'r objekt och siffror f'#195#182'r index. Anv'
  +#195#164'nd * f'#195#182'r alla objekt och *#10 f'#195#182'r att sammanfoga '
  +'objekt med en ny rad. Anv'#195#164'nd ~ i slutet av s'#195#182'kv'#195#164
  +'gen f'#195#182'r att returnera den r'#195#165'a JSON-grenen. Separera flera'
  +' segment med semikolon ;.\n"'#10'"Literal: Textblock i {'#226#128#166'}. Sp'
  +'eciell tagg #10 f'#195#182'r nya rader. Anv'#195#164'nd {{regex}} inuti f'
  +#195#182'r att extrahera data direkt till texten.\n"'#10'"Logik: Om en Point'
  +'er i ett segment '#195#164'r tom hoppas hela segmentet '#195#182'ver. Om et'
  +'t segment inte har n'#195#165'gon Pointer bearbetas endast textblock med in'
  +'b'#195#164'ddade regulj'#195#164'ra uttryck.\n"'#10'"Regex: {prefix {regex['
  +'index]} suffix} inuti ett textblock. Om [index] inte anges anv'#195#164'nds'
  +' den f'#195#182'rsta matchningen. Index kan vara ett tal, [*] (sammanfoga m'
  +'ed mellanslag) eller [*#10] (sammanfoga med ny rad). Om det regulj'#195#164
  +'ra uttrycket inte hittar n'#195#165'gon matchning tas hela blocket {'#226
  +#128#166'} bort. Anv'#195#164'ndning av ~ i ett regulj'#195#164'rt uttryck r'
  +'eturnerar hela texten.\n"'#10'"Invertering: B'#195#182'rja ett segment med '
  +'! (t.ex. !/path{Error}) f'#195#182'r att visa dess text endast om Pointer-d'
  +'ata saknas eller om JSON '#195#164'r ogiltig.\n"'#10'"Kommentarer: Kommenta'
  +'rer /* text */ tas bort fr'#195#165'n hela uttrycket innan n'#195#165'gon b'
  +'earbetning sker.\n"'#10'"Exempel:\n"'#10'"responseData/translatedText; matc'
  +'hes/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ '
  +'({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#10#10'#: f'
  +'ormconfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal pro'
  +'gram: optional var section, then a main begin ... end. block.\n"'#10'"\n"'
  +#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetP'
  +'aram(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10
  +'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also u'
  +'se standard Pascal constructs (if, for, while, repeat, etc.). You can defin'
  ,'e your own functions and procedures before the main begin ... end. block.\n'
  +'"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : string\'
  +'n"'#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''name'''
  +', ''value'')\n"'#10'"    Store an output value for the host.\n"'#10'"  GetT'
  +'imestamp() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (UTC)'
  +'.\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with exact'
  +'ly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random fl'
  +'oat in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10
  +'"    Convert integer to hexadecimal string with at least Digits characters.'
  +'\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to an integer'
  +'. Raises an exception on invalid input.\n"'#10'"  IntToStr(Value) : string\'
  +'n"'#10'"    Convert an integer to its string representation.\n"'#10'"  Trim'
  +'(S) : string\n"'#10'"    Remove leading and trailing whitespace from S.\n"'
  +#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whitespace from S.\n"'
  +#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing whitespace from S.\'
  +'n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML characters'
  +' in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HT'
  +'ML entities in S back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10
  +'"    Percent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : stri'
  +'ng\n"'#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, O'
  +'ldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replace all o'
  +'ccurrences of OldPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input'
  +', Pattern, Replacement) : string\n"'#10'"    Replace all regex matches of P'
  +'attern with Replacement in Input. Case-insensitive.\n"'#10'"  RegexMatch(In'
  +'put, Pattern) : Boolean\n"'#10'"    Check if Input matches the regex Patter'
  +'n. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : '
  +'string\n"'#10'"    Extract the substring of S between StartMarker and EndMa'
  +'rker.\n"'#10'"\n"'#10'"JSON functions (use a handle returned by JSONParse):'
  +'\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string and retur'
  +'n a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'" '
  +'   Release the handle after use.\n"'#10'"  JSONGetString(Handle, Path) : st'
  +'ring\n"'#10'"    Get a string value at the specified Path.\n"'#10'"  JSONGe'
  +'tInt(Handle, Path) : Integer\n"'#10'"    Get an integer value at the specif'
  +'ied Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a'
  +' floating-point value at the specified Path.\n"'#10'"  JSONGetBool(Handle, '
  +'Path) : Boolean\n"'#10'"    Get a boolean value at the specified Path.\n"'
  +#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the number '
  +'of elements in an array at the specified Path.\n"'#10'"  JSONGetArrayString'
  +'(Handle, Path, Index) : string\n"'#10'"    Get the string value of an array'
  +' element at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index)'
  +' : Integer\n"'#10'"    Get the integer value of an array element at the giv'
  +'en Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Return t'
  +'he type of the value at Path: \"object\", \"array\", \"string\", \"int\", \'
  +'"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Bool'
  +'ean\n"'#10'"    Check if the specified Path exists.\n"'#10'"  JSONResultIni'
  +'t\n"'#10'"    Initialize an empty JSON array for building a standard error '
  +'result.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Replacements)'
  +'\n"'#10'"    Add an error object to the result array. Replacements is a str'
  +'ing of values separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"'
  +'    Return the current result array as a JSON string.\n"'#10'"  JSONResultC'
  +'lear\n"'#10'"    Clear the result array.\n"'#10'"  Always call JSONFree to '
  +'release the handle after you are done.\n"'#10'"\n"'#10'"Example of working '
  +'with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  beg'
  +'in\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 '
  +'then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\'
  +'n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"  '
  +'  end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved with'
  +' GetParam):\n"'#10'"  text - the input text to process (possibly truncated '
  +'to MaxLength)\n"'#10'"  source - source language code (may be empty)\n"'#10
  +'"  target - target language code\n"'#10'"  timestamp - current Unix timesta'
  +'mp in milliseconds (string)\n"'#10'"  random  - 9-digit random number (stri'
  +'ng)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 - first 1..9 dig'
  +'its of the random number\n"'#10'"\n"'#10'"Additional initial and custom par'
  +'ameters are also available."'#10'msgstr ""'#10'"Skriptet '#195#164'r ett st'
  ,'andardprogram i Pascal: en valfri var-sektion, f'#195#182'ljd av ett huvudb'
  +'lock begin ... end.\n"'#10'"\n"'#10'"Exempel:\n"'#10'"  var s: string;\n"'
  +#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAl'
  +'l(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  en'
  +'d.\n"'#10'"\n"'#10'"Du kan ocks'#195#165' anv'#195#164'nda standardkonstruk'
  +'tioner i Pascal (if, for, while, repeat osv.). Du kan definiera egna funkti'
  +'oner och procedurer f'#195#182're huvudblocket begin ... end.\n"'#10'"\n"'
  +#10'"Tillg'#195#164'ngliga funktioner:\n"'#10'"  GetParam(''name'') : string'
  +'\n"'#10'"    H'#195#164'mtar v'#195#164'rdet f'#195#182'r en indataparamete'
  +'r.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Lagrar ett utdatav'
  +#195#164'rde f'#195#182'r v'#195#164'rdenheten.\n"'#10'"  GetTimestamp() : I'
  +'nt64\n"'#10'"    Aktuell Unix-tidsst'#195#164'mpel i millisekunder (UTC).\n'
  +'"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Slumpm'#195#164'ssigt heltal'
  +' med exakt Length decimaler.\n"'#10'"  Random : Extended\n"'#10'"    Slumpm'
  +#195#164'ssigt flyttal i intervallet [0, 1).\n"'#10'"  IntToHex(Value, Digit'
  +'s) : string\n"'#10'"    Konverterar ett heltal till en hexadecimal str'#195
  +#164'ng med minst Digits tecken.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"   '
  +' Konverterar en str'#195#164'ng till ett heltal. Orsakar ett undantag vid o'
  +'giltig indata.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Konverterar e'
  +'tt heltal till dess str'#195#164'ngrepresentation.\n"'#10'"  Trim(S) : stri'
  +'ng\n"'#10'"    Tar bort inledande och avslutande blanksteg fr'#195#165'n S.'
  +'\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Tar bort inledande blanksteg fr'
  +#195#165'n S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Tar bort avslutand'
  +'e blanksteg fr'#195#165'n S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    K'
  +'odar s'#195#164'rskilda HTML-tecken i S som entiteter.\n"'#10'"  HtmlDecode'
  +'(S) : string\n"'#10'"    Avkodar HTML-entiteter i S tillbaka till tecken.\n'
  +'"'#10'"  UrlEncode(S) : string\n"'#10'"    Procentkodar S f'#195#182'r s'
  +#195#164'ker inkludering i en URL.\n"'#10'"  UrlDecode(S) : string\n"'#10'" '
  +'   Avkodar en procentkodad str'#195#164'ng S.\n"'#10'"  ReplaceAll(S, OldPa'
  +'ttern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Ers'#195#164'tter'
  +' alla f'#195#182'rekomster av OldPattern med NewPattern i S.\n"'#10'"  Rege'
  +'xReplace(Input, Pattern, Replacement) : string\n"'#10'"    Ers'#195#164'tte'
  +'r alla matchningar av det regulj'#195#164'ra uttrycket Pattern med Replacem'
  +'ent i Input. Skiftl'#195#164'gesok'#195#164'nsligt.\n"'#10'"  RegexMatch(In'
  +'put, Pattern) : Boolean\n"'#10'"    Kontrollerar om Input matchar det regul'
  +'j'#195#164'ra uttrycket Pattern. Skiftl'#195#164'gesok'#195#164'nsligt.\n"'
  +#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10'"    H'#195
  +#164'mtar delstr'#195#164'ngen i S mellan StartMarker och EndMarker.\n"'#10
  +'"\n"'#10'"JSON-funktioner (anv'#195#164'nd ett handle som returneras av JSO'
  +'NParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Tolkar en JSON-str'
  +#195#164'ng och returnerar ett handle (>=0). Returnerar -1 vid fel.\n"'#10'"'
  +'  JSONFree(Handle)\n"'#10'"    Frig'#195#182'r handle efter anv'#195#164'nd'
  +'ning.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'#10'"    H'#195#164
  +'mtar ett str'#195#164'ngv'#195#164'rde fr'#195#165'n den angivna s'#195#182
  +'kv'#195#164'gen Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"'
  +'    H'#195#164'mtar ett heltalsv'#195#164'rde fr'#195#165'n den angivna s'
  +#195#182'kv'#195#164'gen Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extend'
  +'ed\n"'#10'"    H'#195#164'mtar ett flyttalsv'#195#164'rde fr'#195#165'n den'
  +' angivna s'#195#182'kv'#195#164'gen Path.\n"'#10'"  JSONGetBool(Handle, Pat'
  +'h) : Boolean\n"'#10'"    H'#195#164'mtar ett booleskt v'#195#164'rde fr'#195
  +#165'n den angivna s'#195#182'kv'#195#164'gen Path.\n"'#10'"  JSONGetArrayCo'
  +'unt(Handle, Path) : Integer\n"'#10'"    H'#195#164'mtar antalet element i e'
  +'n array p'#195#165' den angivna s'#195#182'kv'#195#164'gen Path.\n"'#10'"  '
  +'JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    H'#195#164'mta'
  +'r str'#195#164'ngv'#195#164'rdet f'#195#182'r ett arrayelement vid det angi'
  +'vna indexet Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer'
  +'\n"'#10'"    H'#195#164'mtar heltalsv'#195#164'rdet f'#195#182'r ett arraye'
  +'lement vid det angivna indexet Index.\n"'#10'"  JSONGetType(Handle, Path) :'
  +' string\n"'#10'"    Returnerar typen f'#195#182'r v'#195#164'rdet p'#195#165
  +' Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"n'
  +'ull\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10'"    Kontrol'
  +'lerar om den angivna s'#195#182'kv'#195#164'gen Path finns.\n"'#10'"  JSONR'
  +'esultInit\n"'#10'"    Initierar en tom JSON-array f'#195#182'r att skapa et'
  +'t standardiserat felresultat.\n"'#10'"  JSONResultAddError(Offset, Length, '
  ,'Message, Replacements)\n"'#10'"    L'#195#164'gger till ett felobjekt i res'
  +'ultatarrayen. Replacements '#195#164'r en str'#195#164'ng med v'#195#164'rd'
  +'en separerade med \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Retur'
  +'nerar den aktuella resultatarrayen som en JSON-str'#195#164'ng.\n"'#10'"  J'
  +'SONResultClear\n"'#10'"    Rensar resultatarrayen.\n"'#10'"  Anropa alltid '
  +'JSONFree f'#195#182'r att frig'#195#182'ra handle n'#195#164'r du '#195#164
  +'r klar med det.\n"'#10'"\n"'#10'"Exempel p'#195#165' arbete med JSON:\n"'#10
  +'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h :'
  +'= JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    b'
  +'egin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetO'
  +'utput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  e'
  +'nd.\n"'#10'"\n"'#10'"Tillg'#195#164'ngliga parametrar (h'#195#164'mtas med '
  +'GetParam):\n"'#10'"  text - indatatexten som ska bearbetas (kan vara trunke'
  +'rad till MaxLength)\n"'#10'"  source - koden f'#195#182'r k'#195#164'llspr'
  +#195#165'ket (kan vara tom)\n"'#10'"  target - koden f'#195#182'r m'#195#165
  +'lspr'#195#165'ket\n"'#10'"  timestamp - aktuell Unix-tidsst'#195#164'mpel i'
  +' millisekunder (str'#195#164'ng)\n"'#10'"  random  - slumpm'#195#164'ssigt '
  +'9-siffrigt nummer (str'#195#164'ng)\n"'#10'"  rand - samma som random\n"'#10
  +'"  rand1..rand9 - de f'#195#182'rsta 1..9 siffrorna i det slumpm'#195#164's'
  +'siga numret\n"'#10'"\n"'#10'"Ytterligare initiala och anpassade parametrar '
  +#195#164'r ocks'#195#165' tillg'#195#164'ngliga.g'#195#164'ngliga."'#10#10'#'
  +': formconfig.rscriptresponsehint'#10'msgid ""'#10'"This script processes th'
  +'e response data. All functions and parameters described in the script hint '
  +'are available here as well.\n"'#10'"Use GetParam(''result'') to obtain the '
  +'received text.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'" '
  +' begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''resul'
  +'t'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can define custom parameters i'
  +'n the parameters script using SetParam(''name'', ''value''),\n"'#10'"and th'
  +'en retrieve them here with GetParam(''name'')."'#10'msgstr ""'#10'"Detta sk'
  +'ript bearbetar svarsdata. Alla funktioner och parametrar som beskrivs i skr'
  +'ipthj'#195#164'lpen finns '#195#164'ven tillg'#195#164'ngliga h'#195#164'r.'
  +'\n"'#10'"Anv'#195#164'nd GetParam(''result'') f'#195#182'r att h'#195#164'm'
  +'ta den mottagna texten.\n"'#10'"\n"'#10'"Exempel:\n"'#10'"  var s: string;\'
  +'n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutpu'
  +'t(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Du kan definiera anpassad'
  +'e parametrar i parameterskriptet med hj'#195#164'lp av SetParam(''name'', '
  +'''value''),\n"'#10'"och sedan h'#195#164'mta dem h'#195#164'r med GetParam('
  +'''name'')."'#10#10'#: formconfig.rvaluetype1'#10'msgctxt "formconfig.rvalue'
  +'type1"'#10'msgid "None"'#10'msgstr "Ingen"'#10#10'#: formconfig.rvaluetype2'
