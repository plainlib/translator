  +'})}; !/translations{Error: No data!#10}; /translations"'#10#10'#: formconfi'
  +'g.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal program: op'
  +'tional var section, then a main begin ... end. block.\n"'#10'"\n"'#10'"Exam'
  +'ple:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''t'
  +'ext'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    Se'
  +'tOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also use stan'
  +'dard Pascal constructs (if, for, while, repeat, etc.). You can define your '
  +'own functions and procedures before the main begin ... end. block.\n"'#10'"'
  +'\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : string\n"'#10
  +'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''name'', ''val'
  +'ue'')\n"'#10'"    Store an output value for the host.\n"'#10'"  GetTimestam'
  ,'p() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#10
  +'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with exactly Length'
  +' decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random float in th'
  +'e range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Conv'
  +'ert integer to hexadecimal string with at least Digits characters.\n"'#10'"'
  +'  StrToInt(S) : Integer\n"'#10'"    Convert a string to an integer. Raises '
  +'an exception on invalid input.\n"'#10'"  IntToStr(Value) : string\n"'#10'" '
  +'   Convert an integer to its string representation.\n"'#10'"  Trim(S) : str'
  +'ing\n"'#10'"    Remove leading and trailing whitespace from S.\n"'#10'"  Tr'
  +'imLeft(S) : string\n"'#10'"    Remove leading whitespace from S.\n"'#10'"  '
  +'TrimRight(S) : string\n"'#10'"    Remove trailing whitespace from S.\n"'#10
  +'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML characters in S i'
  +'nto entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HTML enti'
  +'ties in S back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    P'
  +'ercent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : string\n"'
  +#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, OldPatte'
  +'rn, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replace all occurren'
  +'ces of OldPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input, Patte'
  +'rn, Replacement) : string\n"'#10'"    Replace all regex matches of Pattern '
  +'with Replacement in Input. Case-insensitive.\n"'#10'"  RegexMatch(Input, Pa'
  +'ttern) : Boolean\n"'#10'"    Check if Input matches the regex Pattern. Case'
  +'-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\'
  +'n"'#10'"    Extract the substring of S between StartMarker and EndMarker.\n'
  +'"'#10'"\n"'#10'"JSON functions (use a handle returned by JSONParse):\n"'#10
  +'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string and return a hand'
  +'le (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Relea'
  +'se the handle after use.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'
  +#10'"    Get a string value at the specified Path.\n"'#10'"  JSONGetInt(Hand'
  +'le, Path) : Integer\n"'#10'"    Get an integer value at the specified Path.'
  +'\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a floating'
  +'-point value at the specified Path.\n"'#10'"  JSONGetBool(Handle, Path) : B'
  +'oolean\n"'#10'"    Get a boolean value at the specified Path.\n"'#10'"  JSO'
  +'NGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the number of elemen'
  +'ts in an array at the specified Path.\n"'#10'"  JSONGetArrayString(Handle, '
  +'Path, Index) : string\n"'#10'"    Get the string value of an array element '
  +'at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Intege'
  +'r\n"'#10'"    Get the integer value of an array element at the given Index.'
  +'\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Return the type o'
  +'f the value at Path: \"object\", \"array\", \"string\", \"int\", \"float\",'
  +' \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10
  +'"    Check if the specified Path exists.\n"'#10'"  JSONResultInit\n"'#10'" '
  +'   Initialize an empty JSON array for building a standard error result.\n"'
  +#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"   '
  +' Add an error object to the result array. Replacements is a string of value'
  +'s separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Return t'
  +'he current result array as a JSON string.\n"'#10'"  JSONResultClear\n"'#10
  +'"    Clear the result array.\n"'#10'"  Always call JSONFree to release the '
  +'handle after you are done.\n"'#10'"\n"'#10'"Example of working with JSON:\n'
  +'"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'" '
  +'   h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10
  +'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"    '
  +'  SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10
  +'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'
  +#10'"  text - the input text to process (possibly truncated to MaxLength)\n"'
  +#10'"  source - source language code (may be empty)\n"'#10'"  target - targe'
  +'t language code\n"'#10'"  timestamp - current Unix timestamp in millisecond'
  +'s (string)\n"'#10'"  random  - 9-digit random number (string)\n"'#10'"  ran'
  +'d - same as random\n"'#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#10'"\n"'#10'"Additional initial and custom parameters are also '
  +'available."'#10'msgstr ""'#10'"'#236#138#164#237#129#172#235#166#189#237#138
