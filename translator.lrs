  +#10'"'#208#159#209#128#208#184#208#188#208#181#209#128#208#184':\n"'#13#10'"'
  +'responseData/translatedText; matches/*#10/translation; /texts/text; {litera'
  +'l text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: '#208
  +#157#209#143#208#188#208#176' '#208#180#208#176#208#189#208#189#208#184'!#10'
  +'}; /translations/0/text"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgi'
  +'d ""'#13#10'"The script is a standard Pascal program: optional var section,'
  +' then a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10
  +'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'')'
  +';\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    Se'
  +'tOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also'
  +' use standard Pascal constructs (if, for, while, repeat, etc.). You can def'
  ,'ine your own functions and procedures before the main begin ... end. block.'
  +'\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'''
  +') : string\n"'#13#10'"    Retrieve an input parameter value.\n"'#13#10'"  S'
  +'etOutput(''name'', ''value'')\n"'#13#10'"    Store an output value for the '
  +'host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix times'
  +'tamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10
  +'"    Random integer with exactly Length decimal digits.\n"'#13#10'"  Random'
  +' : Extended\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10'"  I'
  +'ntToHex(Value, Digits) : string\n"'#13#10'"    Convert integer to hexadecim'
  +'al string with at least Digits characters.\n"'#13#10'"  StrToInt(S) : Integ'
  +'er\n"'#13#10'"    Convert a string to an integer. Raises an exception on in'
  +'valid input.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Convert a'
  +'n integer to its string representation.\n"'#13#10'"  Trim(S) : string\n"'#13
  +#10'"    Remove leading and trailing whitespace from S.\n"'#13#10'"  TrimLef'
  +'t(S) : string\n"'#13#10'"    Remove leading whitespace from S.\n"'#13#10'" '
  +' TrimRight(S) : string\n"'#13#10'"    Remove trailing whitespace from S.\n"'
