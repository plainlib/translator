  +'onfigtrayslate.btnresponsetest.hint'#10'msgid "Converts the current respons'
  +'e"'#10'msgstr "Converti la risposta attuale"'#10#10'#: tformconfigtrayslate'
  +'.btnscripthelp.hint'#10'msgctxt "tformconfigtrayslate.btnscripthelp.hint"'
  +#10'msgid "Help"'#10'msgstr "Aiuto"'#10#10'#: tformconfigtrayslate.btnscript'
  +'responsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnscriptresponsehelp.h'
  +'int"'#10'msgid "Help"'#10'msgstr "Aiuto"'#10#10'#: tformconfigtrayslate.btn'
  +'scriptresponsetest.hint'#10'msgctxt "tformconfigtrayslate.btnscriptresponse'
  +'test.hint"'#10'msgid "Execute script and view the result"'#10'msgstr "Esegu'
  +'i lo script e visualizza il risultato"'#10#10'#: tformconfigtrayslate.btnsc'
  +'ripttest.hint'#10'msgctxt "tformconfigtrayslate.btnscripttest.hint"'#10'msg'
  +'id "Execute script and view the result"'#10'msgstr "Esegui lo script e visu'
  +'alizza il risultato"'#10#10'#: tformconfigtrayslate.btnurltest.hint'#10'msg'
  +'id "Execute get request and view the result"'#10'msgstr "Esegui richiesta G'
  +'ET e visualizza il risultato"'#10#10'#: tformconfigtrayslate.caption'#10'ms'
  +'gctxt "tformconfigtrayslate.caption"'#10'msgid "Config Editor"'#10'msgstr "'
  ,'Editor configurazione"'#10#10'#: tformconfigtrayslate.checkencodecustompara'
  +'meters.caption'#10'msgid "Encode parameters"'#10'msgstr "Codifica parametri'
