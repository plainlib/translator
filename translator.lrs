  +'m format key=value, key: value juga didukung"'#13#10#13#10'#: tformconfigtr'
  +'ayslate.labelinitheaders2.caption'#13#10'msgctxt "tformconfigtrayslate.labe'
  +'linitheaders2.caption"'#13#10'msgid "Headers"'#13#10'msgstr "Headers"'#13#10
  +#13#10'#: tformconfigtrayslate.labelinitlivetime.caption'#13#10'msgctxt "tfo'
  +'rmconfigtrayslate.labelinitlivetime.caption"'#13#10'msgid "Time in seconds '
  +'to refresh parameters with a new request (0 = every request)"'#13#10'msgstr'
  +' "Waktu dalam detik untuk memperbarui parameter dengan permintaan baru (0 ='
  +' setiap permintaan)"'#13#10#13#10'#: tformconfigtrayslate.labelinitlivetime'
  +'2.caption'#13#10'msgctxt "tformconfigtrayslate.labelinitlivetime2.caption"'
  +#13#10'msgid "Live time"'#13#10'msgstr "Waktu langsung"'#13#10#13#10'#: tfor'
  +'mconfigtrayslate.labelinitparameters.caption'#13#10'msgid "Parameters name='
