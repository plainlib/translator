  +#172#236#152#164#234#184#176'"'#13#10#13#10'#: tformconfigtrayslate.sbcopyco'
  +'nfig.hint'#13#10'msgid "Copy configuration"'#13#10'msgstr "'#236#132#164#236
  +#160#149' '#235#179#181#236#130#172'"'#13#10#13#10'#: tformconfigtrayslate.s'
  +'bnewconfig.hint'#13#10'msgid "New configuration"'#13#10'msgstr "'#236#131
  +#136' '#236#132#164#236#160#149'"'#13#10#13#10
]);
LazarusResources.Add('formconfig.nl','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: nl\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Configuratie-editor"'#13#10#13#10'#: formconfig.rclearlanguages'#13#10'ms'
  +'gid "The list is already filled. Do you want to clear it?"'#13#10'msgstr "D'
  +'e lijst is al gevuld. Wilt u deze leegmaken?"'#13#10#13#10'#: formconfig.rc'
  +'onfigeditor'#13#10'msgid "Config Editor..."'#13#10'msgstr "Configuratie-edi'
  +'tor..."'#13#10#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you sure'
  +' you want to delete config"'#13#10'msgstr "Weet u zeker dat u de configurat'
  +'ie wilt verwijderen"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13#10
  +'msgid "Delete config"'#13#10'msgstr "Configuratie verwijderen"'#13#10#13#10
  +'#: formconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Annul'
  +'eren"'#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Keep'
  +' my changes"'#13#10'msgstr "Mijn wijzigingen behouden"'#13#10#13#10'#: form'
  +'config.rfilechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The fil'
  +'e \"%s\" has been modified by another application since it was opened."'#13
  +#10'msgstr "Het bestand \"%s\" is sinds het openen ervan gewijzigd door een '
  +'andere toepassing."'#13#10#13#10'#: formconfig.rfilechangedmsgactivate'#13
  +#10'msgid "You have unsaved changes. Keep them or reload from disk?"'#13#10
  +'msgstr "Je hebt niet-opgeslagen wijzigingen. Wil je deze behouden of het be'
  +'stand opnieuw laden vanaf de schijf?"'#13#10#13#10'#: formconfig.rfilechang'
  +'edreloaddisk'#13#10'msgid "Reload from disk"'#13#10'msgstr "Opnieuw laden v'
  +'anaf de schijf"'#13#10#13#10'#: formconfig.rfilechangedtitle'#13#10'msgid "'
  +'File changed on disk"'#13#10'msgstr "Bestand gewijzigd op schijf"'#13#10#13
  +#10'#: formconfig.rnamequestion'#13#10'msgid "Enter new config file name:"'
  +#13#10'msgstr "Voer de naam van het nieuwe configuratiebestand in:"'#13#10#13
  +#10'#: formconfig.rneedsave'#13#10'msgid "The configuration was modified. Sa'
  +'ve changes?"'#13#10'msgstr "De configuratie is gewijzigd. Wijzigingen opsla'
  +'an?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgid ""'#13#10'"Json '
  +'Pointer: Use / for levels, keys for objects, and numbers for indexes.\n"'#13
  +#10'"Use * for all items, *#10 to join items by newline. Use ~ at the end of'
  +' the path to return the raw JSON branch.\n"'#13#10'"Separate multiple segme'
  +'nts with semicolon ;.\n"'#13#10'"Literal: Text block in {'#226#128#166'}. S'
  +'pecial tag #10 for newlines. Use {{regex}} inside to extract data directly '
  +'into the text.\n"'#13#10'"Logic: If a Pointer in a segment is empty, the wh'
  +'ole segment is skipped. If a segment has no Pointer, only literal text bloc'
  +'ks with embedded regular expressions are processed.\n"'#13#10'"Regex: {pref'
  +'ix {regex[index]} suffix} inside a text block. If no [index] is specified, '
  +'the first match is used.\n"'#13#10'"Index can be a number, [*] (join by spa'
  +'ce), or [*#10] (join by newline). If the regex finds no match, the entire {'
  +#226#128#166'} block is removed.\n"'#13#10'"Using ~ inside a regex returns t'
  +'he entire text.\n"'#13#10'"Inversion: Start a segment with ! (e.g. !/path{E'
  +'rror}) to show its text only if the Pointer data is missing or the JSON is '
  +'invalid.\n"'#13#10'"Commenting: /* text */ comments are stripped from the e'
  +'ntire expression before any processing.\n"'#13#10'"Examples:\n"'#13#10'"res'
  +'ponseData/translatedText; matches/*#10/translation; /texts/text; {literal t'
  +'ext#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#1'
  +'0}; /translations/0/text"'#13#10'msgstr ""'#13#10'"JSON Pointer: Gebruik / '
  +'voor niveaus, sleutels voor objecten en cijfers voor indexen. Gebruik * voo'
  +'r alle items en *#10 om items met een nieuwe regel samen te voegen. Gebruik'
  +' ~ aan het einde van het pad om de onbewerkte JSON-tak terug te geven. Sche'
  +'id meerdere segmenten met puntkomma ;.\n"'#13#10'"Letterlijk: Tekstblok in '
  +'{'#226#128#166'}. Speciale tag #10 voor nieuwe regels. Gebruik {{regex}} er'
  +'in om gegevens rechtstreeks in de tekst te extraheren.\n"'#13#10'"Logica: A'
  +'ls een Pointer in een segment leeg is, wordt het hele segment overgeslagen.'
  +' Als een segment geen Pointer heeft, worden alleen letterlijke tekstblokken'
  +' met ingebedde reguliere expressies verwerkt.\n"'#13#10'"Regex: {voorvoegse'
  +'l {regex[index]} achtervoegsel} binnen een tekstblok. Als [index] niet is o'
  +'pgegeven, wordt de eerste overeenkomst gebruikt. Index kan een getal zijn, '
  +'[*] (samenvoegen met spatie) of [*#10] (samenvoegen met nieuwe regel). Als '
  ,'de reguliere expressie geen overeenkomst vindt, wordt het volledige {'#226
  +#128#166'}-blok verwijderd. Het gebruik van ~ binnen een reguliere expressie'
  +' retourneert de volledige tekst.\n"'#13#10'"Inversie: Begin een segment met'
  +' ! (bijvoorbeeld !/path{Error}) om de tekst ervan alleen weer te geven als '
  +'de Pointer-gegevens ontbreken of de JSON ongeldig is.\n"'#13#10'"Commentaar'
  +': /* tekst */-commentaren worden uit de volledige expressie verwijderd voor'
  +'dat enige verwerking plaatsvindt.\n"'#13#10'"Voorbeelden:\n"'#13#10'"respon'
  +'seData/translatedText; matches/*#10/translation; /texts/text; {literal text'
  +'#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10};'
  +' /translations"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13
  +#10'"The script is a standard Pascal program: optional var section, then a m'
  +'ain begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var '
  +'s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13
  +#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput('
  +'''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use sta'
  +'ndard Pascal constructs (if, for, while, repeat, etc.). You can define your'
  +' own functions and procedures before the main begin ... end. block.\n"'#13
  +#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'') : stri'
  +'ng\n"'#13#10'"    Retrieve an input parameter value.\n"'#13#10'"  SetOutput'
  +'(''name'', ''value'')\n"'#13#10'"    Store an output value for the host.\n"'
  +#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix timestamp in mi'
  +'lliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Ran'
  +'dom integer with exactly Length decimal digits.\n"'#13#10'"  Random : Exten'
  +'ded\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10'"  IntToHex('
  +'Value, Digits) : string\n"'#13#10'"    Convert integer to hexadecimal strin'
  +'g with at least Digits characters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13
  +#10'"    Convert a string to an integer. Raises an exception on invalid inpu'
  +'t.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Convert an integer '
  +'to its string representation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    '
  +'Remove leading and trailing whitespace from S.\n"'#13#10'"  TrimLeft(S) : s'
  +'tring\n"'#13#10'"    Remove leading whitespace from S.\n"'#13#10'"  TrimRig'
  +'ht(S) : string\n"'#13#10'"    Remove trailing whitespace from S.\n"'#13#10
  +'"  HtmlEncode(S) : string\n"'#13#10'"    Encode special HTML characters in '
  +'S into entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decode '
  +'HTML entities in S back to characters.\n"'#13#10'"  UrlEncode(S) : string\n'
  +'"'#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13#10'"  UrlDeco'
  +'de(S) : string\n"'#13#10'"    Decode a percent-encoded string S.\n"'#13#10
  +'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13
  +#10'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'#13
  +#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    Rep'
  +'lace all regex matches of Pattern with Replacement in Input. Case-insensiti'
  +'ve.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Check '
  +'if Input matches the regex Pattern. Case-insensitive.\n"'#13#10'"  ExtractB'
  +'etween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extract the subst'
  +'ring of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON fu'
  +'nctions (use a handle returned by JSONParse):\n"'#13#10'"  JSONParse(S) : I'
  +'nteger\n"'#13#10'"    Parse a JSON string and return a handle (>=0). Return'
  +'s -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release the han'
  +'dle after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10
  +'"    Get a string value at the specified Path.\n"'#13#10'"  JSONGetInt(Hand'
  +'le, Path) : Integer\n"'#13#10'"    Get an integer value at the specified Pa'
  +'th.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Get a'
  +' floating-point value at the specified Path.\n"'#13#10'"  JSONGetBool(Handl'
  +'e, Path) : Boolean\n"'#13#10'"    Get a boolean value at the specified Path'
  +'.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Get'
  +' the number of elements in an array at the specified Path.\n"'#13#10'"  JSO'
  +'NGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the string'
  +' value of an array element at the given Index.\n"'#13#10'"  JSONGetArrayInt'
  +'(Handle, Path, Index) : Integer\n"'#13#10'"    Get the integer value of an '
  +'array element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Path) : '
  +'string\n"'#13#10'"    Return the type of the value at Path: \"object\", \"a'
  +'rray\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JS'
  +'ONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the specified '
  +'Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an empty'
  ,' JSON array for building a standard error result.\n"'#13#10'"  JSONResultAd'
  +'dError(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an error o'
  +'bject to the result array. Replacements is a string of values separated by '
  +'\"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the curren'
  +'t result array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10'"  '
  +'  Clear the result array.\n"'#13#10'"  Always call JSONFree to release the '
  +'handle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working with J'
  +'SON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  '
  +'begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    i'
  +'f h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, '
  +'''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      J'
  +'SONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Av'
  +'ailable parameters (retrieved with GetParam):\n"'#13#10'"  text - the input'
  +' text to process (possibly truncated to MaxLength)\n"'#13#10'"  source - so'
  +'urce language code (may be empty)\n"'#13#10'"  target - target language cod'
  +'e\n"'#13#10'"  timestamp - current Unix timestamp in milliseconds (string)\'
  +'n"'#13#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand - s'
  +'ame as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random n'
  +'umber\n"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are a'
  +'lso available."'#13#10'msgstr ""'#13#10'"Het script is een standaard Pascal'
  +'-programma: een optionele var-sectie, gevolgd door een hoofdblok begin ... '
  +'end.\n"'#13#10'"\n"'#13#10'"Voorbeeld:\n"'#13#10'"  var s: string;\n"'#13#10
  +'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := Replac'
  +'eAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13
  +#10'"  end.\n"'#13#10'"\n"'#13#10'"Je kunt ook standaard Pascal-constructies'
  +' gebruiken (if, for, while, repeat, enz.). Je kunt je eigen functies en pro'
  +'cedures defini'#195#171'ren v'#195#179#195#179'r het hoofdblok begin ... en'
  +'d.\n"'#13#10'"\n"'#13#10'"Beschikbare functies:\n"'#13#10'"  GetParam(''nam'
  +'e'') : string\n"'#13#10'"    Haalt de waarde van een invoerparameter op.\n"'
  +#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Slaat een uitvoerwaa'
  +'rde voor de host op.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Hui'
  +'dige Unix-tijdstempel in milliseconden (UTC).\n"'#13#10'"  GetRandom(Length'
  +') : Int64\n"'#13#10'"    Willekeurig geheel getal met precies Length decima'
  +'le cijfers.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Willekeurig getal'
  +' met drijvende komma in het bereik [0, 1).\n"'#13#10'"  IntToHex(Value, Dig'
  +'its) : string\n"'#13#10'"    Zet een geheel getal om naar een hexadecimale '
  +'tekenreeks met ten minste Digits tekens.\n"'#13#10'"  StrToInt(S) : Integer'
  +'\n"'#13#10'"    Zet een tekenreeks om naar een geheel getal. Genereert een '
  +'uitzondering bij ongeldige invoer.\n"'#13#10'"  IntToStr(Value) : string\n"'
  +#13#10'"    Zet een geheel getal om naar zijn tekenreeksrepresentatie.\n"'#13
  +#10'"  Trim(S) : string\n"'#13#10'"    Verwijdert witruimte aan het begin en'
  +' einde van S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Verwijdert w'
  +'itruimte aan het begin van S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10
  +'"    Verwijdert witruimte aan het einde van S.\n"'#13#10'"  HtmlEncode(S) :'
  +' string\n"'#13#10'"    Codeert speciale HTML-tekens in S als entiteiten.\n"'
  +#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decodeert HTML-entiteiten in'
  +' S terug naar tekens.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Cod'
  +'eert S met procentcodering voor veilige opname in een URL.\n"'#13#10'"  Url'
  +'Decode(S) : string\n"'#13#10'"    Decodeert een met procentcodering gecodee'
  +'rde tekenreeks S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, Ignore'
  +'Case=False) : string\n"'#13#10'"    Vervangt alle voorkomens van OldPattern'
  +' door NewPattern in S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacemen'
  +'t) : string\n"'#13#10'"    Vervangt alle overeenkomsten van de reguliere ex'
  +'pressie Pattern door Replacement in Input. Niet hoofdlettergevoelig.\n"'#13
  +#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Controleert of In'
  +'put overeenkomt met de reguliere expressie Pattern. Niet hoofdlettergevoeli'
  +'g.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10
  +'"    Haalt de substring uit S tussen StartMarker en EndMarker.\n"'#13#10'"\'
  +'n"'#13#10'"JSON-functies (gebruik een handle die door JSONParse wordt geret'
  +'ourneerd):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parseert een '
  +'JSON-tekenreeks en retourneert een handle (>=0). Retourneert -1 bij een fou'
  +'t.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Geeft de handle na gebruik '
  +'vrij.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"    Haal'
  +'t een tekenreekswaarde op via het opgegeven Path.\n"'#13#10'"  JSONGetInt(H'
  ,'andle, Path) : Integer\n"'#13#10'"    Haalt een gehele waarde op via het op'
  +'gegeven Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10
  +'"    Haalt een waarde met drijvende komma op via het opgegeven Path.\n"'#13
  +#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Haalt een booleaan'
  +'se waarde op via het opgegeven Path.\n"'#13#10'"  JSONGetArrayCount(Handle,'
  +' Path) : Integer\n"'#13#10'"    Haalt het aantal elementen op van een array'
  +' via het opgegeven Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Inde'
  +'x) : string\n"'#13#10'"    Haalt de tekenreekswaarde op van een array-eleme'
  +'nt op de opgegeven Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index)'
  +' : Integer\n"'#13#10'"    Haalt de gehele waarde op van een array-element o'
  +'p de opgegeven Index.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13
  +#10'"    Retourneert het type van de waarde op Path: \"object\", \"array\", '
  +'\"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathEx'
  +'ists(Handle, Path) : Boolean\n"'#13#10'"    Controleert of het opgegeven Pa'
  +'th bestaat.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialiseert een le'
  +'ge JSON-array voor het opbouwen van een standaard foutresultaat.\n"'#13#10
  +'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"   '
  +' Voegt een foutobject toe aan de resultatenarray. Replacements is een teken'
  +'reeks met waarden, gescheiden door \"|\".\n"'#13#10'"  JSONResultGet : stri'
  +'ng\n"'#13#10'"    Retourneert de huidige resultatenarray als een JSON-teken'
  +'reeks.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Wist de resultatenarray.'
  +'\n"'#13#10'"  Roep altijd JSONFree aan om de handle vrij te geven nadat je '
  +'klaar bent.\n"'#13#10'"\n"'#13#10'"Voorbeeld van werken met JSON:\n"'#13#10
  +'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10
  +'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'
  +#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'
  +#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10
  +'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Beschikbare parameters ('
  +'opgehaald met GetParam):\n"'#13#10'"  text - de te verwerken invoertekst (m'
  +'ogelijk afgekapt tot MaxLength)\n"'#13#10'"  source - code van de brontaal '
  +'(kan leeg zijn)\n"'#13#10'"  target - code van de doeltaal\n"'#13#10'"  tim'
  +'estamp - huidige Unix-tijdstempel in milliseconden (tekenreeks)\n"'#13#10'"'
  +'  random  - willekeurig getal van 9 cijfers (tekenreeks)\n"'#13#10'"  rand '
  +'- hetzelfde als random\n"'#13#10'"  rand1..rand9 - de eerste 1..9 cijfers v'
  +'an het willekeurige getal\n"'#13#10'"\n"'#13#10'"Er zijn ook aanvullende in'
  +'iti'#195#171'le en aangepaste parameters beschikbaar.xtra initi'#195#171'le'
  +' en aangepaste parameters zijn ook beschikbaar."'#13#10#13#10'#: formconfig'
  +'.rscriptresponsehint'#13#10'msgid ""'#13#10'"This script processes the resp'
  +'onse data. All functions and parameters described in the script hint are av'
  +'ailable here as well.\n"'#13#10'"Use GetParam(''result'') to obtain the rec'
  +'eived text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    Set'
  +'Output(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can def'
  +'ine custom parameters in the parameters script using SetParam(''name'', ''v'
  +'alue''),\n"'#13#10'"and then retrieve them here with GetParam(''name'')."'
  +#13#10'msgstr ""'#13#10'"Dit script verwerkt de responsgegevens. Alle functi'
  +'es en parameters die in de scripthint worden beschreven, zijn hier ook besc'
  +'hikbaar.\n"'#13#10'"Gebruik GetParam(''result'') om de ontvangen tekst op t'
  +'e halen.\n"'#13#10'"\n"'#13#10'"Voorbeeld:\n"'#13#10'"  var s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    Set'
  +'Output(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"U kunt aang'
  +'epaste parameters defini'#195#171'ren in het parameterscript met SetParam('
  +'''name'', ''value''),\n"'#13#10'"en ze vervolgens hier ophalen met GetParam'
  +'(''name'')."'#13#10#13#10'#: formconfig.rvaluetype1'#13#10'msgctxt "formcon'
  +'fig.rvaluetype1"'#13#10'msgid "None"'#13#10'msgstr "Geen"'#13#10#13#10'#: f'
  +'ormconfig.rvaluetype2'#13#10'msgid "Language"'#13#10'msgstr "Taal"'#13#10#13
