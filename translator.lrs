  +#13#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msg'
  +'str "Editor de Configura'#195#167#195#181'es"'#13#10#13#10'#: formconfig.rc'
  +'learlanguages'#13#10'msgid "The list is already filled. Do you want to clea'
  +'r it?"'#13#10'msgstr "A lista j'#195#161' est'#195#161' preenchida. Voc'#195
  +#170' quer limpar isso?"'#13#10#13#10'#: formconfig.rconfigeditor'#13#10'msg'
  +'id "Config Editor..."'#13#10'msgstr "Editor de Configura'#195#167#195#181'e'
  +'s..."'#13#10#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you sure y'
  +'ou want to delete config"'#13#10'msgstr "Tem certeza de que deseja excluir '
  +'a configura'#195#167#195#163'o"'#13#10#13#10'#: formconfig.rdeleteconfigcap'
  +'tion'#13#10'msgid "Delete config"'#13#10'msgstr "Excluir configura'#195#167
  +#195#163'o"'#13#10#13#10'#: formconfig.rfilechangedcancel'#13#10'msgid "Canc'
  +'el"'#13#10'msgstr "Cancelar"'#13#10#13#10'#: formconfig.rfilechangedkeepcha'
  +'nges'#13#10'msgid "Keep my changes"'#13#10'msgstr "Manter minhas altera'#195
  +#167#195#181'es"'#13#10#13#10'#: formconfig.rfilechangedmsg'#13#10'#, object'
  +'-pascal-format'#13#10'msgid "The file \"%s\" has been modified by another a'
  +'pplication since it was opened."'#13#10'msgstr "O arquivo \"%s\" foi modifi'
  +'cado por outro aplicativo desde que foi aberto."'#13#10#13#10'#: formconfig'
  +'.rfilechangedmsgactivate'#13#10'msgid "You have unsaved changes. Keep them '
  +'or reload from disk?"'#13#10'msgstr "Voc'#195#170' tem altera'#195#167#195
  +#181'es n'#195#163'o salvas. Deseja mant'#195#170'-las ou recarregar o arqui'
  +'vo do disco?"'#13#10#13#10'#: formconfig.rfilechangedreloaddisk'#13#10'msgi'
  +'d "Reload from disk"'#13#10'msgstr "Recarregar do disco"'#13#10#13#10'#: fo'
  +'rmconfig.rfilechangedtitle'#13#10'msgid "File changed on disk"'#13#10'msgst'
  +'r "Arquivo alterado no disco"'#13#10#13#10'#: formconfig.rnamequestion'#13
  +#10'msgid "Enter new config file name:"'#13#10'msgstr "Digite o nome do novo'
  +' arquivo de configura'#195#167#195#163'o:"'#13#10#13#10'#: formconfig.rneed'
  +'save'#13#10'msgid "The configuration was modified. Save changes?"'#13#10'ms'
  +'gstr "A configura'#195#167#195#163'o foi modificada. Salvar altera'#195#167
  +#195#181'es?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgid ""'#13#10
  +'"Json Pointer: Use / for levels, keys for objects, and numbers for indexes.'
  +'\n"'#13#10'"Use * for all items, *#10 to join items by newline. Use ~ at th'
  +'e end of the path to return the raw JSON branch.\n"'#13#10'"Separate multip'
  +'le segments with semicolon ;.\n"'#13#10'"Literal: Text block in {'#226#128
  +#166'}. Special tag #10 for newlines. Use {{regex}} inside to extract data d'
  +'irectly into the text.\n"'#13#10'"Logic: If a Pointer in a segment is empty'
  +', the whole segment is skipped. If a segment has no Pointer, only literal t'
  +'ext blocks with embedded regular expressions are processed.\n"'#13#10'"Rege'
  +'x: {prefix {regex[index]} suffix} inside a text block. If no [index] is spe'
  +'cified, the first match is used.\n"'#13#10'"Index can be a number, [*] (joi'
  +'n by space), or [*#10] (join by newline). If the regex finds no match, the '
  +'entire {'#226#128#166'} block is removed.\n"'#13#10'"Using ~ inside a regex'
  +' returns the entire text.\n"'#13#10'"Inversion: Start a segment with ! (e.g'
  +'. !/path{Error}) to show its text only if the Pointer data is missing or th'
  +'e JSON is invalid.\n"'#13#10'"Commenting: /* text */ comments are stripped '
  +'from the entire expression before any processing.\n"'#13#10'"Examples:\n"'
  +#13#10'"responseData/translatedText; matches/*#10/translation; /texts/text; '
  +'{literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: '
  +'No data!#10}; /translations/0/text"'#13#10'msgstr ""'#13#10'"Ponteiro Json:'
  +' Use / para n'#195#173'veis, chaves para objetos e n'#195#186'meros para '
  +#195#173'ndices.\n"'#13#10'"Use * para todos os itens, *#10 para unir itens '
  +'por quebra de linha. Use ~ no final do caminho para retornar o branch JSON '
  +'bruto.\n"'#13#10'"Separe v'#195#161'rios segmentos com ponto e v'#195#173'r'
  +'gula ;.\n"'#13#10'"Literal: Bloco de texto em {'#226#128#166'}. Etiqueta es'
  +'pecial #10 para quebras de linha. Use {{regex}} dentro para extrair dados d'
  +'iretamente no texto.\n"'#13#10'"L'#195#179'gica: Se um Ponteiro em um segme'
  +'nto estiver vazio, o segmento inteiro '#195#169' ignorado. Se um segmento n'
  +#195#163'o tiver Ponteiro, apenas blocos de texto literal com express'#195
  +#181'es regulares incorporadas s'#195#163'o processados.\n"'#13#10'"Regex: {'
  ,'prefixo {regex['#195#173'ndice]} sufixo} dentro de um bloco de texto. Se ne'
  +'nhum ['#195#173'ndice] for especificado, a primeira correspond'#195#170'nci'
  +'a ser'#195#161' usada.\n"'#13#10'"O '#195#173'ndice pode ser um n'#195#186
  +'mero, [*] (jun'#195#167#195#163'o por espa'#195#167'o) ou [*#10] (jun'#195
  +#167#195#163'o por nova linha). Se a regex n'#195#163'o encontrar nenhuma co'
  +'rrespond'#195#170'ncia, todo o bloco {'#226#128#166'} ser'#195#161' removid'
  +'o.\n"'#13#10'"Usar ~ dentro de uma regex retorna o texto inteiro.\n"'#13#10
  +'"Invers'#195#163'o: Comece um segmento com ! (por exemplo, !/caminho{Erro})'
  +' para mostrar seu texto somente se os dados do Pointer estiverem ausentes o'
  +'u o JSON for inv'#195#161'lido.\n"'#13#10'"Comentando: Coment'#195#161'rios'
  +' /* texto */ s'#195#163'o removidos de toda a express'#195#163'o antes de q'
  +'ualquer processamento.\n"'#13#10'"Exemplos:\n"'#13#10'"responseData/transla'
  +'tedText; matches/*#10/translation; /texts/text; {texto literal#10}; /result'
  +'/text; /text{ ({(\\w+)})}; !/translations{Erro: Sem dados!#10}; /translatio'
  +'ns/0/text"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"T'
  +'he script is a standard Pascal program: optional var section, then a main b'
  +'egin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: st'
  +'ring;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10
  +'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''te'
  +'xt'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standar'
  +'d Pascal constructs (if, for, while, repeat, etc.). You can define your own'
  +' functions and procedures before the main begin ... end. block.\n"'#13#10'"'
  +'\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'') : string\n'
  +'"'#13#10'"    Retrieve an input parameter value.\n"'#13#10'"  SetOutput(''n'
  +'ame'', ''value'')\n"'#13#10'"    Store an output value for the host.\n"'#13
  +#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix timestamp in milli'
  +'seconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random'
  +' integer with exactly Length decimal digits.\n"'#13#10'"  Random : Extended'
  +'\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10'"  IntToHex(Val'
  +'ue, Digits) : string\n"'#13#10'"    Convert integer to hexadecimal string w'
  +'ith at least Digits characters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10
  +'"    Convert a string to an integer. Raises an exception on invalid input.\'
  +'n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Convert an integer to '
  +'its string representation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Rem'
  +'ove leading and trailing whitespace from S.\n"'#13#10'"  TrimLeft(S) : stri'
  +'ng\n"'#13#10'"    Remove leading whitespace from S.\n"'#13#10'"  TrimRight('
  +'S) : string\n"'#13#10'"    Remove trailing whitespace from S.\n"'#13#10'"  '
  +'HtmlEncode(S) : string\n"'#13#10'"    Encode special HTML characters in S i'
  +'nto entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTM'
  +'L entities in S back to characters.\n"'#13#10'"  UrlEncode(S) : string\n"'
  +#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13#10'"  UrlDecode('
  +'S) : string\n"'#13#10'"    Decode a percent-encoded string S.\n"'#13#10'"  '
  +'ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13#10
  +'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'#13#10
  +'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    Replac'
  +'e all regex matches of Pattern with Replacement in Input. Case-insensitive.'
  +'\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Check if '
  +'Input matches the regex Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetw'
  +'een(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extract the substrin'
  +'g of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON funct'
  +'ions (use a handle returned by JSONParse):\n"'#13#10'"  JSONParse(S) : Inte'
  +'ger\n"'#13#10'"    Parse a JSON string and return a handle (>=0). Returns -'
  +'1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release the handle'
  +' after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"  '
  +'  Get a string value at the specified Path.\n"'#13#10'"  JSONGetInt(Handle,'
  +' Path) : Integer\n"'#13#10'"    Get an integer value at the specified Path.'
  +'\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Get a fl'
  +'oating-point value at the specified Path.\n"'#13#10'"  JSONGetBool(Handle, '
  +'Path) : Boolean\n"'#13#10'"    Get a boolean value at the specified Path.\n'
  +'"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Get th'
  +'e number of elements in an array at the specified Path.\n"'#13#10'"  JSONGe'
  +'tArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the string va'
  +'lue of an array element at the given Index.\n"'#13#10'"  JSONGetArrayInt(Ha'
  +'ndle, Path, Index) : Integer\n"'#13#10'"    Get the integer value of an arr'
  ,'ay element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Path) : str'
  +'ing\n"'#13#10'"    Return the type of the value at Path: \"object\", \"arra'
  +'y\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONP'
  +'athExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the specified Pat'
  +'h exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an empty JS'
  +'ON array for building a standard error result.\n"'#13#10'"  JSONResultAddEr'
  +'ror(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an error obje'
  +'ct to the result array. Replacements is a string of values separated by \"|'
  +'\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the current r'
  +'esult array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    C'
  +'lear the result array.\n"'#13#10'"  Always call JSONFree to release the han'
  +'dle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working with JSON'
  +':\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  beg'
  +'in\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h'
  +' >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''so'
  +'me.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONF'
  +'ree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Availa'
  +'ble parameters (retrieved with GetParam):\n"'#13#10'"  text - the input tex'
  +'t to process (possibly truncated to MaxLength)\n"'#13#10'"  source - source'
  +' language code (may be empty)\n"'#13#10'"  target - target language code\n"'
  +#13#10'"  timestamp - current Unix timestamp in milliseconds (string)\n"'#13
  +#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand - same as '
  +'random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random number\n'
  +'"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are also ava'
  +'ilable."'#13#10'msgstr ""'#13#10'"O script '#195#169' um programa Pascal pa'
  +'dr'#195#163'o: se'#195#167#195#163'o var opcional, depois um bloco main beg'
  +'in ... end.\n"'#13#10'"\n"'#13#10'"Exemplo:\n"'#13#10'"  var s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s :=\'
  +'n"'#13#10'"ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''t'
  +'ext'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Voc'#195#170' tamb'#195
  +#169'm pode usar constru'#195#167#195#181'es Pascal padr'#195#163'o (if, for'
  +', while, repeat, etc.). Voc'#195#170' pode definir suas pr'#195#179'prias f'
  +'un'#195#167#195#181'es e procedimentos antes do bloco principal begin ... e'
  +'nd.\n"'#13#10'"\n"'#13#10'"Fun'#195#167#195#181'es dispon'#195#173'veis:\n"'
  +#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Recupera um valor de pa'
  +'r'#195#162'metro de entrada.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'
  +#13#10'"    Armazena um valor de sa'#195#173'da para o host.\n"'#13#10'"  Ge'
  +'tTimestamp() : Int64\n"'#13#10'"    Timestamp Unix atual em milissegundos ('
  +'UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    N'#195#186'mero'
  +' inteiro aleat'#195#179'rio com exatamente Length d'#195#173'gitos decimais'
  +'.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Float aleat'#195#179'rio no'
  +' intervalo [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10
  +'"    Converte um n'#195#186'mero inteiro em uma string hexadecimal com no m'
  +#195#173'nimo Digits caracteres.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10
  +'"    Converte uma string em um n'#195#186'mero inteiro. Levanta uma exce'
  +#195#167#195#163'o em caso de entrada inv'#195#161'lida.\n"'#13#10'"  IntToS'
  +'tr(Value) : string\n"'#13#10'"    Converte um n'#195#186'mero inteiro em su'
  +'a representa'#195#167#195#163'o em string.\n"'#13#10'"  Trim(S) : string\n"'
  +#13#10'"    Remove espa'#195#167'os em branco no in'#195#173'cio e no fim de'
  +' S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Remove espa'#195#167'o'
  +'s em branco no in'#195#173'cio de S.\n"'#13#10'"  TrimRight(S) : string\n"'
  +#13#10'"    Remove espa'#195#167'os em branco no fim de S.\n"'#13#10'"  Html'
  +'Encode(S) : string\n"'#13#10'"    Codifica caracteres especiais de HTML em '
  +'S para entidades.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decodi'
  +'fica entidades HTML em S de volta para caracteres.\n"'#13#10'"  UrlEncode(S'
  +') : string\n"'#13#10'"    Codifica S em percent-encoding para inclus'#195
  +#163'o segura em URLs.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Dec'
  +'odifica uma string S codificada em percent-encoding.\n"'#13#10'"  ReplaceAl'
  +'l(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Subs'
  +'titui todas as ocorr'#195#170'ncias de OldPattern por NewPattern em S.\n"'
  +#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    '
  +'Substitui todas as correspond'#195#170'ncias da express'#195#163'o regular '
  +'Pattern por Replacement em Input. N'#195#163'o diferencia mai'#195#186'scul'
  +'as de min'#195#186'sculas.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolea'
  ,'n\n"'#13#10'"    Verifica se Input corresponde ao padr'#195#163'o de expres'
  +'s'#195#163'o regular Pattern. Sem distin'#195#167#195#163'o entre mai'#195
  +#186'sculas e min'#195#186'sculas.\n"'#13#10'"  ExtractBetween(S, StartMarke'
  +'r, EndMarker) : string\n"'#13#10'"    Extrai a subcadeia de S entre StartMa'
  +'rker e EndMarker.\n"'#13#10'"\n"'#13#10'"Fun'#195#167#195#181'es JSON (use '
  +'um identificador retornado por JSONParse):\n"'#13#10'"  JSONParse(S) : Inte'
  +'iro\n"'#13#10'"    Analisa uma string JSON e retorna um identificador (>=0)'
  +'. Retorna -1 em caso de erro.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    '
  +'Libere o identificador ap'#195#179's o uso.\n"'#13#10'"  JSONGetString(Hand'
  +'le, Path) : string\n"'#13#10'"    Obt'#195#169'm um valor de string no cami'
  +'nho especificado.\n"'#13#10'"  JSONGetInt(Handle, Path) : Inteiro\n"'#13#10
  +'"    Obt'#195#169'm um valor inteiro no caminho especificado.\n"'#13#10'"  '
  +'JSONGetFloat(Handle, Path) : Estendido\n"'#13#10'"    Obt'#195#169'm um val'
  +'or de ponto flutuante no caminho especificado.\n"'#13#10'"  JSONGetBool(Han'
  +'dle, Path) : Booleano\n"'#13#10'"    Obt'#195#169'm um valor booleano no ca'
  +'minho especificado.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Inteiro\'
  +'n"'#13#10'"    Obt'#195#169'm o n'#195#186'mero de elementos em uma matriz '
  +'no Caminho especificado.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Inde'
  +'x) : string\n"'#13#10'"    Obt'#195#169'm o valor da string de um elemento '
  +'da matriz no '#195#141'ndice fornecido.\n"'#13#10'"  JSONGetArrayInt(Handle'
  +', Path, Index) : Inteiro\n"'#13#10'"    Obt'#195#169'm o valor inteiro de u'
  +'m elemento da matriz no '#195#141'ndice fornecido.\n"'#13#10'"  JSONGetType'
  +'(Handle, Path) : string\n"'#13#10'"    Retorna o tipo do valor em Path: \"o'
  +'bject\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'
  +#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Verifica se '
  +'o caminho especificado existe.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    I'
  +'nicializa uma matriz JSON vazia para criar um resultado de erro padr'#195
  +#163'o.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replacement'
  +'s)\n"'#13#10'"    Adiciona um objeto de erro '#195#160' matriz de resultado'
  +'s. Replacements '#195#169' uma sequ'#195#170'ncia de valores separados por '
  +'\"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"\n"'#13#10'"    Retor'
  +'na a matriz de resultados atual como uma sequ'#195#170'ncia JSON.\n"'#13#10
  +'"  JSONResultClear\n"'#13#10'"    Limpa a matriz de resultados.\n"'#13#10'"'
  +'  Sempre chame JSONFree para liberar o identificador depois de terminar.\n"'
  +#13#10'"\n"'#13#10'"Exemplo de trabalho com JSON:\n"'#13#10'"  var h: Intege'
  +'r;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONP'
  +'arse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    be'
  +'gin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"     '
  +' SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Par'#195#162'metros dispon'#195#173
  +'veis (recuperados com GetParam):\n"'#13#10'"  text - o texto de entrada a s'
  +'er processado (possivelmente truncado para MaxLength)\n"'#13#10'"  source -'
  +' c'#195#179'digo do idioma de origem (pode estar vazio)\n"'#13#10'"  target'
  +' - c'#195#179'digo do idioma de destino\n"'#13#10'"  timestamp - carimbo de'
  +' data/hora Unix atual em milissegundos (string)\n"'#13#10'"  random  - n'
  +#195#186'mero aleat'#195#179'rio de 9 d'#195#173'gitos (string)\n"'#13#10'" '
  +' rand - igual a random\n"'#13#10'"  rand1..rand9 - primeiros 1 a 9 d'#195
  +#173'gitos do n'#195#186'mero aleat'#195#179'rio\n"'#13#10'"\n"'#13#10'"Par'
  +#195#162'metros iniciais e personalizados adicionais tamb'#195#169'm est'#195
  +#163'o dispon'#195#173'veis."'#13#10#13#10'#: formconfig.rscriptresponsehint'
  +#13#10'msgid ""'#13#10'"This script processes the response data. All functio'
  +'ns and parameters described in the script hint are available here as well.\'
  +'n"'#13#10'"Use GetParam(''result'') to obtain the received text.\n"'#13#10
  +'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13
  +#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput(''result'', s);'
  +'\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define custom parameters '
  +'in the parameters script using SetParam(''name'', ''value''),\n"'#13#10'"an'
  +'d then retrieve them here with GetParam(''name'')."'#13#10'msgstr ""'#13#10
  +'"Este script processa os dados da resposta. Todas as fun'#195#167#195#181'e'
  +'s e par'#195#162'metros descritos na dica do script tamb'#195#169'm est'#195
  +#163'o dispon'#195#173'veis aqui.\n"'#13#10'"Use GetParam(''result'') para o'
  +'bter o texto recebido.\n"'#13#10'"\n"'#13#10'"Exemplo:\n"'#13#10'"  var s: '
  +'string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13
  +#10'"    SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  ,'Voc'#195#170' pode definir par'#195#162'metros personalizados no script de '
  +'par'#195#162'metros usando SetParam(''name'', ''value''),\n"'#13#10'"e depo'
  +'is recuper'#195#161'-los aqui com GetParam(''name'')."'#13#10#13#10'#: form'
  +'config.rvaluetype1'#13#10'msgctxt "formconfig.rvaluetype1"'#13#10'msgid "No'
  +'ne"'#13#10'msgstr "Vazio"'#13#10#13#10'#: formconfig.rvaluetype2'#13#10'msg'
