  +'nsehelp.hint'#13#10'msgctxt "tformconfigtrayslate.btnscriptresponsehelp.hin'
  +'t"'#13#10'msgid "Help"'#13#10'msgstr "Hj'#195#164'lp"'#13#10#13#10'#: tform'
  +'configtrayslate.btnscriptresponsetest.hint'#13#10'msgctxt "tformconfigtrays'
  +'late.btnscriptresponsetest.hint"'#13#10'msgid "Execute script and view the '
