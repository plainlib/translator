  +'msgid "Execute post request and view the result"'#10'msgstr "Ejecutar la so'
  +'licitud POST y ver el resultado"'#10#10'#: tformconfigtrayslate.btnresponse'
  +'help.hint'#10'msgctxt "tformconfigtrayslate.btnresponsehelp.hint"'#10'msgid'
