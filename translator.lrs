  +'d "Script Processing the Response"'#10'msgstr "Pemrosesan Respons dengan Sk'
  +'rip"'#10#10'#: tformconfigtrayslate.imagepreview.hint'#10'msgid "Click to s'
  +'elect the config icon, Middle-Click clears the icon"'#10'msgstr "Klik untuk'
  +' memilih ikon konfigurasi, Middle-Click menghapus ikon"'#10#10'#: tformconf'
  +'igtrayslate.labelaccept.caption'#10'msgid "Accept"'#10'msgstr "Accept"'#10
