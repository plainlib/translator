  +'slate.labelurl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10'#: tformcon'
  +'figtrayslate.labeluseragent.caption'#10'msgctxt "tformconfigtrayslate.label'
  +'useragent.caption"'#10'msgid "User Agent"'#10'msgstr "User Agent"'#10#10'#:'
  +' tformconfigtrayslate.labelvaluetype.caption'#10'msgid "Value Type"'#10'msg'
  +'str "'#234#176#146' '#236#156#160#237#152#149'"'#10#10'#: tformconfigtraysl'
  +'ate.pageinitialrequest.caption'#10'msgctxt "tformconfigtrayslate.pageinitia'
  +'lrequest.caption"'#10'msgid "Initial Request"'#10'msgstr "'#236#180#136#234
