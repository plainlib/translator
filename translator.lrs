  ,#13#10'"  target - k'#195#179'd c'#195#173'lov'#195#169'ho jazyka\n"'#13#10
  +'"  timestamp - aktu'#195#161'ln'#195#173' '#196#141'asov'#195#169' raz'#195
  +#173'tko Unix v milisekund'#195#161'ch ('#197#153'et'#196#155'zec)\n"'#13#10
  +'"  random  - n'#195#161'hodn'#195#169' 9m'#195#173'stn'#195#169' '#196#141
  +#195#173'slo ('#197#153'et'#196#155'zec)\n"'#13#10'"  rand - tot'#195#169#197
  +#190' co random\n"'#13#10'"  rand1..rand9 - prvn'#195#173'ch 1..9 '#196#141
  +#195#173'slic n'#195#161'hodn'#195#169'ho '#196#141#195#173'sla\n"'#13#10'"\'
  +'n"'#13#10'"K dispozici jsou tak'#195#169' dal'#197#161#195#173' po'#196#141
  +#195#161'te'#196#141'n'#195#173' a vlastn'#195#173' parametry."'#13#10#13#10
  +'#: formconfig.rscriptresponsehint'#13#10'msgid ""'#13#10'"This script proce'
