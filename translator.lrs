  +'kservicerealtime.caption'#10'msgid "Allow translate as you type"'#10'msgstr'
  +' "Salli k'#195#164#195#164'nn'#195#182's kirjoittaessasi"'#10#10'#: tformco'
  +'nfigtrayslate.checkservicevisible.caption'#10'msgid "Visible in menu"'#10'm'
  +'sgstr "N'#195#164'kyy valikossa"'#10#10'#: tformconfigtrayslate.combomethod'
  +'.text'#10'msgid "GET"'#10'msgstr "GET"'#10#10'#: tformconfigtrayslate.combo'
  +'valuetype.text'#10'msgctxt "tformconfigtrayslate.combovaluetype.text"'#10'm'
  +'sgid "None"'#10'msgstr "Ei mit'#195#164#195#164'n"'#10#10'#: tformconfigtra'
  +'yslate.groupboxcustomparameters.caption'#10'msgid "Custom Parameters"'#10'm'
  +'sgstr "Mukautetut parametrit"'#10#10'#: tformconfigtrayslate.groupboxservic'
  +'e.caption'#10'msgctxt "tformconfigtrayslate.groupboxservice.caption"'#10'ms'
  +'gid "Service"'#10'msgstr "Palvelu"'#10#10'#: tformconfigtrayslate.groupinit'
  +'parameters.caption'#10'msgctxt "tformconfigtrayslate.groupinitparameters.ca'
  +'ption"'#10'msgid "Initial Request"'#10'msgstr "Alkupyynt'#195#182'"'#10#10
  +'#: tformconfigtrayslate.grouplanguages.caption'#10'msgctxt "tformconfigtray'
  +'slate.grouplanguages.caption"'#10'msgid "Languages"'#10'msgstr "Kielet"'#10
  +#10'#: tformconfigtrayslate.grouplanguagestarget.caption'#10'msgctxt "tformc'
  +'onfigtrayslate.grouplanguagestarget.caption"'#10'msgid "Target Languages"'
  +#10'msgstr "Kohdekielet"'#10#10'#: tformconfigtrayslate.grouprequest.caption'
  +#10'msgctxt "tformconfigtrayslate.grouprequest.caption"'#10'msgid "Request"'
  +#10'msgstr "Pyynt'#195#182'"'#10#10'#: tformconfigtrayslate.groupresponse.ca'
  +'ption'#10'msgid "Json Pointer Processing the Response"'#10'msgstr "Vastauks'
  +'en k'#195#164'sittely Json Pointer -toiminnolla"'#10#10'#: tformconfigtrays'
  +'late.groupscript.caption'#10'msgid "Script Retrieved Parameters"'#10'msgstr'
  +' "Skriptin hakemat parametrit"'#10#10'#: tformconfigtrayslate.groupscriptre'
  +'sponse.caption'#10'msgid "Script Processing the Response"'#10'msgstr "Vasta'
  +'uksen k'#195#164'sittely komentosarjalla"'#10#10'#: tformconfigtrayslate.im'
  +'agepreview.hint'#10'msgid "Click to select the config icon, Middle-Click cl'
