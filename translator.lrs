  +#235#182#132'."'#10#10'#: tformconfigtrayslate.labellanguagestarget.caption'
  +#10'msgid ""'#10'"Target languages e.g. en=en-US, en - internal, en-US - ser'
  +'vice code.\n"'#10'"If not specified, both source and target languages are t'
  +'aken from the languages section."'#10'msgstr ""'#10'"'#235#140#128#236#131
  +#129' '#236#150#184#236#150#180' ('#236#152#136': en=en-US, en - '#235#130
  +#180#235#182#128', en-US - '#236#132#156#235#185#132#236#138#164' '#236#189
