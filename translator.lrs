LazarusResources.Add('formconfig.tr','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: tr\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Yap'#196#177'land'#196#177'rma D'#195#188'zenleyici"'#13#10#13#10'#: form'
  +'config.rclearlanguages'#13#10'msgid "The list is already filled. Do you wan'
  +'t to clear it?"'#13#10'msgstr "Liste zaten dolu. Temizlemek istiyor musunuz'
  +'?"'#13#10#13#10'#: formconfig.rconfigeditor'#13#10'msgid "Config Editor..."'
  +#13#10'msgstr "Yap'#196#177'land'#196#177'rma D'#195#188'zenleyici..."'#13#10
  +#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you sure you want to de'
  +'lete config"'#13#10'msgstr "Yap'#196#177'land'#196#177'rmay'#196#177' silme'
  +'k istedi'#196#159'inizden emin misiniz"'#13#10#13#10'#: formconfig.rdeletec'
  +'onfigcaption'#13#10'msgid "Delete config"'#13#10'msgstr "Yap'#196#177'land'
  +#196#177'rmay'#196#177' sil"'#13#10#13#10'#: formconfig.rfilechangedcancel'
  +#13#10'msgid "Cancel"'#13#10'msgstr "'#196#176'ptal"'#13#10#13#10'#: formcon'
  +'fig.rfilechangedkeepchanges'#13#10'msgid "Keep my changes"'#13#10'msgstr "D'
  +'e'#196#159'i'#197#159'ikliklerimi koru"'#13#10#13#10'#: formconfig.rfilecha'
  +'ngedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The file \"%s\" has be'
  +'en modified by another application since it was opened."'#13#10'msgstr "\"%'
  +'s\" dosyas'#196#177' a'#195#167#196#177'ld'#196#177'ktan sonra ba'#197#159
  +'ka bir uygulama taraf'#196#177'ndan de'#196#159'i'#197#159'tirildi."'#13#10
  +#13#10'#: formconfig.rfilechangedmsgactivate'#13#10'msgid "You have unsaved '
  +'changes. Keep them or reload from disk?"'#13#10'msgstr "Kaydedilmemi'#197
  +#159' de'#196#159'i'#197#159'iklikleriniz var. Bunlar'#196#177' korumak m'
  +#196#177' yoksa dosyay'#196#177' diskten yeniden y'#195#188'klemek mi istiyo'
  +'rsunuz?"'#13#10#13#10'#: formconfig.rfilechangedreloaddisk'#13#10'msgid "Re'
  +'load from disk"'#13#10'msgstr "Diskten yeniden y'#195#188'kle"'#13#10#13#10
  +'#: formconfig.rfilechangedtitle'#13#10'msgid "File changed on disk"'#13#10
  +'msgstr "Dosya diskte de'#196#159'i'#197#159'tirildi"'#13#10#13#10'#: formco'
  +'nfig.rnamequestion'#13#10'msgid "Enter new config file name:"'#13#10'msgstr'
  +' "Yeni yap'#196#177'land'#196#177'rma dosyas'#196#177' ad'#196#177'n'#196
  +#177' girin:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The configu'
  +'ration was modified. Save changes?"'#13#10'msgstr "Yap'#196#177'land'#196
  +#177'rma de'#196#159'i'#197#159'tirildi. De'#196#159'i'#197#159'iklikler kay'
  +'dedilsin mi?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgid ""'#13
  +#10'"Json Pointer: Use / for levels, keys for objects, and numbers for index'
  +'es.\n"'#13#10'"Use * for all items, *#10 to join items by newline. Use ~ at'
  +' the end of the path to return the raw JSON branch.\n"'#13#10'"Separate mul'
  +'tiple segments with semicolon ;.\n"'#13#10'"Literal: Text block in {'#226
  +#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to extract da'
  +'ta directly into the text.\n"'#13#10'"Logic: If a Pointer in a segment is e'
  +'mpty, the whole segment is skipped. If a segment has no Pointer, only liter'
  +'al text blocks with embedded regular expressions are processed.\n"'#13#10'"'
  +'Regex: {prefix {regex[index]} suffix} inside a text block. If no [index] is'
  +' specified, the first match is used.\n"'#13#10'"Index can be a number, [*] '
  +'(join by space), or [*#10] (join by newline). If the regex finds no match, '
  +'the entire {'#226#128#166'} block is removed.\n"'#13#10'"Using ~ inside a r'
  +'egex returns the entire text.\n"'#13#10'"Inversion: Start a segment with ! '
  +'(e.g. !/path{Error}) to show its text only if the Pointer data is missing o'
  +'r the JSON is invalid.\n"'#13#10'"Commenting: /* text */ comments are strip'
  +'ped from the entire expression before any processing.\n"'#13#10'"Examples:\'
  +'n"'#13#10'"responseData/translatedText; matches/*#10/translation; /texts/te'
  +'xt; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Err'
  +'or: No data!#10}; /translations/0/text"'#13#10'msgstr ""'#13#10'"JSON Point'
  +'er: Seviyeler i'#195#167'in /, nesneler i'#195#167'in anahtarlar ve dizinle'
  +'r i'#195#167'in say'#196#177'lar kullan'#196#177'n. T'#195#188'm '#195#182
  +#196#159'eler i'#195#167'in * ve '#195#182#196#159'eleri yeni sat'#196#177'r'
  +'la birle'#197#159'tirmek i'#195#167'in *#10 kullan'#196#177'n. Ham JSON dal'
  +#196#177'n'#196#177' d'#195#182'nd'#195#188'rmek i'#195#167'in yolun sonunda'
  +' ~ kullan'#196#177'n. Birden fazla segmenti noktal'#196#177' virg'#195#188
  +'l ; ile ay'#196#177'r'#196#177'n.\n"'#13#10'"Literal: {'#226#128#166'} i'
  ,#195#167'indeki metin blo'#196#159'u. Yeni sat'#196#177'rlar i'#195#167'in '
  +#195#182'zel etiket #10. Verileri do'#196#159'rudan metne '#195#167#196#177
  +'karmak i'#195#167'in i'#195#167'inde {{regex}} kullan'#196#177'n.\n"'#13#10
  +'"Mant'#196#177'k: Bir segmentteki Pointer bo'#197#159'sa, t'#195#188'm segm'
  +'ent atlan'#196#177'r. Bir segmentte Pointer yoksa yaln'#196#177'zca g'#195
  +#182'm'#195#188'l'#195#188' d'#195#188'zenli ifadeler i'#195#167'eren litera'
  +'l metin bloklar'#196#177' i'#197#159'lenir.\n"'#13#10'"Regex: Bir metin blo'
  +#196#159'u i'#195#167'inde {'#195#182'n ek {regex[index]} son ek}. [index] b'
  +'elirtilmezse ilk e'#197#159'le'#197#159'me kullan'#196#177'l'#196#177'r. '
  +#196#176'ndeks bir say'#196#177', [*] (bo'#197#159'lukla birle'#197#159'tir)'
  +' veya [*#10] (yeni sat'#196#177'rla birle'#197#159'tir) olabilir. D'#195#188
  +'zenli ifade e'#197#159'le'#197#159'me bulamazsa, t'#195#188'm {'#226#128#166
  +'} blo'#196#159'u kald'#196#177'r'#196#177'l'#196#177'r. D'#195#188'zenli if'
  +'ade i'#195#167'inde ~ kullan'#196#177'lmas'#196#177' t'#195#188'm metni d'
  +#195#182'nd'#195#188'r'#195#188'r.\n"'#13#10'"Tersine '#195#167'evirme: Bir '
  +'segmenti ! ile ba'#197#159'lat'#196#177'n ('#195#182'rne'#196#159'in !/path'
  +'{Error}); b'#195#182'ylece metni yaln'#196#177'zca Pointer verisi eksikse v'
  +'eya JSON ge'#195#167'ersizse g'#195#182'sterilir.\n"'#13#10'"Yorumlar: /* m'
  +'etin */ yorumlar'#196#177', herhangi bir i'#197#159'lem yap'#196#177'lmadan'
  +' '#195#182'nce t'#195#188'm ifadeden kald'#196#177'r'#196#177'l'#196#177'r.'
  +'\n"'#13#10'"'#195#150'rnekler:\n"'#13#10'"responseData/translatedText; matc'
  +'hes/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ '
  +'({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#13#10#13#10
  +'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"The script is a standard '
  +'Pascal program: optional var section, then a main begin ... end. block.\n"'
  +#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\'
  +'n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, '
  +'''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  e'
  +'nd.\n"'#13#10'"\n"'#13#10'"You can also use standard Pascal constructs (if,'
  +' for, while, repeat, etc.). You can define your own functions and procedure'
  +'s before the main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Available fu'
  +'nctions:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Retrieve a'
  +'n input parameter value.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13
  +#10'"    Store an output value for the host.\n"'#13#10'"  GetTimestamp() : I'
  +'nt64\n"'#13#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#13#10
  +'"  GetRandom(Length) : Int64\n"'#13#10'"    Random integer with exactly Len'
  +'gth decimal digits.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random fl'
  +'oat in the range [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'
  +#13#10'"    Convert integer to hexadecimal string with at least Digits chara'
  +'cters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convert a string t'
  +'o an integer. Raises an exception on invalid input.\n"'#13#10'"  IntToStr(V'
  +'alue) : string\n"'#13#10'"    Convert an integer to its string representati'
  +'on.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove leading and trailin'
  +'g whitespace from S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Remov'
  +'e leading whitespace from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"'
  +'    Remove trailing whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string\'
  +'n"'#13#10'"    Encode special HTML characters in S into entities.\n"'#13#10
  +'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTML entities in S back to '
  +'characters.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encod'
  +'e S for safe URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'" '
  +'   Decode a percent-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern'
  +', NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Replace all occurre'
  +'nces of OldPattern with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, P'
  +'attern, Replacement) : string\n"'#13#10'"    Replace all regex matches of P'
  +'attern with Replacement in Input. Case-insensitive.\n"'#13#10'"  RegexMatch'
  +'(Input, Pattern) : Boolean\n"'#13#10'"    Check if Input matches the regex '
  +'Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndM'
  +'arker) : string\n"'#13#10'"    Extract the substring of S between StartMark'
  +'er and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a handle retur'
  +'ned by JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse'
  +' a JSON string and return a handle (>=0). Returns -1 on error.\n"'#13#10'" '
  +' JSONFree(Handle)\n"'#13#10'"    Release the handle after use.\n"'#13#10'" '
  +' JSONGetString(Handle, Path) : string\n"'#13#10'"    Get a string value at '
  +'the specified Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13
  ,#10'"    Get an integer value at the specified Path.\n"'#13#10'"  JSONGetFlo'
  +'at(Handle, Path) : Extended\n"'#13#10'"    Get a floating-point value at th'
  +'e specified Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10
  +'"    Get a boolean value at the specified Path.\n"'#13#10'"  JSONGetArrayCo'
  +'unt(Handle, Path) : Integer\n"'#13#10'"    Get the number of elements in an'
  +' array at the specified Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path,'
  +' Index) : string\n"'#13#10'"    Get the string value of an array element at'
  +' the given Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integ'
  +'er\n"'#13#10'"    Get the integer value of an array element at the given In'
  +'dex.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Return '
  +'the type of the value at Path: \"object\", \"array\", \"string\", \"int\", '
  +'\"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : '
  +'Boolean\n"'#13#10'"    Check if the specified Path exists.\n"'#13#10'"  JSO'
  +'NResultInit\n"'#13#10'"    Initialize an empty JSON array for building a st'
  +'andard error result.\n"'#13#10'"  JSONResultAddError(Offset, Length, Messag'
  +'e, Replacements)\n"'#13#10'"    Add an error object to the result array. Re'
  +'placements is a string of values separated by \"|\".\n"'#13#10'"  JSONResul'
  +'tGet : string\n"'#13#10'"    Return the current result array as a JSON stri'
  +'ng.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Clear the result array.\n"'
  +#13#10'"  Always call JSONFree to release the handle after you are done.\n"'
  +#13#10'"\n"'#13#10'"Example of working with JSON:\n"'#13#10'"  var h: Intege'
  +'r;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONP'
  +'arse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    be'
  +'gin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"     '
  +' SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Available parameters (retrieved wi'
  +'th GetParam):\n"'#13#10'"  text - the input text to process (possibly trunc'
  +'ated to MaxLength)\n"'#13#10'"  source - source language code (may be empty'
  +')\n"'#13#10'"  target - target language code\n"'#13#10'"  timestamp - curre'
  +'nt Unix timestamp in milliseconds (string)\n"'#13#10'"  random  - 9-digit r'
  +'andom number (string)\n"'#13#10'"  rand - same as random\n"'#13#10'"  rand1'
  +'..rand9 - first 1..9 digits of the random number\n"'#13#10'"\n"'#13#10'"Add'
  +'itional initial and custom parameters are also available."'#13#10'msgstr ""'
  +#13#10'"Betik standart bir Pascal program'#196#177'd'#196#177'r: iste'#196
  +#159'e ba'#196#159'l'#196#177' bir var b'#195#182'l'#195#188'm'#195#188' ve '
  +'ard'#196#177'ndan bir ana begin ... end. blo'#196#159'u bulunur.\n"'#13#10
  +'"\n"'#13#10'"'#195#150'rnek:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin'
  +'\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, '
  +'''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  e'
  +'nd.\n"'#13#10'"\n"'#13#10'"Standart Pascal yap'#196#177'lar'#196#177' da ku'
  +'llan'#196#177'labilir (if, for, while, repeat vb.). Ana begin ... end. blo'
  +#196#159'undan '#195#182'nce kendi i'#197#159'levlerinizi ve yordamlar'#196
  +#177'n'#196#177'z'#196#177' tan'#196#177'mlayabilirsiniz.\n"'#13#10'"\n"'#13
  +#10'"Kullan'#196#177'labilir i'#197#159'levler:\n"'#13#10'"  GetParam(''name'
  +''') : string\n"'#13#10'"    Bir giri'#197#159' parametresinin de'#196#159'e'
  +'rini al'#196#177'r.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"'
  +'    Ana bilgisayar i'#195#167'in bir '#195#167#196#177'kt'#196#177' de'#196
  +#159'eri kaydeder.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Ge'#195
  +#167'erli Unix zaman damgas'#196#177'n'#196#177' milisaniye cinsinden d'#195
  +#182'nd'#195#188'r'#195#188'r (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\'
  +'n"'#13#10'"    Tam olarak Length ondal'#196#177'k basamak i'#195#167'eren r'
  +'astgele bir tam say'#196#177' d'#195#182'nd'#195#188'r'#195#188'r.\n"'#13#10
  +'"  Random : Extended\n"'#13#10'"    [0, 1) aral'#196#177#196#159#196#177'nd'
  +'a rastgele bir kayan noktal'#196#177' say'#196#177' d'#195#182'nd'#195#188
  +'r'#195#188'r.\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    '
  +'Bir tam say'#196#177'y'#196#177' en az Digits karakter i'#195#167'eren onal'
  +'t'#196#177'l'#196#177'k bir dizeye d'#195#182'n'#195#188#197#159't'#195#188
  +'r'#195#188'r.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Bir dizeyi '
  +'tam say'#196#177'ya d'#195#182'n'#195#188#197#159't'#195#188'r'#195#188'r. '
  +'Ge'#195#167'ersiz giri'#197#159'te bir istisna olu'#197#159'turur.\n"'#13#10
  +'"  IntToStr(Value) : string\n"'#13#10'"    Bir tam say'#196#177'y'#196#177
  +' dize g'#195#182'sterimine d'#195#182'n'#195#188#197#159't'#195#188'r'#195
  +#188'r.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    S''nin ba'#197#159#196
  +#177'ndaki ve sonundaki bo'#197#159'luklar'#196#177' kald'#196#177'r'#196#177
  ,'r.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    S''nin ba'#197#159#196
  +#177'ndaki bo'#197#159'luklar'#196#177' kald'#196#177'r'#196#177'r.\n"'#13#10
  +'"  TrimRight(S) : string\n"'#13#10'"    S''nin sonundaki bo'#197#159'luklar'
  +#196#177' kald'#196#177'r'#196#177'r.\n"'#13#10'"  HtmlEncode(S) : string\n"'
  +#13#10'"    S i'#195#167'indeki '#195#182'zel HTML karakterlerini varl'#196
  +#177'klara d'#195#182'n'#195#188#197#159't'#195#188'r'#195#188'r.\n"'#13#10
  +'"  HtmlDecode(S) : string\n"'#13#10'"    S i'#195#167'indeki HTML varl'#196
  +#177'klar'#196#177'n'#196#177' tekrar karakterlere d'#195#182'n'#195#188#197
  +#159't'#195#188'r'#195#188'r.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"'
  +'    S''yi URL i'#195#167'inde g'#195#188'venli '#197#159'ekilde kullan'#196
  +#177'labilmesi i'#195#167'in y'#195#188'zde kodlamas'#196#177'yla kodlar.\n"'
  +#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Y'#195#188'zde kodlamas'#196
  +#177'yla kodlanm'#196#177#197#159' S dizesini '#195#167#195#182'zer.\n"'#13
  +#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'
  +#13#10'"    S i'#195#167'indeki t'#195#188'm OldPattern olu'#197#159'umlar'
  +#196#177'n'#196#177' NewPattern ile de'#196#159'i'#197#159'tirir.\n"'#13#10
  +'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    Input '
  +'i'#195#167'indeki Pattern d'#195#188'zenli ifadesiyle e'#197#159'le'#197#159
  +'en t'#195#188'm b'#195#182'l'#195#188'mleri Replacement ile de'#196#159'i'
  +#197#159'tirir. B'#195#188'y'#195#188'k/k'#195#188#195#167#195#188'k harf du'
  +'yarl'#196#177' de'#196#159'ildir.\n"'#13#10'"  RegexMatch(Input, Pattern) :'
  +' Boolean\n"'#13#10'"    Input''un Pattern d'#195#188'zenli ifadesiyle e'#197
  +#159'le'#197#159'ip e'#197#159'le'#197#159'medi'#196#159'ini kontrol eder. B'
  +#195#188'y'#195#188'k/k'#195#188#195#167#195#188'k harf duyarl'#196#177' de'
  +#196#159'ildir.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) : str'
  +'ing\n"'#13#10'"    S i'#195#167'indeki StartMarker ile EndMarker aras'#196
  +#177'ndaki alt dizeyi '#195#167#196#177'kar'#196#177'r.\n"'#13#10'"\n"'#13#10
  +'"JSON i'#197#159'levleri (JSONParse taraf'#196#177'ndan d'#195#182'nd'#195
  +#188'r'#195#188'len bir handle kullan'#196#177'n):\n"'#13#10'"  JSONParse(S)'
  +' : Integer\n"'#13#10'"    Bir JSON dizesini ayr'#196#177#197#159't'#196#177
  +'r'#196#177'r ve bir handle (>=0) d'#195#182'nd'#195#188'r'#195#188'r. Hata '
  +'durumunda -1 d'#195#182'nd'#195#188'r'#195#188'r.\n"'#13#10'"  JSONFree(Han'
  +'dle)\n"'#13#10'"    Kullan'#196#177'mdan sonra handle'''#196#177' serbest b'
  +#196#177'rak'#196#177'r.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n'
  +'"'#13#10'"    Belirtilen Path konumundaki dize de'#196#159'erini al'#196#177
  +'r.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    Belirtile'
  +'n Path konumundaki tam say'#196#177' de'#196#159'erini al'#196#177'r.\n"'#13
  +#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Belirtilen Path '
  +'konumundaki kayan noktal'#196#177' de'#196#159'eri al'#196#177'r.\n"'#13#10
  +'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Belirtilen Path konum'
  +'undaki boolean de'#196#159'erini al'#196#177'r.\n"'#13#10'"  JSONGetArrayCo'
  +'unt(Handle, Path) : Integer\n"'#13#10'"    Belirtilen Path konumundaki dizi'
  +'nin eleman say'#196#177's'#196#177'n'#196#177' al'#196#177'r.\n"'#13#10'"  '
  +'JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Belirtilen '
  +'Index konumundaki dizi eleman'#196#177'n'#196#177'n dize de'#196#159'erini '
  +'al'#196#177'r.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\'
  +'n"'#13#10'"    Belirtilen Index konumundaki dizi eleman'#196#177'n'#196#177
  +'n tam say'#196#177' de'#196#159'erini al'#196#177'r.\n"'#13#10'"  JSONGetTy'
  +'pe(Handle, Path) : string\n"'#13#10'"    Path konumundaki de'#196#159'erin '
  +'t'#195#188'r'#195#188'n'#195#188' d'#195#182'nd'#195#188'r'#195#188'r: \"ob'
  +'ject\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'
  +#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Belirtilen P'
  +'ath konumunun mevcut olup olmad'#196#177#196#159#196#177'n'#196#177' kontro'
  +'l eder.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Standart bir hata sonucu'
  +' olu'#197#159'turmak i'#195#167'in bo'#197#159' bir JSON dizisi ba'#197#159
  +'lat'#196#177'r.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Re'
  +'placements)\n"'#13#10'"    Sonu'#195#167' dizisine bir hata nesnesi ekler. '
  +'Replacements, \"|\" karakteriyle ayr'#196#177'lm'#196#177#197#159' de'#196
  +#159'erlerden olu'#197#159'an bir dizedir.\n"'#13#10'"  JSONResultGet : stri'
  +'ng\n"'#13#10'"    Ge'#195#167'erli sonu'#195#167' dizisini JSON dizesi olar'
  +'ak d'#195#182'nd'#195#188'r'#195#188'r.\n"'#13#10'"  JSONResultClear\n"'#13
  +#10'"    Sonu'#195#167' dizisini temizler.\n"'#13#10'"  '#196#176#197#159'in'
  +'iz bittikten sonra handle'''#196#177' serbest b'#196#177'rakmak i'#195#167
  +'in her zaman JSONFree '#195#167'a'#196#159'r'#196#177's'#196#177'n'#196#177
  ,' yap'#196#177'n.\n"'#13#10'"\n"'#13#10'"JSON ile '#195#167'al'#196#177#197
  +#159'ma '#195#182'rne'#196#159'i:\n"'#13#10'"  var h: Integer;\n"'#13#10'"  '
  +'    s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam('''
  +'result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'" '
  +'     s := JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''tex'
  +'t'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end'
  +'.\n"'#13#10'"\n"'#13#10'"Kullan'#196#177'labilir parametreler (GetParam ile'
  +' al'#196#177'n'#196#177'r):\n"'#13#10'"  text - i'#197#159'lenecek giri'#197
  +#159' metni (MaxLength de'#196#159'erine kadar k'#196#177'salt'#196#177'lm'
  +#196#177#197#159' olabilir)\n"'#13#10'"  source - kaynak dil kodu (bo'#197
  +#159' olabilir)\n"'#13#10'"  target - hedef dil kodu\n"'#13#10'"  timestamp '
  +'- ge'#195#167'erli Unix zaman damgas'#196#177', milisaniye cinsinden (dize)'
  +'\n"'#13#10'"  random  - 9 basamakl'#196#177' rastgele say'#196#177' (dize)\'
  +'n"'#13#10'"  rand - random ile ayn'#196#177'd'#196#177'r\n"'#13#10'"  rand1'
  +'..rand9 - rastgele say'#196#177'n'#196#177'n ilk 1..9 basama'#196#159#196
  +#177'\n"'#13#10'"\n"'#13#10'"Ek ba'#197#159'lang'#196#177#195#167' ve '#195
  +#182'zel parametreler de kullan'#196#177'labilir."'#13#10#13#10'#: formconfi'
  +'g.rscriptresponsehint'#13#10'msgid ""'#13#10'"This script processes the res'
  +'ponse data. All functions and parameters described in the script hint are a'
  +'vailable here as well.\n"'#13#10'"Use GetParam(''result'') to obtain the re'
  +'ceived text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    Set'
  +'Output(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can def'
  +'ine custom parameters in the parameters script using SetParam(''name'', ''v'
  +'alue''),\n"'#13#10'"and then retrieve them here with GetParam(''name'')."'
  +#13#10'msgstr ""'#13#10'"Bu betik yan'#196#177't verilerini i'#197#159'ler. '
  +'Betik ipucunda a'#195#167#196#177'klanan t'#195#188'm i'#197#159'levler ve '
  +'parametreler burada da kullan'#196#177'labilir.\n"'#13#10'"Al'#196#177'nan '
  +'metni elde etmek i'#195#167'in GetParam(''result'') kullan'#196#177'n.\n"'
  +#13#10'"\n"'#13#10'"'#195#150'rnek:\n"'#13#10'"  var s: string;\n"'#13#10'" '
  +' begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput('
  +'''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Parametre beti'#196
  +#159'inde SetParam(''name'', ''value'') kullanarak '#195#182'zel parametrele'
  +'r tan'#196#177'mlayabilir,\n"'#13#10'"ard'#196#177'ndan bunlar'#196#177' bu'
  +'rada GetParam(''name'') ile alabilirsiniz."'#13#10#13#10'#: formconfig.rval'
  +'uetype1'#13#10'msgctxt "formconfig.rvaluetype1"'#13#10'msgid "None"'#13#10
  +'msgstr "Yok"'#13#10#13#10'#: formconfig.rvaluetype2'#13#10'msgid "Language"'
  +#13#10'msgstr "Dil"'#13#10#13#10'#: formconfig.rvaluetype3'#13#10'msgid "Cur'
  +'rency All"'#13#10'msgstr "T'#195#188'm para birimleri"'#13#10#13#10'#: form'
  +'config.rvaluetype4'#13#10'msgid "Currency Fiat Only"'#13#10'msgstr "Sadece '
  +'fiat para birimleri"'#13#10#13#10'#: formconfig.rvaluetype5'#13#10'msgid "C'
