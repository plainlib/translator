LazarusResources.Add('formconfig.nl','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: nl\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Configuratie-editor"'#10#10'#: formconfig.rclearlanguages'#10'msgid'
  +' "The list is already filled. Do you want to clear it?"'#10'msgstr "De lijs'
  +'t is al gevuld. Wilt u deze leegmaken?"'#10#10'#: formconfig.rdeleteconfig'
  +#10'msgid "Are you sure you want to delete config"'#10'msgstr "Weet u zeker '
  +'dat u de configuratie wilt verwijderen"'#10#10'#: formconfig.rdeleteconfigc'
  +'aption'#10'msgid "Delete config"'#10'msgstr "Configuratie verwijderen"'#10
  +#10'#: formconfig.rnamequestion'#10'msgid "Enter new config file name:"'#10
  +'msgstr "Voer de naam van het nieuwe configuratiebestand in:"'#10#10'#: form'
  +'config.rneedsave'#10'msgid "The configuration was modified. Save changes?"'
  +#10'msgstr "De configuratie is gewijzigd. Wijzigingen opslaan?"'#10#10'#: fo'
  +'rmconfig.rresponsehint'#10'msgid ""'#10'"Json Pointer: Use / for levels, ke'
  +'ys for objects, and numbers for indexes.\n"'#10'"Use * for all items, *#10 '
  +'to join items by newline. Use ~ at the end of the path to return the raw JS'
  +'ON branch.\n"'#10'"Separate multiple segments with semicolon ;.\n"'#10'"Lit'
  +'eral: Text block in {'#226#128#166'}. Special tag #10 for newlines. Use {{r'
  +'egex}} inside to extract data directly into the text.\n"'#10'"Logic: If a P'
  +'ointer in a segment is empty, the whole segment is skipped. If a segment ha'
  +'s no Pointer, only literal text blocks with embedded regular expressions ar'
  +'e processed.\n"'#10'"Regex: {prefix {regex[index]} suffix} inside a text bl'
  +'ock. If no [index] is specified, the first match is used.\n"'#10'"Index can'
  +' be a number, [*] (join by space), or [*#10] (join by newline). If the rege'
  +'x finds no match, the entire {'#226#128#166'} block is removed.\n"'#10'"Usi'
  +'ng ~ inside a regex returns the entire text.\n"'#10'"Inversion: Start a seg'
  +'ment with ! (e.g. !/path{Error}) to show its text only if the Pointer data '
  +'is missing or the JSON is invalid.\n"'#10'"Commenting: /* text */ comments '
  +'are stripped from the entire expression before any processing.\n"'#10'"Exam'
  +'ples:\n"'#10'"responseData/translatedText; matches/*#10/translation; /texts'
  +'/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{'
  +'Error: No data!#10}; /translations/0/text"'#10'msgstr ""'#10'"JSON Pointer:'
  +' Gebruik / voor niveaus, sleutels voor objecten en cijfers voor indexen. Ge'
  +'bruik * voor alle items en *#10 om items met een nieuwe regel samen te voeg'
  +'en. Gebruik ~ aan het einde van het pad om de onbewerkte JSON-tak terug te '
  +'geven. Scheid meerdere segmenten met puntkomma ;.\n"'#10'"Letterlijk: Tekst'
  +'blok in {'#226#128#166'}. Speciale tag #10 voor nieuwe regels. Gebruik {{re'
  +'gex}} erin om gegevens rechtstreeks in de tekst te extraheren.\n"'#10'"Logi'
  +'ca: Als een Pointer in een segment leeg is, wordt het hele segment overgesl'
  +'agen. Als een segment geen Pointer heeft, worden alleen letterlijke tekstbl'
  +'okken met ingebedde reguliere expressies verwerkt.\n"'#10'"Regex: {voorvoeg'
  +'sel {regex[index]} achtervoegsel} binnen een tekstblok. Als [index] niet is'
  +' opgegeven, wordt de eerste overeenkomst gebruikt. Index kan een getal zijn'
  +', [*] (samenvoegen met spatie) of [*#10] (samenvoegen met nieuwe regel). Al'
  +'s de reguliere expressie geen overeenkomst vindt, wordt het volledige {'#226
  +#128#166'}-blok verwijderd. Het gebruik van ~ binnen een reguliere expressie'
  +' retourneert de volledige tekst.\n"'#10'"Inversie: Begin een segment met ! '
  +'(bijvoorbeeld !/path{Error}) om de tekst ervan alleen weer te geven als de '
  +'Pointer-gegevens ontbreken of de JSON ongeldig is.\n"'#10'"Commentaar: /* t'
  +'ekst */-commentaren worden uit de volledige expressie verwijderd voordat en'
  +'ige verwerking plaatsvindt.\n"'#10'"Voorbeelden:\n"'#10'"responseData/trans'
  +'latedText; matches/*#10/translation; /texts/text; {literal text#10}; /resul'
  +'t/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translatio'
  +'ns"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a stan'
  +'dard Pascal program: optional var section, then a main begin ... end. block'
  +'.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10
  +'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', '
  +'False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10
  +'"You can also use standard Pascal constructs (if, for, while, repeat, etc.)'
  +'. You can define your own functions and procedures before the main begin ..'
  +'. end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''na'
  ,'me'') : string\n"'#10'"    Retrieve an input parameter value.\n"'#10'"  Set'
  +'Output(''name'', ''value'')\n"'#10'"    Store an output value for the host.'
  +'\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timestamp in mil'
  +'liseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random int'
  +'eger with exactly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10
  +'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : '
  +'string\n"'#10'"    Convert integer to hexadecimal string with at least Digi'
  +'ts characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string'
  +' to an integer. Raises an exception on invalid input.\n"'#10'"  IntToStr(Va'
  +'lue) : string\n"'#10'"    Convert an integer to its string representation.\'
  +'n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailing whitespa'
  +'ce from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whites'
  +'pace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing wh'
  +'itespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode specia'
  +'l HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'
  +#10'"    Decode HTML entities in S back to characters.\n"'#10'"  UrlEncode(S'
  +') : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"  U'
  +'rlDecode(S) : string\n"'#10'"    Decode a percent-encoded string S.\n"'#10
  +'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10
  +'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'#10'"  '
  +'RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Replace all '
  +'regex matches of Pattern with Replacement in Input. Case-insensitive.\n"'#10
  +'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if Input matches '
  +'the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarke'
  +'r, EndMarker) : string\n"'#10'"    Extract the substring of S between Start'
  +'Marker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle returne'
  +'d by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON '
  +'string and return a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(H'
  +'andle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSONGetString(Ha'
  +'ndle, Path) : string\n"'#10'"    Get a string value at the specified Path.\'
  +'n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an integer val'
  +'ue at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n'
  +'"'#10'"    Get a floating-point value at the specified Path.\n"'#10'"  JSON'
  +'GetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value at the spec'
  +'ified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"   '
  +' Get the number of elements in an array at the specified Path.\n"'#10'"  JS'
  +'ONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the string v'
  +'alue of an array element at the given Index.\n"'#10'"  JSONGetArrayInt(Hand'
  +'le, Path, Index) : Integer\n"'#10'"    Get the integer value of an array el'
  +'ement at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'
  +#10'"    Return the type of the value at Path: \"object\", \"array\", \"stri'
  +'ng\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Hand'
  +'le, Path) : Boolean\n"'#10'"    Check if the specified Path exists.\n"'#10
  +'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for building a'
  +' standard error result.\n"'#10'"  JSONResultAddError(Offset, Length, Messag'
  +'e, Replacements)\n"'#10'"    Add an error object to the result array. Repla'
  +'cements is a string of values separated by \"|\".\n"'#10'"  JSONResultGet :'
  +' string\n"'#10'"    Return the current result array as a JSON string.\n"'#10
  +'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always cal'
  +'l JSONFree to release the handle after you are done.\n"'#10'"\n"'#10'"Examp'
  +'le of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;'
  +'\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"'
  +'    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, '''
  +'some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree('
  +'h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters ('
  +'retrieved with GetParam):\n"'#10'"  text - the input text to process (possi'
  +'bly truncated to MaxLength)\n"'#10'"  source - source language code (may be'
  +' empty)\n"'#10'"  target - target language code\n"'#10'"  timestamp - curre'
  +'nt Unix timestamp in milliseconds (string)\n"'#10'"  random  - 9-digit rand'
  +'om number (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 -'
  +' first 1..9 digits of the random number\n"'#10'"\n"'#10'"Additional initial'
  +' and custom parameters are also available."'#10'msgstr ""'#10'"Het script i'
  +'s een standaard Pascal-programma: een optionele var-sectie, gevolgd door ee'
  +'n hoofdblok begin ... end.\n"'#10'"\n"'#10'"Voorbeeld:\n"'#10'"  var s: str'
  ,'ing;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := '
  +'ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'
  +#10'"  end.\n"'#10'"\n"'#10'"Je kunt ook standaard Pascal-constructies gebru'
  +'iken (if, for, while, repeat, enz.). Je kunt je eigen functies en procedure'
  +'s defini'#195#171'ren v'#195#179#195#179'r het hoofdblok begin ... end.\n"'
  +#10'"\n"'#10'"Beschikbare functies:\n"'#10'"  GetParam(''name'') : string\n"'
  +#10'"    Haalt de waarde van een invoerparameter op.\n"'#10'"  SetOutput(''n'
  +'ame'', ''value'')\n"'#10'"    Slaat een uitvoerwaarde voor de host op.\n"'
  +#10'"  GetTimestamp() : Int64\n"'#10'"    Huidige Unix-tijdstempel in millis'
  +'econden (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Willekeurig '
  +'geheel getal met precies Length decimale cijfers.\n"'#10'"  Random : Extend'
  +'ed\n"'#10'"    Willekeurig getal met drijvende komma in het bereik [0, 1).\'
  +'n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Zet een geheel getal'
  +' om naar een hexadecimale tekenreeks met ten minste Digits tekens.\n"'#10'"'
  +'  StrToInt(S) : Integer\n"'#10'"    Zet een tekenreeks om naar een geheel g'
  +'etal. Genereert een uitzondering bij ongeldige invoer.\n"'#10'"  IntToStr(V'
  +'alue) : string\n"'#10'"    Zet een geheel getal om naar zijn tekenreeksrepr'
  +'esentatie.\n"'#10'"  Trim(S) : string\n"'#10'"    Verwijdert witruimte aan '
  +'het begin en einde van S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Verwij'
  +'dert witruimte aan het begin van S.\n"'#10'"  TrimRight(S) : string\n"'#10
  +'"    Verwijdert witruimte aan het einde van S.\n"'#10'"  HtmlEncode(S) : st'
  +'ring\n"'#10'"    Codeert speciale HTML-tekens in S als entiteiten.\n"'#10'"'
  +'  HtmlDecode(S) : string\n"'#10'"    Decodeert HTML-entiteiten in S terug n'
  +'aar tekens.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    Codeert S met proce'
  +'ntcodering voor veilige opname in een URL.\n"'#10'"  UrlDecode(S) : string\'
  +'n"'#10'"    Decodeert een met procentcodering gecodeerde tekenreeks S.\n"'
  +#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'
  +#10'"    Vervangt alle voorkomens van OldPattern door NewPattern in S.\n"'#10
  +'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Vervangt '
  +'alle overeenkomsten van de reguliere expressie Pattern door Replacement in '
  +'Input. Niet hoofdlettergevoelig.\n"'#10'"  RegexMatch(Input, Pattern) : Boo'
  +'lean\n"'#10'"    Controleert of Input overeenkomt met de reguliere expressi'
  +'e Pattern. Niet hoofdlettergevoelig.\n"'#10'"  ExtractBetween(S, StartMarke'
  +'r, EndMarker) : string\n"'#10'"    Haalt de substring uit S tussen StartMar'
  +'ker en EndMarker.\n"'#10'"\n"'#10'"JSON-functies (gebruik een handle die do'
  +'or JSONParse wordt geretourneerd):\n"'#10'"  JSONParse(S) : Integer\n"'#10
  +'"    Parseert een JSON-tekenreeks en retourneert een handle (>=0). Retourne'
  +'ert -1 bij een fout.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Geeft de handle'
  +' na gebruik vrij.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'#10'"  '
  +'  Haalt een tekenreekswaarde op via het opgegeven Path.\n"'#10'"  JSONGetIn'
  +'t(Handle, Path) : Integer\n"'#10'"    Haalt een gehele waarde op via het op'
  +'gegeven Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    H'
  +'aalt een waarde met drijvende komma op via het opgegeven Path.\n"'#10'"  JS'
  +'ONGetBool(Handle, Path) : Boolean\n"'#10'"    Haalt een booleaanse waarde o'
  +'p via het opgegeven Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integ'
  +'er\n"'#10'"    Haalt het aantal elementen op van een array via het opgegeve'
  +'n Path.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"'
  +'    Haalt de tekenreekswaarde op van een array-element op de opgegeven Inde'
  +'x.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#10'"    Haa'
  +'lt de gehele waarde op van een array-element op de opgegeven Index.\n"'#10
  +'"  JSONGetType(Handle, Path) : string\n"'#10'"    Retourneert het type van '
  +'de waarde op Path: \"object\", \"array\", \"string\", \"int\", \"float\", \'
  +'"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10
  +'"    Controleert of het opgegeven Path bestaat.\n"'#10'"  JSONResultInit\n"'
  +#10'"    Initialiseert een lege JSON-array voor het opbouwen van een standaa'
  +'rd foutresultaat.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Rep'
  +'lacements)\n"'#10'"    Voegt een foutobject toe aan de resultatenarray. Rep'
  +'lacements is een tekenreeks met waarden, gescheiden door \"|\".\n"'#10'"  J'
  +'SONResultGet : string\n"'#10'"    Retourneert de huidige resultatenarray al'
  +'s een JSON-tekenreeks.\n"'#10'"  JSONResultClear\n"'#10'"    Wist de result'
  +'atenarray.\n"'#10'"  Roep altijd JSONFree aan om de handle vrij te geven na'
  +'dat je klaar bent.\n"'#10'"\n"'#10'"Voorbeeld van werken met JSON:\n"'#10'"'
  +'  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h :='
  +' JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    be'
  ,'gin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetOu'
  +'tput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  en'
  +'d.\n"'#10'"\n"'#10'"Beschikbare parameters (opgehaald met GetParam):\n"'#10
  +'"  text - de te verwerken invoertekst (mogelijk afgekapt tot MaxLength)\n"'
  +#10'"  source - code van de brontaal (kan leeg zijn)\n"'#10'"  target - code'
  +' van de doeltaal\n"'#10'"  timestamp - huidige Unix-tijdstempel in millisec'
  +'onden (tekenreeks)\n"'#10'"  random  - willekeurig getal van 9 cijfers (tek'
  +'enreeks)\n"'#10'"  rand - hetzelfde als random\n"'#10'"  rand1..rand9 - de '
  +'eerste 1..9 cijfers van het willekeurige getal\n"'#10'"\n"'#10'"Er zijn ook'
  +' aanvullende initi'#195#171'le en aangepaste parameters beschikbaar.xtra in'
  +'iti'#195#171'le en aangepaste parameters zijn ook beschikbaar."'#10#10'#: f'
  +'ormconfig.rscriptresponsehint'#10'msgid ""'#10'"This script processes the r'
  +'esponse data. All functions and parameters described in the script hint are'
  +' available here as well.\n"'#10'"Use GetParam(''result'') to obtain the rec'
  +'eived text.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  be'
  +'gin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''result'''
  +', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can define custom parameters in t'
  +'he parameters script using SetParam(''name'', ''value''),\n"'#10'"and then '
  +'retrieve them here with GetParam(''name'')."'#10'msgstr ""'#10'"Dit script '
  +'verwerkt de responsgegevens. Alle functies en parameters die in de scripthi'
  +'nt worden beschreven, zijn hier ook beschikbaar.\n"'#10'"Gebruik GetParam('
  +'''result'') om de ontvangen tekst op te halen.\n"'#10'"\n"'#10'"Voorbeeld:\'
  +'n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'
  +''');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"'
  +'U kunt aangepaste parameters defini'#195#171'ren in het parameterscript met'
  +' SetParam(''name'', ''value''),\n"'#10'"en ze vervolgens hier ophalen met G'
  +'etParam(''name'')."'#10#10'#: formconfig.rvaluetype1'#10'msgctxt "formconfi'
  +'g.rvaluetype1"'#10'msgid "None"'#10'msgstr "Geen"'#10#10'#: formconfig.rval'
  +'uetype2'#10'msgid "Language"'#10'msgstr "Taal"'#10#10'#: formconfig.rvaluet'
  +'ype3'#10'msgid "Currency All"'#10'msgstr "Alle valuta"'#10#10'#: formconfig'
  +'.rvaluetype4'#10'msgid "Currency Fiat Only"'#10'msgstr "Alleen fiatvaluta"'
  +#10#10'#: formconfig.rvaluetype5'#10'msgid "Currency Crypto Only"'#10'msgstr'
  +' "Alleen cryptovaluta"'#10#10'#: formconfig.rvaluetype6'#10'msgid "Measurem'
  +'ent Units"'#10'msgstr "Meeteenheden"'#10#10'#: tformconfigtrayslate.acleari'
  +'con.caption'#10'msgid "Clear Icon"'#10'msgstr "Pictogram wissen"'#10#10'#: '
  +'tformconfigtrayslate.asave.caption'#10'msgid "Save"'#10'msgstr "Opslaan"'#10
  +#10'#: tformconfigtrayslate.asaveiconas.caption'#10'msgid "Save Icon As..."'
  +#10'msgstr "Pictogram opslaan als..."'#10#10'#: tformconfigtrayslate.btnclos'
  +'e.caption'#10'msgid "Close"'#10'msgstr "Sluiten"'#10#10'#: tformconfigtrays'
  +'late.btninitparameterstest.hint'#10'msgid "Execute request and view the par'
  +'ameters"'#10'msgstr "Verzoek uitvoeren en parameters bekijken"'#10#10'#: tf'
  +'ormconfigtrayslate.btniniturltest.hint'#10'msgid "Execute request and view '
  +'the result"'#10'msgstr "Verzoek uitvoeren en resultaat bekijken"'#10#10'#: '
  +'tformconfigtrayslate.btnpostdatatest.hint'#10'msgid "Execute post request a'
  +'nd view the result"'#10'msgstr "POST-verzoek uitvoeren en resultaat bekijke'
  +'n"'#10#10'#: tformconfigtrayslate.btnresponsehelp.hint'#10'msgctxt "tformco'
  +'nfigtrayslate.btnresponsehelp.hint"'#10'msgid "Help"'#10'msgstr "Help"'#10
  +#10'#: tformconfigtrayslate.btnresponsetest.hint'#10'msgid "Converts the cur'
  +'rent response"'#10'msgstr "Converteert de huidige reactie"'#10#10'#: tformc'
  +'onfigtrayslate.btnscripthelp.hint'#10'msgctxt "tformconfigtrayslate.btnscri'
  +'pthelp.hint"'#10'msgid "Help"'#10'msgstr "Help"'#10#10'#: tformconfigtraysl'
  +'ate.btnscriptresponsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnscriptr'
  +'esponsehelp.hint"'#10'msgid "Help"'#10'msgstr "Help"'#10#10'#: tformconfigt'
  +'rayslate.btnscriptresponsetest.hint'#10'msgctxt "tformconfigtrayslate.btnsc'
  +'riptresponsetest.hint"'#10'msgid "Execute script and view the result"'#10'm'
  +'sgstr "Script uitvoeren en resultaat bekijken"'#10#10'#: tformconfigtraysla'
  +'te.btnscripttest.hint'#10'msgctxt "tformconfigtrayslate.btnscripttest.hint"'
  +#10'msgid "Execute script and view the result"'#10'msgstr "Script uitvoeren '
  +'en resultaat bekijken"'#10#10'#: tformconfigtrayslate.btnurltest.hint'#10'm'
  +'sgid "Execute get request and view the result"'#10'msgstr "GET-verzoek uitv'
  +'oeren en resultaat bekijken"'#10#10'#: tformconfigtrayslate.caption'#10'msg'
  +'ctxt "tformconfigtrayslate.caption"'#10'msgid "Config Editor"'#10'msgstr "C'
  +'onfiguratie-editor"'#10#10'#: tformconfigtrayslate.checkencodecustomparamet'
  +'ers.caption'#10'msgid "Encode parameters"'#10'msgstr "Parameters coderen"'
  ,#10#10'#: tformconfigtrayslate.checkencodetext.caption'#10'msgid "Encode {te'
  +'xt} parameter"'#10'msgstr "Parameter {text} coderen"'#10#10'#: tformconfigt'
  +'rayslate.checkserviceautoswap.caption'#10'msgid "Allow auto-swap language p'
  +'air"'#10'msgstr "Automatisch wisselen van taalpaar toestaan"'#10#10'#: tfor'
  +'mconfigtrayslate.checkserviceonlybutton.caption'#10'msgid "Allow translatio'
  +'n only by translation button"'#10'msgstr "Alleen vertaling via de vertaalkn'
  +'op toestaan"'#10#10'#: tformconfigtrayslate.checkserviceproxy.caption'#10'm'
  +'sgid "Allow proxy"'#10'msgstr "Proxy toestaan"'#10#10'#: tformconfigtraysla'
