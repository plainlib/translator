  +'n'#10'msgctxt "tformconfigtrayslate.groupinitparameters.caption"'#10'msgid '
  +'"Initial Request"'#10'msgstr "Richiesta iniziale"'#10#10'#: tformconfigtray'
  +'slate.grouplanguages.caption'#10'msgctxt "tformconfigtrayslate.grouplanguag'
  +'es.caption"'#10'msgid "Languages"'#10'msgstr "Lingue"'#10#10'#: tformconfig'
  +'trayslate.grouplanguagestarget.caption'#10'msgctxt "tformconfigtrayslate.gr'
  +'ouplanguagestarget.caption"'#10'msgid "Target Languages"'#10'msgstr "Lingue'
  +' destinazione"'#10#10'#: tformconfigtrayslate.grouprequest.caption'#10'msgc'
  +'txt "tformconfigtrayslate.grouprequest.caption"'#10'msgid "Request"'#10'msg'
  +'str "Richiesta"'#10#10'#: tformconfigtrayslate.groupresponse.caption'#10'ms'
  +'gid "Json Pointer Processing the Response"'#10'msgstr "Elaborazione rispost'
  +'a con Json Pointer"'#10#10'#: tformconfigtrayslate.groupscript.caption'#10
  +'msgid "Script Retrieved Parameters"'#10'msgstr "Parametri recuperati dallo '
  +'script"'#10#10'#: tformconfigtrayslate.groupscriptresponse.caption'#10'msgi'
  +'d "Script Processing the Response"'#10'msgstr "Elaborazione risposta tramit'
  +'e script"'#10#10'#: tformconfigtrayslate.imagepreview.hint'#10'msgid "Click'
  +' to select the config icon, Middle-Click clears the icon"'#10'msgstr "Fai c'
  +'lic per selezionare l'#226#128#153'icona di configurazione, clic centrale e'
  +'limina l'#226#128#153'icona"'#10#10'#: tformconfigtrayslate.labelaccept.cap'
  +'tion'#10'msgid "Accept"'#10'msgstr "Accetto"'#10#10'#: tformconfigtrayslate'
  +'.labelcolorrecent.caption'#10'msgid "Recent Color"'#10'msgstr "Colore recen'
  +'te"'#10#10'#: tformconfigtrayslate.labelcontenttype.caption'#10'msgid "Cont'
  +'ent Type"'#10'msgstr "Tipo contenuto"'#10#10'#: tformconfigtrayslate.labelf'
  +'illlanguages.caption'#10'msgctxt "tformconfigtrayslate.labelfilllanguages.c'
  +'aption"'#10'msgid "Fill with default"'#10'msgstr "Compila con valori predef'
  +'initi"'#10#10'#: tformconfigtrayslate.labelfilltargetlanguages.caption'#10
  +'msgctxt "tformconfigtrayslate.labelfilltargetlanguages.caption"'#10'msgid "'
  +'Fill with default"'#10'msgstr "Compila con i valori predefiniti"'#10#10'#: '
  +'tformconfigtrayslate.labelheaders.caption'#10'msgid "Additional request hea'
  +'ders in key=value format, key: value is also supported"'#10'msgstr "Intesta'
  +'zioni aggiuntive della richiesta in formato ''key=value'', '#195#168' suppo'
  +'rtato anche ''key: value''"'#10#10'#: tformconfigtrayslate.labelinitheaders'
  +'.caption'#10'msgid "Additional initial request headers in key=value format,'
  +' key: value is also supported"'#10'msgstr "Intestazioni aggiuntive della ri'
  +'chiesta iniziale in formato ''key=value'', '#195#168' supportato anche ''ke'
  +'y: value''"'#10#10'#: tformconfigtrayslate.labelinitheaders2.caption'#10'ms'
  +'gctxt "tformconfigtrayslate.labelinitheaders2.caption"'#10'msgid "Headers"'
  +#10'msgstr "Intestazioni"'#10#10'#: tformconfigtrayslate.labelinitlivetime.c'
  +'aption'#10'msgid "Live time"'#10'msgstr "Durata live"'#10#10'#: tformconfig'
  +'trayslate.labelinitparameters.caption'#10'msgid "Parameters name=regexp are'
  +' extracted from the response and used by name in requests"'#10'msgstr "I pa'
  +'rametri ''name=regexp'' vengono estratti dalla risposta e usati per nome ne'
  +'lle richieste"'#10#10'#: tformconfigtrayslate.labelinitparameters1.caption'
  +#10'msgid "Time in seconds to refresh parameters with a new request (0 = eve'
  ,'ry request)"'#10'msgstr "Tempo in secondi per aggiornare i parametri con un'
  +'a nuova richiesta (0 = ogni richiesta)"'#10#10'#: tformconfigtrayslate.labe'
  +'linitparameters2.caption'#10'msgctxt "tformconfigtrayslate.labelinitparamet'
  +'ers2.caption"'#10'msgid "Parameters"'#10'msgstr "Parametri"'#10#10'#: tform'
  +'configtrayslate.labelinitparameters4.caption'#10'msgid "Parameters in the f'
  +'orm key=value used by {key} in requests. If the value is omitted (key=), it'
  +' will be requested from the user."'#10'msgstr "Parametri nel formato ''key='
  +'value'' usati nelle richieste da {key}. Se il valore viene omesso (key=), v'
  +'err'#195#160' richiesto dall''utente."'#10#10'#: tformconfigtrayslate.label'
  +'initparemeters.caption'#10'msgid "Initial GET request to obtain required pa'
  +'rameters."'#10'msgstr "Richiesta GET iniziale per ottenere i parametri nece'
  +'ssari."'#10#10'#: tformconfigtrayslate.labeliniturl.caption'#10'msgctxt "tf'
  +'ormconfigtrayslate.labeliniturl.caption"'#10'msgid "URL"'#10'msgstr "URL"'
  +#10#10'#: tformconfigtrayslate.labelinituseragent.caption'#10'msgctxt "tform'
  +'configtrayslate.labelinituseragent.caption"'#10'msgid "User Agent"'#10'msgs'
  +'tr "User Agent"'#10#10'#: tformconfigtrayslate.labellanguages.caption'#10'm'
  +'sgid "Supported languages e.g. en=en-US (en - internal, en-US - service). \'
  +'"empty\" - do not send."'#10'msgstr "Lingue supportate, ad es. en=en-US (en'
  +' - interno, en-US - servizio). \"empty\" - non inviare."'#10#10'#: tformcon'
  +'figtrayslate.labellanguages1.caption'#10'msgid "Value type for populating n'
  +'ames. None keeps originals; None and Unit are case-sensitive."'#10'msgstr "'
  +'Tipo di valore per popolare i nomi. ''Nessuno'' mantiene quelli originali. '
  +'''Nessuno'' e ''Unit'#195#160''' fanno distinzione tra maiuscole e minuscol'
  +'e."'#10#10'#: tformconfigtrayslate.labellanguagestarget.caption'#10'msgid "'
  +'"'#10'"Target languages e.g. en=en-US, en - internal, en-US - service code.'
  +'\n"'#10'"If not specified, both source and target languages are taken from '
  +'the languages section."'#10'msgstr ""'#10'"Lingue destinazione, ad es. en=e'
  +'n-US, en - interno, en-US - codice servizio.\n"'#10'"Se non specificato, si'
  +'a le lingue sorgenti che quelle destinazione vengono prese dalla sezione li'
  +'ngue."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid "Max'
  +' Length, bytes"'#10'msgstr "Lunghezza massima, byte"'#10#10'#: tformconfigt'
  +'rayslate.labelmethod.caption'#10'msgid "Method"'#10'msgstr "Metodo"'#10#10
  +'#: tformconfigtrayslate.labelparemeters.caption'#10'msgid "Use parameters: '
  +'{text} '#226#128#147' input text, {source} '#226#128#147' source language, '
