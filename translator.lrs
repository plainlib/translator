  +#231#164#186#227#129#151#227#129#190#227#129#153#227#128#130'\n"'#13#10'"'
  +#227#130#179#227#131#161#227#131#179#227#131#136': /* text */ '#227#130#179
  +#227#131#161#227#131#179#227#131#136#227#129#175#227#128#129#229#135#166#231
  +#144#134#227#130#146#232#161#140#227#129#134#229#137#141#227#129#171#229#188
  +#143#229#133#168#228#189#147#227#129#139#227#130#137#229#137#138#233#153#164
  +#227#129#149#227#130#140#227#129#190#227#129#153#227#128#130'\n"'#13#10'"'
  +#228#190#139':\n"'#13#10'"responseData/translatedText; matches/*#10/translat'
  +'ion; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/tr'
  +'anslations{Error: No data!#10}; /translations"'#13#10#13#10'#: formconfig.r'
  +'scripthint'#13#10'msgid ""'#13#10'"The script is a standard Pascal program:'
  +' optional var section, then a main begin ... end. block.\n"'#13#10'"\n"'#13
  +#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    '
  +'s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', Fa'
  +'lse);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\'
  +'n"'#13#10'"You can also use standard Pascal constructs (if, for, while, rep'
  +'eat, etc.). You can define your own functions and procedures before the mai'
  +'n begin ... end. block.\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13
  +#10'"  GetParam(''name'') : string\n"'#13#10'"    Retrieve an input paramete'
  +'r value.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Store a'
  +'n output value for the host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10
  +'"    Current Unix timestamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(L'
  +'ength) : Int64\n"'#13#10'"    Random integer with exactly Length decimal di'
  +'gits.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random float in the ran'
  +'ge [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Con'
  +'vert integer to hexadecimal string with at least Digits characters.\n"'#13
  +#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convert a string to an integer. '
  +'Raises an exception on invalid input.\n"'#13#10'"  IntToStr(Value) : string'
  +'\n"'#13#10'"    Convert an integer to its string representation.\n"'#13#10
  +'"  Trim(S) : string\n"'#13#10'"    Remove leading and trailing whitespace f'
  +'rom S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Remove leading whit'
  +'espace from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Remove tra'
  +'iling whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"   '
  +' Encode special HTML characters in S into entities.\n"'#13#10'"  HtmlDecode'
  +'(S) : string\n"'#13#10'"    Decode HTML entities in S back to characters.\n'
  +'"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encode S for safe '
  +'URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Decode a p'
  +'ercent-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern,'
  +' IgnoreCase=False) : string\n"'#13#10'"    Replace all occurrences of OldPa'
  +'ttern with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, Pattern, Repla'
  ,'cement) : string\n"'#13#10'"    Replace all regex matches of Pattern with R'
  +'eplacement in Input. Case-insensitive.\n"'#13#10'"  RegexMatch(Input, Patte'
  +'rn) : Boolean\n"'#13#10'"    Check if Input matches the regex Pattern. Case'
  +'-insensitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) : stri'
  +'ng\n"'#13#10'"    Extract the substring of S between StartMarker and EndMar'
  +'ker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a handle returned by JSONPa'
  +'rse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse a JSON strin'
  +'g and return a handle (>=0). Returns -1 on error.\n"'#13#10'"  JSONFree(Han'
  +'dle)\n"'#13#10'"    Release the handle after use.\n"'#13#10'"  JSONGetStrin'
  +'g(Handle, Path) : string\n"'#13#10'"    Get a string value at the specified'
  +' Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    Get a'
  +'n integer value at the specified Path.\n"'#13#10'"  JSONGetFloat(Handle, Pa'
  +'th) : Extended\n"'#13#10'"    Get a floating-point value at the specified P'
  +'ath.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Get a '
  +'boolean value at the specified Path.\n"'#13#10'"  JSONGetArrayCount(Handle,'
  +' Path) : Integer\n"'#13#10'"    Get the number of elements in an array at t'
  +'he specified Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Index) : s'
  +'tring\n"'#13#10'"    Get the string value of an array element at the given '
  +'Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#13#10
  +'"    Get the integer value of an array element at the given Index.\n"'#13#10
  +'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Return the type of the'
  +' value at Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bo'
  +'ol\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13
  +#10'"    Check if the specified Path exists.\n"'#13#10'"  JSONResultInit\n"'
  +#13#10'"    Initialize an empty JSON array for building a standard error res'
  +'ult.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replacements)'
  +'\n"'#13#10'"    Add an error object to the result array. Replacements is a '
  +'string of values separated by \"|\".\n"'#13#10'"  JSONResultGet : string\n"'
  +#13#10'"    Return the current result array as a JSON string.\n"'#13#10'"  J'
  +'SONResultClear\n"'#13#10'"    Clear the result array.\n"'#13#10'"  Always c'
  +'all JSONFree to release the handle after you are done.\n"'#13#10'"\n"'#13#10
  +'"Example of working with JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"    '
  +'  s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''re'
  +'sult''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"   '
  +'   s := JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''text'
  +''', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.'
  +'\n"'#13#10'"\n"'#13#10'"Available parameters (retrieved with GetParam):\n"'
  +#13#10'"  text - the input text to process (possibly truncated to MaxLength)'
  +'\n"'#13#10'"  source - source language code (may be empty)\n"'#13#10'"  tar'
  +'get - target language code\n"'#13#10'"  timestamp - current Unix timestamp '
  +'in milliseconds (string)\n"'#13#10'"  random  - 9-digit random number (stri'
  +'ng)\n"'#13#10'"  rand - same as random\n"'#13#10'"  rand1..rand9 - first 1.'
  +'.9 digits of the random number\n"'#13#10'"\n"'#13#10'"Additional initial an'
  +'d custom parameters are also available."'#13#10'msgstr ""'#13#10'"'#227#130
  +#185#227#130#175#227#131#170#227#131#151#227#131#136#227#129#175#230#168#153
  +#230#186#150#231#154#132#227#129#170' Pascal '#227#131#151#227#131#173#227
  +#130#176#227#131#169#227#131#160#227#129#167#227#129#153#227#128#130#231#156
  +#129#231#149#165#229#143#175#232#131#189#227#129#170' var '#227#130#187#227
  +#130#175#227#130#183#227#131#167#227#131#179#227#129#140#227#129#130#227#130
  +#138#227#128#129#227#129#157#227#129#174#229#190#140#227#129#171#227#131#161
  +#227#130#164#227#131#179#227#129#174' begin ... end. '#227#131#150#227#131
  +#173#227#131#131#227#130#175#227#129#140#231#182#154#227#129#141#227#129#190
  +#227#129#153#227#128#130'\n"'#13#10'"\n"'#13#10'"'#228#190#139':\n"'#13#10'"'
  +'  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');'
  +'\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    Set'
  +'Output(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'#230#168#153
  +#230#186#150#231#154#132#227#129#170' Pascal '#227#129#174#230#167#139#230
  +#150#135#239#188#136'if'#227#128#129'for'#227#128#129'while'#227#128#129'rep'
