  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: Trayslate - Italian - '
  +'18.10.2026\n"'#13#10'"POT-Creation-Date: \n"'#13#10'"PO-Revision-Date: 2026'
  +'-11-04 14:41-0300\n"'#13#10'"Last-Translator: plaintool <astverskoy@gmail.c'
  +'om>\n"'#13#10'"Language-Team: bovirus (bovirus@gmail.com)\n"'#13#10'"Langua'
  +'ge: it\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type: text/plain; ch'
  +'arset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'#13#10'"X-Generat'
  +'or: PoBatch 1.0.0\n"'#13#10'"X-Poedit-SourceCharset: UTF-8\n"'#13#10#13#10
  +'#: formconfig.rcaption'#13#10'msgctxt "formconfig.rcaption"'#13#10'msgid "C'
  +'onfig Editor"'#13#10'msgstr "Editor configurazione"'#13#10#13#10'#: formcon'
  +'fig.rclearlanguages'#13#10'msgid "The list is already filled. Do you want t'
  +'o clear it?"'#13#10'msgstr ""'#13#10'"L''elenco '#195#168' gi'#195#160' pie'
  +'no.\n"'#13#10'"Vuoi cancellarlo?"'#13#10#13#10'#: formconfig.rconfigeditor'
  +#13#10'msgid "Config Editor..."'#13#10'msgstr "Editor configurazione..."'#13
  +#10#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you sure you want to'
  +' delete config"'#13#10'msgstr "Vuoi eliminare la configurazione"'#13#10#13
  +#10'#: formconfig.rdeleteconfigcaption'#13#10'msgid "Delete config"'#13#10'm'
  +'sgstr "Elimina configurazione"'#13#10#13#10'#: formconfig.rfilechangedcance'
  +'l'#13#10'msgid "Cancel"'#13#10'msgstr "Annulla"'#13#10#13#10'#: formconfig.'
  +'rfilechangedkeepchanges'#13#10'msgid "Keep my changes"'#13#10'msgstr "Manti'
  +'eni le mie modifiche"'#13#10#13#10'#: formconfig.rfilechangedmsg'#13#10'#, '
  +'object-pascal-format'#13#10'msgid "The file \"%s\" has been modified by ano'
  +'ther application since it was opened."'#13#10'msgstr "Il file \"%s\" '#195
  +#168' stato modificato da un''altra applicazione dopo essere stato aperto."'
  +#13#10#13#10'#: formconfig.rfilechangedmsgactivate'#13#10'msgid "You have un'
  +'saved changes. Keep them or reload from disk?"'#13#10'msgstr "Sono presenti'
  +' modifiche non salvate. Vuoi mantenerle o ricaricare il file dal disco?"'#13
  +#10#13#10'#: formconfig.rfilechangedreloaddisk'#13#10'msgid "Reload from dis'
  +'k"'#13#10'msgstr "Ricarica dal disco"'#13#10#13#10'#: formconfig.rfilechang'
  +'edtitle'#13#10'msgid "File changed on disk"'#13#10'msgstr "File modificato '
  +'sul disco"'#13#10#13#10'#: formconfig.rnamequestion'#13#10'msgid "Enter new'
  +' config file name:"'#13#10'msgstr "Inserisci nome nuovo file configurazione'
  +':"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The configuration was'
  +' modified. Save changes?"'#13#10'msgstr ""'#13#10'"La configurazione '#195
  +#168' stata modificata.\n"'#13#10'"Vuoi salvare le modifiche?"'#13#10#13#10
  +'#: formconfig.rresponsehint'#13#10'msgid ""'#13#10'"Json Pointer: Use / for'
  +' levels, keys for objects, and numbers for indexes.\n"'#13#10'"Use * for al'
  +'l items, *#10 to join items by newline. Use ~ at the end of the path to ret'
  +'urn the raw JSON branch.\n"'#13#10'"Separate multiple segments with semicol'
  +'on ;.\n"'#13#10'"Literal: Text block in {'#226#128#166'}. Special tag #10 f'
  +'or newlines. Use {{regex}} inside to extract data directly into the text.\n'
  +'"'#13#10'"Logic: If a Pointer in a segment is empty, the whole segment is s'
  +'kipped. If a segment has no Pointer, only literal text blocks with embedded'
  +' regular expressions are processed.\n"'#13#10'"Regex: {prefix {regex[index]'
  +'} suffix} inside a text block. If no [index] is specified, the first match '
  +'is used.\n"'#13#10'"Index can be a number, [*] (join by space), or [*#10] ('
  +'join by newline). If the regex finds no match, the entire {'#226#128#166'} '
  +'block is removed.\n"'#13#10'"Using ~ inside a regex returns the entire text'
  +'.\n"'#13#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show'
  +' its text only if the Pointer data is missing or the JSON is invalid.\n"'#13
  +#10'"Commenting: /* text */ comments are stripped from the entire expression'
  +' before any processing.\n"'#13#10'"Examples:\n"'#13#10'"responseData/transl'
  +'atedText; matches/*#10/translation; /texts/text; {literal text#10}; /result'
  +'/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translation'
  +'s/0/text"'#13#10'msgstr ""'#13#10'"Json Pointer: Usa / per i livelli, le ch'
  +'iavi per gli oggetti e i numeri per gli indici. Usa * per tutti gli element'
  +'i, *#10 per unire gli elementi con nuova riga. Usa ~ alla fine del percorso'
  +' per restituire il ramo JSON grezzo. Separa pi'#195#185' segmenti con il pu'
  +'nto e virgola ;.\n"'#13#10'"Letterale: Blocco di testo in {'#226#128#166'}.'
  +' Tag speciale #10 per le nuove righe. Usa {{regex}} all''interno per estrar'
  +'re i dati direttamente nel testo.\n"'#13#10'"Logica: Se un puntatore in un '
  +'segmento '#195#168' vuoto, l''intero segmento viene saltato. Se un segmento'
  +' non ha un puntatore, vengono elaborati solo i blocchi di testo letterale c'
  +'on espressioni regolari incorporate.\n"'#13#10'"Regex: {prefisso {regex[ind'
  +'ice]} suffisso} all''interno di un blocco di testo. Se non viene specificat'
  ,'o [indice], viene usata la prima corrispondenza. L''indice pu'#195#178' ess'
  +'ere un numero, [*] (unisci con spazio) o [*#10] (unisci con nuova riga). Se'
  +' l''espressione regolare non trova corrispondenze, l''intero blocco {'#226
  +#128#166'} viene rimosso. L''uso di ~ all''interno di un''espressione regola'
  +'re restituisce l''intero testo.\n"'#13#10'"Inversione: Inizia un segmento c'
  +'on ! (es. !/path{Error}) per visualizzarne il testo solo se i dati del punt'
  +'atore mancano o il JSON non '#195#168' valido.\n"'#13#10'"Commenti: i comme'
  +'nti /* testo */ vengono rimossi dall''intera espressione prima di qualsiasi'
  +' elaborazione.\n"'#13#10'"Esempi:\n"'#13#10'"responseData/translatedText; m'
  +'atches/*#10/translation; /texts/text; {literal text#10}; /result/text; /tex'
  +'t{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'
  +#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"The script is'
  +' a standard Pascal program: optional var section, then a main begin ... end'
  +'. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13
  +#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := Rep'
  +'laceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'
  +#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standard Pascal const'
  +'ructs (if, for, while, repeat, etc.). You can define your own functions and'
  +' procedures before the main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Av'
  +'ailable functions:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    '
  +'Retrieve an input parameter value.\n"'#13#10'"  SetOutput(''name'', ''value'
  +''')\n"'#13#10'"    Store an output value for the host.\n"'#13#10'"  GetTime'
  +'stamp() : Int64\n"'#13#10'"    Current Unix timestamp in milliseconds (UTC)'
  +'.\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random integer with'
  +' exactly Length decimal digits.\n"'#13#10'"  Random : Extended\n"'#13#10'" '
  +'   Random float in the range [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) :'
  +' string\n"'#13#10'"    Convert integer to hexadecimal string with at least '
  +'Digits characters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Conver'
  +'t a string to an integer. Raises an exception on invalid input.\n"'#13#10'"'
  +'  IntToStr(Value) : string\n"'#13#10'"    Convert an integer to its string '
  +'representation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove leading'
  +' and trailing whitespace from S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10
  +'"    Remove leading whitespace from S.\n"'#13#10'"  TrimRight(S) : string\n'
  +'"'#13#10'"    Remove trailing whitespace from S.\n"'#13#10'"  HtmlEncode(S)'
  +' : string\n"'#13#10'"    Encode special HTML characters in S into entities.'
  +'\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTML entities in'
  +' S back to characters.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Pe'
  +'rcent-encode S for safe URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n'
  +'"'#13#10'"    Decode a percent-encoded string S.\n"'#13#10'"  ReplaceAll(S,'
  +' OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Replace '
  +'all occurrences of OldPattern with NewPattern in S.\n"'#13#10'"  RegexRepla'
  +'ce(Input, Pattern, Replacement) : string\n"'#13#10'"    Replace all regex m'
  +'atches of Pattern with Replacement in Input. Case-insensitive.\n"'#13#10'" '
  +' RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Check if Input matches'
  +' the regex Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetween(S, StartM'
  +'arker, EndMarker) : string\n"'#13#10'"    Extract the substring of S betwee'
  +'n StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a h'
  +'andle returned by JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10
  +'"    Parse a JSON string and return a handle (>=0). Returns -1 on error.\n"'
  +#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release the handle after use.\n"'
  +#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"    Get a string v'
  +'alue at the specified Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer'
  +'\n"'#13#10'"    Get an integer value at the specified Path.\n"'#13#10'"  JS'
  +'ONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Get a floating-point val'
  +'ue at the specified Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\'
  +'n"'#13#10'"    Get a boolean value at the specified Path.\n"'#13#10'"  JSON'
  +'GetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Get the number of elem'
  +'ents in an array at the specified Path.\n"'#13#10'"  JSONGetArrayString(Han'
  +'dle, Path, Index) : string\n"'#13#10'"    Get the string value of an array '
  +'element at the given Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Inde'
  +'x) : Integer\n"'#13#10'"    Get the integer value of an array element at th'
  +'e given Index.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'" '
  +'   Return the type of the value at Path: \"object\", \"array\", \"string\",'
  +' \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle'
  ,', Path) : Boolean\n"'#13#10'"    Check if the specified Path exists.\n"'#13
  +#10'"  JSONResultInit\n"'#13#10'"    Initialize an empty JSON array for buil'
  +'ding a standard error result.\n"'#13#10'"  JSONResultAddError(Offset, Lengt'
  +'h, Message, Replacements)\n"'#13#10'"    Add an error object to the result '
  +'array. Replacements is a string of values separated by \"|\".\n"'#13#10'"  '
  +'JSONResultGet : string\n"'#13#10'"    Return the current result array as a '
  +'JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Clear the result a'
  +'rray.\n"'#13#10'"  Always call JSONFree to release the handle after you are'
  +' done.\n"'#13#10'"\n"'#13#10'"Example of working with JSON:\n"'#13#10'"  va'
  +'r h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"   '
  +' h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13
  +#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'#13
  +#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"'
  +'    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Available parameters (ret'
  +'rieved with GetParam):\n"'#13#10'"  text - the input text to process (possi'
  +'bly truncated to MaxLength)\n"'#13#10'"  source - source language code (may'
  +' be empty)\n"'#13#10'"  target - target language code\n"'#13#10'"  timestam'
  +'p - current Unix timestamp in milliseconds (string)\n"'#13#10'"  random  - '
  +'9-digit random number (string)\n"'#13#10'"  rand - same as random\n"'#13#10
  +'"  rand1..rand9 - first 1..9 digits of the random number\n"'#13#10'"\n"'#13
  +#10'"Additional initial and custom parameters are also available."'#13#10'ms'
  +'gstr ""'#13#10'"Lo script '#195#168' un programma Pascal standard: una sezi'
  +'one var facoltativa, seguita da un blocco principale begin ... end.\n"'#13
  +#10'"\n"'#13#10'"Esempio:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'
  +#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'''
  +', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n'
  +'"'#13#10'"\n"'#13#10'"Puoi anche utilizzare le strutture standard di Pascal'
  +' (if, for, while, repeat, ecc.). Puoi definire le tue funzioni e procedure '
  +'prima del blocco principale begin ... end.\n"'#13#10'"\n"'#13#10'"Funzioni '
  +'disponibili:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Recupe'
  +'ra il valore di un parametro di input.\n"'#13#10'"  SetOutput(''name'', ''v'
  +'alue'')\n"'#13#10'"    Memorizza un valore di output per l''host.\n"'#13#10
  +'"  GetTimestamp() : Int64\n"'#13#10'"    Timestamp Unix attuale in millisec'
  +'ondi (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Numero in'
  +'tero casuale con esattamente Lenght cifre decimali.\n"'#13#10'"  Random : E'
  +'xtended\n"'#13#10'"    Numero in virgola mobile casuale nell''intervallo [0'
  +', 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Converte'
  +' un numero intero in una stringa esadecimale con almeno Digits caratteri.\n'
  +'"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Converte una stringa in un'
  +' numero intero. In caso di input non valido genera un''eccezione.\n"'#13#10
  +'"  IntToStr(Value) : string\n"'#13#10'"    Converte un numero intero nella '
  +'sua rappresentazione come stringa.\n"'#13#10'"  Trim(S) : string\n"'#13#10
  +'"    Rimuove da S gli spazi iniziali e finali.\n"'#13#10'"  TrimLeft(S) : s'
  +'tring\n"'#13#10'"    Rimuove da S gli spazi iniziali.\n"'#13#10'"  TrimRigh'
  +'t(S) : string\n"'#13#10'"    Rimuove da S gli spazi finali.\n"'#13#10'"  Ht'
  +'mlEncode(S) : string\n"'#13#10'"    Codifica i caratteri HTML speciali pres'
  +'enti in S come entit'#195#160'.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13
  +#10'"    Decodifica le entit'#195#160' HTML presenti in S riportandole ai ca'
  +'ratteri originali.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Codifi'
  +'ca S con la codifica percentuale per un''inclusione sicura negli URL.\n"'#13
  +#10'"  UrlDecode(S) : string\n"'#13#10'"    Decodifica una stringa S codific'
  +'ata con la codifica percentuale.\n"'#13#10'"  ReplaceAll(S, OldPattern, New'
  +'Pattern, IgnoreCase=False) : string\n"'#13#10'"    Sostituisce tutte le occ'
  +'orrenze di OldPattern con NewPattern in S.\n"'#13#10'"  RegexReplace(Input,'
  +' Pattern, Replacement) : string\n"'#13#10'"    Sostituisce tutte le corrisp'
  +'ondenze dell''espressione regolare Pattern con Replacement in Input. Senza '
  +'distinzione tra maiuscole e minuscole.\n"'#13#10'"  RegexMatch(Input, Patte'
  +'rn) : Boolean\n"'#13#10'"    Verifica se Input corrisponde all''espressione'
  +' regolare Pattern. Senza distinzione tra maiuscole e minuscole.\n"'#13#10'"'
  +'  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Estrae '
  +'la sottostringa di S compresa tra StartMarker e EndMarker.\n"'#13#10'"\n"'
  +#13#10'"Funzioni JSON (usare un handle restituito da JSONParse):\n"'#13#10'"'
  +'  JSONParse(S) : Integer\n"'#13#10'"    Analizza una stringa JSON e restitu'
  +'isce un handle (>=0). In caso di errore restituisce -1.\n"'#13#10'"  JSONFr'
  ,'ee(Handle)\n"'#13#10'"    Rilascia l''handle dopo l''uso.\n"'#13#10'"  JSON'
  +'GetString(Handle, Path) : string\n"'#13#10'"    Ottiene un valore stringa d'
  +'al Path specificato.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13
  +#10'"    Ottiene un valore intero dal Path specificato.\n"'#13#10'"  JSONGet'
  +'Float(Handle, Path) : Extended\n"'#13#10'"    Ottiene un valore a virgola m'
  +'obile dal Path specificato.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolea'
  +'n\n"'#13#10'"    Ottiene un valore booleano dal Path specificato.\n"'#13#10
  +'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Ottiene il nume'
  +'ro di elementi di un array dal Path specificato.\n"'#13#10'"  JSONGetArrayS'
  +'tring(Handle, Path, Index) : string\n"'#13#10'"    Ottiene il valore string'
  +'a di un elemento dell''array all''Index specificato.\n"'#13#10'"  JSONGetAr'
  +'rayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Ottiene il valore inte'
  +'ro di un elemento dell''array all''Index specificato.\n"'#13#10'"  JSONGetT'
  +'ype(Handle, Path) : string\n"'#13#10'"    Restituisce il tipo del valore in'
  +' Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"n'
  +'ull\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    V'
  +'erifica se il Path specificato esiste.\n"'#13#10'"  JSONResultInit\n"'#13#10
  +'"    Inizializza un array JSON vuoto per creare un risultato di errore stan'
  +'dard.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replacements'
  +')\n"'#13#10'"    Aggiunge un oggetto errore all''array risultati. Replaceme'
  +'nts '#195#168' una stringa di valori separati da \"|\".\n"'#13#10'"  JSONRe'
  +'sultGet : string\n"'#13#10'"    Restituisce l''array dei risultati attuale '
  +'come stringa JSON.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Cancella l'''
  +'array risultati.\n"'#13#10'"  Chiama sempre JSONFree per rilasciare l''hand'
  +'le dopo aver terminato di usarlo.\n"'#13#10'"\n"'#13#10'"Esempio uso JSON:\'
  +'n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  begin'
  +'\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h >'
  +'= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''some'
  +'.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONFre'
  +'e(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Parametr'
  +'i disponibili (recuperati con GetParam):\n"'#13#10'"  text - il testo in in'
  +'put da elaborare (potrebbe essere troncato a MaxLength)\n"'#13#10'"  source'
  +' - codice lingua sorgente (pu'#195#178' essere vuoto)\n"'#13#10'"  target -'
  +' codice lingua destinazione\n"'#13#10'"  timestamp - timestamp Unix attuale'
  +' in millisecondi (stringa)\n"'#13#10'"  random  - numero casuale di 9 cifre'
  +' (stringa)\n"'#13#10'"  rand - uguale a random\n"'#13#10'"  rand1..rand9 - '
  +'le prime 1..9 cifre del numero casuale\n"'#13#10'"\n"'#13#10'"Sono disponib'
  +'ili anche ulteriori parametri iniziali e personalizzati.onibili parametri i'
  +'niziali e personalizzati aggiuntivi."'#13#10#13#10'#: formconfig.rscriptres'
  +'ponsehint'#13#10'msgid ""'#13#10'"This script processes the response data. '
  +'All functions and parameters described in the script hint are available her'
  +'e as well.\n"'#13#10'"Use GetParam(''result'') to obtain the received text.'
  +'\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  b'
  +'egin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput(''r'
  +'esult'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define custom'
  +' parameters in the parameters script using SetParam(''name'', ''value''),\n'
  +'"'#13#10'"and then retrieve them here with GetParam(''name'')."'#13#10'msgs'
  +'tr ""'#13#10'"Questo script elabora i dati della risposta. Tutte le funzion'
  +'i e i parametri descritti nel suggerimento dello script sono disponibili an'
  +'che qui.\n"'#13#10'"Per ottenere il testo ricevuto usa GetParam(''result'')'
  +' .\n"'#13#10'"\n"'#13#10'"Esempio:\n"'#13#10'"  var s: string;\n"'#13#10'" '
  +' begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput('
  +'''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'#195#136' possibi'
  +'le definire parametri personalizzati nello script parametri usando SetParam'
