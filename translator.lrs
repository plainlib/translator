  +'msgctxt "tformconfigtrayslate.labelsort.caption"'#10'msgid "Sort"'#10'msgst'
  +'r "Sortuj"'#10#10'#: tformconfigtrayslate.labeltargetsort.caption'#10'msgct'
  +'xt "tformconfigtrayslate.labeltargetsort.caption"'#10'msgid "Sort"'#10'msgs'
  +'tr "Sortuj"'#10#10'#: tformconfigtrayslate.labelurl.caption'#10'msgctxt "tf'
  +'ormconfigtrayslate.labelurl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10
  +'#: tformconfigtrayslate.labeluseragent.caption'#10'msgctxt "tformconfigtray'
  +'slate.labeluseragent.caption"'#10'msgid "User Agent"'#10'msgstr "User Agent'
  +'"'#10#10'#: tformconfigtrayslate.labelvaluetype.caption'#10'msgid "Value Ty'
  +'pe"'#10'msgstr "Typ warto'#197#155'ci"'#10#10'#: tformconfigtrayslate.pagei'
  +'nitialrequest.caption'#10'msgctxt "tformconfigtrayslate.pageinitialrequest.'
  +'caption"'#10'msgid "Initial Request"'#10'msgstr "'#197#187#196#133'danie po'
  +'cz'#196#133'tkowe"'#10#10'#: tformconfigtrayslate.pagelanguages.caption'#10
  +'msgctxt "tformconfigtrayslate.pagelanguages.caption"'#10'msgid "Languages"'
  +#10'msgstr "J'#196#153'zyki"'#10#10'#: tformconfigtrayslate.pagelanguagestar'
  +'get.caption'#10'msgctxt "tformconfigtrayslate.pagelanguagestarget.caption"'
  +#10'msgid "Target Languages"'#10'msgstr "J'#196#153'zyki docelowe"'#10#10'#:'
  +' tformconfigtrayslate.pageparameters.caption'#10'msgctxt "tformconfigtraysl'
  +'ate.pageparameters.caption"'#10'msgid "Parameters"'#10'msgstr "Parametry"'
  +#10#10'#: tformconfigtrayslate.pagerequest.caption'#10'msgctxt "tformconfigt'
  +'rayslate.pagerequest.caption"'#10'msgid "Request"'#10'msgstr "'#197#187#196
  +#133'danie"'#10#10'#: tformconfigtrayslate.pageresponse.caption'#10'msgid "R'
  +'esponse"'#10'msgstr "Odpowied'#197#186'"'#10#10'#: tformconfigtrayslate.pag'
  +'eservice.caption'#10'msgctxt "tformconfigtrayslate.pageservice.caption"'#10
  +'msgid "Service"'#10'msgstr "Us'#197#130'uga"'#10#10'#: tformconfigtrayslate'
  +'.reloadconfigs.hint'#10'msgid "Reload configurations from disk"'#10'msgstr '
  +'"Prze'#197#130'aduj konfiguracje z dysku"'#10#10'#: tformconfigtrayslate.sb'
