  +'e taken from the languages section."'#13#10'msgstr ""'#13#10'"C'#195#173'lo'
  +'v'#195#169' jazyky nap'#197#153'. en=en-US, en - intern'#195#173', en-US - '
  +'k'#195#179'd slu'#197#190'by.\n"'#13#10'"Pokud nen'#195#173' uvedeno, zdroj'
  +'ov'#195#169' i c'#195#173'lov'#195#169' jazyky se berou z '#196#141#195#161
  +'sti jazyky."'#13#10#13#10'#: tformconfigtrayslate.labelmaxlength.caption'#13
  +#10'msgid "Max Length, bytes"'#13#10'msgstr "Maxim'#195#161'ln'#195#173' d'
  +#195#169'lka, bajty"'#13#10#13#10'#: tformconfigtrayslate.labelmethod.captio'
  +'n'#13#10'msgid "Method"'#13#10'msgstr "Metoda"'#13#10#13#10'#: tformconfigt'
  +'rayslate.labelparemeters.caption'#13#10'msgid "Use parameters: {text} '#226
  +#128#147' input text, {source} '#226#128#147' source language, {target} '#226
  ,#128#147' target language. Prefix the name with ! for lowercase or ^ for upp'
  +'ercase value. Also supported {timestamp}, {rand}. Use {parameter} from the '
  +'parameters page."'#13#10'msgstr "Pou'#197#190'ijte parametry: {text} '#226
  +#128#147' vstupn'#195#173' text, {source} '#226#128#147' zdrojov'#195#189' j'
  +'azyk, {target} '#226#128#147' c'#195#173'lov'#195#189' jazyk. P'#197#153'ed'
  +'pona ! pro hodnotu mal'#195#189'mi p'#195#173'smeny nebo ^ pro velk'#195#189
  +'mi p'#195#173'smeny. Podporov'#195#161'no tak'#195#169' {timestamp}, {rand}'
  +'. Pou'#197#190'ijte {parameter} ze str'#195#161'nky parametr'#197#175'."'#13
  +#10#13#10'#: tformconfigtrayslate.labelpostdata.caption'#13#10'msgid "Post D'
  +'ata"'#13#10'msgstr "Post Data"'#13#10#13#10'#: tformconfigtrayslate.labelpo'
  +'stdata1.caption'#13#10'msgctxt "tformconfigtrayslate.labelpostdata1.caption'
  +'"'#13#10'msgid "Headers"'#13#10'msgstr "Headers"'#13#10#13#10'#: tformconfi'
  +'gtrayslate.labelservicedescription.caption'#13#10'msgid "Description"'#13#10
  +'msgstr "Popis"'#13#10#13#10'#: tformconfigtrayslate.labelservicename.captio'
  +'n'#13#10'msgid "Name"'#13#10'msgstr "N'#195#161'zev"'#13#10#13#10'#: tformc'
  +'onfigtrayslate.labelserviceorder.caption'#13#10'msgid "Order"'#13#10'msgstr'
  +' "Po'#197#153'ad'#195#173'"'#13#10#13#10'#: tformconfigtrayslate.labelsort.'
  +'caption'#13#10'msgctxt "tformconfigtrayslate.labelsort.caption"'#13#10'msgi'
  +'d "Sort"'#13#10'msgstr "Se'#197#153'adit"'#13#10#13#10'#: tformconfigtraysl'
  +'ate.labeltargetsort.caption'#13#10'msgctxt "tformconfigtrayslate.labeltarge'
  +'tsort.caption"'#13#10'msgid "Sort"'#13#10'msgstr "Se'#197#153'adit"'#13#10
  +#13#10'#: tformconfigtrayslate.labelurl.caption'#13#10'msgctxt "tformconfigt'
  +'rayslate.labelurl.caption"'#13#10'msgid "URL"'#13#10'msgstr "URL"'#13#10#13
  +#10'#: tformconfigtrayslate.labeluseragent.caption'#13#10'msgctxt "tformconf'
  +'igtrayslate.labeluseragent.caption"'#13#10'msgid "User Agent"'#13#10'msgstr'
  +' "User Agent"'#13#10#13#10'#: tformconfigtrayslate.labelvaluetype.caption'
  +#13#10'msgid "Value Type"'#13#10'msgstr "Typ hodnoty"'#13#10#13#10'#: tformc'
  +'onfigtrayslate.pageinitialrequest.caption'#13#10'msgctxt "tformconfigtraysl'
  +'ate.pageinitialrequest.caption"'#13#10'msgid "Initial Request"'#13#10'msgst'
  +'r "Po'#196#141#195#161'te'#196#141'n'#195#173' po'#197#190'adavek"'#13#10#13
  +#10'#: tformconfigtrayslate.pagelanguages.caption'#13#10'msgctxt "tformconfi'
  +'gtrayslate.pagelanguages.caption"'#13#10'msgid "Languages"'#13#10'msgstr "J'
  +'azyky"'#13#10#13#10'#: tformconfigtrayslate.pagelanguagestarget.caption'#13
  +#10'msgctxt "tformconfigtrayslate.pagelanguagestarget.caption"'#13#10'msgid '
  +'"Target Languages"'#13#10'msgstr "C'#195#173'lov'#195#169' jazyky"'#13#10#13
  +#10'#: tformconfigtrayslate.pageparameters.caption'#13#10'msgctxt "tformconf'
  +'igtrayslate.pageparameters.caption"'#13#10'msgid "Parameters"'#13#10'msgstr'
  +' "Parametry"'#13#10#13#10'#: tformconfigtrayslate.pagerequest.caption'#13#10
  +'msgctxt "tformconfigtrayslate.pagerequest.caption"'#13#10'msgid "Request"'
  +#13#10'msgstr "Po'#197#190'adavek"'#13#10#13#10'#: tformconfigtrayslate.page'
  +'response.caption'#13#10'msgid "Response"'#13#10'msgstr "Odpov'#196#155#196
  +#143'"'#13#10#13#10'#: tformconfigtrayslate.pageservice.caption'#13#10'msgct'
  +'xt "tformconfigtrayslate.pageservice.caption"'#13#10'msgid "Service"'#13#10
  +'msgstr "Slu'#197#190'ba"'#13#10#13#10'#: tformconfigtrayslate.reloadconfigs'
  +'.hint'#13#10'msgid "Reload configurations from disk"'#13#10'msgstr "Na'#196
  +#141#195#173'st konfigurace z disku"'#13#10#13#10'#: tformconfigtrayslate.sb'
  +'copyconfig.hint'#13#10'msgid "Copy configuration"'#13#10'msgstr "Kop'#195
  +#173'rovat konfiguraci"'#13#10#13#10'#: tformconfigtrayslate.sbnewconfig.hin'
  +'t'#13#10'msgid "New configuration"'#13#10'msgstr "Nov'#195#161' konfigurace'
  +'"'#13#10#13#10
]);
LazarusResources.Add('formconfig.da','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: da\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Konfigurationseditor"'#13#10#13#10'#: formconfig.rclearlanguages'#13#10'm'
  +'sgid "The list is already filled. Do you want to clear it?"'#13#10'msgstr "'
  +'Listen er allerede udfyldt. Vil du rydde den?"'#13#10#13#10'#: formconfig.r'
  +'configeditor'#13#10'msgid "Config Editor..."'#13#10'msgstr "Konfigurationse'
  +'ditor..."'#13#10#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you su'
  +'re you want to delete config"'#13#10'msgstr "Er du sikker p'#195#165', at d'
  +'u vil slette konfiguration"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'
  +#13#10'msgid "Delete config"'#13#10'msgstr "Slet konfiguration"'#13#10#13#10
  +'#: formconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Annul'
  +'ler"'#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Keep '
  +'my changes"'#13#10'msgstr "Behold mine '#195#166'ndringer"'#13#10#13#10'#: '
  +'formconfig.rfilechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The'
  +' file \"%s\" has been modified by another application since it was opened."'
  +#13#10'msgstr "Filen \"%s\" er blevet '#195#166'ndret af et andet program, s'
  +'iden den blev '#195#165'bnet."'#13#10#13#10'#: formconfig.rfilechangedmsgac'
  +'tivate'#13#10'msgid "You have unsaved changes. Keep them or reload from dis'
  +'k?"'#13#10'msgstr "Du har ikke-gemte '#195#166'ndringer. Vil du beholde dem'
  +' eller genindl'#195#166'se filen fra disken?"'#13#10#13#10'#: formconfig.rf'
  +'ilechangedreloaddisk'#13#10'msgid "Reload from disk"'#13#10'msgstr "Genindl'
  +#195#166's fra disken"'#13#10#13#10'#: formconfig.rfilechangedtitle'#13#10'm'
  +'sgid "File changed on disk"'#13#10'msgstr "Filen er '#195#166'ndret p'#195
  +#165' disken"'#13#10#13#10'#: formconfig.rnamequestion'#13#10'msgid "Enter n'
  +'ew config file name:"'#13#10'msgstr "Indtast navn p'#195#165' ny konfigurat'
  +'ionsfil:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The configurat'
  +'ion was modified. Save changes?"'#13#10'msgstr "Konfigurationen er '#195#166
  +'ndret. Gemme '#195#166'ndringer?"'#13#10#13#10'#: formconfig.rresponsehint'
  +#13#10'msgid ""'#13#10'"Json Pointer: Use / for levels, keys for objects, an'
  +'d numbers for indexes.\n"'#13#10'"Use * for all items, *#10 to join items b'
  +'y newline. Use ~ at the end of the path to return the raw JSON branch.\n"'
  +#13#10'"Separate multiple segments with semicolon ;.\n"'#13#10'"Literal: Tex'
  +'t block in {'#226#128#166'}. Special tag #10 for newlines. Use {{regex}} in'
  +'side to extract data directly into the text.\n"'#13#10'"Logic: If a Pointer'
  +' in a segment is empty, the whole segment is skipped. If a segment has no P'
  +'ointer, only literal text blocks with embedded regular expressions are proc'
  +'essed.\n"'#13#10'"Regex: {prefix {regex[index]} suffix} inside a text block'
  +'. If no [index] is specified, the first match is used.\n"'#13#10'"Index can'
  +' be a number, [*] (join by space), or [*#10] (join by newline). If the rege'
  +'x finds no match, the entire {'#226#128#166'} block is removed.\n"'#13#10'"'
  +'Using ~ inside a regex returns the entire text.\n"'#13#10'"Inversion: Start'
  +' a segment with ! (e.g. !/path{Error}) to show its text only if the Pointer'
  +' data is missing or the JSON is invalid.\n"'#13#10'"Commenting: /* text */ '
  +'comments are stripped from the entire expression before any processing.\n"'
  +#13#10'"Examples:\n"'#13#10'"responseData/translatedText; matches/*#10/trans'
  +'lation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !'
  +'/translations{Error: No data!#10}; /translations/0/text"'#13#10'msgstr ""'
  +#13#10'"JSON-pointer: Brug / til niveauer, n'#195#184'gler til objekter og t'
  +'al til indekser. Brug * til alle elementer og *#10 til at sammenk'#195#166
  +'de elementer med en ny linje. Brug ~ i slutningen af stien for at returnere'
  +' den r'#195#165' JSON-gren. Adskil flere segmenter med semikolon ;.\n"'#13
  +#10'"Litteral: Tekstblok i {'#226#128#166'}. S'#195#166'rligt tag #10 til ny'
  +'e linjer. Brug {{regex}} indeni til at inds'#195#166'tte udtrukne data dire'
  +'kte i teksten.\n"'#13#10'"Logik: Hvis en pointer i et segment er tom, sprin'
  +'ges hele segmentet over. Hvis et segment ikke har en pointer, behandles kun'
  +' tekstblokke med indlejrede regul'#195#166're udtryk.\n"'#13#10'"Regex: {pr'
  +#195#166'fiks {regex[index]} suffiks} inde i en tekstblok. Hvis [index] ikke'
  +' er angivet, bruges det f'#195#184'rste match. Indekset kan v'#195#166're e'
  +'t tal, [*] (sammenk'#195#166'd med mellemrum) eller [*#10] (sammenk'#195#166
  ,'d med ny linje). Hvis det regul'#195#166're udtryk ikke finder et match, fj'
  +'ernes hele blokken {'#226#128#166'}. Brug af ~ inde i et regul'#195#166'rt '
  +'udtryk returnerer hele teksten.\n"'#13#10'"Invertering: Start et segment me'
  +'d ! (f.eks. !/path{Error}) for kun at vise dets tekst, hvis pointerdata man'
  +'gler, eller hvis JSON er ugyldig.\n"'#13#10'"Kommentarer: Kommentarer /* te'
  +'kst */ fjernes fra hele udtrykket f'#195#184'r enhver behandling.\n"'#13#10
  +'"Eksempler:\n"'#13#10'"responseData/translatedText; matches/*#10/translatio'
  +'n; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/tran'
  +'slations{Error: No data!#10}; /translations"'#13#10#13#10'#: formconfig.rsc'
  +'ripthint'#13#10'msgid ""'#13#10'"The script is a standard Pascal program: o'
  +'ptional var section, then a main begin ... end. block.\n"'#13#10'"\n"'#13#10
  +'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s :'
  +'= GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False'
  +');\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'
  +#13#10'"You can also use standard Pascal constructs (if, for, while, repeat,'
  +' etc.). You can define your own functions and procedures before the main be'
  +'gin ... end. block.\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13#10'"'
  +'  GetParam(''name'') : string\n"'#13#10'"    Retrieve an input parameter va'
  +'lue.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Store an ou'
  +'tput value for the host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"   '
  +' Current Unix timestamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(Lengt'
  +'h) : Int64\n"'#13#10'"    Random integer with exactly Length decimal digits'
  +'.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random float in the range ['
  +'0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Convert'
  +' integer to hexadecimal string with at least Digits characters.\n"'#13#10'"'
  +'  StrToInt(S) : Integer\n"'#13#10'"    Convert a string to an integer. Rais'
  +'es an exception on invalid input.\n"'#13#10'"  IntToStr(Value) : string\n"'
  +#13#10'"    Convert an integer to its string representation.\n"'#13#10'"  Tr'
  +'im(S) : string\n"'#13#10'"    Remove leading and trailing whitespace from S'
  +'.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Remove leading whitespac'
  +'e from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Remove trailing'
  +' whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Enco'
  +'de special HTML characters in S into entities.\n"'#13#10'"  HtmlDecode(S) :'
  +' string\n"'#13#10'"    Decode HTML entities in S back to characters.\n"'#13
  +#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encode S for safe URL in'
  +'clusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Decode a percent'
  +'-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, Ignor'
  +'eCase=False) : string\n"'#13#10'"    Replace all occurrences of OldPattern '
  +'with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement'
  +') : string\n"'#13#10'"    Replace all regex matches of Pattern with Replace'
  +'ment in Input. Case-insensitive.\n"'#13#10'"  RegexMatch(Input, Pattern) : '
  +'Boolean\n"'#13#10'"    Check if Input matches the regex Pattern. Case-insen'
  +'sitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'
  +#13#10'"    Extract the substring of S between StartMarker and EndMarker.\n"'
  +#13#10'"\n"'#13#10'"JSON functions (use a handle returned by JSONParse):\n"'
  +#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse a JSON string and retu'
  +'rn a handle (>=0). Returns -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13
  +#10'"    Release the handle after use.\n"'#13#10'"  JSONGetString(Handle, Pa'
  +'th) : string\n"'#13#10'"    Get a string value at the specified Path.\n"'#13
  +#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    Get an integer valu'
  +'e at the specified Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended'
  +'\n"'#13#10'"    Get a floating-point value at the specified Path.\n"'#13#10
  +'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Get a boolean value a'
  +'t the specified Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Intege'
  +'r\n"'#13#10'"    Get the number of elements in an array at the specified Pa'
  +'th.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10
  +'"    Get the string value of an array element at the given Index.\n"'#13#10
  +'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Get the in'
  +'teger value of an array element at the given Index.\n"'#13#10'"  JSONGetTyp'
  +'e(Handle, Path) : string\n"'#13#10'"    Return the type of the value at Pat'
  +'h: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\'
  +'".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check'
  +' if the specified Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    I'
  +'nitialize an empty JSON array for building a standard error result.\n"'#13
  ,#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"'
  +'    Add an error object to the result array. Replacements is a string of va'
  +'lues separated by \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"   '
  +' Return the current result array as a JSON string.\n"'#13#10'"  JSONResultC'
  +'lear\n"'#13#10'"    Clear the result array.\n"'#13#10'"  Always call JSONFr'
  +'ee to release the handle after you are done.\n"'#13#10'"\n"'#13#10'"Example'
  +' of working with JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: str'
  +'ing;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''))'
  +';\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := '
  +'JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n'
  +'"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10
  +'"\n"'#13#10'"Available parameters (retrieved with GetParam):\n"'#13#10'"  t'
  +'ext - the input text to process (possibly truncated to MaxLength)\n"'#13#10
  +'"  source - source language code (may be empty)\n"'#13#10'"  target - targe'
  +'t language code\n"'#13#10'"  timestamp - current Unix timestamp in millisec'
  +'onds (string)\n"'#13#10'"  random  - 9-digit random number (string)\n"'#13
  +#10'"  rand - same as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits o'
  +'f the random number\n"'#13#10'"\n"'#13#10'"Additional initial and custom pa'
  +'rameters are also available."'#13#10'msgstr ""'#13#10'"Scriptet er et stand'
  +'ard Pascal-program: en valgfri var-sektion efterfulgt af en hovedblok begin'
  +' ... end.\n"'#13#10'"\n"'#13#10'"Eksempel:\n"'#13#10'"  var s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := '
  +'ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Du kan ogs'#195#165' bruge standar'
  +'dkonstruktioner i Pascal (if, for, while, repeat osv.). Du kan definere din'
  +'e egne funktioner og procedurer f'#195#184'r hovedblokken begin ... end.\n"'
  +#13#10'"\n"'#13#10'"Tilg'#195#166'ngelige funktioner:\n"'#13#10'"  GetParam('
  +'''name'') : string\n"'#13#10'"    Hent v'#195#166'rdien af en inputparamete'
  +'r.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Gem en output'
  +'v'#195#166'rdi for v'#195#166'rten.\n"'#13#10'"  GetTimestamp() : Int64\n"'
  +#13#10'"    Aktuelt Unix-tidsstempel i millisekunder (UTC).\n"'#13#10'"  Get'
  +'Random(Length) : Int64\n"'#13#10'"    Tilf'#195#166'ldigt heltal med pr'#195
  +#166'cis Length decimalcifre.\n"'#13#10'"  Random : Extended\n"'#13#10'"    '
  +'Tilf'#195#166'ldigt decimaltal i omr'#195#165'det [0, 1).\n"'#13#10'"  IntT'
  +'oHex(Value, Digits) : string\n"'#13#10'"    Konverter et heltal til en hexa'
  +'decimal streng med mindst Digits tegn.\n"'#13#10'"  StrToInt(S) : Integer\n'
  +'"'#13#10'"    Konverter en streng til et heltal. Udl'#195#184'ser en undtag'
  +'else ved ugyldigt input.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'" '
  +'   Konverter et heltal til dets strengrepr'#195#166'sentation.\n"'#13#10'" '
  +' Trim(S) : string\n"'#13#10'"    Fjern indledende og afsluttende mellemrum '
  +'fra S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Fjern indledende me'
  +'llemrum fra S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Fjern afsl'
  +'uttende mellemrum fra S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"   '
  +' Kod s'#195#166'rlige HTML-tegn i S som entiteter.\n"'#13#10'"  HtmlDecode('
  +'S) : string\n"'#13#10'"    Afkod HTML-entiteter i S tilbage til tegn.\n"'#13
  +#10'"  UrlEncode(S) : string\n"'#13#10'"    Procentkod S for sikker inkluder'
  +'ing i URL''er.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Afkod en p'
  +'rocentkodet streng S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, Ig'
  +'noreCase=False) : string\n"'#13#10'"    Erstat alle forekomster af OldPatte'
  +'rn med NewPattern i S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacemen'
  +'t) : string\n"'#13#10'"    Erstat alle match af det regul'#195#166're udtry'
  +'k Pattern med Replacement i Input. Uafh'#195#166'ngigt af store og sm'#195
  +#165' bogstaver.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10
  +'"    Kontroll'#195#169'r, om Input matcher det regul'#195#166're udtryk Pat'
  +'tern. Uafh'#195#166'ngigt af store og sm'#195#165' bogstaver.\n"'#13#10'"  '
  +'ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Udtr'#195
  +#166'k delstrengen fra S mellem StartMarker og EndMarker.\n"'#13#10'"\n"'#13
  +#10'"JSON-funktioner (brug et handle, der returneres af JSONParse):\n"'#13#10
  +'"  JSONParse(S) : Integer\n"'#13#10'"    Analys'#195#169'r en JSON-streng o'
  +'g return'#195#169'r et handle (>=0). Returnerer -1 ved fejl.\n"'#13#10'"  J'
  +'SONFree(Handle)\n"'#13#10'"    Frigiv handle efter brug.\n"'#13#10'"  JSONG'
  +'etString(Handle, Path) : string\n"'#13#10'"    Hent en strengv'#195#166'rdi'
  +' p'#195#165' den angivne Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Inte'
  +'ger\n"'#13#10'"    Hent en heltalsv'#195#166'rdi p'#195#165' den angivne Pa'
  ,'th.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Hent '
  +'en flydende kommav'#195#166'rdi p'#195#165' den angivne Path.\n"'#13#10'"  '
  +'JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Hent en boolesk v'#195
  +#166'rdi p'#195#165' den angivne Path.\n"'#13#10'"  JSONGetArrayCount(Handle'
  +', Path) : Integer\n"'#13#10'"    Hent antallet af elementer i et array p'
  +#195#165' den angivne Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path, In'
  +'dex) : string\n"'#13#10'"    Hent strengv'#195#166'rdien for et array-eleme'
  +'nt ved det angivne Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index)'
  +' : Integer\n"'#13#10'"    Hent heltalsv'#195#166'rdien for et array-element'
  +' ved det angivne Index.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'
  +#13#10'"    Return'#195#169'r typen af v'#195#166'rdien p'#195#165' Path: \"'
  +'object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'
  +#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Kontroll'#195
  +#169'r, om den angivne Path findes.\n"'#13#10'"  JSONResultInit\n"'#13#10'" '
  +'   Initialiser et tomt JSON-array til opbygning af et standardresultat med '
  +'fejl.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replacements'
  +')\n"'#13#10'"    Tilf'#195#184'j et fejlobjekt til resultatarrayet. Replace'
  +'ments er en streng med v'#195#166'rdier adskilt af \"|\".\n"'#13#10'"  JSON'
  +'ResultGet : string\n"'#13#10'"    Return'#195#169'r det aktuelle resultatar'
  +'ray som en JSON-streng.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Ryd res'
  +'ultatarrayet.\n"'#13#10'"  Kald altid JSONFree for at frigive handle, n'#195
  +#165'r du er f'#195#166'rdig med det.\n"'#13#10'"\n"'#13#10'"Eksempel p'#195
  +#165' arbejde med JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: str'
  +'ing;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''))'
  +';\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := '
  +'JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n'
  +'"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10
  +'"\n"'#13#10'"Tilg'#195#166'ngelige parametre (hentes med GetParam):\n"'#13
  +#10'"  text - inputteksten, der skal behandles (kan v'#195#166're afkortet t'
  +'il MaxLength)\n"'#13#10'"  source - kildekodesprog (kan v'#195#166're tom)\'
  +'n"'#13#10'"  target - m'#195#165'lsprogskode\n"'#13#10'"  timestamp - aktue'
  +'lt Unix-tidsstempel i millisekunder (streng)\n"'#13#10'"  random  - tilf'
  +#195#166'ldigt 9-cifret tal (streng)\n"'#13#10'"  rand - det samme som rando'
  +'m\n"'#13#10'"  rand1..rand9 - de f'#195#184'rste 1..9 cifre af det tilf'#195
  +#166'ldige tal\n"'#13#10'"\n"'#13#10'"Yderligere indledende og brugerdefiner'
  +'ede parametre er ogs'#195#165' tilg'#195#166'ngelige.nerede parametre er og'
  +'s'#195#165' tilg'#195#166'ngelige."'#13#10#13#10'#: formconfig.rscriptrespo'
  +'nsehint'#13#10'msgid ""'#13#10'"This script processes the response data. Al'
  +'l functions and parameters described in the script hint are available here '
  +'as well.\n"'#13#10'"Use GetParam(''result'') to obtain the received text.\n'
  +'"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  beg'
  +'in\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput(''res'
  +'ult'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define custom p'
  +'arameters in the parameters script using SetParam(''name'', ''value''),\n"'
  +#13#10'"and then retrieve them here with GetParam(''name'')."'#13#10'msgstr '
  +'""'#13#10'"Dette script behandler svardata. Alle funktioner og parametre, d'
  +'er er beskrevet i scriptets tip, er ogs'#195#165' tilg'#195#166'ngelige her'
  +'.\n"'#13#10'"Brug GetParam(''result'') for at hente den modtagne tekst.\n"'
  +#13#10'"\n"'#13#10'"Eksempel:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin'
  +'\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput(''resul'
  +'t'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Du kan definere brugerdef'
  +'inerede parametre i parameterscriptet ved hj'#195#166'lp af SetParam(''name'
  +''', ''value''),\n"'#13#10'"og derefter hente dem her med GetParam(''name'')'
  +'."'#13#10#13#10'#: formconfig.rvaluetype1'#13#10'msgctxt "formconfig.rvalue'
  +'type1"'#13#10'msgid "None"'#13#10'msgstr "Ingen"'#13#10#13#10'#: formconfig'
  +'.rvaluetype2'#13#10'msgid "Language"'#13#10'msgstr "Sprog"'#13#10#13#10'#: '
  +'formconfig.rvaluetype3'#13#10'msgid "Currency All"'#13#10'msgstr "Alle valu'
  +'taer"'#13#10#13#10'#: formconfig.rvaluetype4'#13#10'msgid "Currency Fiat On'
  +'ly"'#13#10'msgstr "Kun fiat-valuta"'#13#10#13#10'#: formconfig.rvaluetype5'
  +#13#10'msgid "Currency Crypto Only"'#13#10'msgstr "Kun kryptovaluta"'#13#10
