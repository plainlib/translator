LazarusResources.Add('formconfig.en','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: en\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Config Editor"'#13#10#13#10'#: formconfig.rclearlanguages'#13#10'msgid "T'
  +'he list is already filled. Do you want to clear it?"'#13#10'msgstr "The lis'
  +'t is already filled. Do you want to clear it?"'#13#10#13#10'#: formconfig.r'
  +'configeditor'#13#10'msgid "Config Editor..."'#13#10'msgstr "Config Editor..'
  +'."'#13#10#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you sure you '
  +'want to delete config"'#13#10'msgstr "Are you sure you want to delete confi'
  +'g"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13#10'msgid "Delete con'
  +'fig"'#13#10'msgstr "Delete config"'#13#10#13#10'#: formconfig.rfilechangedc'
  +'ancel'#13#10'msgid "Cancel"'#13#10'msgstr "Cancel"'#13#10#13#10'#: formconf'
  +'ig.rfilechangedkeepchanges'#13#10'msgid "Keep my changes"'#13#10'msgstr "Ke'
  +'ep my changes"'#13#10#13#10'#: formconfig.rfilechangedmsg'#13#10'#, object-'
  +'pascal-format'#13#10'msgid "The file \"%s\" has been modified by another ap'
  +'plication since it was opened."'#13#10'msgstr "The file \"%s\" has been mod'
  +'ified by another application since it was opened."'#13#10#13#10'#: formconf'
  +'ig.rfilechangedmsgactivate'#13#10'msgid "You have unsaved changes. Keep the'
  +'m or reload from disk?"'#13#10'msgstr "You have unsaved changes. Keep them '
  +'or reload from disk?"'#13#10#13#10'#: formconfig.rfilechangedreloaddisk'#13
  +#10'msgid "Reload from disk"'#13#10'msgstr "Reload from disk"'#13#10#13#10'#'
  +': formconfig.rfilechangedtitle'#13#10'msgid "File changed on disk"'#13#10'm'
  +'sgstr "File changed on disk"'#13#10#13#10'#: formconfig.rnamequestion'#13#10
  +'msgid "Enter new config file name:"'#13#10'msgstr "Enter new config file na'
  +'me:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The configuration w'
  +'as modified. Save changes?"'#13#10'msgstr "The configuration was modified. '
  +'Save changes?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgid ""'#13
  +#10'"Json Pointer: Use / for levels, keys for objects, and numbers for index'
  +'es.\n"'#13#10'"Use * for all items, *#10 to join items by newline. Use ~ at'
  +' the end of the path to return the raw JSON branch.\n"'#13#10'"Separate mul'
  +'tiple segments with semicolon ;.\n"'#13#10'"Literal: Text block in {'#226
  +#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to extract da'
  +'ta directly into the text.\n"'#13#10'"Logic: If a Pointer in a segment is e'
  +'mpty, the whole segment is skipped. If a segment has no Pointer, only liter'
  +'al text blocks with embedded regular expressions are processed.\n"'#13#10'"'
  +'Regex: {prefix {regex[index]} suffix} inside a text block. If no [index] is'
  +' specified, the first match is used.\n"'#13#10'"Index can be a number, [*] '
  +'(join by space), or [*#10] (join by newline). If the regex finds no match, '
  +'the entire {'#226#128#166'} block is removed.\n"'#13#10'"Using ~ inside a r'
  +'egex returns the entire text.\n"'#13#10'"Inversion: Start a segment with ! '
  +'(e.g. !/path{Error}) to show its text only if the Pointer data is missing o'
  +'r the JSON is invalid.\n"'#13#10'"Commenting: /* text */ comments are strip'
  +'ped from the entire expression before any processing.\n"'#13#10'"Examples:\'
  +'n"'#13#10'"responseData/translatedText; matches/*#10/translation; /texts/te'
  +'xt; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Err'
  +'or: No data!#10}; /translations/0/text"'#13#10'msgstr ""'#13#10'"Json Point'
  +'er: Use / for levels, keys for objects, and numbers for indexes.\n"'#13#10
  +'"Use * for all items, *#10 to join items by newline. Use ~ at the end of th'
  +'e path to return the raw JSON branch.\n"'#13#10'"Separate multiple segments'
  +' with semicolon ;.\n"'#13#10'"Literal: Text block in {'#226#128#166'}. Spec'
  +'ial tag #10 for newlines. Use {{regex}} inside to extract data directly int'
  +'o the text.\n"'#13#10'"Logic: If a Pointer in a segment is empty, the whole'
  +' segment is skipped. If a segment has no Pointer, only literal text blocks '
  +'with embedded regular expressions are processed.\n"'#13#10'"Regex: {prefix '
  +'{regex[index]} suffix} inside a text block. If no [index] is specified, the'
  +' first match is used.\n"'#13#10'"Index can be a number, [*] (join by space)'
  +', or [*#10] (join by newline). If the regex finds no match, the entire {'
  +#226#128#166'} block is removed.\n"'#13#10'"Using ~ inside a regex returns t'
  +'he entire text.\n"'#13#10'"Inversion: Start a segment with ! (e.g. !/path{E'
  +'rror}) to show its text only if the Pointer data is missing or the JSON is '
  ,'invalid.\n"'#13#10'"Commenting: /* text */ comments are stripped from the e'
  +'ntire expression before any processing.\n"'#13#10'"Examples:\n"'#13#10'"res'
  +'ponseData/translatedText; matches/*#10/translation; /texts/text; {literal t'
  +'ext#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#1'
  +'0}; /translations/0/text"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msg'
  +'id ""'#13#10'"The script is a standard Pascal program: optional var section'
  +', then a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13
  +#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'
  +''');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"   '
  +' SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can a'
  +'lso use standard Pascal constructs (if, for, while, repeat, etc.). You can '
  +'define your own functions and procedures before the main begin ... end. blo'
  +'ck.\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''nam'
  +'e'') : string\n"'#13#10'"    Retrieve an input parameter value.\n"'#13#10'"'
  +'  SetOutput(''name'', ''value'')\n"'#13#10'"    Store an output value for t'
  +'he host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix ti'
  +'mestamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13
  +#10'"    Random integer with exactly Length decimal digits.\n"'#13#10'"  Ran'
  +'dom : Extended\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10'"'
  +'  IntToHex(Value, Digits) : string\n"'#13#10'"    Convert integer to hexade'
  +'cimal string with at least Digits characters.\n"'#13#10'"  StrToInt(S) : In'
  +'teger\n"'#13#10'"    Convert a string to an integer. Raises an exception on'
  +' invalid input.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Conver'
  +'t an integer to its string representation.\n"'#13#10'"  Trim(S) : string\n"'
  +#13#10'"    Remove leading and trailing whitespace from S.\n"'#13#10'"  Trim'
  +'Left(S) : string\n"'#13#10'"    Remove leading whitespace from S.\n"'#13#10
  +'"  TrimRight(S) : string\n"'#13#10'"    Remove trailing whitespace from S.\'
  +'n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Encode special HTML char'
  +'acters in S into entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'" '
  +'   Decode HTML entities in S back to characters.\n"'#13#10'"  UrlEncode(S) '
  +': string\n"'#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13#10
  +'"  UrlDecode(S) : string\n"'#13#10'"    Decode a percent-encoded string S.\'
  +'n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : stri'
  +'ng\n"'#13#10'"    Replace all occurrences of OldPattern with NewPattern in '
  +'S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10
  +'"    Replace all regex matches of Pattern with Replacement in Input. Case-i'
  +'nsensitive.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"  '
  +'  Check if Input matches the regex Pattern. Case-insensitive.\n"'#13#10'"  '
  +'ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extract t'
  +'he substring of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10
  +'"JSON functions (use a handle returned by JSONParse):\n"'#13#10'"  JSONPars'
  +'e(S) : Integer\n"'#13#10'"    Parse a JSON string and return a handle (>=0)'
  +'. Returns -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release'
  +' the handle after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'
  +#13#10'"    Get a string value at the specified Path.\n"'#13#10'"  JSONGetIn'
  +'t(Handle, Path) : Integer\n"'#13#10'"    Get an integer value at the specif'
  +'ied Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"   '
  +' Get a floating-point value at the specified Path.\n"'#13#10'"  JSONGetBool'
  +'(Handle, Path) : Boolean\n"'#13#10'"    Get a boolean value at the specifie'
  +'d Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'" '
  +'   Get the number of elements in an array at the specified Path.\n"'#13#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#13#10'"  JSONGetAr'
  +'rayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Get the integer value '
  +'of an array element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Pa'
  +'th) : string\n"'#13#10'"    Return the type of the value at Path: \"object\'
  +'", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10
  +'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the speci'
  +'fied Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an '
  +'empty JSON array for building a standard error result.\n"'#13#10'"  JSONRes'
  +'ultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an er'
  +'ror object to the result array. Replacements is a string of values separate'
  +'d by \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the c'
  +'urrent result array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10
  ,'"    Clear the result array.\n"'#13#10'"  Always call JSONFree to release t'
  +'he handle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working wit'
  +'h JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10
  +'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"  '
  +'  if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h'
  +', ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"     '
  +' JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'Available parameters (retrieved with GetParam):\n"'#13#10'"  text - the inp'
  +'ut text to process (possibly truncated to MaxLength)\n"'#13#10'"  source - '
  +'source language code (may be empty)\n"'#13#10'"  target - target language c'
  +'ode\n"'#13#10'"  timestamp - current Unix timestamp in milliseconds (string'
  +')\n"'#13#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand -'
  +' same as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are'
  +' also available."'#13#10'msgstr ""'#13#10'"The script is a standard Pascal '
  +'program: optional var section, then a main begin ... end. block.\n"'#13#10
  +'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13
  +#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', '
  +'''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'
  +#13#10'"\n"'#13#10'"You can also use standard Pascal constructs (if, for, wh'
  +'ile, repeat, etc.). You can define your own functions and procedures before'
  +' the main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Available functions:'
  +'\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Retrieve an input '
  +'parameter value.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"   '
  +' Store an output value for the host.\n"'#13#10'"  GetTimestamp() : Int64\n"'
  +#13#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#13#10'"  GetRa'
  +'ndom(Length) : Int64\n"'#13#10'"    Random integer with exactly Length deci'
  +'mal digits.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random float in t'
  +'he range [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'" '
  +'   Convert integer to hexadecimal string with at least Digits characters.\n'
  +'"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convert a string to an int'
  +'eger. Raises an exception on invalid input.\n"'#13#10'"  IntToStr(Value) : '
  +'string\n"'#13#10'"    Convert an integer to its string representation.\n"'
  +#13#10'"  Trim(S) : string\n"'#13#10'"    Remove leading and trailing whites'
  +'pace from S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Remove leadin'
  +'g whitespace from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Remo'
  +'ve trailing whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10
  +'"    Encode special HTML characters in S into entities.\n"'#13#10'"  HtmlDe'
  +'code(S) : string\n"'#13#10'"    Decode HTML entities in S back to character'
  +'s.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encode S for s'
  +'afe URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Decode'
  +' a percent-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPatt'
  +'ern, IgnoreCase=False) : string\n"'#13#10'"    Replace all occurrences of O'
  +'ldPattern with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, Pattern, R'
  +'eplacement) : string\n"'#13#10'"    Replace all regex matches of Pattern wi'
  +'th Replacement in Input. Case-insensitive.\n"'#13#10'"  RegexMatch(Input, P'
  +'attern) : Boolean\n"'#13#10'"    Check if Input matches the regex Pattern. '
  +'Case-insensitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) : '
  +'string\n"'#13#10'"    Extract the substring of S between StartMarker and En'
  +'dMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a handle returned by JS'
  +'ONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse a JSON s'
  +'tring and return a handle (>=0). Returns -1 on error.\n"'#13#10'"  JSONFree'
  +'(Handle)\n"'#13#10'"    Release the handle after use.\n"'#13#10'"  JSONGetS'
  +'tring(Handle, Path) : string\n"'#13#10'"    Get a string value at the speci'
  +'fied Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    G'
  +'et an integer value at the specified Path.\n"'#13#10'"  JSONGetFloat(Handle'
  +', Path) : Extended\n"'#13#10'"    Get a floating-point value at the specifi'
  +'ed Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Ge'
  +'t a boolean value at the specified Path.\n"'#13#10'"  JSONGetArrayCount(Han'
  +'dle, Path) : Integer\n"'#13#10'"    Get the number of elements in an array '
  +'at the specified Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Index)'
  +' : string\n"'#13#10'"    Get the string value of an array element at the gi'
  +'ven Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'
  +#13#10'"    Get the integer value of an array element at the given Index.\n"'
  ,#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Return the type '
  +'of the value at Path: \"object\", \"array\", \"string\", \"int\", \"float\"'
  +', \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n'
  +'"'#13#10'"    Check if the specified Path exists.\n"'#13#10'"  JSONResultIn'
  +'it\n"'#13#10'"    Initialize an empty JSON array for building a standard er'
  +'ror result.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replac'
  +'ements)\n"'#13#10'"    Add an error object to the result array. Replacement'
  +'s is a string of values separated by \"|\".\n"'#13#10'"  JSONResultGet : st'
  +'ring\n"'#13#10'"    Return the current result array as a JSON string.\n"'#13
  +#10'"  JSONResultClear\n"'#13#10'"    Clear the result array.\n"'#13#10'"  A'
  +'lways call JSONFree to release the handle after you are done.\n"'#13#10'"\n'
  +'"'#13#10'"Example of working with JSON:\n"'#13#10'"  var h: Integer;\n"'#13
  +#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetPa'
  +'ram(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13
  +#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput('
  +'''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"'
  +'  end.\n"'#13#10'"\n"'#13#10'"Available parameters (retrieved with GetParam'
  +'):\n"'#13#10'"  text - the input text to process (possibly truncated to Max'
  +'Length)\n"'#13#10'"  source - source language code (may be empty)\n"'#13#10
  +'"  target - target language code\n"'#13#10'"  timestamp - current Unix time'
  +'stamp in milliseconds (string)\n"'#13#10'"  random  - 9-digit random number'
  +' (string)\n"'#13#10'"  rand - same as random\n"'#13#10'"  rand1..rand9 - fi'
  +'rst 1..9 digits of the random number\n"'#13#10'"\n"'#13#10'"Additional init'
  +'ial and custom parameters are also available."'#13#10#13#10'#: formconfig.r'
  +'scriptresponsehint'#13#10'msgid ""'#13#10'"This script processes the respon'
  +'se data. All functions and parameters described in the script hint are avai'
  +'lable here as well.\n"'#13#10'"Use GetParam(''result'') to obtain the recei'
  +'ved text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13
  +#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOut'
  +'put(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define'
  +' custom parameters in the parameters script using SetParam(''name'', ''valu'
  +'e''),\n"'#13#10'"and then retrieve them here with GetParam(''name'')."'#13
  +#10'msgstr ""'#13#10'"This script processes the response data. All functions'
  +' and parameters described in the script hint are available here as well.\n"'
  +#13#10'"Use GetParam(''result'') to obtain the received text.\n"'#13#10'"\n"'
  +#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'" '
  +'   s := GetParam(''result'');\n"'#13#10'"    SetOutput(''result'', s);\n"'
  +#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define custom parameters in th'
  +'e parameters script using SetParam(''name'', ''value''),\n"'#13#10'"and the'
  +'n retrieve them here with GetParam(''name'')."'#13#10#13#10'#: formconfig.r'
