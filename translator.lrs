  +'"'#215#147#215#149#215#146#215#158#215#144#215#149#215#170':\n"'#10'"respon'
  ,'seData/translatedText; matches/*#10/translation; /texts/text; {literal text'
  +'#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10};'
  +' /translations"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The scri'
  +'pt is a standard Pascal program: optional var section, then a main begin ..'
  +'. end. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  '
  +'begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, '
  +'''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'
  +#10'"\n"'#10'"You can also use standard Pascal constructs (if, for, while, r'
  +'epeat, etc.). You can define your own functions and procedures before the m'
  +'ain begin ... end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  G'
  +'etParam(''name'') : string\n"'#10'"    Retrieve an input parameter value.\n'
  +'"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an output value f'
  +'or the host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix time'
  +'stamp in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"  '
  +'  Random integer with exactly Length decimal digits.\n"'#10'"  Random : Ext'
  +'ended\n"'#10'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Valu'
  +'e, Digits) : string\n"'#10'"    Convert integer to hexadecimal string with '
  +'at least Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Con'
  +'vert a string to an integer. Raises an exception on invalid input.\n"'#10'"'
  +'  IntToStr(Value) : string\n"'#10'"    Convert an integer to its string rep'
  +'resentation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trai'
  +'ling whitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove l'
  +'eading whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remov'
  +'e trailing whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    '
  +'Encode special HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) '
  +': string\n"'#10'"    Decode HTML entities in S back to characters.\n"'#10'"'
  +'  UrlEncode(S) : string\n"'#10'"    Percent-encode S for safe URL inclusion'
  +'.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-encoded stri'
  +'ng S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : s'
  +'tring\n"'#10'"    Replace all occurrences of OldPattern with NewPattern in '
  +'S.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"   '
  +' Replace all regex matches of Pattern with Replacement in Input. Case-insen'
  +'sitive.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if'
  +' Input matches the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetwee'
  +'n(S, StartMarker, EndMarker) : string\n"'#10'"    Extract the substring of '
  +'S between StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a'
  +' handle returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"  '
  +'  Parse a JSON string and return a handle (>=0). Returns -1 on error.\n"'#10
  +'"  JSONFree(Handle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSO'
  +'NGetString(Handle, Path) : string\n"'#10'"    Get a string value at the spe'
  +'cified Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get a'
  +'n integer value at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path)'
  +' : Extended\n"'#10'"    Get a floating-point value at the specified Path.\n'
  +'"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean valu'
  +'e at the specified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Intege'
  +'r\n"'#10'"    Get the number of elements in an array at the specified Path.'
  +'\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get'
  +' the string value of an array element at the given Index.\n"'#10'"  JSONGet'
  +'ArrayInt(Handle, Path, Index) : Integer\n"'#10'"    Get the integer value o'
  +'f an array element at the given Index.\n"'#10'"  JSONGetType(Handle, Path) '
  +': string\n"'#10'"    Return the type of the value at Path: \"object\", \"ar'
  +'ray\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPa'
  +'thExists(Handle, Path) : Boolean\n"'#10'"    Check if the specified Path ex'
  +'ists.\n"'#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array f'
  +'or building a standard error result.\n"'#10'"  JSONResultAddError(Offset, L'
  +'ength, Message, Replacements)\n"'#10'"    Add an error object to the result'
  +' array. Replacements is a string of values separated by \"|\".\n"'#10'"  JS'
  +'ONResultGet : string\n"'#10'"    Return the current result array as a JSON '
  +'string.\n"'#10'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10
  +'"  Always call JSONFree to release the handle after you are done.\n"'#10'"\'
  +'n"'#10'"Example of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"   '
  +'   s: string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result'
  +'''));\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONG'
  +'etString(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'" '
  ,'     JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Availabl'
  +'e parameters (retrieved with GetParam):\n"'#10'"  text - the input text to '
  +'process (possibly truncated to MaxLength)\n"'#10'"  source - source languag'
  +'e code (may be empty)\n"'#10'"  target - target language code\n"'#10'"  tim'
  +'estamp - current Unix timestamp in milliseconds (string)\n"'#10'"  random  '
  +'- 9-digit random number (string)\n"'#10'"  rand - same as random\n"'#10'"  '
  +'rand1..rand9 - first 1..9 digits of the random number\n"'#10'"\n"'#10'"Addi'
  +'tional initial and custom parameters are also available."'#10'msgstr ""'#10
