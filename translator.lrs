LazarusResources.Add('formconfig.fi','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: fi\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Konfiguraatioeditori"'#10#10'#: formconfig.rclearlanguages'#10'msgi'
  +'d "The list is already filled. Do you want to clear it?"'#10'msgstr "Luette'
  +'lo on jo t'#195#164'ytetty. Tyhjennet'#195#164#195#164'nk'#195#182' se?"'#10
  +#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you want to delete c'
  +'onfig"'#10'msgstr "Oletko varma, ett'#195#164' haluat poistaa konfiguraatio'
  +'n"'#10#10'#: formconfig.rdeleteconfigcaption'#10'msgid "Delete config"'#10
  +'msgstr "Poista konfiguraatio"'#10#10'#: formconfig.rnamequestion'#10'msgid '
  +'"Enter new config file name:"'#10'msgstr "Sy'#195#182't'#195#164' uuden kon'
  +'figuraatiotiedoston nimi:"'#10#10'#: formconfig.rneedsave'#10'msgid "The co'
  +'nfiguration was modified. Save changes?"'#10'msgstr "Konfiguraatiota on muu'
  +'tettu. Tallennetaanko muutokset?"'#10#10'#: formconfig.rresponsehint'#10'ms'
  +'gid ""'#10'"Json Pointer: Use / for levels, keys for objects, and numbers f'
  +'or indexes.\n"'#10'"Use * for all items, *#10 to join items by newline. Use'
  +' ~ at the end of the path to return the raw JSON branch.\n"'#10'"Separate m'
  +'ultiple segments with semicolon ;.\n"'#10'"Literal: Text block in {'#226#128
  +#166'}. Special tag #10 for newlines. Use {{regex}} inside to extract data d'
  +'irectly into the text.\n"'#10'"Logic: If a Pointer in a segment is empty, t'
  +'he whole segment is skipped. If a segment has no Pointer, only literal text'
  +' blocks with embedded regular expressions are processed.\n"'#10'"Regex: {pr'
  +'efix {regex[index]} suffix} inside a text block. If no [index] is specified'
  +', the first match is used.\n"'#10'"Index can be a number, [*] (join by spac'
  +'e), or [*#10] (join by newline). If the regex finds no match, the entire {'
  +#226#128#166'} block is removed.\n"'#10'"Using ~ inside a regex returns the '
  +'entire text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/path{Error})'
  +' to show its text only if the Pointer data is missing or the JSON is invali'
  +'d.\n"'#10'"Commenting: /* text */ comments are stripped from the entire exp'
  +'ression before any processing.\n"'#10'"Examples:\n"'#10'"responseData/trans'
  +'latedText; matches/*#10/translation; /texts/text; {literal text#10}; /resul'
  +'t/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translatio'
  +'ns/0/text"'#10'msgstr ""'#10'"JSON-osoitin: K'#195#164'yt'#195#164' /-merkk'
  +'i'#195#164' tasoille, avaimia objekteille ja numeroita indekseille. K'#195
  +#164'yt'#195#164' *-merkki'#195#164' kaikille kohteille ja *#10 yhdist'#195
  +#164'm'#195#164#195#164'n kohteet rivinvaihdolla. K'#195#164'yt'#195#164' ~-'
  +'merkki'#195#164' polun lopussa palauttaaksesi k'#195#164'sittelem'#195#164
  +'tt'#195#182'm'#195#164'n JSON-haaran. Erottele useita segmenttej'#195#164' '
  +'puolipisteell'#195#164' ;.\n"'#10'"Literaali: Tekstilohko muodossa {'#226
  +#128#166'}. Erikoistunniste #10 rivinvaihdoille. K'#195#164'yt'#195#164' {{r'
  +'egex}}-rakennetta lohkon sis'#195#164'll'#195#164' poimiaksesi tiedot suora'
  +'an tekstiin.\n"'#10'"Logiikka: Jos segmentin osoitin on tyhj'#195#164', kok'
  +'o segmentti ohitetaan. Jos segmentill'#195#164' ei ole osoitinta, k'#195#164
  +'sitell'#195#164#195#164'n vain literaaliset tekstilohkot, joissa on upotett'
  +'uja s'#195#164#195#164'nn'#195#182'llisi'#195#164' lausekkeita.\n"'#10'"Reg'
  +'ex: {etuliite {regex[index]} j'#195#164'lkiliite} tekstilohkon sis'#195#164
  +'ll'#195#164'. Jos [index]-arvoa ei ole m'#195#164#195#164'ritetty, k'#195
  +#164'ytet'#195#164#195#164'n ensimm'#195#164'ist'#195#164' osumaa. Indeksi v'
  +'oi olla numero, [*] (yhdist'#195#164' v'#195#164'lily'#195#182'nnill'#195
  +#164') tai [*#10] (yhdist'#195#164' rivinvaihdolla). Jos s'#195#164#195#164
  +'nn'#195#182'llinen lauseke ei l'#195#182'yd'#195#164' osumaa, koko {'#226
  +#128#166'}-lohko poistetaan. Merkin ~ k'#195#164'ytt'#195#164'minen s'#195
  +#164#195#164'nn'#195#182'llisen lausekkeen sis'#195#164'll'#195#164' palautt'
  +'aa koko tekstin.\n"'#10'"K'#195#164#195#164'nteinen ehto: Aloita segmentti '
  +'merkill'#195#164' ! (esim. !/path{Error}), jotta sen teksti n'#195#164'ytet'
  +#195#164#195#164'n vain, jos osoittimen tiedot puuttuvat tai JSON ei ole kel'
  +'vollinen.\n"'#10'"Kommentit: Kommentit muodossa /* teksti */ poistetaan kok'
  +'o lausekkeesta ennen mit'#195#164#195#164'n k'#195#164'sittely'#195#164'.\n'
  +'"'#10'"Esimerkkej'#195#164':\n"'#10'"responseData/translatedText; matches/*'
  +'#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\'
  +'w+)})}; !/translations{Error: No data!#10}; /translations"'#10#10'#: formco'
  ,'nfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal program:'
  +' optional var section, then a main begin ... end. block.\n"'#10'"\n"'#10'"E'
  +'xample:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam('
  +'''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"   '
  +' SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also use s'
  +'tandard Pascal constructs (if, for, while, repeat, etc.). You can define yo'
  +'ur own functions and procedures before the main begin ... end. block.\n"'#10
  +'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : string\n"'#10
  +'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''name'', ''val'
  +'ue'')\n"'#10'"    Store an output value for the host.\n"'#10'"  GetTimestam'
  +'p() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#10
  +'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with exactly Length'
  +' decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random float in th'
  +'e range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Conv'
  +'ert integer to hexadecimal string with at least Digits characters.\n"'#10'"'
  +'  StrToInt(S) : Integer\n"'#10'"    Convert a string to an integer. Raises '
  +'an exception on invalid input.\n"'#10'"  IntToStr(Value) : string\n"'#10'" '
  +'   Convert an integer to its string representation.\n"'#10'"  Trim(S) : str'
  +'ing\n"'#10'"    Remove leading and trailing whitespace from S.\n"'#10'"  Tr'
  +'imLeft(S) : string\n"'#10'"    Remove leading whitespace from S.\n"'#10'"  '
  +'TrimRight(S) : string\n"'#10'"    Remove trailing whitespace from S.\n"'#10
  +'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML characters in S i'
  +'nto entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HTML enti'
  +'ties in S back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    P'
  +'ercent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : string\n"'
  +#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, OldPatte'
  +'rn, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replace all occurren'
  +'ces of OldPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input, Patte'
  +'rn, Replacement) : string\n"'#10'"    Replace all regex matches of Pattern '
  +'with Replacement in Input. Case-insensitive.\n"'#10'"  RegexMatch(Input, Pa'
  +'ttern) : Boolean\n"'#10'"    Check if Input matches the regex Pattern. Case'
  +'-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\'
  +'n"'#10'"    Extract the substring of S between StartMarker and EndMarker.\n'
  +'"'#10'"\n"'#10'"JSON functions (use a handle returned by JSONParse):\n"'#10
  +'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string and return a hand'
  +'le (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Relea'
  +'se the handle after use.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'
  +#10'"    Get a string value at the specified Path.\n"'#10'"  JSONGetInt(Hand'
  +'le, Path) : Integer\n"'#10'"    Get an integer value at the specified Path.'
  +'\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a floating'
  +'-point value at the specified Path.\n"'#10'"  JSONGetBool(Handle, Path) : B'
  +'oolean\n"'#10'"    Get a boolean value at the specified Path.\n"'#10'"  JSO'
  +'NGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the number of elemen'
  +'ts in an array at the specified Path.\n"'#10'"  JSONGetArrayString(Handle, '
  +'Path, Index) : string\n"'#10'"    Get the string value of an array element '
  +'at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Intege'
  +'r\n"'#10'"    Get the integer value of an array element at the given Index.'
  +'\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Return the type o'
  +'f the value at Path: \"object\", \"array\", \"string\", \"int\", \"float\",'
  +' \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10
  +'"    Check if the specified Path exists.\n"'#10'"  JSONResultInit\n"'#10'" '
  +'   Initialize an empty JSON array for building a standard error result.\n"'
  +#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"   '
  +' Add an error object to the result array. Replacements is a string of value'
  +'s separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Return t'
  +'he current result array as a JSON string.\n"'#10'"  JSONResultClear\n"'#10
  +'"    Clear the result array.\n"'#10'"  Always call JSONFree to release the '
  +'handle after you are done.\n"'#10'"\n"'#10'"Example of working with JSON:\n'
  +'"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'" '
  +'   h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10
  +'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"    '
  +'  SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10
  +'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'
  +#10'"  text - the input text to process (possibly truncated to MaxLength)\n"'
  ,#10'"  source - source language code (may be empty)\n"'#10'"  target - targe'
  +'t language code\n"'#10'"  timestamp - current Unix timestamp in millisecond'
  +'s (string)\n"'#10'"  random  - 9-digit random number (string)\n"'#10'"  ran'
  +'d - same as random\n"'#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#10'"\n"'#10'"Additional initial and custom parameters are also '
  +'available."'#10'msgstr ""'#10'"Skripti on tavallinen Pascal-ohjelma: valinn'
  +'ainen var-osio ja sen j'#195#164'lkeen p'#195#164#195#164'lohko begin ... e'
  +'nd.\n"'#10'"\n"'#10'"Esimerkki:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'
  +#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'
  +''', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'
  +#10'"Voit k'#195#164'ytt'#195#164#195#164' my'#195#182's Pascalin tavallisia'
  +' rakenteita (if, for, while, repeat jne.). Voit m'#195#164#195#164'ritell'
  +#195#164' omia funktioita ja proseduureja ennen p'#195#164#195#164'lohkoa be'
  +'gin ... end.\n"'#10'"\n"'#10'"K'#195#164'ytett'#195#164'viss'#195#164' olev'
  +'at funktiot:\n"'#10'"  GetParam(''name'') : string\n"'#10'"    Hakee sy'#195
  +#182'teparametrin arvon.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"  '
  +'  Tallentaa tulosarvon is'#195#164'nt'#195#164'sovellukselle.\n"'#10'"  Get'
  +'Timestamp() : Int64\n"'#10'"    Nykyinen Unix-aikaleima millisekunteina (UT'
  +'C).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Satunnainen kokonaisluk'
  +'u, jossa on t'#195#164'sm'#195#164'lleen Length desimaalinumeroa.\n"'#10'" '
  +' Random : Extended\n"'#10'"    Satunnainen liukuluku v'#195#164'lill'#195
  +#164' [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Muuntaa'
  +' kokonaisluvun heksadesimaalimerkkijonoksi, jossa on v'#195#164'hint'#195
  +#164#195#164'n Digits merkki'#195#164'.\n"'#10'"  StrToInt(S) : Integer\n"'
  +#10'"    Muuntaa merkkijonon kokonaisluvuksi. Aiheuttaa poikkeuksen, jos sy'
  +#195#182'te ei kelpaa.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Muunta'
  +'a kokonaisluvun merkkijonomuotoon.\n"'#10'"  Trim(S) : string\n"'#10'"    P'
  +'oistaa S:n alussa ja lopussa olevat tyhj'#195#164't merkit.\n"'#10'"  TrimL'
  +'eft(S) : string\n"'#10'"    Poistaa S:n alussa olevat tyhj'#195#164't merki'
  +'t.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Poistaa S:n lopussa olevat t'
  +'yhj'#195#164't merkit.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Koodaa '
  +'S:n erityiset HTML-merkit entiteeteiksi.\n"'#10'"  HtmlDecode(S) : string\n'
  +'"'#10'"    Purkaa S:n HTML-entiteetit takaisin merkeiksi.\n"'#10'"  UrlEnco'
  +'de(S) : string\n"'#10'"    Koodaa S:n prosenttikoodauksella turvallista k'
  +#195#164'ytt'#195#182#195#164' varten URL-osoitteissa.\n"'#10'"  UrlDecode(S'
  +') : string\n"'#10'"    Purkaa prosenttikoodatun merkkijonon S.\n"'#10'"  Re'
  +'placeAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    '
  +'Korvaa kaikki OldPattern-merkkijonon esiintym'#195#164't NewPattern-merkkij'
  +'onolla S:ss'#195#164'.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) '
  +': string\n"'#10'"    Korvaa kaikki s'#195#164#195#164'nn'#195#182'llisen la'
  +'usekkeen Pattern osumat Replacement-merkkijonolla Inputissa. Ei huomioi kir'
  +'jainkokoa.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Tarki'
  +'staa, vastaako Input s'#195#164#195#164'nn'#195#182'llist'#195#164' lauseke'
  +'tta Pattern. Ei huomioi kirjainkokoa.\n"'#10'"  ExtractBetween(S, StartMark'
  +'er, EndMarker) : string\n"'#10'"    Poimii S:st'#195#164' alimerkkijonon St'
  +'artMarker- ja EndMarker-merkkien v'#195#164'list'#195#164'.\n"'#10'"\n"'#10
  +'"JSON-funktiot (k'#195#164'yt'#195#164' JSONParse-funktion palauttamaa k'
  +#195#164'sittelytunnistetta):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    J'
  +#195#164'sent'#195#164#195#164' JSON-merkkijonon ja palauttaa k'#195#164'sit'
  +'telytunnisteen (>=0). Palauttaa -1 virheen sattuessa.\n"'#10'"  JSONFree(Ha'
  +'ndle)\n"'#10'"    Vapauttaa k'#195#164'sittelytunnisteen k'#195#164'yt'#195
  +#182'n j'#195#164'lkeen.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'
  +#10'"    Hakee merkkijonoarvon m'#195#164#195#164'ritetyst'#195#164' Path-po'
  +'lusta.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Hakee kokon'
  +'aislukuarvon m'#195#164#195#164'ritetyst'#195#164' Path-polusta.\n"'#10'"  '
  +'JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Hakee liukulukuarvon m'
  +#195#164#195#164'ritetyst'#195#164' Path-polusta.\n"'#10'"  JSONGetBool(Hand'
  +'le, Path) : Boolean\n"'#10'"    Hakee totuusarvon m'#195#164#195#164'ritety'
  +'st'#195#164' Path-polusta.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Inte'
  +'ger\n"'#10'"    Hakee m'#195#164#195#164'ritetyn Path-polun taulukon elemen'
  +'ttien m'#195#164#195#164'r'#195#164'n.\n"'#10'"  JSONGetArrayString(Handle,'
  +' Path, Index) : string\n"'#10'"    Hakee taulukon elementin merkkijonoarvon'
  +' annetusta Index-indeksist'#195#164'.\n"'#10'"  JSONGetArrayInt(Handle, Pat'
  +'h, Index) : Integer\n"'#10'"    Hakee taulukon elementin kokonaislukuarvon '
  ,'annetusta Index-indeksist'#195#164'.\n"'#10'"  JSONGetType(Handle, Path) : '
  +'string\n"'#10'"    Palauttaa Path-polun arvon tyypin: \"object\", \"array\"'
  +', \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExi'
  +'sts(Handle, Path) : Boolean\n"'#10'"    Tarkistaa, onko m'#195#164#195#164
  +'ritetty Path-polku olemassa.\n"'#10'"  JSONResultInit\n"'#10'"    Alustaa t'
  +'yhj'#195#164'n JSON-taulukon tavallisen virhetuloksen muodostamista varten.'
  +'\n"'#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10
  +'"    Lis'#195#164#195#164' virheobjektin tulostaulukkoon. Replacements on m'
  +'erkkijono arvoista, jotka on erotettu merkill'#195#164' \"|\".\n"'#10'"  JS'
  +'ONResultGet : string\n"'#10'"    Palauttaa nykyisen tulostaulukon JSON-merk'
  +'kijonona.\n"'#10'"  JSONResultClear\n"'#10'"    Tyhjent'#195#164#195#164' t'
  +'ulostaulukon.\n"'#10'"  Kutsu aina JSONFree vapauttaaksesi k'#195#164'sitte'
  +'lytunnisteen, kun olet valmis.\n"'#10'"\n"'#10'"Esimerkki JSON:n k'#195#164
  +'sittelyst'#195#164':\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'
  +#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    i'
  +'f h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.'
  +'path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n'
  +'"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"K'#195#164'ytett'#195#164'v'
  +'iss'#195#164' olevat parametrit (haetaan GetParam-funktiolla):\n"'#10'"  te'
  +'xt - k'#195#164'sitelt'#195#164'v'#195#164' sy'#195#182'tt'#195#182'teksti '
  +'(saatetaan katkaista MaxLength-arvoon)\n"'#10'"  source - l'#195#164'hdekie'
  +'len koodi (voi olla tyhj'#195#164')\n"'#10'"  target - kohdekielen koodi\n"'
  +#10'"  timestamp - nykyinen Unix-aikaleima millisekunteina (merkkijono)\n"'
  +#10'"  random  - satunnainen 9-numeroinen luku (merkkijono)\n"'#10'"  rand -'
  +' sama kuin random\n"'#10'"  rand1..rand9 - satunnaisluvun ensimm'#195#164'i'
  +'set 1..9 numeroa\n"'#10'"\n"'#10'"Saatavilla on my'#195#182's muita alkuper'
  +#195#164'isi'#195#164' ja mukautettuja parametreja.ss'#195#164'."'#10#10'#: '
  +'formconfig.rscriptresponsehint'#10'msgid ""'#10'"This script processes the '
  +'response data. All functions and parameters described in the script hint ar'
  +'e available here as well.\n"'#10'"Use GetParam(''result'') to obtain the re'
  +'ceived text.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  b'
  +'egin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''result'
  +''', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can define custom parameters in'
  +' the parameters script using SetParam(''name'', ''value''),\n"'#10'"and the'
  +'n retrieve them here with GetParam(''name'')."'#10'msgstr ""'#10'"T'#195#164
  +'m'#195#164' komentosarja k'#195#164'sittelee vastaustietoja. Kaikki komento'
  +'sarjan ohjeessa kuvatut funktiot ja parametrit ovat k'#195#164'ytett'#195
  +#164'viss'#195#164' my'#195#182's t'#195#164#195#164'll'#195#164'.\n"'#10'"K'
  +#195#164'yt'#195#164' GetParam(''result'')-funktiota vastaanotetun tekstin h'
  +'akemiseen.\n"'#10'"\n"'#10'"Esimerkki:\n"'#10'"  var s: string;\n"'#10'"  b'
  +'egin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''result'
  +''', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Voit m'#195#164#195#164'ritt'#195
  +#164#195#164' mukautettuja parametreja parametrikomentosarjassa k'#195#164'y'
  +'tt'#195#164'm'#195#164'll'#195#164' SetParam(''name'', ''value''),\n"'#10'"'
  +'ja hakea ne sitten t'#195#164#195#164'll'#195#164' GetParam(''name'')-funkt'
  +'iolla."'#10#10'#: formconfig.rvaluetype1'#10'msgctxt "formconfig.rvaluetype'
  +'1"'#10'msgid "None"'#10'msgstr "Ei mit'#195#164#195#164'n"'#10#10'#: formco'
  +'nfig.rvaluetype2'#10'msgid "Language"'#10'msgstr "Kieli"'#10#10'#: formconf'
  +'ig.rvaluetype3'#10'msgid "Currency All"'#10'msgstr "Kaikki valuutat"'#10#10
  +'#: formconfig.rvaluetype4'#10'msgid "Currency Fiat Only"'#10'msgstr "Vain f'
  +'iat-valuutat"'#10#10'#: formconfig.rvaluetype5'#10'msgid "Currency Crypto O'
  +'nly"'#10'msgstr "Vain kryptovaluutat"'#10#10'#: formconfig.rvaluetype6'#10
  +'msgid "Measurement Units"'#10'msgstr "Mittayksik'#195#182't"'#10#10'#: tfor'
  +'mconfigtrayslate.aclearicon.caption'#10'msgid "Clear Icon"'#10'msgstr "Tyhj'
  +'enn'#195#164' kuvake"'#10#10'#: tformconfigtrayslate.asave.caption'#10'msgi'
  +'d "Save"'#10'msgstr "Tallenna"'#10#10'#: tformconfigtrayslate.asaveiconas.c'
  +'aption'#10'msgid "Save Icon As..."'#10'msgstr "Tallenna kuvake nimell'#195
  +#164'..."'#10#10'#: tformconfigtrayslate.btnclose.caption'#10'msgid "Close"'
  +#10'msgstr "Sulje"'#10#10'#: tformconfigtrayslate.btninitparameterstest.hint'
  +#10'msgid "Execute request and view the parameters"'#10'msgstr "Suorita pyyn'
  +'t'#195#182' ja tarkastele parametreja"'#10#10'#: tformconfigtrayslate.btnin'
  +'iturltest.hint'#10'msgid "Execute request and view the result"'#10'msgstr "'
  +'Suorita pyynt'#195#182' ja tarkastele tulosta"'#10#10'#: tformconfigtraysla'
  +'te.btnpostdatatest.hint'#10'msgid "Execute post request and view the result'
  ,'"'#10'msgstr "Suorita POST-pyynt'#195#182' ja tarkastele tulosta"'#10#10'#:'
  +' tformconfigtrayslate.btnresponsehelp.hint'#10'msgctxt "tformconfigtrayslat'
  +'e.btnresponsehelp.hint"'#10'msgid "Help"'#10'msgstr "Ohje"'#10#10'#: tformc'
  +'onfigtrayslate.btnresponsetest.hint'#10'msgid "Converts the current respons'
  +'e"'#10'msgstr "Muuntaa nykyisen vastauksen"'#10#10'#: tformconfigtrayslate.'
  +'btnscripthelp.hint'#10'msgctxt "tformconfigtrayslate.btnscripthelp.hint"'#10
  +'msgid "Help"'#10'msgstr "Ohje"'#10#10'#: tformconfigtrayslate.btnscriptresp'
  +'onsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnscriptresponsehelp.hint"'
  +#10'msgid "Help"'#10'msgstr "Ohje"'#10#10'#: tformconfigtrayslate.btnscriptr'
  +'esponsetest.hint'#10'msgctxt "tformconfigtrayslate.btnscriptresponsetest.hi'
  +'nt"'#10'msgid "Execute script and view the result"'#10'msgstr "Suorita kome'
  +'ntosarja ja n'#195#164'yt'#195#164' tulos"'#10#10'#: tformconfigtrayslate.b'
  +'tnscripttest.hint'#10'msgctxt "tformconfigtrayslate.btnscripttest.hint"'#10
  +'msgid "Execute script and view the result"'#10'msgstr "Suorita komentosarja'
