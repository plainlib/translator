  +#163'o extra'#195#173'dos da resposta e usados pelo nome nos pedidos"'#10#10
  +'#: tformconfigtrayslate.labelinitparameters1.caption'#10'msgid "Time in sec'
  +'onds to refresh parameters with a new request (0 = every request)"'#10'msgs'
  +'tr "Tempo em segundos para atualizar os par'#195#162'metros com um novo ped'
  +'ido (0 = cada pedido)"'#10#10'#: tformconfigtrayslate.labelinitparameters2.'
  +'caption'#10'msgctxt "tformconfigtrayslate.labelinitparameters2.caption"'#10
  +'msgid "Parameters"'#10'msgstr "Par'#195#162'metros"'#10#10'#: tformconfigtr'
  +'ayslate.labelinitparameters4.caption'#10'msgid "Parameters in the form key='
  +'value used by {key} in requests. If the value is omitted (key=), it will be'
  +' requested from the user."'#10'msgstr "Par'#195#162'metros no formato key=v'
  +'alue utilizados por {key} nos pedidos. Se o valor for omitido (key=), ser'
  +#195#161' solicitado ao utilizador."'#10#10'#: tformconfigtrayslate.labelini'
  +'tparemeters.caption'#10'msgid "Initial GET request to obtain required param'
  +'eters."'#10'msgstr "Pedido GET inicial para obter os par'#195#162'metros ne'
  +'cess'#195#161'rios."'#10#10'#: tformconfigtrayslate.labeliniturl.caption'#10
  +'msgctxt "tformconfigtrayslate.labeliniturl.caption"'#10'msgid "URL"'#10'msg'
  +'str "URL"'#10#10'#: tformconfigtrayslate.labelinituseragent.caption'#10'msg'
  +'ctxt "tformconfigtrayslate.labelinituseragent.caption"'#10'msgid "User Agen'
  +'t"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labellanguages.ca'
  +'ption'#10'msgid "Supported languages e.g. en=en-US (en - internal, en-US - '
  +'service). \"empty\" - do not send."'#10'msgstr "Idiomas suportados, por exe'
  +'mplo, en=en-US (en - interno, en-US - servi'#195#167'o). \"empty\" - n'#195
  +#163'o enviar."'#10#10'#: tformconfigtrayslate.labellanguages1.caption'#10'm'
  +'sgid "Value type for populating names. None keeps originals; None and Unit '
  +'are case-sensitive."'#10'msgstr "Tipo de valor para preencher nomes. None m'
  +'ant'#195#169'm os originais; None e Unit diferenciam mai'#195#186'sculas de'
  +' min'#195#186'sculas."'#10#10'#: tformconfigtrayslate.labellanguagestarget.'
  +'caption'#10'msgid ""'#10'"Target languages e.g. en=en-US, en - internal, en'
  +'-US - service code.\n"'#10'"If not specified, both source and target langua'
  +'ges are taken from the languages section."'#10'msgstr ""'#10'"Idiomas de de'
  +'stino, por exemplo, en=en-US, en - interno, en-US - c'#195#179'digo do serv'
  +'i'#195#167'o.\n"'#10'"Se n'#195#163'o especificado, tanto o idioma de orige'
  +'m quanto os de destino s'#195#163'o retirados da sec'#195#167#195#163'o de '
  +'idiomas."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid "'
  +'Max Length, bytes"'#10'msgstr "Comprimento m'#195#161'ximo, bytes"'#10#10'#'
  +': tformconfigtrayslate.labelmethod.caption'#10'msgid "Method"'#10'msgstr "M'
  +#195#169'todo"'#10#10'#: tformconfigtrayslate.labelparemeters.caption'#10'ms'
  +'gid "Use parameters: {text} '#226#128#147' input text, {source} '#226#128
  +#147' source language, {target} '#226#128#147' target language. Prefix the n'
  +'ame with ! for lowercase or ^ for uppercase value. Also supported {timestam'
  +'p}, {rand}. Use {parameter} from the parameters page."'#10'msgstr "Use par'
  +#195#162'metros: {text} '#226#128#147' texto de entrada, {source} '#226#128
  +#147' idioma de origem, {target} '#226#128#147' idioma de destino. Prefixe o'
  +' nome com ! para min'#195#186'sculas ou ^ para mai'#195#186'sculas. Tamb'
  +#195#169'm suportados {timestamp}, {rand}. Use {parameter} da p'#195#161'gin'
  +'a de par'#195#162'metros."'#10#10'#: tformconfigtrayslate.labelpostdata.cap'
  +'tion'#10'msgid "Post Data"'#10'msgstr "Post Data"'#10#10'#: tformconfigtray'
  +'slate.labelpostdata1.caption'#10'msgctxt "tformconfigtrayslate.labelpostdat'
  +'a1.caption"'#10'msgid "Headers"'#10'msgstr "Headers"'#10#10'#: tformconfigt'
  +'rayslate.labelservicedescription.caption'#10'msgid "Description"'#10'msgstr'
  +' "Descri'#195#167#195#163'o"'#10#10'#: tformconfigtrayslate.labelservicenam'
