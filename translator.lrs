  +'.labelserviceorder.caption'#10'msgid "Order"'#10'msgstr "Ordem"'#10#10'#: t'
  +'formconfigtrayslate.labelsort.caption'#10'msgctxt "tformconfigtrayslate.lab'
  +'elsort.caption"'#10'msgid "Sort"'#10'msgstr "Ordenar"'#10#10'#: tformconfig'
