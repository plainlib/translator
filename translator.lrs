  +#137#224#164#168#224#165#141#224#164#171#224#164#188#224#164#191#224#164#151
  +#224#164#176#224#165#135#224#164#182#224#164#168' '#224#164#149#224#165#137
  +#224#164#170#224#165#128' '#224#164#149#224#164#176#224#165#135#224#164#130
  +'"'#10#10'#: tformconfigtrayslate.sbnewconfig.hint'#10'msgid "New configurat'
  +'ion"'#10'msgstr "'#224#164#168#224#164#175#224#164#190' '#224#164#149#224
  +#165#137#224#164#168#224#165#141#224#164#171#224#164#188#224#164#191#224#164
  +#151#224#164#176#224#165#135#224#164#182#224#164#168'"'#10#10
]);
LazarusResources.Add('formconfig.id','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: id\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Editor Konfigurasi"'#10#10'#: formconfig.rclearlanguages'#10'msgid '
  +'"The list is already filled. Do you want to clear it?"'#10'msgstr "Daftar s'
  +'udah terisi. Apakah Anda ingin mengosongkannya?"'#10#10'#: formconfig.rdele'
  +'teconfig'#10'msgid "Are you sure you want to delete config"'#10'msgstr "Apa'
  +'kah Anda yakin ingin menghapus konfigurasi"'#10#10'#: formconfig.rdeletecon'
  +'figcaption'#10'msgid "Delete config"'#10'msgstr "Hapus konfigurasi"'#10#10
  +'#: formconfig.rnamequestion'#10'msgid "Enter new config file name:"'#10'msg'
  +'str "Masukkan nama file konfigurasi baru:"'#10#10'#: formconfig.rneedsave'
  +#10'msgid "The configuration was modified. Save changes?"'#10'msgstr "Konfig'
  +'urasi telah diubah. Simpan perubahan?"'#10#10'#: formconfig.rresponsehint'
  +#10'msgid ""'#10'"Json Pointer: Use / for levels, keys for objects, and numb'
  +'ers for indexes.\n"'#10'"Use * for all items, *#10 to join items by newline'
  +'. Use ~ at the end of the path to return the raw JSON branch.\n"'#10'"Separ'
  +'ate multiple segments with semicolon ;.\n"'#10'"Literal: Text block in {'
  +#226#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to extrac'
  +'t data directly into the text.\n"'#10'"Logic: If a Pointer in a segment is '
  +'empty, the whole segment is skipped. If a segment has no Pointer, only lite'
  +'ral text blocks with embedded regular expressions are processed.\n"'#10'"Re'
  +'gex: {prefix {regex[index]} suffix} inside a text block. If no [index] is s'
  +'pecified, the first match is used.\n"'#10'"Index can be a number, [*] (join'
  +' by space), or [*#10] (join by newline). If the regex finds no match, the e'
  +'ntire {'#226#128#166'} block is removed.\n"'#10'"Using ~ inside a regex ret'
  +'urns the entire text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/pat'
  +'h{Error}) to show its text only if the Pointer data is missing or the JSON '
  +'is invalid.\n"'#10'"Commenting: /* text */ comments are stripped from the e'
  +'ntire expression before any processing.\n"'#10'"Examples:\n"'#10'"responseD'
  +'ata/translatedText; matches/*#10/translation; /texts/text; {literal text#10'
  +'}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /t'
  +'ranslations/0/text"'#10'msgstr ""'#10'"Pointer JSON: Gunakan / untuk level,'
  +' kunci untuk objek, dan angka untuk indeks. Gunakan * untuk semua item, dan'
  +' *#10 untuk menggabungkan item dengan baris baru. Gunakan ~ di akhir jalur '
  +'untuk mengembalikan cabang JSON mentah. Pisahkan beberapa segmen dengan tit'
  +'ik koma ;.\n"'#10'"Literal: Blok teks di dalam {'#226#128#166'}. Tag khusus'
  +' #10 untuk baris baru. Gunakan {{regex}} di dalamnya untuk mengekstrak data'
  +' langsung ke dalam teks.\n"'#10'"Logika: Jika sebuah pointer dalam segmen k'
  +'osong, seluruh segmen dilewati. Jika sebuah segmen tidak memiliki pointer, '
  +'hanya blok teks literal dengan ekspresi reguler yang disematkan yang dipros'
  +'es.\n"'#10'"Regex: {awalan {regex[index]} akhiran} di dalam blok teks. Jika'
  +' [index] tidak ditentukan, kecocokan pertama akan digunakan. Indeks dapat b'
  +'erupa angka, [*] (gabungkan dengan spasi), atau [*#10] (gabungkan dengan ba'
  +'ris baru). Jika ekspresi reguler tidak menemukan kecocokan, seluruh blok {'
  +#226#128#166'} akan dihapus. Menggunakan ~ di dalam ekspresi reguler akan me'
  +'ngembalikan seluruh teks.\n"'#10'"Inversi: Awali segmen dengan ! (misalnya '
  +'!/path{Error}) agar teksnya hanya ditampilkan jika data pointer tidak ada a'
  +'tau JSON tidak valid.\n"'#10'"Komentar: Komentar /* teks */ dihapus dari se'
  +'luruh ekspresi sebelum pemrosesan apa pun.\n"'#10'"Contoh:\n"'#10'"response'
  +'Data/translatedText; matches/*#10/translation; /texts/text; {literal text#1'
  +'0}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /'
  +'translations"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script'
  +' is a standard Pascal program: optional var section, then a main begin ... '
  +'end. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  be'
  +'gin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'
  +''', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"You can also use standard Pascal constructs (if, for, while, repe'
  +'at, etc.). You can define your own functions and procedures before the main'
  +' begin ... end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetP'
  +'aram(''name'') : string\n"'#10'"    Retrieve an input parameter value.\n"'
  +#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an output value for '
  ,'the host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timesta'
  +'mp in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    R'
  +'andom integer with exactly Length decimal digits.\n"'#10'"  Random : Extend'
  +'ed\n"'#10'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, '
  +'Digits) : string\n"'#10'"    Convert integer to hexadecimal string with at '
  +'least Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Conver'
  +'t a string to an integer. Raises an exception on invalid input.\n"'#10'"  I'
  +'ntToStr(Value) : string\n"'#10'"    Convert an integer to its string repres'
  +'entation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailin'
  +'g whitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove lead'
  +'ing whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove t'
  +'railing whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Enc'
  +'ode special HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : s'
  +'tring\n"'#10'"    Decode HTML entities in S back to characters.\n"'#10'"  U'
  +'rlEncode(S) : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n'
  +'"'#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-encoded string '
  +'S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : stri'
  +'ng\n"'#10'"    Replace all occurrences of OldPattern with NewPattern in S.\'
  +'n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Re'
  +'place all regex matches of Pattern with Replacement in Input. Case-insensit'
  +'ive.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if In'
  +'put matches the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S'
  +', StartMarker, EndMarker) : string\n"'#10'"    Extract the substring of S b'
  +'etween StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a ha'
  +'ndle returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    P'
  +'arse a JSON string and return a handle (>=0). Returns -1 on error.\n"'#10'"'
  +'  JSONFree(Handle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSON'
  +'GetString(Handle, Path) : string\n"'#10'"    Get a string value at the spec'
  +'ified Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an'
  +' integer value at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) '
  +': Extended\n"'#10'"    Get a floating-point value at the specified Path.\n"'
  +#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value a'
  +'t the specified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n'
  +'"'#10'"    Get the number of elements in an array at the specified Path.\n"'
  +#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#10'"  JSONGetArray'
  +'Int(Handle, Path, Index) : Integer\n"'#10'"    Get the integer value of an '
  +'array element at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : str'
  +'ing\n"'#10'"    Return the type of the value at Path: \"object\", \"array\"'
  +', \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExi'
  +'sts(Handle, Path) : Boolean\n"'#10'"    Check if the specified Path exists.'
  +'\n"'#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for bu'
  +'ilding a standard error result.\n"'#10'"  JSONResultAddError(Offset, Length'
  +', Message, Replacements)\n"'#10'"    Add an error object to the result arra'
  +'y. Replacements is a string of values separated by \"|\".\n"'#10'"  JSONRes'
  +'ultGet : string\n"'#10'"    Return the current result array as a JSON strin'
  +'g.\n"'#10'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  '
  +'Always call JSONFree to release the handle after you are done.\n"'#10'"\n"'
  +#10'"Example of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s'
  +': string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));'
  +'\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetStr'
  +'ing(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      '
  +'JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available par'
  +'ameters (retrieved with GetParam):\n"'#10'"  text - the input text to proce'
  +'ss (possibly truncated to MaxLength)\n"'#10'"  source - source language cod'
  +'e (may be empty)\n"'#10'"  target - target language code\n"'#10'"  timestam'
  +'p - current Unix timestamp in milliseconds (string)\n"'#10'"  random  - 9-d'
  +'igit random number (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1'
  +'..rand9 - first 1..9 digits of the random number\n"'#10'"\n"'#10'"Additiona'
  +'l initial and custom parameters are also available."'#10'msgstr ""'#10'"Skr'
  +'ip ini adalah program Pascal standar: bagian var opsional, lalu blok utama '
  +'begin ... end.\n"'#10'"\n"'#10'"Contoh:\n"'#10'"  var s: string;\n"'#10'"  '
  +'begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, '
  +'''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'
  ,#10'"\n"'#10'"Anda juga dapat menggunakan konstruksi Pascal standar (if, for'
  +', while, repeat, dll.). Anda dapat mendefinisikan fungsi dan prosedur Anda '
  +'sendiri sebelum blok utama begin ... end.\n"'#10'"\n"'#10'"Fungsi yang ters'
  +'edia:\n"'#10'"  GetParam(''name'') : string\n"'#10'"    Mengambil nilai par'
  +'ameter input.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Menyimpa'
  +'n nilai output untuk host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Tim'
  +'estamp Unix saat ini dalam milidetik (UTC).\n"'#10'"  GetRandom(Length) : I'
  +'nt64\n"'#10'"    Bilangan bulat acak dengan tepat Length digit desimal.\n"'
  +#10'"  Random : Extended\n"'#10'"    Bilangan floating-point acak dalam rent'
  +'ang [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Mengonve'
  +'rsi bilangan bulat menjadi string heksadesimal dengan setidaknya Digits kar'
  +'akter.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Mengonversi string menja'
  +'di bilangan bulat. Menghasilkan pengecualian jika input tidak valid.\n"'#10
  +'"  IntToStr(Value) : string\n"'#10'"    Mengonversi bilangan bulat menjadi '
  +'representasi string-nya.\n"'#10'"  Trim(S) : string\n"'#10'"    Menghapus s'
  +'pasi di awal dan akhir S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Mengha'
  +'pus spasi di awal S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Menghapus '
  +'spasi di akhir S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Mengodekan k'
  +'arakter HTML khusus dalam S menjadi entitas.\n"'#10'"  HtmlDecode(S) : stri'
  +'ng\n"'#10'"    Mendekode entitas HTML dalam S kembali menjadi karakter.\n"'
  +#10'"  UrlEncode(S) : string\n"'#10'"    Melakukan pengodean persen pada S a'
  +'gar aman disertakan dalam URL.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    '
  +'Mendekode string S yang telah dikodekan dengan pengodean persen.\n"'#10'"  '
  +'ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"  '
  +'  Mengganti semua kemunculan OldPattern dengan NewPattern dalam S.\n"'#10'"'
  +'  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Mengganti '
  +'semua kecocokan ekspresi reguler Pattern dengan Replacement dalam Input. Ti'
  +'dak membedakan huruf besar-kecil.\n"'#10'"  RegexMatch(Input, Pattern) : Bo'
  +'olean\n"'#10'"    Memeriksa apakah Input cocok dengan ekspresi reguler Patt'
  +'ern. Tidak membedakan huruf besar-kecil.\n"'#10'"  ExtractBetween(S, StartM'
  +'arker, EndMarker) : string\n"'#10'"    Mengekstrak substring dari S yang be'
  +'rada di antara StartMarker dan EndMarker.\n"'#10'"\n"'#10'"Fungsi JSON (gun'
  +'akan handle yang dikembalikan oleh JSONParse):\n"'#10'"  JSONParse(S) : Int'
  +'eger\n"'#10'"    Mengurai string JSON dan mengembalikan handle (>=0). Menge'
  +'mbalikan -1 jika terjadi kesalahan.\n"'#10'"  JSONFree(Handle)\n"'#10'"    '
  +'Melepaskan handle setelah digunakan.\n"'#10'"  JSONGetString(Handle, Path) '
  +': string\n"'#10'"    Mendapatkan nilai string pada Path yang ditentukan.\n"'
  +#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Mendapatkan nilai bila'
  +'ngan bulat pada Path yang ditentukan.\n"'#10'"  JSONGetFloat(Handle, Path) '
  +': Extended\n"'#10'"    Mendapatkan nilai floating-point pada Path yang dite'
  +'ntukan.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Mendapatk'
  +'an nilai boolean pada Path yang ditentukan.\n"'#10'"  JSONGetArrayCount(Han'
  +'dle, Path) : Integer\n"'#10'"    Mendapatkan jumlah elemen dalam array pada'
  +' Path yang ditentukan.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : '
  +'string\n"'#10'"    Mendapatkan nilai string elemen array pada Index yang di'
  +'tentukan.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#10'"'
  +'    Mendapatkan nilai bilangan bulat elemen array pada Index yang ditentuka'
  +'n.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Mengembalikan t'
  +'ipe nilai pada Path: \"object\", \"array\", \"string\", \"int\", \"float\",'
  +' \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10
  +'"    Memeriksa apakah Path yang ditentukan ada.\n"'#10'"  JSONResultInit\n"'
  +#10'"    Menginisialisasi array JSON kosong untuk membuat hasil kesalahan st'
  +'andar.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\'
  +'n"'#10'"    Menambahkan objek kesalahan ke array hasil. Replacements adalah'
  +' string nilai yang dipisahkan dengan \"|\".\n"'#10'"  JSONResultGet : strin'
  +'g\n"'#10'"    Mengembalikan array hasil saat ini sebagai string JSON.\n"'#10
  +'"  JSONResultClear\n"'#10'"    Menghapus array hasil.\n"'#10'"  Selalu pang'
  +'gil JSONFree untuk melepaskan handle setelah selesai menggunakannya.\n"'#10
  +'"\n"'#10'"Contoh penggunaan JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s'
  +': string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));'
  +'\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetStr'
  +'ing(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      '
  +'JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Parameter yan'
  +'g tersedia (diambil dengan GetParam):\n"'#10'"  text - teks input yang akan'
  ,' diproses (mungkin dipotong hingga MaxLength)\n"'#10'"  source - kode bahas'
  +'a sumber (dapat kosong)\n"'#10'"  target - kode bahasa target\n"'#10'"  tim'
  +'estamp - timestamp Unix saat ini dalam milidetik (string)\n"'#10'"  random '
  +' - angka acak 9 digit (string)\n"'#10'"  rand - sama dengan random\n"'#10'"'
  +'  rand1..rand9 - 1..9 digit pertama dari angka acak\n"'#10'"\n"'#10'"Parame'
  +'ter awal dan parameter kustom tambahan juga tersedia.\n"'#10'"Parameter awa'
  +'l dan parameter kustom tambahan juga tersedia."'#10#10'#: formconfig.rscrip'
  +'tresponsehint'#10'msgid ""'#10'"This script processes the response data. Al'
  +'l functions and parameters described in the script hint are available here '
  +'as well.\n"'#10'"Use GetParam(''result'') to obtain the received text.\n"'
  +#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    '
  +'s := GetParam(''result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  '
  +'end.\n"'#10'"\n"'#10'"You can define custom parameters in the parameters sc'
  +'ript using SetParam(''name'', ''value''),\n"'#10'"and then retrieve them he'
  +'re with GetParam(''name'')."'#10'msgstr ""'#10'"Skrip ini memproses data re'
  +'spons. Semua fungsi dan parameter yang dijelaskan dalam petunjuk skrip juga'
  +' tersedia di sini.\n"'#10'"Gunakan GetParam(''result'') untuk memperoleh te'
  +'ks yang diterima.\n"'#10'"\n"'#10'"Contoh:\n"'#10'"  var s: string;\n"'#10
  +'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''res'
  +'ult'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Anda dapat menentukan parameter '
  +'khusus dalam skrip parameter menggunakan SetParam(''name'', ''value''),\n"'
  +#10'"lalu mengambilnya di sini dengan GetParam(''name'')."'#10#10'#: formcon'
  +'fig.rvaluetype1'#10'msgctxt "formconfig.rvaluetype1"'#10'msgid "None"'#10'm'
  +'sgstr "Tidak ada"'#10#10'#: formconfig.rvaluetype2'#10'msgid "Language"'#10
  +'msgstr "Bahasa"'#10#10'#: formconfig.rvaluetype3'#10'msgid "Currency All"'
  +#10'msgstr "Semua Mata Uang"'#10#10'#: formconfig.rvaluetype4'#10'msgid "Cur'
  +'rency Fiat Only"'#10'msgstr "Hanya Mata Uang Fiat"'#10#10'#: formconfig.rva'
  +'luetype5'#10'msgid "Currency Crypto Only"'#10'msgstr "Hanya Mata Uang Kript'
  +'o"'#10#10'#: formconfig.rvaluetype6'#10'msgid "Measurement Units"'#10'msgst'
  +'r "Satuan Ukur"'#10#10'#: tformconfigtrayslate.aclearicon.caption'#10'msgid'
  +' "Clear Icon"'#10'msgstr "Hapus Ikon"'#10#10'#: tformconfigtrayslate.asave.'
  +'caption'#10'msgid "Save"'#10'msgstr "Simpan"'#10#10'#: tformconfigtrayslate'
  +'.asaveiconas.caption'#10'msgid "Save Icon As..."'#10'msgstr "Simpan Ikon Se'
  +'bagai..."'#10#10'#: tformconfigtrayslate.btnclose.caption'#10'msgid "Close"'
  +#10'msgstr "Tutup"'#10#10'#: tformconfigtrayslate.btninitparameterstest.hint'
  +#10'msgid "Execute request and view the parameters"'#10'msgstr "Jalankan per'
  +'mintaan dan lihat parameter"'#10#10'#: tformconfigtrayslate.btniniturltest.'
  +'hint'#10'msgid "Execute request and view the result"'#10'msgstr "Jalankan p'
  +'ermintaan dan lihat hasilnya"'#10#10'#: tformconfigtrayslate.btnpostdatates'
  +'t.hint'#10'msgid "Execute post request and view the result"'#10'msgstr "Jal'
  +'ankan permintaan POST dan lihat hasilnya"'#10#10'#: tformconfigtrayslate.bt'
  +'nresponsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnresponsehelp.hint"'
  +#10'msgid "Help"'#10'msgstr "Bantuan"'#10#10'#: tformconfigtrayslate.btnresp'
  +'onsetest.hint'#10'msgid "Converts the current response"'#10'msgstr "Mengonv'
  +'ersi respons saat ini"'#10#10'#: tformconfigtrayslate.btnscripthelp.hint'#10
  +'msgctxt "tformconfigtrayslate.btnscripthelp.hint"'#10'msgid "Help"'#10'msgs'
  +'tr "Bantuan"'#10#10'#: tformconfigtrayslate.btnscriptresponsehelp.hint'#10
  +'msgctxt "tformconfigtrayslate.btnscriptresponsehelp.hint"'#10'msgid "Help"'
  +#10'msgstr "Bantuan"'#10#10'#: tformconfigtrayslate.btnscriptresponsetest.hi'
  +'nt'#10'msgctxt "tformconfigtrayslate.btnscriptresponsetest.hint"'#10'msgid '
  +'"Execute script and view the result"'#10'msgstr "Jalankan skrip dan lihat h'
  +'asilnya"'#10#10'#: tformconfigtrayslate.btnscripttest.hint'#10'msgctxt "tfo'
  +'rmconfigtrayslate.btnscripttest.hint"'#10'msgid "Execute script and view th'
  +'e result"'#10'msgstr "Jalankan skrip dan lihat hasilnya"'#10#10'#: tformcon'
  +'figtrayslate.btnurltest.hint'#10'msgid "Execute get request and view the re'
  +'sult"'#10'msgstr "Jalankan permintaan GET dan lihat hasilnya"'#10#10'#: tfo'
  +'rmconfigtrayslate.caption'#10'msgctxt "tformconfigtrayslate.caption"'#10'ms'
  +'gid "Config Editor"'#10'msgstr "Editor Konfigurasi"'#10#10'#: tformconfigtr'
  +'ayslate.checkencodecustomparameters.caption'#10'msgid "Encode parameters"'
  +#10'msgstr "Parameter enkode"'#10#10'#: tformconfigtrayslate.checkencodetext'
  +'.caption'#10'msgid "Encode {text} parameter"'#10'msgstr "Enkode parameter {'
  +'text}"'#10#10'#: tformconfigtrayslate.checkserviceautoswap.caption'#10'msgi'
  +'d "Allow auto-swap language pair"'#10'msgstr "Izinkan pertukaran pasangan b'
  +'ahasa secara otomatis"'#10#10'#: tformconfigtrayslate.checkserviceonlybutto'
  ,'n.caption'#10'msgid "Allow translation only by translation button"'#10'msgs'
  +'tr "Izinkan penerjemahan hanya melalui tombol terjemahan"'#10#10'#: tformco'
  +'nfigtrayslate.checkserviceproxy.caption'#10'msgid "Allow proxy"'#10'msgstr '
  +'"Izinkan proxy"'#10#10'#: tformconfigtrayslate.checkservicerealtime.caption'
  +#10'msgid "Allow translate as you type"'#10'msgstr "Izinkan penerjemahan saa'
  +'t mengetik"'#10#10'#: tformconfigtrayslate.checkservicevisible.caption'#10
  +'msgid "Visible in menu"'#10'msgstr "Tampil di menu"'#10#10'#: tformconfigtr'
  +'ayslate.combomethod.text'#10'msgid "GET"'#10'msgstr "GET"'#10#10'#: tformco'
  +'nfigtrayslate.combovaluetype.text'#10'msgctxt "tformconfigtrayslate.combova'
  +'luetype.text"'#10'msgid "None"'#10'msgstr "Tidak ada"'#10#10'#: tformconfig'
  +'trayslate.groupboxcustomparameters.caption'#10'msgid "Custom Parameters"'#10
  +'msgstr "Parameter kustom"'#10#10'#: tformconfigtrayslate.groupboxservice.ca'
  +'ption'#10'msgctxt "tformconfigtrayslate.groupboxservice.caption"'#10'msgid '
  +'"Service"'#10'msgstr "Layanan"'#10#10'#: tformconfigtrayslate.groupinitpara'
  +'meters.caption'#10'msgctxt "tformconfigtrayslate.groupinitparameters.captio'
  +'n"'#10'msgid "Initial Request"'#10'msgstr "Permintaan Awal"'#10#10'#: tform'
  +'configtrayslate.grouplanguages.caption'#10'msgctxt "tformconfigtrayslate.gr'
  +'ouplanguages.caption"'#10'msgid "Languages"'#10'msgstr "Bahasa"'#10#10'#: t'
  +'formconfigtrayslate.grouplanguagestarget.caption'#10'msgctxt "tformconfigtr'
  +'ayslate.grouplanguagestarget.caption"'#10'msgid "Target Languages"'#10'msgs'
  +'tr "Bahasa Sasaran"'#10#10'#: tformconfigtrayslate.grouprequest.caption'#10
  +'msgctxt "tformconfigtrayslate.grouprequest.caption"'#10'msgid "Request"'#10
  +'msgstr "Permintaan"'#10#10'#: tformconfigtrayslate.groupresponse.caption'#10
