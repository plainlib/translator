LazarusResources.Add('formconfig.cs','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: cs\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Editor konfigurace"'#10#10'#: formconfig.rclearlanguages'#10'msgid '
  +'"The list is already filled. Do you want to clear it?"'#10'msgstr "Seznam j'
  +'e ji'#197#190' zapln'#196#155'n. Chcete jej vy'#196#141'istit?"'#10#10'#: f'
  +'ormconfig.rdeleteconfig'#10'msgid "Are you sure you want to delete config"'
  +#10'msgstr "Opravdu chcete smazat konfiguraci"'#10#10'#: formconfig.rdeletec'
  +'onfigcaption'#10'msgid "Delete config"'#10'msgstr "Smazat konfiguraci"'#10
  +#10'#: formconfig.rnamequestion'#10'msgid "Enter new config file name:"'#10
  +'msgstr "Zadejte n'#195#161'zev nov'#195#169'ho konfigura'#196#141'n'#195#173
  +'ho souboru:"'#10#10'#: formconfig.rneedsave'#10'msgid "The configuration wa'
  +'s modified. Save changes?"'#10'msgstr "Konfigurace byla zm'#196#155'n'#196
  +#155'na. Ulo'#197#190'it zm'#196#155'ny?"'#10#10'#: formconfig.rresponsehint'
  +#10'msgid ""'#10'"Json Pointer: Use / for levels, keys for objects, and numb'
  +'ers for indexes.\n"'#10'"Use * for all items, *#10 to join items by newline'
  +'. Use ~ at the end of the path to return the raw JSON branch.\n"'#10'"Separ'
  +'ate multiple segments with semicolon ;.\n"'#10'"Literal: Text block in {'
  +#226#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to extrac'
  +'t data directly into the text.\n"'#10'"Logic: If a Pointer in a segment is '
  +'empty, the whole segment is skipped. If a segment has no Pointer, only lite'
  +'ral text blocks with embedded regular expressions are processed.\n"'#10'"Re'
  +'gex: {prefix {regex[index]} suffix} inside a text block. If no [index] is s'
  +'pecified, the first match is used.\n"'#10'"Index can be a number, [*] (join'
  +' by space), or [*#10] (join by newline). If the regex finds no match, the e'
  +'ntire {'#226#128#166'} block is removed.\n"'#10'"Using ~ inside a regex ret'
  +'urns the entire text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/pat'
  +'h{Error}) to show its text only if the Pointer data is missing or the JSON '
  +'is invalid.\n"'#10'"Commenting: /* text */ comments are stripped from the e'
  +'ntire expression before any processing.\n"'#10'"Examples:\n"'#10'"responseD'
  +'ata/translatedText; matches/*#10/translation; /texts/text; {literal text#10'
  +'}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /t'
  +'ranslations/0/text"'#10'msgstr ""'#10'"Ukazatel JSON: Pou'#197#190'ijte / p'
  +'ro '#195#186'rovn'#196#155', kl'#195#173#196#141'e pro objekty a '#196#141
  +#195#173'sla pro indexy. Pou'#197#190'ijte * pro v'#197#161'echny polo'#197
  +#190'ky, *#10 pro spojen'#195#173' polo'#197#190'ek pomoc'#195#173' nov'#195
  +#169'ho '#197#153#195#161'dku. Pou'#197#190'ijte ~ na konci cesty pro vr'#195
  +#161'cen'#195#173' nezpracovan'#195#169' v'#196#155'tve JSON. V'#195#173'ce '
  +'segment'#197#175' odd'#196#155'lte st'#197#153'edn'#195#173'kem ;.\n"'#10'"'
  +'Liter'#195#161'l: Textov'#195#189' blok v {'#226#128#166'}. Speci'#195#161
  +'ln'#195#173' zna'#196#141'ka #10 pro nov'#195#169' '#197#153#195#161'dky. P'
  +'ou'#197#190'ijte {{regex}} uvnit'#197#153' pro p'#197#153#195#173'm'#195#169
  +' vlo'#197#190'en'#195#173' extrahovan'#195#189'ch dat do textu.\n"'#10'"Log'
  +'ika: Pokud je ukazatel v segmentu pr'#195#161'zdn'#195#189', cel'#195#189' '
  +'segment se p'#197#153'esko'#196#141#195#173'. Pokud segment neobsahuje ukaz'
  +'atel, zpracuj'#195#173' se pouze bloky doslovn'#195#169'ho textu s vlo'#197
  +#190'en'#195#189'mi regul'#195#161'rn'#195#173'mi v'#195#189'razy.\n"'#10'"R'
  +'egex: {prefix {regex[index]} suffix} uvnit'#197#153' textov'#195#169'ho blo'
  +'ku. Pokud nen'#195#173' zad'#195#161'n [index], pou'#197#190'ije se prvn'
  +#195#173' shoda. Index m'#197#175#197#190'e b'#195#189't '#196#141#195#173's'
  +'lo, [*] (spojit mezerou) nebo [*#10] (spojit nov'#195#189'm '#197#153#195
  +#161'dkem). Pokud regul'#195#161'rn'#195#173' v'#195#189'raz nenajde '#197
  +#190#195#161'dnou shodu, cel'#195#189' blok {'#226#128#166'} se odstran'#195
  +#173'. Pou'#197#190'it'#195#173' ~ uvnit'#197#153' regul'#195#161'rn'#195#173
  +'ho v'#195#189'razu vr'#195#161't'#195#173' cel'#195#189' text.\n"'#10'"Inve'
  +'rze: Za'#196#141'n'#196#155'te segment znakem ! (nap'#197#153'. !/path{Erro'
  +'r}), aby se jeho text zobrazil pouze tehdy, pokud chyb'#195#173' data ukaza'
  +'tele nebo je JSON neplatn'#195#189'.\n"'#10'"Koment'#195#161#197#153'e: Kom'
  +'ent'#195#161#197#153'e /* text */ jsou z cel'#195#169'ho v'#195#189'razu od'
  +'stran'#196#155'ny p'#197#153'ed jak'#195#189'mkoli zpracov'#195#161'n'#195
  +#173'm.\n"'#10'"P'#197#153#195#173'klady:\n"'#10'"responseData/translatedTex'
  ,'t; matches/*#10/translation; /texts/text; {literal text#10}; /result/text; '
  +'/text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#10
  +#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pas'
  +'cal program: optional var section, then a main begin ... end. block.\n"'#10
  +'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s :'
  +'= GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\'
  +'n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can'
  +' also use standard Pascal constructs (if, for, while, repeat, etc.). You ca'
  +'n define your own functions and procedures before the main begin ... end. b'
  +'lock.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : '
  +'string\n"'#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutput('
  +'''name'', ''value'')\n"'#10'"    Store an output value for the host.\n"'#10
  +'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timestamp in millisecond'
  +'s (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer wit'
  +'h exactly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Ra'
  +'ndom float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\'
  +'n"'#10'"    Convert integer to hexadecimal string with at least Digits char'
  +'acters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to an '
  +'integer. Raises an exception on invalid input.\n"'#10'"  IntToStr(Value) : '
  +'string\n"'#10'"    Convert an integer to its string representation.\n"'#10
  +'"  Trim(S) : string\n"'#10'"    Remove leading and trailing whitespace from'
  +' S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whitespace fr'
  +'om S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing whitespac'
  +'e from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML '
  +'characters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"   '
  +' Decode HTML entities in S back to characters.\n"'#10'"  UrlEncode(S) : str'
  +'ing\n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"  UrlDecod'
  +'e(S) : string\n"'#10'"    Decode a percent-encoded string S.\n"'#10'"  Repl'
  +'aceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Re'
  +'place all occurrences of OldPattern with NewPattern in S.\n"'#10'"  RegexRe'
  +'place(Input, Pattern, Replacement) : string\n"'#10'"    Replace all regex m'
  +'atches of Pattern with Replacement in Input. Case-insensitive.\n"'#10'"  Re'
  +'gexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if Input matches the r'
  +'egex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, En'
  +'dMarker) : string\n"'#10'"    Extract the substring of S between StartMarke'
  +'r and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle returned by '
  +'JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON strin'
  +'g and return a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle'
  +')\n"'#10'"    Release the handle after use.\n"'#10'"  JSONGetString(Handle,'
  +' Path) : string\n"'#10'"    Get a string value at the specified Path.\n"'#10
  +'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an integer value at t'
  +'he specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"'
  +'    Get a floating-point value at the specified Path.\n"'#10'"  JSONGetBool'
  +'(Handle, Path) : Boolean\n"'#10'"    Get a boolean value at the specified P'
  +'ath.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get th'
  +'e number of elements in an array at the specified Path.\n"'#10'"  JSONGetAr'
  +'rayString(Handle, Path, Index) : string\n"'#10'"    Get the string value of'
  +' an array element at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Pat'
  +'h, Index) : Integer\n"'#10'"    Get the integer value of an array element a'
  +'t the given Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"   '
  +' Return the type of the value at Path: \"object\", \"array\", \"string\", \'
  +'"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Pat'
  +'h) : Boolean\n"'#10'"    Check if the specified Path exists.\n"'#10'"  JSON'
  +'ResultInit\n"'#10'"    Initialize an empty JSON array for building a standa'
  +'rd error result.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Repl'
  +'acements)\n"'#10'"    Add an error object to the result array. Replacements'
  +' is a string of values separated by \"|\".\n"'#10'"  JSONResultGet : string'
  +'\n"'#10'"    Return the current result array as a JSON string.\n"'#10'"  JS'
  +'ONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always call JSO'
  +'NFree to release the handle after you are done.\n"'#10'"\n"'#10'"Example of'
  +' working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'
  +#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    i'
  +'f h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.'
  +'path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n'
  ,'"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters (retri'
  +'eved with GetParam):\n"'#10'"  text - the input text to process (possibly t'
  +'runcated to MaxLength)\n"'#10'"  source - source language code (may be empt'
  +'y)\n"'#10'"  target - target language code\n"'#10'"  timestamp - current Un'
  +'ix timestamp in milliseconds (string)\n"'#10'"  random  - 9-digit random nu'
  +'mber (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 - firs'
  +'t 1..9 digits of the random number\n"'#10'"\n"'#10'"Additional initial and '
  +'custom parameters are also available."'#10'msgstr ""'#10'"Skript je standar'
  +'dn'#195#173' program v Pascalu: voliteln'#195#161' sekce var a pot'#195#169
  +' hlavn'#195#173' blok begin ... end.\n"'#10'"\n"'#10'"P'#197#153#195#173'kl'
  +'ad:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''te'
  +'xt'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    Set'
  +'Output(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"M'#197#175#197#190'ete'
  +' tak'#195#169' pou'#197#190#195#173'vat standardn'#195#173' konstrukce Pasc'
  +'alu (if, for, while, repeat atd.). P'#197#153'ed hlavn'#195#173'm blokem be'
  +'gin ... end. m'#197#175#197#190'ete definovat vlastn'#195#173' funkce a pro'
  +'cedury.\n"'#10'"\n"'#10'"Dostupn'#195#169' funkce:\n"'#10'"  GetParam(''nam'
  +'e'') : string\n"'#10'"    Na'#196#141'te hodnotu vstupn'#195#173'ho paramet'
  +'ru.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Ulo'#197#190#195
  +#173' v'#195#189'stupn'#195#173' hodnotu pro hostitele.\n"'#10'"  GetTimesta'
  +'mp() : Int64\n"'#10'"    Aktu'#195#161'ln'#195#173' '#196#141'asov'#195#169
  +' raz'#195#173'tko Unix v milisekund'#195#161'ch (UTC).\n"'#10'"  GetRandom('
  +'Length) : Int64\n"'#10'"    N'#195#161'hodn'#195#169' cel'#195#169' '#196
  +#141#195#173'slo s p'#197#153'esn'#196#155' Length desetinn'#195#189'mi '#196
  +#141#195#173'slicemi.\n"'#10'"  Random : Extended\n"'#10'"    N'#195#161'hod'
  +'n'#195#169' '#196#141#195#173'slo s plovouc'#195#173' desetinnou '#196#141
  +#195#161'rkou v rozsahu [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n'
  +'"'#10'"    P'#197#153'evede cel'#195#169' '#196#141#195#173'slo na '#197#161
  +'estn'#195#161'ctkov'#195#189' '#197#153'et'#196#155'zec s alespo'#197#136' '
  +'Digits znaky.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    P'#197#153'evede '
  +#197#153'et'#196#155'zec na cel'#195#169' '#196#141#195#173'slo. P'#197#153
  +'i neplatn'#195#169'm vstupu vyvol'#195#161' v'#195#189'jimku.\n"'#10'"  Int'
  +'ToStr(Value) : string\n"'#10'"    P'#197#153'evede cel'#195#169' '#196#141
  +#195#173'slo na jeho '#197#153'et'#196#155'zcovou reprezentaci.\n"'#10'"  Tr'
  +'im(S) : string\n"'#10'"    Odstran'#195#173' po'#196#141#195#161'te'#196#141
  +'n'#195#173' a koncov'#195#169' mezery z S.\n"'#10'"  TrimLeft(S) : string\n'
  +'"'#10'"    Odstran'#195#173' po'#196#141#195#161'te'#196#141'n'#195#173' me'
  +'zery z S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Odstran'#195#173' kon'
  +'cov'#195#169' mezery z S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Zak'
  +#195#179'duje speci'#195#161'ln'#195#173' HTML znaky v S do entit.\n"'#10'" '
  +' HtmlDecode(S) : string\n"'#10'"    Dek'#195#179'duje HTML entity v S zp'
  +#196#155't na znaky.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    Provede pro'
  +'centov'#195#169' k'#195#179'dov'#195#161'n'#195#173' S pro bezpe'#196#141'n'
  +#195#169' pou'#197#190'it'#195#173' v URL.\n"'#10'"  UrlDecode(S) : string\n'
  +'"'#10'"    Dek'#195#179'duje '#197#153'et'#196#155'zec S k'#195#179'dovan'
  +#195#189' pomoc'#195#173' procentov'#195#169'ho k'#195#179'dov'#195#161'n'
  +#195#173'.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False)'
  +' : string\n"'#10'"    Nahrad'#195#173' v'#197#161'echny v'#195#189'skyty Ol'
  +'dPattern za NewPattern v S.\n"'#10'"  RegexReplace(Input, Pattern, Replacem'
  +'ent) : string\n"'#10'"    Nahrad'#195#173' v'#197#161'echny shody regul'#195
  +#161'rn'#195#173'ho v'#195#189'razu Pattern za Replacement v Input. Bez rozl'
  +'i'#197#161'en'#195#173' velk'#195#189'ch a mal'#195#189'ch p'#195#173'smen.'
  +'\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Zkontroluje, zd'
  +'a Input odpov'#195#173'd'#195#161' regul'#195#161'rn'#195#173'mu v'#195#189
  +'razu Pattern. Bez rozli'#197#161'en'#195#173' velk'#195#189'ch a mal'#195
  +#189'ch p'#195#173'smen.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker)'
  +' : string\n"'#10'"    Extrahuje pod'#197#153'et'#196#155'zec z S mezi Start'
  +'Marker a EndMarker.\n"'#10'"\n"'#10'"Funkce JSON (pou'#197#190'ijte handle '
  +'vr'#195#161'cen'#195#189' funkc'#195#173' JSONParse):\n"'#10'"  JSONParse(S'
  +') : Integer\n"'#10'"    Analyzuje '#197#153'et'#196#155'zec JSON a vr'#195
  +#161't'#195#173' handle (>=0). P'#197#153'i chyb'#196#155' vr'#195#161't'#195
  +#173' -1.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Po pou'#197#190'it'#195#173
  +' uvoln'#195#173' handle.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'
  +#10'"    Z'#195#173'sk'#195#161' '#197#153'et'#196#155'zcovou hodnotu na zad'
  ,'an'#195#169' cest'#196#155' Path.\n"'#10'"  JSONGetInt(Handle, Path) : Inte'
  +'ger\n"'#10'"    Z'#195#173'sk'#195#161' celo'#196#141#195#173'selnou hodnot'
  +'u na zadan'#195#169' cest'#196#155' Path.\n"'#10'"  JSONGetFloat(Handle, Pa'
  +'th) : Extended\n"'#10'"    Z'#195#173'sk'#195#161' hodnotu s plovouc'#195
  +#173' desetinnou '#196#141#195#161'rkou na zadan'#195#169' cest'#196#155' Pa'
  +'th.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Z'#195#173'sk'
  +#195#161' logickou hodnotu na zadan'#195#169' cest'#196#155' Path.\n"'#10'" '
  +' JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Z'#195#173'sk'#195
  +#161' po'#196#141'et prvk'#197#175' pole na zadan'#195#169' cest'#196#155' P'
  +'ath.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"   '
  +' Z'#195#173'sk'#195#161' '#197#153'et'#196#155'zcovou hodnotu prvku pole na'
  +' zadan'#195#169'm indexu Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Ind'
  +'ex) : Integer\n"'#10'"    Z'#195#173'sk'#195#161' celo'#196#141#195#173'sel'
  +'nou hodnotu prvku pole na zadan'#195#169'm indexu Index.\n"'#10'"  JSONGetT'
  +'ype(Handle, Path) : string\n"'#10'"    Vr'#195#161't'#195#173' typ hodnoty '
  +'na Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \'
  +'"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10'"    Zkont'
  +'roluje, zda zadan'#195#161' cesta Path existuje.\n"'#10'"  JSONResultInit\n'
  +'"'#10'"    Inicializuje pr'#195#161'zdn'#195#169' pole JSON pro vytvo'#197
  +#153'en'#195#173' standardn'#195#173'ho v'#195#189'sledku s chybami.\n"'#10
  +'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"    P'
  +#197#153'id'#195#161' objekt chyby do v'#195#189'sledn'#195#169'ho pole. Rep'
  +'lacements je '#197#153'et'#196#155'zec hodnot odd'#196#155'len'#195#189'ch '
  +'znakem \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Vr'#195#161't'
  +#195#173' aktu'#195#161'ln'#195#173' v'#195#189'sledn'#195#169' pole jako '
  +#197#153'et'#196#155'zec JSON.\n"'#10'"  JSONResultClear\n"'#10'"    Vyma'
  +#197#190'e v'#195#189'sledn'#195#169' pole.\n"'#10'"  Po dokon'#196#141'en'
  +#195#173' pr'#195#161'ce v'#197#190'dy zavolejte JSONFree, abyste uvolnili h'
  +'andle.\n"'#10'"\n"'#10'"P'#197#153#195#173'klad pr'#195#161'ce s JSON:\n"'
  +#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    '
  +'h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"  '
  +'  begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      S'
  +'etOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"'
  +'  end.\n"'#10'"\n"'#10'"Dostupn'#195#169' parametry (z'#195#173'skan'#195
  +#169' pomoc'#195#173' GetParam):\n"'#10'"  text - vstupn'#195#173' text ke z'
  +'pracov'#195#161'n'#195#173' (m'#197#175#197#190'e b'#195#189't zkr'#195#161
  +'cen na MaxLength)\n"'#10'"  source - k'#195#179'd zdrojov'#195#169'ho jazyk'
  +'a (m'#197#175#197#190'e b'#195#189't pr'#195#161'zdn'#195#189')\n"'#10'"  t'
  +'arget - k'#195#179'd c'#195#173'lov'#195#169'ho jazyka\n"'#10'"  timestamp '
  +'- aktu'#195#161'ln'#195#173' '#196#141'asov'#195#169' raz'#195#173'tko Unix'
  +' v milisekund'#195#161'ch ('#197#153'et'#196#155'zec)\n"'#10'"  random  - n'
  +#195#161'hodn'#195#169' 9m'#195#173'stn'#195#169' '#196#141#195#173'slo ('
  +#197#153'et'#196#155'zec)\n"'#10'"  rand - tot'#195#169#197#190' co random\n'
  +'"'#10'"  rand1..rand9 - prvn'#195#173'ch 1..9 '#196#141#195#173'slic n'#195
  +#161'hodn'#195#169'ho '#196#141#195#173'sla\n"'#10'"\n"'#10'"K dispozici jso'
  +'u tak'#195#169' dal'#197#161#195#173' po'#196#141#195#161'te'#196#141'n'#195
  +#173' a vlastn'#195#173' parametry."'#10#10'#: formconfig.rscriptresponsehin'
  +'t'#10'msgid ""'#10'"This script processes the response data. All functions '
  +'and parameters described in the script hint are available here as well.\n"'
  +#10'"Use GetParam(''result'') to obtain the received text.\n"'#10'"\n"'#10'"'
  +'Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam'
  +'(''result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"'
  +'\n"'#10'"You can define custom parameters in the parameters script using Se'
  +'tParam(''name'', ''value''),\n"'#10'"and then retrieve them here with GetPa'
  +'ram(''name'')."'#10'msgstr ""'#10'"Tento skript zpracov'#195#161'v'#195#161
  +' data odpov'#196#155'di. V'#197#161'echny funkce a parametry popsan'#195#169
  +' v n'#195#161'pov'#196#155'd'#196#155' skriptu jsou k dispozici tak'#195#169
  +' zde.\n"'#10'"Pou'#197#190'ijte GetParam(''result'') pro z'#195#173'sk'#195
  +#161'n'#195#173' p'#197#153'ijat'#195#169'ho textu.\n"'#10'"\n"'#10'"P'#197
  +#153#195#173'klad:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s :='
  +' GetParam(''result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.'
  +'\n"'#10'"\n"'#10'"V parametrick'#195#169'm skriptu m'#197#175#197#190'ete d'
  +'efinovat vlastn'#195#173' parametry pomoc'#195#173' SetParam(''name'', ''va'
  +'lue''),\n"'#10'"a pot'#195#169' je zde z'#195#173'skat pomoc'#195#173' GetP'
  ,'aram(''name'')."'#10#10'#: formconfig.rvaluetype1'#10'msgctxt "formconfig.r'
  +'valuetype1"'#10'msgid "None"'#10'msgstr "'#197#189#195#161'dn'#195#169'"'#10
  +#10'#: formconfig.rvaluetype2'#10'msgid "Language"'#10'msgstr "Jazyk"'#10#10
