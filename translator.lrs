]);
LazarusResources.Add('formconfig.da','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: da\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Konfigurationseditor"'#10#10'#: formconfig.rclearlanguages'#10'msgi'
  +'d "The list is already filled. Do you want to clear it?"'#10'msgstr "Listen'
  +' er allerede udfyldt. Vil du rydde den?"'#10#10'#: formconfig.rdeleteconfig'
  +#10'msgid "Are you sure you want to delete config"'#10'msgstr "Er du sikker '
  +'p'#195#165', at du vil slette konfiguration"'#10#10'#: formconfig.rdeleteco'
  +'nfigcaption'#10'msgid "Delete config"'#10'msgstr "Slet konfiguration"'#10#10
  +'#: formconfig.rnamequestion'#10'msgid "Enter new config file name:"'#10'msg'
  +'str "Indtast navn p'#195#165' ny konfigurationsfil:"'#10#10'#: formconfig.r'
  +'needsave'#10'msgid "The configuration was modified. Save changes?"'#10'msgs'
  +'tr "Konfigurationen er '#195#166'ndret. Gemme '#195#166'ndringer?"'#10#10'#'
  +': formconfig.rresponsehint'#10'msgid ""'#10'"Json Pointer: Use / for levels'
  +', keys for objects, and numbers for indexes.\n"'#10'"Use * for all items, *'
  +'#10 to join items by newline. Use ~ at the end of the path to return the ra'
  +'w JSON branch.\n"'#10'"Separate multiple segments with semicolon ;.\n"'#10
  +'"Literal: Text block in {'#226#128#166'}. Special tag #10 for newlines. Use'
  +' {{regex}} inside to extract data directly into the text.\n"'#10'"Logic: If'
  +' a Pointer in a segment is empty, the whole segment is skipped. If a segmen'
  +'t has no Pointer, only literal text blocks with embedded regular expression'
  +'s are processed.\n"'#10'"Regex: {prefix {regex[index]} suffix} inside a tex'
  +'t block. If no [index] is specified, the first match is used.\n"'#10'"Index'
  +' can be a number, [*] (join by space), or [*#10] (join by newline). If the '
  +'regex finds no match, the entire {'#226#128#166'} block is removed.\n"'#10
  +'"Using ~ inside a regex returns the entire text.\n"'#10'"Inversion: Start a'
  +' segment with ! (e.g. !/path{Error}) to show its text only if the Pointer d'
  +'ata is missing or the JSON is invalid.\n"'#10'"Commenting: /* text */ comme'
  +'nts are stripped from the entire expression before any processing.\n"'#10'"'
  +'Examples:\n"'#10'"responseData/translatedText; matches/*#10/translation; /t'
  +'exts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translati'
  +'ons{Error: No data!#10}; /translations/0/text"'#10'msgstr ""'#10'"JSON-poin'
  +'ter: Brug / til niveauer, n'#195#184'gler til objekter og tal til indekser.'
  +' Brug * til alle elementer og *#10 til at sammenk'#195#166'de elementer med'
  +' en ny linje. Brug ~ i slutningen af stien for at returnere den r'#195#165
  +' JSON-gren. Adskil flere segmenter med semikolon ;.\n"'#10'"Litteral: Tekst'
  +'blok i {'#226#128#166'}. S'#195#166'rligt tag #10 til nye linjer. Brug {{re'
  +'gex}} indeni til at inds'#195#166'tte udtrukne data direkte i teksten.\n"'
  +#10'"Logik: Hvis en pointer i et segment er tom, springes hele segmentet ove'
  +'r. Hvis et segment ikke har en pointer, behandles kun tekstblokke med indle'
  +'jrede regul'#195#166're udtryk.\n"'#10'"Regex: {pr'#195#166'fiks {regex[ind'
  +'ex]} suffiks} inde i en tekstblok. Hvis [index] ikke er angivet, bruges det'
  +' f'#195#184'rste match. Indekset kan v'#195#166're et tal, [*] (sammenk'#195
  +#166'd med mellemrum) eller [*#10] (sammenk'#195#166'd med ny linje). Hvis d'
  +'et regul'#195#166're udtryk ikke finder et match, fjernes hele blokken {'
  +#226#128#166'}. Brug af ~ inde i et regul'#195#166'rt udtryk returnerer hele'
  +' teksten.\n"'#10'"Invertering: Start et segment med ! (f.eks. !/path{Error}'
  +') for kun at vise dets tekst, hvis pointerdata mangler, eller hvis JSON er '
  +'ugyldig.\n"'#10'"Kommentarer: Kommentarer /* tekst */ fjernes fra hele udtr'
  +'ykket f'#195#184'r enhver behandling.\n"'#10'"Eksempler:\n"'#10'"responseDa'
  +'ta/translatedText; matches/*#10/translation; /texts/text; {literal text#10}'
  +'; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /tr'
  +'anslations"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script i'
  +'s a standard Pascal program: optional var section, then a main begin ... en'
  +'d. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begi'
  +'n\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'''
  +', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"You can also use standard Pascal constructs (if, for, while, repe'
  +'at, etc.). You can define your own functions and procedures before the main'
  +' begin ... end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetP'
  +'aram(''name'') : string\n"'#10'"    Retrieve an input parameter value.\n"'
  ,#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an output value for '
  +'the host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timesta'
  +'mp in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    R'
  +'andom integer with exactly Length decimal digits.\n"'#10'"  Random : Extend'
  +'ed\n"'#10'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, '
  +'Digits) : string\n"'#10'"    Convert integer to hexadecimal string with at '
  +'least Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Conver'
  +'t a string to an integer. Raises an exception on invalid input.\n"'#10'"  I'
  +'ntToStr(Value) : string\n"'#10'"    Convert an integer to its string repres'
  +'entation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailin'
  +'g whitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove lead'
  +'ing whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove t'
  +'railing whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Enc'
  +'ode special HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : s'
  +'tring\n"'#10'"    Decode HTML entities in S back to characters.\n"'#10'"  U'
  +'rlEncode(S) : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n'
  +'"'#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-encoded string '
  +'S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : stri'
  +'ng\n"'#10'"    Replace all occurrences of OldPattern with NewPattern in S.\'
  +'n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Re'
  +'place all regex matches of Pattern with Replacement in Input. Case-insensit'
  +'ive.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if In'
  +'put matches the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S'
  +', StartMarker, EndMarker) : string\n"'#10'"    Extract the substring of S b'
  +'etween StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a ha'
  +'ndle returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    P'
  +'arse a JSON string and return a handle (>=0). Returns -1 on error.\n"'#10'"'
  +'  JSONFree(Handle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSON'
  +'GetString(Handle, Path) : string\n"'#10'"    Get a string value at the spec'
  +'ified Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an'
  +' integer value at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) '
  +': Extended\n"'#10'"    Get a floating-point value at the specified Path.\n"'
  +#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value a'
  +'t the specified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n'
  +'"'#10'"    Get the number of elements in an array at the specified Path.\n"'
  +#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#10'"  JSONGetArray'
  +'Int(Handle, Path, Index) : Integer\n"'#10'"    Get the integer value of an '
  +'array element at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : str'
  +'ing\n"'#10'"    Return the type of the value at Path: \"object\", \"array\"'
  +', \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExi'
  +'sts(Handle, Path) : Boolean\n"'#10'"    Check if the specified Path exists.'
  +'\n"'#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for bu'
  +'ilding a standard error result.\n"'#10'"  JSONResultAddError(Offset, Length'
  +', Message, Replacements)\n"'#10'"    Add an error object to the result arra'
  +'y. Replacements is a string of values separated by \"|\".\n"'#10'"  JSONRes'
  +'ultGet : string\n"'#10'"    Return the current result array as a JSON strin'
  +'g.\n"'#10'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  '
  +'Always call JSONFree to release the handle after you are done.\n"'#10'"\n"'
  +#10'"Example of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s'
  +': string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));'
  +'\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetStr'
  +'ing(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      '
  +'JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available par'
  +'ameters (retrieved with GetParam):\n"'#10'"  text - the input text to proce'
  +'ss (possibly truncated to MaxLength)\n"'#10'"  source - source language cod'
  +'e (may be empty)\n"'#10'"  target - target language code\n"'#10'"  timestam'
  +'p - current Unix timestamp in milliseconds (string)\n"'#10'"  random  - 9-d'
  +'igit random number (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1'
  +'..rand9 - first 1..9 digits of the random number\n"'#10'"\n"'#10'"Additiona'
  +'l initial and custom parameters are also available."'#10'msgstr ""'#10'"Scr'
  +'iptet er et standard Pascal-program: en valgfri var-sektion efterfulgt af e'
  +'n hovedblok begin ... end.\n"'#10'"\n"'#10'"Eksempel:\n"'#10'"  var s: stri'
  +'ng;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := R'
  ,'eplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'
  +#10'"  end.\n"'#10'"\n"'#10'"Du kan ogs'#195#165' bruge standardkonstruktion'
  +'er i Pascal (if, for, while, repeat osv.). Du kan definere dine egne funkti'
  +'oner og procedurer f'#195#184'r hovedblokken begin ... end.\n"'#10'"\n"'#10
  +'"Tilg'#195#166'ngelige funktioner:\n"'#10'"  GetParam(''name'') : string\n"'
  +#10'"    Hent v'#195#166'rdien af en inputparameter.\n"'#10'"  SetOutput(''n'
  +'ame'', ''value'')\n"'#10'"    Gem en outputv'#195#166'rdi for v'#195#166'rt'
  +'en.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Aktuelt Unix-tidsstempel i'
  +' millisekunder (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Tilf'
  +#195#166'ldigt heltal med pr'#195#166'cis Length decimalcifre.\n"'#10'"  Ran'
  +'dom : Extended\n"'#10'"    Tilf'#195#166'ldigt decimaltal i omr'#195#165'de'
  +'t [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Konverter '
  +'et heltal til en hexadecimal streng med mindst Digits tegn.\n"'#10'"  StrTo'
  +'Int(S) : Integer\n"'#10'"    Konverter en streng til et heltal. Udl'#195#184
  +'ser en undtagelse ved ugyldigt input.\n"'#10'"  IntToStr(Value) : string\n"'
  +#10'"    Konverter et heltal til dets strengrepr'#195#166'sentation.\n"'#10
  +'"  Trim(S) : string\n"'#10'"    Fjern indledende og afsluttende mellemrum f'
  +'ra S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Fjern indledende mellemrum'
  +' fra S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Fjern afsluttende melle'
  +'mrum fra S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Kod s'#195#166'rli'
  +'ge HTML-tegn i S som entiteter.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"  '
  +'  Afkod HTML-entiteter i S tilbage til tegn.\n"'#10'"  UrlEncode(S) : strin'
  +'g\n"'#10'"    Procentkod S for sikker inkludering i URL''er.\n"'#10'"  UrlD'
  +'ecode(S) : string\n"'#10'"    Afkod en procentkodet streng S.\n"'#10'"  Rep'
  +'laceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    E'
  +'rstat alle forekomster af OldPattern med NewPattern i S.\n"'#10'"  RegexRep'
  +'lace(Input, Pattern, Replacement) : string\n"'#10'"    Erstat alle match af'
  +' det regul'#195#166're udtryk Pattern med Replacement i Input. Uafh'#195#166
  +'ngigt af store og sm'#195#165' bogstaver.\n"'#10'"  RegexMatch(Input, Patte'
  +'rn) : Boolean\n"'#10'"    Kontroll'#195#169'r, om Input matcher det regul'
  +#195#166're udtryk Pattern. Uafh'#195#166'ngigt af store og sm'#195#165' bog'
  +'staver.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10
  +'"    Udtr'#195#166'k delstrengen fra S mellem StartMarker og EndMarker.\n"'
  +#10'"\n"'#10'"JSON-funktioner (brug et handle, der returneres af JSONParse):'
  +'\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Analys'#195#169'r en JSON-str'
  +'eng og return'#195#169'r et handle (>=0). Returnerer -1 ved fejl.\n"'#10'" '
  +' JSONFree(Handle)\n"'#10'"    Frigiv handle efter brug.\n"'#10'"  JSONGetSt'
  +'ring(Handle, Path) : string\n"'#10'"    Hent en strengv'#195#166'rdi p'#195
  +#165' den angivne Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10
  +'"    Hent en heltalsv'#195#166'rdi p'#195#165' den angivne Path.\n"'#10'"  '
  +'JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Hent en flydende kommav'
  +#195#166'rdi p'#195#165' den angivne Path.\n"'#10'"  JSONGetBool(Handle, Pat'
  +'h) : Boolean\n"'#10'"    Hent en boolesk v'#195#166'rdi p'#195#165' den ang'
  +'ivne Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    '
  +'Hent antallet af elementer i et array p'#195#165' den angivne Path.\n"'#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Hent streng'
  +'v'#195#166'rdien for et array-element ved det angivne Index.\n"'#10'"  JSON'
  +'GetArrayInt(Handle, Path, Index) : Integer\n"'#10'"    Hent heltalsv'#195
  +#166'rdien for et array-element ved det angivne Index.\n"'#10'"  JSONGetType'
  +'(Handle, Path) : string\n"'#10'"    Return'#195#169'r typen af v'#195#166'r'
  +'dien p'#195#165' Path: \"object\", \"array\", \"string\", \"int\", \"float\'
  +'", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'
  +#10'"    Kontroll'#195#169'r, om den angivne Path findes.\n"'#10'"  JSONResu'
  +'ltInit\n"'#10'"    Initialiser et tomt JSON-array til opbygning af et stand'
  +'ardresultat med fejl.\n"'#10'"  JSONResultAddError(Offset, Length, Message,'
  +' Replacements)\n"'#10'"    Tilf'#195#184'j et fejlobjekt til resultatarraye'
  +'t. Replacements er en streng med v'#195#166'rdier adskilt af \"|\".\n"'#10
  +'"  JSONResultGet : string\n"'#10'"    Return'#195#169'r det aktuelle result'
  +'atarray som en JSON-streng.\n"'#10'"  JSONResultClear\n"'#10'"    Ryd resul'
  +'tatarrayet.\n"'#10'"  Kald altid JSONFree for at frigive handle, n'#195#165
  +'r du er f'#195#166'rdig med det.\n"'#10'"\n"'#10'"Eksempel p'#195#165' arbe'
  +'jde med JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  '
  +'begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    if h >='
  +' 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'''
  ,');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10
  +'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Tilg'#195#166'ngelige parametre ('
  +'hentes med GetParam):\n"'#10'"  text - inputteksten, der skal behandles (ka'
  +'n v'#195#166're afkortet til MaxLength)\n"'#10'"  source - kildekodesprog ('
  +'kan v'#195#166're tom)\n"'#10'"  target - m'#195#165'lsprogskode\n"'#10'"  '
  +'timestamp - aktuelt Unix-tidsstempel i millisekunder (streng)\n"'#10'"  ran'
  +'dom  - tilf'#195#166'ldigt 9-cifret tal (streng)\n"'#10'"  rand - det samme'
  +' som random\n"'#10'"  rand1..rand9 - de f'#195#184'rste 1..9 cifre af det t'
  +'ilf'#195#166'ldige tal\n"'#10'"\n"'#10'"Yderligere indledende og brugerdefi'
  +'nerede parametre er ogs'#195#165' tilg'#195#166'ngelige.nerede parametre er'
  +' ogs'#195#165' tilg'#195#166'ngelige."'#10#10'#: formconfig.rscriptresponse'
  +'hint'#10'msgid ""'#10'"This script processes the response data. All functio'
  +'ns and parameters described in the script hint are available here as well.\'
  +'n"'#10'"Use GetParam(''result'') to obtain the received text.\n"'#10'"\n"'
  +#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetP'
  +'aram(''result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'
  +#10'"\n"'#10'"You can define custom parameters in the parameters script usin'
  +'g SetParam(''name'', ''value''),\n"'#10'"and then retrieve them here with G'
  +'etParam(''name'')."'#10'msgstr ""'#10'"Dette script behandler svardata. All'
  +'e funktioner og parametre, der er beskrevet i scriptets tip, er ogs'#195#165
  +' tilg'#195#166'ngelige her.\n"'#10'"Brug GetParam(''result'') for at hente '
  +'den modtagne tekst.\n"'#10'"\n"'#10'"Eksempel:\n"'#10'"  var s: string;\n"'
  +#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput('''
  +'result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Du kan definere brugerdefiner'
  +'ede parametre i parameterscriptet ved hj'#195#166'lp af SetParam(''name'', '
  +'''value''),\n"'#10'"og derefter hente dem her med GetParam(''name'')."'#10
  +#10'#: formconfig.rvaluetype1'#10'msgctxt "formconfig.rvaluetype1"'#10'msgid'
  +' "None"'#10'msgstr "Ingen"'#10#10'#: formconfig.rvaluetype2'#10'msgid "Lang'
  +'uage"'#10'msgstr "Sprog"'#10#10'#: formconfig.rvaluetype3'#10'msgid "Curren'
  +'cy All"'#10'msgstr "Alle valutaer"'#10#10'#: formconfig.rvaluetype4'#10'msg'
  +'id "Currency Fiat Only"'#10'msgstr "Kun fiat-valuta"'#10#10'#: formconfig.r'
  +'valuetype5'#10'msgid "Currency Crypto Only"'#10'msgstr "Kun kryptovaluta"'
  +#10#10'#: formconfig.rvaluetype6'#10'msgid "Measurement Units"'#10'msgstr "M'
  +#195#165'leenheder"'#10#10'#: tformconfigtrayslate.aclearicon.caption'#10'ms'
  +'gid "Clear Icon"'#10'msgstr "Ryd ikon"'#10#10'#: tformconfigtrayslate.asave'
  +'.caption'#10'msgid "Save"'#10'msgstr "Gem"'#10#10'#: tformconfigtrayslate.a'
  +'saveiconas.caption'#10'msgid "Save Icon As..."'#10'msgstr "Gem ikon som..."'
  +#10#10'#: tformconfigtrayslate.btnclose.caption'#10'msgid "Close"'#10'msgstr'
  +' "Luk"'#10#10'#: tformconfigtrayslate.btninitparameterstest.hint'#10'msgid '
  +'"Execute request and view the parameters"'#10'msgstr "Udf'#195#184'r anmodn'
  +'ing og se parametrene"'#10#10'#: tformconfigtrayslate.btniniturltest.hint'
  +#10'msgid "Execute request and view the result"'#10'msgstr "Udf'#195#184'r a'
  +'nmodning og se resultatet"'#10#10'#: tformconfigtrayslate.btnpostdatatest.h'
  +'int'#10'msgid "Execute post request and view the result"'#10'msgstr "Udf'
  +#195#184'r POST-anmodning og se resultatet"'#10#10'#: tformconfigtrayslate.b'
  +'tnresponsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnresponsehelp.hint"'
  +#10'msgid "Help"'#10'msgstr "Hj'#195#166'lp"'#10#10'#: tformconfigtrayslate.'
  +'btnresponsetest.hint'#10'msgid "Converts the current response"'#10'msgstr "'
  +'Konverterer det aktuelle svar"'#10#10'#: tformconfigtrayslate.btnscripthelp'
  +'.hint'#10'msgctxt "tformconfigtrayslate.btnscripthelp.hint"'#10'msgid "Help'
  +'"'#10'msgstr "Hj'#195#166'lp"'#10#10'#: tformconfigtrayslate.btnscriptrespo'
  +'nsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnscriptresponsehelp.hint"'
  +#10'msgid "Help"'#10'msgstr "Hj'#195#166'lp"'#10#10'#: tformconfigtrayslate.'
  +'btnscriptresponsetest.hint'#10'msgctxt "tformconfigtrayslate.btnscriptrespo'
  +'nsetest.hint"'#10'msgid "Execute script and view the result"'#10'msgstr "K'
  +#195#184'r script og vis resultatet"'#10#10'#: tformconfigtrayslate.btnscrip'
  +'ttest.hint'#10'msgctxt "tformconfigtrayslate.btnscripttest.hint"'#10'msgid '
  +'"Execute script and view the result"'#10'msgstr "K'#195#184'r script og vis'
  +' resultatet"'#10#10'#: tformconfigtrayslate.btnurltest.hint'#10'msgid "Exec'
  +'ute get request and view the result"'#10'msgstr "Udf'#195#184'r GET-anmodni'
  +'ng og se resultatet"'#10#10'#: tformconfigtrayslate.caption'#10'msgctxt "tf'
  +'ormconfigtrayslate.caption"'#10'msgid "Config Editor"'#10'msgstr "Konfigura'
  +'tionseditor"'#10#10'#: tformconfigtrayslate.checkencodecustomparameters.cap'
  +'tion'#10'msgid "Encode parameters"'#10'msgstr "Kodningsparametre"'#10#10'#:'
  ,' tformconfigtrayslate.checkencodetext.caption'#10'msgid "Encode {text} para'
  +'meter"'#10'msgstr "Kod {text}-parameter"'#10#10'#: tformconfigtrayslate.che'
  +'ckserviceautoswap.caption'#10'msgid "Allow auto-swap language pair"'#10'msg'
  +'str "Tillad automatisk skift af sprogpar"'#10#10'#: tformconfigtrayslate.ch'
  +'eckserviceonlybutton.caption'#10'msgid "Allow translation only by translati'
  +'on button"'#10'msgstr "Tillad kun overs'#195#166'ttelse via overs'#195#166
  +'ttelsesknappen"'#10#10'#: tformconfigtrayslate.checkserviceproxy.caption'#10
  +'msgid "Allow proxy"'#10'msgstr "Tillad proxy"'#10#10'#: tformconfigtrayslat'
  +'e.checkservicerealtime.caption'#10'msgid "Allow translate as you type"'#10
