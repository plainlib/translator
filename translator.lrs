  +' parameter"'#10'msgstr "Codificar par'#195#162'metro {text}"'#10#10'#: tfor'
  +'mconfigtrayslate.checkserviceautoswap.caption'#10'msgid "Allow auto-swap la'
  +'nguage pair"'#10'msgstr "Permitir troca autom'#195#161'tica do par de idiom'
