LazarusResources.Add('formconfig.es','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: es\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Editor de configuraci'#195#179'n"'#13#10#13#10'#: formconfig.rclearlangua'
  +'ges'#13#10'msgid "The list is already filled. Do you want to clear it?"'#13
  +#10'msgstr "La lista ya est'#195#161' llena. '#194#191'Quiere vaciarla?"'#13
  +#10#13#10'#: formconfig.rconfigeditor'#13#10'msgid "Config Editor..."'#13#10
  +'msgstr "Editor de configuraci'#195#179'n..."'#13#10#13#10'#: formconfig.rde'
  +'leteconfig'#13#10'msgid "Are you sure you want to delete config"'#13#10'msg'
  +'str "'#194#191'Est'#195#161' seguro de que desea eliminar la configuraci'
  +#195#179'n"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13#10'msgid "De'
  +'lete config"'#13#10'msgstr "Eliminar configuraci'#195#179'n"'#13#10#13#10'#'
  +': formconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Cancel'
  +'ar"'#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Keep m'
  +'y changes"'#13#10'msgstr "Conservar mis cambios"'#13#10#13#10'#: formconfig'
  +'.rfilechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The file \"%s'
  +'\" has been modified by another application since it was opened."'#13#10'ms'
  +'gstr "El archivo \"%s\" ha sido modificado por otra aplicaci'#195#179'n des'
  +'de que se abri'#195#179'."'#13#10#13#10'#: formconfig.rfilechangedmsgactiva'
  +'te'#13#10'msgid "You have unsaved changes. Keep them or reload from disk?"'
  +#13#10'msgstr "Tiene cambios sin guardar. '#194#191'Desea conservarlos o vol'
  +'ver a cargar el archivo desde el disco?"'#13#10#13#10'#: formconfig.rfilech'
  +'angedreloaddisk'#13#10'msgid "Reload from disk"'#13#10'msgstr "Recargar des'
  +'de el disco"'#13#10#13#10'#: formconfig.rfilechangedtitle'#13#10'msgid "Fil'
  +'e changed on disk"'#13#10'msgstr "Archivo modificado en el disco"'#13#10#13
  +#10'#: formconfig.rnamequestion'#13#10'msgid "Enter new config file name:"'
  +#13#10'msgstr "Introduzca el nombre del nuevo archivo de configuraci'#195#179
  +'n:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The configuration wa'
  +'s modified. Save changes?"'#13#10'msgstr "La configuraci'#195#179'n ha sido'
  +' modificada. '#194#191'Guardar los cambios?"'#13#10#13#10'#: formconfig.rre'
  +'sponsehint'#13#10'msgid ""'#13#10'"Json Pointer: Use / for levels, keys for'
  +' objects, and numbers for indexes.\n"'#13#10'"Use * for all items, *#10 to '
  +'join items by newline. Use ~ at the end of the path to return the raw JSON '
  +'branch.\n"'#13#10'"Separate multiple segments with semicolon ;.\n"'#13#10'"'
  +'Literal: Text block in {'#226#128#166'}. Special tag #10 for newlines. Use '
  +'{{regex}} inside to extract data directly into the text.\n"'#13#10'"Logic: '
  +'If a Pointer in a segment is empty, the whole segment is skipped. If a segm'
  +'ent has no Pointer, only literal text blocks with embedded regular expressi'
  +'ons are processed.\n"'#13#10'"Regex: {prefix {regex[index]} suffix} inside '
  +'a text block. If no [index] is specified, the first match is used.\n"'#13#10
  +'"Index can be a number, [*] (join by space), or [*#10] (join by newline). I'
  +'f the regex finds no match, the entire {'#226#128#166'} block is removed.\n'
  +'"'#13#10'"Using ~ inside a regex returns the entire text.\n"'#13#10'"Invers'
  +'ion: Start a segment with ! (e.g. !/path{Error}) to show its text only if t'
  +'he Pointer data is missing or the JSON is invalid.\n"'#13#10'"Commenting: /'
  +'* text */ comments are stripped from the entire expression before any proce'
  +'ssing.\n"'#13#10'"Examples:\n"'#13#10'"responseData/translatedText; matches'
  +'/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({('
  +'\\w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#13#10
  +'msgstr ""'#13#10'"Puntero JSON: Use / para los niveles, claves para los obj'
  +'etos y n'#195#186'meros para los '#195#173'ndices. Use * para todos los ele'
  +'mentos y *#10 para unir los elementos mediante un salto de l'#195#173'nea. '
  +'Use ~ al final de la ruta para devolver la rama JSON sin procesar. Separe v'
  +'arios segmentos con punto y coma ;.\n"'#13#10'"Literal: Bloque de texto ent'
  +'re {'#226#128#166'}. Etiqueta especial #10 para los saltos de l'#195#173'ne'
  +'a. Use {{regex}} dentro para extraer datos directamente en el texto.\n"'#13
  +#10'"L'#195#179'gica: Si un puntero de un segmento est'#195#161' vac'#195#173
  +'o, se omite todo el segmento. Si un segmento no tiene puntero, solo se proc'
  +'esan los bloques de texto literal con expresiones regulares incrustadas.\n"'
  +#13#10'"Regex: {prefijo {regex[index]} sufijo} dentro de un bloque de texto.'
  ,' Si no se especifica [index], se utiliza la primera coincidencia. El '#195
  +#173'ndice puede ser un n'#195#186'mero, [*] (unir con un espacio) o [*#10] '
  +'(unir con un salto de l'#195#173'nea). Si la expresi'#195#179'n regular no '
  +'encuentra ninguna coincidencia, se elimina todo el bloque {'#226#128#166'}.'
  +' El uso de ~ dentro de una expresi'#195#179'n regular devuelve el texto com'
  +'pleto.\n"'#13#10'"Inversi'#195#179'n: Comience un segmento con ! (por ejemp'
  +'lo, !/path{Error}) para mostrar su texto solo si faltan los datos del punte'
  +'ro o el JSON no es v'#195#161'lido.\n"'#13#10'"Comentarios: Los comentarios'
  +' /* texto */ se eliminan de toda la expresi'#195#179'n antes de cualquier p'
  +'rocesamiento.\n"'#13#10'"Ejemplos:\n"'#13#10'"responseData/translatedText; '
  +'matches/*#10/translation; /texts/text; {literal text#10}; /result/text; /te'
  +'xt{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#13#10
  +#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"The script is a sta'
  +'ndard Pascal program: optional var section, then a main begin ... end. bloc'
  +'k.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'" '
  +' begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceA'
  +'ll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10
  +'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standard Pascal constructs '
  +'(if, for, while, repeat, etc.). You can define your own functions and proce'
  +'dures before the main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Availabl'
  +'e functions:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Retrie'
  +'ve an input parameter value.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'
  +#13#10'"    Store an output value for the host.\n"'#13#10'"  GetTimestamp() '
  +': Int64\n"'#13#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#13
  +#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random integer with exactly '
  +'Length decimal digits.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random'
  +' float in the range [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n'
  +'"'#13#10'"    Convert integer to hexadecimal string with at least Digits ch'
  +'aracters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convert a strin'
  +'g to an integer. Raises an exception on invalid input.\n"'#13#10'"  IntToSt'
  +'r(Value) : string\n"'#13#10'"    Convert an integer to its string represent'
  +'ation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove leading and trai'
  +'ling whitespace from S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Re'
  +'move leading whitespace from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10
  +'"    Remove trailing whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string'
  +'\n"'#13#10'"    Encode special HTML characters in S into entities.\n"'#13#10
  +'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTML entities in S back to '
  +'characters.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encod'
  +'e S for safe URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'" '
  +'   Decode a percent-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern'
  +', NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Replace all occurre'
  +'nces of OldPattern with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, P'
  +'attern, Replacement) : string\n"'#13#10'"    Replace all regex matches of P'
  +'attern with Replacement in Input. Case-insensitive.\n"'#13#10'"  RegexMatch'
  +'(Input, Pattern) : Boolean\n"'#13#10'"    Check if Input matches the regex '
  +'Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndM'
  +'arker) : string\n"'#13#10'"    Extract the substring of S between StartMark'
  +'er and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a handle retur'
  +'ned by JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse'
  +' a JSON string and return a handle (>=0). Returns -1 on error.\n"'#13#10'" '
  +' JSONFree(Handle)\n"'#13#10'"    Release the handle after use.\n"'#13#10'" '
  +' JSONGetString(Handle, Path) : string\n"'#13#10'"    Get a string value at '
  +'the specified Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13
  +#10'"    Get an integer value at the specified Path.\n"'#13#10'"  JSONGetFlo'
  +'at(Handle, Path) : Extended\n"'#13#10'"    Get a floating-point value at th'
  +'e specified Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10
  +'"    Get a boolean value at the specified Path.\n"'#13#10'"  JSONGetArrayCo'
  +'unt(Handle, Path) : Integer\n"'#13#10'"    Get the number of elements in an'
  +' array at the specified Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path,'
  +' Index) : string\n"'#13#10'"    Get the string value of an array element at'
  +' the given Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integ'
  +'er\n"'#13#10'"    Get the integer value of an array element at the given In'
  +'dex.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Return '
  +'the type of the value at Path: \"object\", \"array\", \"string\", \"int\", '
  ,'\"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : '
  +'Boolean\n"'#13#10'"    Check if the specified Path exists.\n"'#13#10'"  JSO'
  +'NResultInit\n"'#13#10'"    Initialize an empty JSON array for building a st'
  +'andard error result.\n"'#13#10'"  JSONResultAddError(Offset, Length, Messag'
  +'e, Replacements)\n"'#13#10'"    Add an error object to the result array. Re'
  +'placements is a string of values separated by \"|\".\n"'#13#10'"  JSONResul'
  +'tGet : string\n"'#13#10'"    Return the current result array as a JSON stri'
  +'ng.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Clear the result array.\n"'
  +#13#10'"  Always call JSONFree to release the handle after you are done.\n"'
  +#13#10'"\n"'#13#10'"Example of working with JSON:\n"'#13#10'"  var h: Intege'
  +'r;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONP'
  +'arse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    be'
  +'gin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"     '
  +' SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Available parameters (retrieved wi'
  +'th GetParam):\n"'#13#10'"  text - the input text to process (possibly trunc'
  +'ated to MaxLength)\n"'#13#10'"  source - source language code (may be empty'
  +')\n"'#13#10'"  target - target language code\n"'#13#10'"  timestamp - curre'
  +'nt Unix timestamp in milliseconds (string)\n"'#13#10'"  random  - 9-digit r'
  +'andom number (string)\n"'#13#10'"  rand - same as random\n"'#13#10'"  rand1'
  +'..rand9 - first 1..9 digits of the random number\n"'#13#10'"\n"'#13#10'"Add'
  +'itional initial and custom parameters are also available."'#13#10'msgstr ""'
  +#13#10'"El script es un programa Pascal est'#195#161'ndar: una secci'#195#179
  +'n var opcional, seguida de un bloque principal begin ... end.\n"'#13#10'"\n'
  +'"'#13#10'"Ejemplo:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10
  +'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'
  +''', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13
  +#10'"\n"'#13#10'"Tambi'#195#169'n puedes utilizar las construcciones est'#195
  +#161'ndar de Pascal (if, for, while, repeat, etc.). Puedes definir tus propi'
  +'as funciones y procedimientos antes del bloque principal begin ... end.\n"'
  +#13#10'"\n"'#13#10'"Funciones disponibles:\n"'#13#10'"  GetParam(''name'') :'
  +' string\n"'#13#10'"    Recupera el valor de un par'#195#161'metro de entrad'
  +'a.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Almacena un v'
  +'alor de salida para el host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10
  +'"    Marca de tiempo Unix actual en milisegundos (UTC).\n"'#13#10'"  GetRan'
  +'dom(Length) : Int64\n"'#13#10'"    N'#195#186'mero entero aleatorio con exa'
  +'ctamente Length d'#195#173'gitos decimales.\n"'#13#10'"  Random : Extended\'
  +'n"'#13#10'"    N'#195#186'mero de coma flotante aleatorio en el rango [0, 1'
  +').\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Convierte u'
  +'n n'#195#186'mero entero en una cadena hexadecimal con al menos Digits cara'
  +'cteres.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convierte una cad'
  +'ena en un n'#195#186'mero entero. Genera una excepci'#195#179'n si la entra'
  +'da no es v'#195#161'lida.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"'
  +'    Convierte un n'#195#186'mero entero en su representaci'#195#179'n como '
  +'cadena.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Elimina los espacios e'
  +'n blanco iniciales y finales de S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13
  +#10'"    Elimina los espacios en blanco iniciales de S.\n"'#13#10'"  TrimRig'
  +'ht(S) : string\n"'#13#10'"    Elimina los espacios en blanco finales de S.\'
  +'n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Codifica los caracteres '
  +'HTML especiales de S como entidades.\n"'#13#10'"  HtmlDecode(S) : string\n"'
  +#13#10'"    Decodifica las entidades HTML de S y las convierte de nuevo en c'
  +'aracteres.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Codifica S med'
  +'iante codificaci'#195#179'n porcentual para incluirlo de forma segura en un'
  +'a URL.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Decodifica una cad'
  +'ena S codificada mediante porcentajes.\n"'#13#10'"  ReplaceAll(S, OldPatter'
  +'n, NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Reemplaza todas la'
  +'s apariciones de OldPattern por NewPattern en S.\n"'#13#10'"  RegexReplace('
  +'Input, Pattern, Replacement) : string\n"'#13#10'"    Reemplaza todas las co'
  +'incidencias de la expresi'#195#179'n regular Pattern por Replacement en Inp'
  +'ut. No distingue entre may'#195#186'sculas y min'#195#186'sculas.\n"'#13#10
  +'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Comprueba si Input c'
  +'oincide con la expresi'#195#179'n regular Pattern. No distingue entre may'
  +#195#186'sculas y min'#195#186'sculas.\n"'#13#10'"  ExtractBetween(S, StartM'
  +'arker, EndMarker) : string\n"'#13#10'"    Extrae la subcadena de S situada '
  ,'entre StartMarker y EndMarker.\n"'#13#10'"\n"'#13#10'"Funciones JSON (utili'
  +'za un handle devuelto por JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n'
  +'"'#13#10'"    Analiza una cadena JSON y devuelve un handle (>=0). Devuelve '
  +'-1 en caso de error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Libera el'
  +' handle despu'#195#169's de su uso.\n"'#13#10'"  JSONGetString(Handle, Path'
  +') : string\n"'#13#10'"    Obtiene un valor de tipo cadena en la ruta especi'
  +'ficada Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"   '
  +' Obtiene un valor entero en la ruta especificada Path.\n"'#13#10'"  JSONGet'
  +'Float(Handle, Path) : Extended\n"'#13#10'"    Obtiene un valor de coma flot'
  +'ante en la ruta especificada Path.\n"'#13#10'"  JSONGetBool(Handle, Path) :'
  +' Boolean\n"'#13#10'"    Obtiene un valor booleano en la ruta especificada P'
  +'ath.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    '
  +'Obtiene el n'#195#186'mero de elementos de un array en la ruta especificada'
  +' Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13
  +#10'"    Obtiene el valor de tipo cadena de un elemento del array en el '#195
  +#173'ndice indicado Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index)'
  +' : Integer\n"'#13#10'"    Obtiene el valor entero de un elemento del array '
  +'en el '#195#173'ndice indicado Index.\n"'#13#10'"  JSONGetType(Handle, Path'
  +') : string\n"'#13#10'"    Devuelve el tipo del valor en Path: \"object\", \'
  +'"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  '
  +'JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Comprueba si existe l'
  +'a ruta especificada Path.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Inicia'
  +'liza un array JSON vac'#195#173'o para crear un resultado de error est'#195
  +#161'ndar.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replacem'
  +'ents)\n"'#13#10'"    A'#195#177'ade un objeto de error al array de resultad'
  +'os. Replacements es una cadena de valores separados por \"|\".\n"'#13#10'" '
  +' JSONResultGet : string\n"'#13#10'"    Devuelve el array de resultados actu'
  +'al como una cadena JSON.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Borra '
  +'el array de resultados.\n"'#13#10'"  Llama siempre a JSONFree para liberar '
  +'el handle cuando hayas terminado de utilizarlo.\n"'#13#10'"\n"'#13#10'"Ejem'
  +'plo de trabajo con JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: s'
  +'tring;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result'''
  +'));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s :'
  +'= JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);'
  +'\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13
  +#10'"\n"'#13#10'"Par'#195#161'metros disponibles (recuperados mediante GetPa'
  +'ram):\n"'#13#10'"  text - el texto de entrada que se va a procesar (posible'
  +'mente truncado a MaxLength)\n"'#13#10'"  source - c'#195#179'digo del idiom'
  +'a de origen (puede estar vac'#195#173'o)\n"'#13#10'"  target - c'#195#179'd'
  +'igo del idioma de destino\n"'#13#10'"  timestamp - marca de tiempo Unix act'
  +'ual en milisegundos (cadena)\n"'#13#10'"  random  - n'#195#186'mero aleator'
  +'io de 9 d'#195#173'gitos (cadena)\n"'#13#10'"  rand - igual que random\n"'
  +#13#10'"  rand1..rand9 - los primeros 1..9 d'#195#173'gitos del n'#195#186'm'
  +'ero aleatorio\n"'#13#10'"\n"'#13#10'"Tambi'#195#169'n est'#195#161'n dispon'
  +'ibles par'#195#161'metros iniciales y personalizados adicionales. personali'
  +'zados adicionales."'#13#10#13#10'#: formconfig.rscriptresponsehint'#13#10'm'
  +'sgid ""'#13#10'"This script processes the response data. All functions and '
  +'parameters described in the script hint are available here as well.\n"'#13
  +#10'"Use GetParam(''result'') to obtain the received text.\n"'#13#10'"\n"'#13
  +#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    '
  +'s := GetParam(''result'');\n"'#13#10'"    SetOutput(''result'', s);\n"'#13
  +#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define custom parameters in the p'
  +'arameters script using SetParam(''name'', ''value''),\n"'#13#10'"and then r'
  +'etrieve them here with GetParam(''name'')."'#13#10'msgstr ""'#13#10'"Este s'
  +'cript procesa los datos de respuesta. Todas las funciones y par'#195#161'me'
  +'tros descritos en la ayuda del script tambi'#195#169'n est'#195#161'n dispo'
  +'nibles aqu'#195#173'.\n"'#13#10'"Use GetParam(''result'') para obtener el t'
  +'exto recibido.\n"'#13#10'"\n"'#13#10'"Ejemplo:\n"'#13#10'"  var s: string;\'
  +'n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"   '
  +' SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Puede d'
  +'efinir par'#195#161'metros personalizados en el script de par'#195#161'metr'
  +'os mediante SetParam(''name'', ''value''),\n"'#13#10'"y luego recuperarlos '
  +'aqu'#195#173' con GetParam(''name'')."'#13#10#13#10'#: formconfig.rvaluetyp'
  +'e1'#13#10'msgctxt "formconfig.rvaluetype1"'#13#10'msgid "None"'#13#10'msgst'
  ,'r "Ninguno"'#13#10#13#10'#: formconfig.rvaluetype2'#13#10'msgid "Language"'
  +#13#10'msgstr "Idioma"'#13#10#13#10'#: formconfig.rvaluetype3'#13#10'msgid "'
  +'Currency All"'#13#10'msgstr "Todas las monedas"'#13#10#13#10'#: formconfig.'
  +'rvaluetype4'#13#10'msgid "Currency Fiat Only"'#13#10'msgstr "Solo monedas f'
  +'iat"'#13#10#13#10'#: formconfig.rvaluetype5'#13#10'msgid "Currency Crypto O'
  +'nly"'#13#10'msgstr "Solo criptomonedas"'#13#10#13#10'#: formconfig.rvaluety'
  +'pe6'#13#10'msgid "Measurement Units"'#13#10'msgstr "Unidades de medida"'#13
  +#10#13#10'#: tformconfigtrayslate.aclearicon.caption'#13#10'msgid "Clear Ico'
  +'n"'#13#10'msgstr "Borrar icono"'#13#10#13#10'#: tformconfigtrayslate.aeditf'
  +'ile.caption'#13#10'msgid "Edit File..."'#13#10'msgstr "Editar archivo..."'
  +#13#10#13#10'#: tformconfigtrayslate.asave.caption'#13#10'msgid "Save"'#13#10
  +'msgstr "Guardar"'#13#10#13#10'#: tformconfigtrayslate.asaveiconas.caption'
  +#13#10'msgid "Save Icon As..."'#13#10'msgstr "Guardar icono como..."'#13#10
  +#13#10'#: tformconfigtrayslate.btnclose.caption'#13#10'msgid "Close"'#13#10
  +'msgstr "Cerrar"'#13#10#13#10'#: tformconfigtrayslate.btninitparameterstest.'
  +'hint'#13#10'msgid "Execute request and view the parameters"'#13#10'msgstr "'
  +'Ejecutar la solicitud y ver los par'#195#161'metros"'#13#10#13#10'#: tformc'
  +'onfigtrayslate.btniniturltest.hint'#13#10'msgid "Execute request and view t'
  +'he result"'#13#10'msgstr "Ejecutar la solicitud y ver el resultado"'#13#10
  +#13#10'#: tformconfigtrayslate.btnpostdatatest.hint'#13#10'msgid "Execute po'
  +'st request and view the result"'#13#10'msgstr "Ejecutar la solicitud POST y'
  +' ver el resultado"'#13#10#13#10'#: tformconfigtrayslate.btnresponsehelp.hin'
  +'t'#13#10'msgctxt "tformconfigtrayslate.btnresponsehelp.hint"'#13#10'msgid "'
  +'Help"'#13#10'msgstr "Ayuda"'#13#10#13#10'#: tformconfigtrayslate.btnrespons'
  +'etest.hint'#13#10'msgid "Converts the current response"'#13#10'msgstr "Conv'
  +'ierte la respuesta actual"'#13#10#13#10'#: tformconfigtrayslate.btnscripthe'
  +'lp.hint'#13#10'msgctxt "tformconfigtrayslate.btnscripthelp.hint"'#13#10'msg'
  +'id "Help"'#13#10'msgstr "Ayuda"'#13#10#13#10'#: tformconfigtrayslate.btnscr'
  +'iptresponsehelp.hint'#13#10'msgctxt "tformconfigtrayslate.btnscriptresponse'
  +'help.hint"'#13#10'msgid "Help"'#13#10'msgstr "Ayuda"'#13#10#13#10'#: tformc'
  +'onfigtrayslate.btnscriptresponsetest.hint'#13#10'msgctxt "tformconfigtraysl'
  +'ate.btnscriptresponsetest.hint"'#13#10'msgid "Execute script and view the r'
  +'esult"'#13#10'msgstr "Ejecutar el script y ver el resultado"'#13#10#13#10'#'
  +': tformconfigtrayslate.btnscripttest.hint'#13#10'msgctxt "tformconfigtraysl'
  +'ate.btnscripttest.hint"'#13#10'msgid "Execute script and view the result"'
  +#13#10'msgstr "Ejecutar el script y ver el resultado"'#13#10#13#10'#: tformc'
  +'onfigtrayslate.btnurltest.hint'#13#10'msgid "Execute get request and view t'
  +'he result"'#13#10'msgstr "Ejecutar la solicitud GET y ver el resultado"'#13
