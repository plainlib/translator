  +'s2.caption'#10'msgctxt "tformconfigtrayslate.labelinitparameters2.caption"'
  +#10'msgid "Parameters"'#10'msgstr "Parametry"'#10#10'#: tformconfigtrayslate'
  +'.labelinitparameters4.caption'#10'msgid "Parameters in the form key=value u'
