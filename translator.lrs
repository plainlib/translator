  +'slate.combomethod.text'#10'msgid "GET"'#10'msgstr "GET"'#10#10'#: tformconf'
  +'igtrayslate.combovaluetype.text'#10'msgctxt "tformconfigtrayslate.combovalu'
  +'etype.text"'#10'msgid "None"'#10'msgstr "Aucun"'#10#10'#: tformconfigtraysl'
  +'ate.groupboxcustomparameters.caption'#10'msgid "Custom Parameters"'#10'msgs'
  +'tr "Param'#195#168'tres personnalis'#195#169's"'#10#10'#: tformconfigtraysl'
  +'ate.groupboxservice.caption'#10'msgctxt "tformconfigtrayslate.groupboxservi'
  +'ce.caption"'#10'msgid "Service"'#10'msgstr "Service"'#10#10'#: tformconfigt'
  +'rayslate.groupinitparameters.caption'#10'msgctxt "tformconfigtrayslate.grou'
  +'pinitparameters.caption"'#10'msgid "Initial Request"'#10'msgstr "Requ'#195
  +#170'te initiale"'#10#10'#: tformconfigtrayslate.grouplanguages.caption'#10
  +'msgctxt "tformconfigtrayslate.grouplanguages.caption"'#10'msgid "Languages"'
  +#10'msgstr "Langues"'#10#10'#: tformconfigtrayslate.grouplanguagestarget.cap'
  +'tion'#10'msgctxt "tformconfigtrayslate.grouplanguagestarget.caption"'#10'ms'
  +'gid "Target Languages"'#10'msgstr "Langues cibles"'#10#10'#: tformconfigtra'
  +'yslate.grouprequest.caption'#10'msgctxt "tformconfigtrayslate.grouprequest.'
  +'caption"'#10'msgid "Request"'#10'msgstr "Requ'#195#170'te"'#10#10'#: tformc'
  +'onfigtrayslate.groupresponse.caption'#10'msgid "Json Pointer Processing the'
  +' Response"'#10'msgstr "Traitement de la r'#195#169'ponse avec Json Pointer"'
  +#10#10'#: tformconfigtrayslate.groupscript.caption'#10'msgid "Script Retriev'
  +'ed Parameters"'#10'msgstr "Param'#195#168'tres r'#195#169'cup'#195#169'r'
  +#195#169's par le script"'#10#10'#: tformconfigtrayslate.groupscriptresponse'
  +'.caption'#10'msgid "Script Processing the Response"'#10'msgstr "Traitement '
  +'de la r'#195#169'ponse par le script"'#10#10'#: tformconfigtrayslate.imagep'
