  +'on'#10'msgid "Name"'#10'msgstr "Nombre"'#10#10'#: tformconfigtrayslate.labe'
  +'lserviceorder.caption'#10'msgid "Order"'#10'msgstr "Orden"'#10#10'#: tformc'
  +'onfigtrayslate.labelsort.caption'#10'msgctxt "tformconfigtrayslate.labelsor'
