  +'ranslatedText; matches/*#10/translation; /texts/text; {literal text#10}; /r'
  ,'esult/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /transl'
  +'ations"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a '
  +'standard Pascal program: optional var section, then a main begin ... end. b'
  +'lock.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'
  +#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'
  +''', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'
  +#10'"You can also use standard Pascal constructs (if, for, while, repeat, et'
  +'c.). You can define your own functions and procedures before the main begin'
  +' ... end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam('
  +'''name'') : string\n"'#10'"    Retrieve an input parameter value.\n"'#10'" '
  +' SetOutput(''name'', ''value'')\n"'#10'"    Store an output value for the h'
  +'ost.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timestamp in'
  +' milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random'
  +' integer with exactly Length decimal digits.\n"'#10'"  Random : Extended\n"'
  +#10'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits)'
  +' : string\n"'#10'"    Convert integer to hexadecimal string with at least D'
  +'igits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a str'
  +'ing to an integer. Raises an exception on invalid input.\n"'#10'"  IntToStr'
  +'(Value) : string\n"'#10'"    Convert an integer to its string representatio'
  +'n.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailing white'
  +'space from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whi'
  +'tespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing'
  +' whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode spe'
  +'cial HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n'
  +'"'#10'"    Decode HTML entities in S back to characters.\n"'#10'"  UrlEncod'
  +'e(S) : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"'
  +'  UrlDecode(S) : string\n"'#10'"    Decode a percent-encoded string S.\n"'
  +#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'
  +#10'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'#10
  +'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Replace a'
  +'ll regex matches of Pattern with Replacement in Input. Case-insensitive.\n"'
  +#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if Input match'
  +'es the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMa'
  +'rker, EndMarker) : string\n"'#10'"    Extract the substring of S between St'
  +'artMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle retu'
  +'rned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JS'
  +'ON string and return a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFre'
  +'e(Handle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSONGetString'
  +'(Handle, Path) : string\n"'#10'"    Get a string value at the specified Pat'
  +'h.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an integer '
  +'value at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extende'
  +'d\n"'#10'"    Get a floating-point value at the specified Path.\n"'#10'"  J'
  +'SONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value at the s'
  +'pecified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"'
  +'    Get the number of elements in an array at the specified Path.\n"'#10'" '
  +' JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the strin'
  +'g value of an array element at the given Index.\n"'#10'"  JSONGetArrayInt(H'
  +'andle, Path, Index) : Integer\n"'#10'"    Get the integer value of an array'
  +' element at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n'
  +'"'#10'"    Return the type of the value at Path: \"object\", \"array\", \"s'
  +'tring\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(H'
  +'andle, Path) : Boolean\n"'#10'"    Check if the specified Path exists.\n"'
  +#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for buildin'
  +'g a standard error result.\n"'#10'"  JSONResultAddError(Offset, Length, Mes'
  +'sage, Replacements)\n"'#10'"    Add an error object to the result array. Re'
  +'placements is a string of values separated by \"|\".\n"'#10'"  JSONResultGe'
