  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Editor konfigurace"'#13#10#13#10'#: formconfig.rclearlanguages'#13#10'msg'
  +'id "The list is already filled. Do you want to clear it?"'#13#10'msgstr "Se'
  +'znam je ji'#197#190' zapln'#196#155'n. Chcete jej vy'#196#141'istit?"'#13#10
  +#13#10'#: formconfig.rconfigeditor'#13#10'msgid "Config Editor..."'#13#10'ms'
  +'gstr "Editor konfigurace..."'#13#10#13#10'#: formconfig.rdeleteconfig'#13#10
  +'msgid "Are you sure you want to delete config"'#13#10'msgstr "Opravdu chcet'
  +'e smazat konfiguraci"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13#10
  +'msgid "Delete config"'#13#10'msgstr "Smazat konfiguraci"'#13#10#13#10'#: fo'
  +'rmconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Zru'#197
  +#161'it"'#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Ke'
  +'ep my changes"'#13#10'msgstr "Zachovat moje zm'#196#155'ny"'#13#10#13#10'#:'
  +' formconfig.rfilechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "Th'
  +'e file \"%s\" has been modified by another application since it was opened.'
  +'"'#13#10'msgstr "Soubor \"%s\" byl od sv'#195#169'ho otev'#197#153'en'#195
  +#173' zm'#196#155'n'#196#155'n jinou aplikac'#195#173'."'#13#10#13#10'#: for'
  +'mconfig.rfilechangedmsgactivate'#13#10'msgid "You have unsaved changes. Kee'
  +'p them or reload from disk?"'#13#10'msgstr "M'#195#161'te neulo'#197#190'en'
  +#195#169' zm'#196#155'ny. Chcete je zachovat, nebo znovu na'#196#141#195#173
  +'st soubor z disku?"'#13#10#13#10'#: formconfig.rfilechangedreloaddisk'#13#10
  +'msgid "Reload from disk"'#13#10'msgstr "Znovu na'#196#141#195#173'st z disk'
  +'u"'#13#10#13#10'#: formconfig.rfilechangedtitle'#13#10'msgid "File changed '
  +'on disk"'#13#10'msgstr "Soubor byl zm'#196#155'n'#196#155'n na disku"'#13#10
  +#13#10'#: formconfig.rnamequestion'#13#10'msgid "Enter new config file name:'
  +'"'#13#10'msgstr "Zadejte n'#195#161'zev nov'#195#169'ho konfigura'#196#141
  +'n'#195#173'ho souboru:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "'
  +'The configuration was modified. Save changes?"'#13#10'msgstr "Konfigurace b'
  +'yla zm'#196#155'n'#196#155'na. Ulo'#197#190'it zm'#196#155'ny?"'#13#10#13#10
  +'#: formconfig.rresponsehint'#13#10'msgid ""'#13#10'"Json Pointer: Use / for'
  +' levels, keys for objects, and numbers for indexes.\n"'#13#10'"Use * for al'
  +'l items, *#10 to join items by newline. Use ~ at the end of the path to ret'
  +'urn the raw JSON branch.\n"'#13#10'"Separate multiple segments with semicol'
  +'on ;.\n"'#13#10'"Literal: Text block in {'#226#128#166'}. Special tag #10 f'
  +'or newlines. Use {{regex}} inside to extract data directly into the text.\n'
  +'"'#13#10'"Logic: If a Pointer in a segment is empty, the whole segment is s'
  +'kipped. If a segment has no Pointer, only literal text blocks with embedded'
  +' regular expressions are processed.\n"'#13#10'"Regex: {prefix {regex[index]'
  +'} suffix} inside a text block. If no [index] is specified, the first match '
  +'is used.\n"'#13#10'"Index can be a number, [*] (join by space), or [*#10] ('
  +'join by newline). If the regex finds no match, the entire {'#226#128#166'} '
  +'block is removed.\n"'#13#10'"Using ~ inside a regex returns the entire text'
  +'.\n"'#13#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show'
  +' its text only if the Pointer data is missing or the JSON is invalid.\n"'#13
  +#10'"Commenting: /* text */ comments are stripped from the entire expression'
  +' before any processing.\n"'#13#10'"Examples:\n"'#13#10'"responseData/transl'
  +'atedText; matches/*#10/translation; /texts/text; {literal text#10}; /result'
  +'/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translation'
  +'s/0/text"'#13#10'msgstr ""'#13#10'"Ukazatel JSON: Pou'#197#190'ijte / pro '
  +#195#186'rovn'#196#155', kl'#195#173#196#141'e pro objekty a '#196#141#195
  +#173'sla pro indexy. Pou'#197#190'ijte * pro v'#197#161'echny polo'#197#190
  +'ky, *#10 pro spojen'#195#173' polo'#197#190'ek pomoc'#195#173' nov'#195#169
  +'ho '#197#153#195#161'dku. Pou'#197#190'ijte ~ na konci cesty pro vr'#195#161
  +'cen'#195#173' nezpracovan'#195#169' v'#196#155'tve JSON. V'#195#173'ce segm'
  +'ent'#197#175' odd'#196#155'lte st'#197#153'edn'#195#173'kem ;.\n"'#13#10'"L'
  +'iter'#195#161'l: Textov'#195#189' blok v {'#226#128#166'}. Speci'#195#161'l'
  +'n'#195#173' zna'#196#141'ka #10 pro nov'#195#169' '#197#153#195#161'dky. Po'
  +'u'#197#190'ijte {{regex}} uvnit'#197#153' pro p'#197#153#195#173'm'#195#169
  +' vlo'#197#190'en'#195#173' extrahovan'#195#189'ch dat do textu.\n"'#13#10'"'
  ,'Logika: Pokud je ukazatel v segmentu pr'#195#161'zdn'#195#189', cel'#195#189
  +' segment se p'#197#153'esko'#196#141#195#173'. Pokud segment neobsahuje uka'
  +'zatel, zpracuj'#195#173' se pouze bloky doslovn'#195#169'ho textu s vlo'#197
  +#190'en'#195#189'mi regul'#195#161'rn'#195#173'mi v'#195#189'razy.\n"'#13#10
  +'"Regex: {prefix {regex[index]} suffix} uvnit'#197#153' textov'#195#169'ho b'
  +'loku. Pokud nen'#195#173' zad'#195#161'n [index], pou'#197#190'ije se prvn'
  +#195#173' shoda. Index m'#197#175#197#190'e b'#195#189't '#196#141#195#173's'
  +'lo, [*] (spojit mezerou) nebo [*#10] (spojit nov'#195#189'm '#197#153#195
  +#161'dkem). Pokud regul'#195#161'rn'#195#173' v'#195#189'raz nenajde '#197
  +#190#195#161'dnou shodu, cel'#195#189' blok {'#226#128#166'} se odstran'#195
  +#173'. Pou'#197#190'it'#195#173' ~ uvnit'#197#153' regul'#195#161'rn'#195#173
  +'ho v'#195#189'razu vr'#195#161't'#195#173' cel'#195#189' text.\n"'#13#10'"I'
  +'nverze: Za'#196#141'n'#196#155'te segment znakem ! (nap'#197#153'. !/path{E'
  +'rror}), aby se jeho text zobrazil pouze tehdy, pokud chyb'#195#173' data uk'
  +'azatele nebo je JSON neplatn'#195#189'.\n"'#13#10'"Koment'#195#161#197#153
  +'e: Koment'#195#161#197#153'e /* text */ jsou z cel'#195#169'ho v'#195#189'r'
  +'azu odstran'#196#155'ny p'#197#153'ed jak'#195#189'mkoli zpracov'#195#161'n'
  +#195#173'm.\n"'#13#10'"P'#197#153#195#173'klady:\n"'#13#10'"responseData/tra'
  +'nslatedText; matches/*#10/translation; /texts/text; {literal text#10}; /res'
  +'ult/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translat'
  +'ions"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"The sc'
  +'ript is a standard Pascal program: optional var section, then a main begin '
  +'... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;'
  +'\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    '
  +'s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'','
  +' s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standard Pas'
  +'cal constructs (if, for, while, repeat, etc.). You can define your own func'
  +'tions and procedures before the main begin ... end. block.\n"'#13#10'"\n"'
  +#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'') : string\n"'#13
  +#10'"    Retrieve an input parameter value.\n"'#13#10'"  SetOutput(''name'','
  +' ''value'')\n"'#13#10'"    Store an output value for the host.\n"'#13#10'" '
  +' GetTimestamp() : Int64\n"'#13#10'"    Current Unix timestamp in millisecon'
  +'ds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random inte'
  +'ger with exactly Length decimal digits.\n"'#13#10'"  Random : Extended\n"'
  +#13#10'"    Random float in the range [0, 1).\n"'#13#10'"  IntToHex(Value, D'
  +'igits) : string\n"'#13#10'"    Convert integer to hexadecimal string with a'
  +'t least Digits characters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"  '
  +'  Convert a string to an integer. Raises an exception on invalid input.\n"'
  +#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Convert an integer to its '
  +'string representation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove '
  +'leading and trailing whitespace from S.\n"'#13#10'"  TrimLeft(S) : string\n'
  +'"'#13#10'"    Remove leading whitespace from S.\n"'#13#10'"  TrimRight(S) :'
  +' string\n"'#13#10'"    Remove trailing whitespace from S.\n"'#13#10'"  Html'
  +'Encode(S) : string\n"'#13#10'"    Encode special HTML characters in S into '
  +'entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTML en'
  +'tities in S back to characters.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10
  +'"    Percent-encode S for safe URL inclusion.\n"'#13#10'"  UrlDecode(S) : s'
  +'tring\n"'#13#10'"    Decode a percent-encoded string S.\n"'#13#10'"  Replac'
  +'eAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13#10'"    R'
  +'eplace all occurrences of OldPattern with NewPattern in S.\n"'#13#10'"  Reg'
  +'exReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    Replace all '
  +'regex matches of Pattern with Replacement in Input. Case-insensitive.\n"'#13
  +#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Check if Input ma'
  +'tches the regex Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetween(S, S'
  +'tartMarker, EndMarker) : string\n"'#13#10'"    Extract the substring of S b'
  +'etween StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (us'
  +'e a handle returned by JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'
  +#13#10'"    Parse a JSON string and return a handle (>=0). Returns -1 on err'
  +'or.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release the handle after u'
  +'se.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"    Get a '
  +'string value at the specified Path.\n"'#13#10'"  JSONGetInt(Handle, Path) :'
  +' Integer\n"'#13#10'"    Get an integer value at the specified Path.\n"'#13
  +#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Get a floating-p'
  +'oint value at the specified Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : '
  ,'Boolean\n"'#13#10'"    Get a boolean value at the specified Path.\n"'#13#10
  +'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Get the number '
  +'of elements in an array at the specified Path.\n"'#13#10'"  JSONGetArrayStr'
  +'ing(Handle, Path, Index) : string\n"'#13#10'"    Get the string value of an'
  +' array element at the given Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Pat'
  +'h, Index) : Integer\n"'#13#10'"    Get the integer value of an array elemen'
  +'t at the given Index.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13
  +#10'"    Return the type of the value at Path: \"object\", \"array\", \"stri'
  +'ng\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(H'
  +'andle, Path) : Boolean\n"'#13#10'"    Check if the specified Path exists.\n'
  +'"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an empty JSON array fo'
  +'r building a standard error result.\n"'#13#10'"  JSONResultAddError(Offset,'
  +' Length, Message, Replacements)\n"'#13#10'"    Add an error object to the r'
  +'esult array. Replacements is a string of values separated by \"|\".\n"'#13
  +#10'"  JSONResultGet : string\n"'#13#10'"    Return the current result array'
  +' as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Clear the re'
  +'sult array.\n"'#13#10'"  Always call JSONFree to release the handle after y'
  +'ou are done.\n"'#13#10'"\n"'#13#10'"Example of working with JSON:\n"'#13#10
  +'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10
  +'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'
  +#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'
  +#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10
  +'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Available parameters (re'
  +'trieved with GetParam):\n"'#13#10'"  text - the input text to process (poss'
  +'ibly truncated to MaxLength)\n"'#13#10'"  source - source language code (ma'
  +'y be empty)\n"'#13#10'"  target - target language code\n"'#13#10'"  timesta'
  +'mp - current Unix timestamp in milliseconds (string)\n"'#13#10'"  random  -'
  +' 9-digit random number (string)\n"'#13#10'"  rand - same as random\n"'#13#10
  +'"  rand1..rand9 - first 1..9 digits of the random number\n"'#13#10'"\n"'#13
  +#10'"Additional initial and custom parameters are also available."'#13#10'ms'
  +'gstr ""'#13#10'"Skript je standardn'#195#173' program v Pascalu: voliteln'
  +#195#161' sekce var a pot'#195#169' hlavn'#195#173' blok begin ... end.\n"'
  +#13#10'"\n"'#13#10'"P'#197#153#195#173'klad:\n"'#13#10'"  var s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := '
  +'ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"M'#197#175#197#190'ete tak'#195#169
  +' pou'#197#190#195#173'vat standardn'#195#173' konstrukce Pascalu (if, for, '
  +'while, repeat atd.). P'#197#153'ed hlavn'#195#173'm blokem begin ... end. m'
  +#197#175#197#190'ete definovat vlastn'#195#173' funkce a procedury.\n"'#13#10
  +'"\n"'#13#10'"Dostupn'#195#169' funkce:\n"'#13#10'"  GetParam(''name'') : st'
  +'ring\n"'#13#10'"    Na'#196#141'te hodnotu vstupn'#195#173'ho parametru.\n"'
  +#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Ulo'#197#190#195#173
  +' v'#195#189'stupn'#195#173' hodnotu pro hostitele.\n"'#13#10'"  GetTimestam'
  +'p() : Int64\n"'#13#10'"    Aktu'#195#161'ln'#195#173' '#196#141'asov'#195
  +#169' raz'#195#173'tko Unix v milisekund'#195#161'ch (UTC).\n"'#13#10'"  Get'
  +'Random(Length) : Int64\n"'#13#10'"    N'#195#161'hodn'#195#169' cel'#195#169
  +' '#196#141#195#173'slo s p'#197#153'esn'#196#155' Length desetinn'#195#189
  +'mi '#196#141#195#173'slicemi.\n"'#13#10'"  Random : Extended\n"'#13#10'"   '
  +' N'#195#161'hodn'#195#169' '#196#141#195#173'slo s plovouc'#195#173' deseti'
  +'nnou '#196#141#195#161'rkou v rozsahu [0, 1).\n"'#13#10'"  IntToHex(Value, '
  +'Digits) : string\n"'#13#10'"    P'#197#153'evede cel'#195#169' '#196#141#195
  +#173'slo na '#197#161'estn'#195#161'ctkov'#195#189' '#197#153'et'#196#155'ze'
  +'c s alespo'#197#136' Digits znaky.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13
  +#10'"    P'#197#153'evede '#197#153'et'#196#155'zec na cel'#195#169' '#196
  +#141#195#173'slo. P'#197#153'i neplatn'#195#169'm vstupu vyvol'#195#161' v'
  +#195#189'jimku.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    P'#197
  +#153'evede cel'#195#169' '#196#141#195#173'slo na jeho '#197#153'et'#196#155
  +'zcovou reprezentaci.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Odstran'
  +#195#173' po'#196#141#195#161'te'#196#141'n'#195#173' a koncov'#195#169' mez'
  +'ery z S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Odstran'#195#173
  +' po'#196#141#195#161'te'#196#141'n'#195#173' mezery z S.\n"'#13#10'"  TrimR'
  +'ight(S) : string\n"'#13#10'"    Odstran'#195#173' koncov'#195#169' mezery z'
  +' S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Zak'#195#179'duje sp'
  +'eci'#195#161'ln'#195#173' HTML znaky v S do entit.\n"'#13#10'"  HtmlDecode('
  ,'S) : string\n"'#13#10'"    Dek'#195#179'duje HTML entity v S zp'#196#155't '
  +'na znaky.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Provede procent'
  +'ov'#195#169' k'#195#179'dov'#195#161'n'#195#173' S pro bezpe'#196#141'n'#195
  +#169' pou'#197#190'it'#195#173' v URL.\n"'#13#10'"  UrlDecode(S) : string\n"'
  +#13#10'"    Dek'#195#179'duje '#197#153'et'#196#155'zec S k'#195#179'dovan'
  +#195#189' pomoc'#195#173' procentov'#195#169'ho k'#195#179'dov'#195#161'n'
  +#195#173'.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=Fal'
  +'se) : string\n"'#13#10'"    Nahrad'#195#173' v'#197#161'echny v'#195#189'sk'
  +'yty OldPattern za NewPattern v S.\n"'#13#10'"  RegexReplace(Input, Pattern,'
  +' Replacement) : string\n"'#13#10'"    Nahrad'#195#173' v'#197#161'echny sho'
  +'dy regul'#195#161'rn'#195#173'ho v'#195#189'razu Pattern za Replacement v I'
  +'nput. Bez rozli'#197#161'en'#195#173' velk'#195#189'ch a mal'#195#189'ch p'
  +#195#173'smen.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"'
  +'    Zkontroluje, zda Input odpov'#195#173'd'#195#161' regul'#195#161'rn'#195
  +#173'mu v'#195#189'razu Pattern. Bez rozli'#197#161'en'#195#173' velk'#195
  +#189'ch a mal'#195#189'ch p'#195#173'smen.\n"'#13#10'"  ExtractBetween(S, St'
  +'artMarker, EndMarker) : string\n"'#13#10'"    Extrahuje pod'#197#153'et'#196
  +#155'zec z S mezi StartMarker a EndMarker.\n"'#13#10'"\n"'#13#10'"Funkce JSO'
  +'N (pou'#197#190'ijte handle vr'#195#161'cen'#195#189' funkc'#195#173' JSONP'
  +'arse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Analyzuje '#197
  +#153'et'#196#155'zec JSON a vr'#195#161't'#195#173' handle (>=0). P'#197#153
  +'i chyb'#196#155' vr'#195#161't'#195#173' -1.\n"'#13#10'"  JSONFree(Handle)\'
  +'n"'#13#10'"    Po pou'#197#190'it'#195#173' uvoln'#195#173' handle.\n"'#13
  +#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"    Z'#195#173'sk'#195
  +#161' '#197#153'et'#196#155'zcovou hodnotu na zadan'#195#169' cest'#196#155
  +' Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    Z'#195
  +#173'sk'#195#161' celo'#196#141#195#173'selnou hodnotu na zadan'#195#169' ce'
  +'st'#196#155' Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13
  +#10'"    Z'#195#173'sk'#195#161' hodnotu s plovouc'#195#173' desetinnou '#196
  +#141#195#161'rkou na zadan'#195#169' cest'#196#155' Path.\n"'#13#10'"  JSONG'
  +'etBool(Handle, Path) : Boolean\n"'#13#10'"    Z'#195#173'sk'#195#161' logic'
  +'kou hodnotu na zadan'#195#169' cest'#196#155' Path.\n"'#13#10'"  JSONGetArr'
  +'ayCount(Handle, Path) : Integer\n"'#13#10'"    Z'#195#173'sk'#195#161' po'
  +#196#141'et prvk'#197#175' pole na zadan'#195#169' cest'#196#155' Path.\n"'
  +#13#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Z'
  +#195#173'sk'#195#161' '#197#153'et'#196#155'zcovou hodnotu prvku pole na zad'
  +'an'#195#169'm indexu Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Inde'
  +'x) : Integer\n"'#13#10'"    Z'#195#173'sk'#195#161' celo'#196#141#195#173's'
  +'elnou hodnotu prvku pole na zadan'#195#169'm indexu Index.\n"'#13#10'"  JSO'
  +'NGetType(Handle, Path) : string\n"'#13#10'"    Vr'#195#161't'#195#173' typ '
  +'hodnoty na Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"b'
  +'ool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13
  +#10'"    Zkontroluje, zda zadan'#195#161' cesta Path existuje.\n"'#13#10'"  '
  +'JSONResultInit\n"'#13#10'"    Inicializuje pr'#195#161'zdn'#195#169' pole J'
  +'SON pro vytvo'#197#153'en'#195#173' standardn'#195#173'ho v'#195#189'sledku'
  +' s chybami.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replac'
  +'ements)\n"'#13#10'"    P'#197#153'id'#195#161' objekt chyby do v'#195#189's'
  +'ledn'#195#169'ho pole. Replacements je '#197#153'et'#196#155'zec hodnot odd'
  +#196#155'len'#195#189'ch znakem \"|\".\n"'#13#10'"  JSONResultGet : string\n'
  +'"'#13#10'"    Vr'#195#161't'#195#173' aktu'#195#161'ln'#195#173' v'#195#189
  +'sledn'#195#169' pole jako '#197#153'et'#196#155'zec JSON.\n"'#13#10'"  JSON'
  +'ResultClear\n"'#13#10'"    Vyma'#197#190'e v'#195#189'sledn'#195#169' pole.'
  +'\n"'#13#10'"  Po dokon'#196#141'en'#195#173' pr'#195#161'ce v'#197#190'dy z'
