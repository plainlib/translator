  +#10'#: tformconfigtrayslate.labelinituseragent.caption'#10'msgctxt "tformcon'
  +'figtrayslate.labelinituseragent.caption"'#10'msgid "User Agent"'#10'msgstr '
  +'"User Agent"'#10#10'#: tformconfigtrayslate.labellanguages.caption'#10'msgi'
  +'d "Supported languages e.g. en=en-US (en - internal, en-US - service). \"em'
  +'pty\" - do not send."'#10'msgstr "Spr'#195#165'k som st'#195#182'ds t.ex. e'
  +'n=en-US (en - internt, en-US - tj'#195#164'nst). \"empty\" - skicka inte."'
  +#10#10'#: tformconfigtrayslate.labellanguages1.caption'#10'msgid "Value type'
  +' for populating names. None keeps originals; None and Unit are case-sensiti'
  +'ve."'#10'msgstr "V'#195#164'rdetyp f'#195#182'r att fylla i namn. None beh'
  +#195#165'ller original; None och Unit '#195#164'r skiftl'#195#164'gesk'#195
  +#164'nsliga."'#10#10'#: tformconfigtrayslate.labellanguagestarget.caption'#10
  +'msgid ""'#10'"Target languages e.g. en=en-US, en - internal, en-US - servic'
  +'e code.\n"'#10'"If not specified, both source and target languages are take'
  +'n from the languages section."'#10'msgstr ""'#10'"M'#195#165'lspr'#195#165
  +'k t.ex. en=en-US, en - internt, en-US - tj'#195#164'nstekod.\n"'#10'"Om int'
  +'e anges, h'#195#164'mtas b'#195#165'de k'#195#164'll- och m'#195#165'lspr'
  +#195#165'k fr'#195#165'n spr'#195#165'ksektionen."'#10#10'#: tformconfigtray'
  +'slate.labelmaxlength.caption'#10'msgid "Max Length, bytes"'#10'msgstr "Maxl'
  +#195#164'ngd, byte"'#10#10'#: tformconfigtrayslate.labelmethod.caption'#10'm'
  +'sgid "Method"'#10'msgstr "Metod"'#10#10'#: tformconfigtrayslate.labelpareme'
  +'ters.caption'#10'msgid "Use parameters: {text} '#226#128#147' input text, {'
  +'source} '#226#128#147' source language, {target} '#226#128#147' target lang'
  +'uage. Prefix the name with ! for lowercase or ^ for uppercase value. Also s'
  +'upported {timestamp}, {rand}. Use {parameter} from the parameters page."'#10
  +'msgstr "Anv'#195#164'nd parametrar: {text} '#226#128#147' inmatad text, {so'
  +'urce} '#226#128#147' k'#195#164'llspr'#195#165'k, {target} '#226#128#147' m'
  +#195#165'lspr'#195#165'k. Prefixa namnet med ! f'#195#182'r gemener eller ^ '
  +'f'#195#182'r versaler. '#195#132'ven {timestamp}, {rand} st'#195#182'ds. An'
  +'v'#195#164'nd {parameter} fr'#195#165'n parametersidan."'#10#10'#: tformcon'
  +'figtrayslate.labelpostdata.caption'#10'msgid "Post Data"'#10'msgstr "Post D'
  +'ata"'#10#10'#: tformconfigtrayslate.labelpostdata1.caption'#10'msgctxt "tfo'
  +'rmconfigtrayslate.labelpostdata1.caption"'#10'msgid "Headers"'#10'msgstr "H'
  +'eaders"'#10#10'#: tformconfigtrayslate.labelservicedescription.caption'#10
  +'msgid "Description"'#10'msgstr "Beskrivning"'#10#10'#: tformconfigtrayslate'
  +'.labelservicename.caption'#10'msgid "Name"'#10'msgstr "Namn"'#10#10'#: tfor'
  +'mconfigtrayslate.labelserviceorder.caption'#10'msgid "Order"'#10'msgstr "Or'
  +'dning"'#10#10'#: tformconfigtrayslate.labelsort.caption'#10'msgctxt "tformc'
  +'onfigtrayslate.labelsort.caption"'#10'msgid "Sort"'#10'msgstr "Sortera"'#10
  ,#10'#: tformconfigtrayslate.labeltargetsort.caption'#10'msgctxt "tformconfig'
  +'trayslate.labeltargetsort.caption"'#10'msgid "Sort"'#10'msgstr "Sortera"'#10
  +#10'#: tformconfigtrayslate.labelurl.caption'#10'msgctxt "tformconfigtraysla'
  +'te.labelurl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10'#: tformconfig'
  +'trayslate.labeluseragent.caption'#10'msgctxt "tformconfigtrayslate.labeluse'
  +'ragent.caption"'#10'msgid "User Agent"'#10'msgstr "User Agent"'#10#10'#: tf'
  +'ormconfigtrayslate.labelvaluetype.caption'#10'msgid "Value Type"'#10'msgstr'
  +' "V'#195#164'rdetyp"'#10#10'#: tformconfigtrayslate.pageinitialrequest.capt'
  +'ion'#10'msgctxt "tformconfigtrayslate.pageinitialrequest.caption"'#10'msgid'
  +' "Initial Request"'#10'msgstr "Inledande beg'#195#164'ran"'#10#10'#: tformc'
  +'onfigtrayslate.pagelanguages.caption'#10'msgctxt "tformconfigtrayslate.page'
  +'languages.caption"'#10'msgid "Languages"'#10'msgstr "Spr'#195#165'k"'#10#10
  +'#: tformconfigtrayslate.pagelanguagestarget.caption'#10'msgctxt "tformconfi'
  +'gtrayslate.pagelanguagestarget.caption"'#10'msgid "Target Languages"'#10'ms'
  +'gstr "M'#195#165'lspr'#195#165'k"'#10#10'#: tformconfigtrayslate.pageparame'
  +'ters.caption'#10'msgctxt "tformconfigtrayslate.pageparameters.caption"'#10
  +'msgid "Parameters"'#10'msgstr "Parametrar"'#10#10'#: tformconfigtrayslate.p'
  +'agerequest.caption'#10'msgctxt "tformconfigtrayslate.pagerequest.caption"'
  +#10'msgid "Request"'#10'msgstr "Beg'#195#164'ran"'#10#10'#: tformconfigtrays'
  +'late.pageresponse.caption'#10'msgid "Response"'#10'msgstr "Svar"'#10#10'#: '
  +'tformconfigtrayslate.pageservice.caption'#10'msgctxt "tformconfigtrayslate.'
  +'pageservice.caption"'#10'msgid "Service"'#10'msgstr "Tj'#195#164'nst"'#10#10
  +'#: tformconfigtrayslate.reloadconfigs.hint'#10'msgid "Reload configurations'
  +' from disk"'#10'msgstr "Ladda om konfigurationer fr'#195#165'n disken"'#10
  +#10'#: tformconfigtrayslate.sbcopyconfig.hint'#10'msgid "Copy configuration"'
  +#10'msgstr "Kopiera konfiguration"'#10#10'#: tformconfigtrayslate.sbnewconfi'
  +'g.hint'#10'msgid "New configuration"'#10'msgstr "Ny konfiguration"'#10#10
]);
LazarusResources.Add('formconfig.tr','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: tr\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Yap'#196#177'land'#196#177'rma D'#195#188'zenleyici"'#10#10'#: form'
  +'config.rclearlanguages'#10'msgid "The list is already filled. Do you want t'
  +'o clear it?"'#10'msgstr "Liste zaten dolu. Temizlemek istiyor musunuz?"'#10
  +#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you want to delete c'
  +'onfig"'#10'msgstr "Yap'#196#177'land'#196#177'rmay'#196#177' silmek istedi'
  +#196#159'inizden emin misiniz"'#10#10'#: formconfig.rdeleteconfigcaption'#10
  +'msgid "Delete config"'#10'msgstr "Yap'#196#177'land'#196#177'rmay'#196#177
  +' sil"'#10#10'#: formconfig.rnamequestion'#10'msgid "Enter new config file n'
  +'ame:"'#10'msgstr "Yeni yap'#196#177'land'#196#177'rma dosyas'#196#177' ad'
  +#196#177'n'#196#177' girin:"'#10#10'#: formconfig.rneedsave'#10'msgid "The c'
  +'onfiguration was modified. Save changes?"'#10'msgstr "Yap'#196#177'land'#196
  +#177'rma de'#196#159'i'#197#159'tirildi. De'#196#159'i'#197#159'iklikler kay'
  +'dedilsin mi?"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Poi'
  +'nter: Use / for levels, keys for objects, and numbers for indexes.\n"'#10'"'
  +'Use * for all items, *#10 to join items by newline. Use ~ at the end of the'
  +' path to return the raw JSON branch.\n"'#10'"Separate multiple segments wit'
  +'h semicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag'
  +' #10 for newlines. Use {{regex}} inside to extract data directly into the t'
  +'ext.\n"'#10'"Logic: If a Pointer in a segment is empty, the whole segment i'
  +'s skipped. If a segment has no Pointer, only literal text blocks with embed'
  +'ded regular expressions are processed.\n"'#10'"Regex: {prefix {regex[index]'
  +'} suffix} inside a text block. If no [index] is specified, the first match '
  +'is used.\n"'#10'"Index can be a number, [*] (join by space), or [*#10] (joi'
  +'n by newline). If the regex finds no match, the entire {'#226#128#166'} blo'
  +'ck is removed.\n"'#10'"Using ~ inside a regex returns the entire text.\n"'
  +#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show its text'
  +' only if the Pointer data is missing or the JSON is invalid.\n"'#10'"Commen'
  +'ting: /* text */ comments are stripped from the entire expression before an'
  +'y processing.\n"'#10'"Examples:\n"'#10'"responseData/translatedText; matche'
  +'s/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({'
  +'(\\w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#10'ms'
  +'gstr ""'#10'"JSON Pointer: Seviyeler i'#195#167'in /, nesneler i'#195#167'i'
  +'n anahtarlar ve dizinler i'#195#167'in say'#196#177'lar kullan'#196#177'n. '
  +'T'#195#188'm '#195#182#196#159'eler i'#195#167'in * ve '#195#182#196#159'el'
  +'eri yeni sat'#196#177'rla birle'#197#159'tirmek i'#195#167'in *#10 kullan'
  +#196#177'n. Ham JSON dal'#196#177'n'#196#177' d'#195#182'nd'#195#188'rmek i'
  +#195#167'in yolun sonunda ~ kullan'#196#177'n. Birden fazla segmenti noktal'
  +#196#177' virg'#195#188'l ; ile ay'#196#177'r'#196#177'n.\n"'#10'"Literal: {'
  +#226#128#166'} i'#195#167'indeki metin blo'#196#159'u. Yeni sat'#196#177'rla'
  +'r i'#195#167'in '#195#182'zel etiket #10. Verileri do'#196#159'rudan metne '
  +#195#167#196#177'karmak i'#195#167'in i'#195#167'inde {{regex}} kullan'#196
  +#177'n.\n"'#10'"Mant'#196#177'k: Bir segmentteki Pointer bo'#197#159'sa, t'
  +#195#188'm segment atlan'#196#177'r. Bir segmentte Pointer yoksa yaln'#196
  +#177'zca g'#195#182'm'#195#188'l'#195#188' d'#195#188'zenli ifadeler i'#195
  +#167'eren literal metin bloklar'#196#177' i'#197#159'lenir.\n"'#10'"Regex: B'
  +'ir metin blo'#196#159'u i'#195#167'inde {'#195#182'n ek {regex[index]} son '
  +'ek}. [index] belirtilmezse ilk e'#197#159'le'#197#159'me kullan'#196#177'l'
  +#196#177'r. '#196#176'ndeks bir say'#196#177', [*] (bo'#197#159'lukla birle'
  +#197#159'tir) veya [*#10] (yeni sat'#196#177'rla birle'#197#159'tir) olabili'
  +'r. D'#195#188'zenli ifade e'#197#159'le'#197#159'me bulamazsa, t'#195#188'm'
  +' {'#226#128#166'} blo'#196#159'u kald'#196#177'r'#196#177'l'#196#177'r. D'
  +#195#188'zenli ifade i'#195#167'inde ~ kullan'#196#177'lmas'#196#177' t'#195
  +#188'm metni d'#195#182'nd'#195#188'r'#195#188'r.\n"'#10'"Tersine '#195#167
  +'evirme: Bir segmenti ! ile ba'#197#159'lat'#196#177'n ('#195#182'rne'#196
  +#159'in !/path{Error}); b'#195#182'ylece metni yaln'#196#177'zca Pointer ver'
  +'isi eksikse veya JSON ge'#195#167'ersizse g'#195#182'sterilir.\n"'#10'"Yoru'
  +'mlar: /* metin */ yorumlar'#196#177', herhangi bir i'#197#159'lem yap'#196
  +#177'lmadan '#195#182'nce t'#195#188'm ifadeden kald'#196#177'r'#196#177'l'
  ,#196#177'r.\n"'#10'"'#195#150'rnekler:\n"'#10'"responseData/translatedText; '
  +'matches/*#10/translation; /texts/text; {literal text#10}; /result/text; /te'
  +'xt{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#10#10
  +'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal'
  +' program: optional var section, then a main begin ... end. block.\n"'#10'"\'
  +'n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := '
  +'GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'
  +#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can als'
  +'o use standard Pascal constructs (if, for, while, repeat, etc.). You can de'
  +'fine your own functions and procedures before the main begin ... end. block'
  +'.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : stri'
  +'ng\n"'#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''nam'
  +'e'', ''value'')\n"'#10'"    Store an output value for the host.\n"'#10'"  G'
  +'etTimestamp() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (U'
  +'TC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with ex'
  +'actly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random'
  +' float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'
  +#10'"    Convert integer to hexadecimal string with at least Digits characte'
  +'rs.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to an inte'
  +'ger. Raises an exception on invalid input.\n"'#10'"  IntToStr(Value) : stri'
  +'ng\n"'#10'"    Convert an integer to its string representation.\n"'#10'"  T'
  +'rim(S) : string\n"'#10'"    Remove leading and trailing whitespace from S.\'
  +'n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whitespace from S'
  +'.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing whitespace fr'
  +'om S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML char'
  +'acters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Dec'
  +'ode HTML entities in S back to characters.\n"'#10'"  UrlEncode(S) : string\'
  +'n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S)'
  +' : string\n"'#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceA'
  +'ll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replac'
  +'e all occurrences of OldPattern with NewPattern in S.\n"'#10'"  RegexReplac'
  +'e(Input, Pattern, Replacement) : string\n"'#10'"    Replace all regex match'
  +'es of Pattern with Replacement in Input. Case-insensitive.\n"'#10'"  RegexM'
  +'atch(Input, Pattern) : Boolean\n"'#10'"    Check if Input matches the regex'
  +' Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMar'
  +'ker) : string\n"'#10'"    Extract the substring of S between StartMarker an'
  +'d EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle returned by JSON'
  +'Parse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string an'
  +'d return a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'
  +#10'"    Release the handle after use.\n"'#10'"  JSONGetString(Handle, Path)'
  +' : string\n"'#10'"    Get a string value at the specified Path.\n"'#10'"  J'
  +'SONGetInt(Handle, Path) : Integer\n"'#10'"    Get an integer value at the s'
  +'pecified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    '
  +'Get a floating-point value at the specified Path.\n"'#10'"  JSONGetBool(Han'
  +'dle, Path) : Boolean\n"'#10'"    Get a boolean value at the specified Path.'
  +'\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the nu'
  +'mber of elements in an array at the specified Path.\n"'#10'"  JSONGetArrayS'
  +'tring(Handle, Path, Index) : string\n"'#10'"    Get the string value of an '
  +'array element at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, I'
  +'ndex) : Integer\n"'#10'"    Get the integer value of an array element at th'
  +'e given Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Ret'
  +'urn the type of the value at Path: \"object\", \"array\", \"string\", \"int'
  +'\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) :'
  +' Boolean\n"'#10'"    Check if the specified Path exists.\n"'#10'"  JSONResu'
  +'ltInit\n"'#10'"    Initialize an empty JSON array for building a standard e'
  +'rror result.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Replacem'
  +'ents)\n"'#10'"    Add an error object to the result array. Replacements is '
  +'a string of values separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'
  +#10'"    Return the current result array as a JSON string.\n"'#10'"  JSONRes'
  +'ultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always call JSONFree'
  +' to release the handle after you are done.\n"'#10'"\n"'#10'"Example of work'
  +'ing with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'" '
  +' begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    if h >'
  +'= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'
  ,''');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10
  +'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved w'
  +'ith GetParam):\n"'#10'"  text - the input text to process (possibly truncat'
  +'ed to MaxLength)\n"'#10'"  source - source language code (may be empty)\n"'
  +#10'"  target - target language code\n"'#10'"  timestamp - current Unix time'
  +'stamp in milliseconds (string)\n"'#10'"  random  - 9-digit random number (s'
  +'tring)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 - first 1..9 '
  +'digits of the random number\n"'#10'"\n"'#10'"Additional initial and custom '
  +'parameters are also available."'#10'msgstr ""'#10'"Betik standart bir Pasca'
  +'l program'#196#177'd'#196#177'r: iste'#196#159'e ba'#196#159'l'#196#177' bi'
  +'r var b'#195#182'l'#195#188'm'#195#188' ve ard'#196#177'ndan bir ana begin '
  +'... end. blo'#196#159'u bulunur.\n"'#10'"\n"'#10'"'#195#150'rnek:\n"'#10'" '
  +' var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10
  +'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'
  +''', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Standart Pascal yap'#196#177'lar'
  +#196#177' da kullan'#196#177'labilir (if, for, while, repeat vb.). Ana begin'
  +' ... end. blo'#196#159'undan '#195#182'nce kendi i'#197#159'levlerinizi ve '
  +'yordamlar'#196#177'n'#196#177'z'#196#177' tan'#196#177'mlayabilirsiniz.\n"'
  +#10'"\n"'#10'"Kullan'#196#177'labilir i'#197#159'levler:\n"'#10'"  GetParam('
  +'''name'') : string\n"'#10'"    Bir giri'#197#159' parametresinin de'#196#159
  +'erini al'#196#177'r.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    A'
  +'na bilgisayar i'#195#167'in bir '#195#167#196#177'kt'#196#177' de'#196#159
  +'eri kaydeder.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Ge'#195#167'erli'
  +' Unix zaman damgas'#196#177'n'#196#177' milisaniye cinsinden d'#195#182'nd'
  +#195#188'r'#195#188'r (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"   '
  +' Tam olarak Length ondal'#196#177'k basamak i'#195#167'eren rastgele bir ta'
  +'m say'#196#177' d'#195#182'nd'#195#188'r'#195#188'r.\n"'#10'"  Random : Ext'
  +'ended\n"'#10'"    [0, 1) aral'#196#177#196#159#196#177'nda rastgele bir kay'
  +'an noktal'#196#177' say'#196#177' d'#195#182'nd'#195#188'r'#195#188'r.\n"'
  +#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Bir tam say'#196#177'y'
  +#196#177' en az Digits karakter i'#195#167'eren onalt'#196#177'l'#196#177'k '
  +'bir dizeye d'#195#182'n'#195#188#197#159't'#195#188'r'#195#188'r.\n"'#10'" '
  +' StrToInt(S) : Integer\n"'#10'"    Bir dizeyi tam say'#196#177'ya d'#195#182
  +'n'#195#188#197#159't'#195#188'r'#195#188'r. Ge'#195#167'ersiz giri'#197#159
  +'te bir istisna olu'#197#159'turur.\n"'#10'"  IntToStr(Value) : string\n"'#10
  +'"    Bir tam say'#196#177'y'#196#177' dize g'#195#182'sterimine d'#195#182
  +'n'#195#188#197#159't'#195#188'r'#195#188'r.\n"'#10'"  Trim(S) : string\n"'
  +#10'"    S''nin ba'#197#159#196#177'ndaki ve sonundaki bo'#197#159'luklar'
  +#196#177' kald'#196#177'r'#196#177'r.\n"'#10'"  TrimLeft(S) : string\n"'#10
  +'"    S''nin ba'#197#159#196#177'ndaki bo'#197#159'luklar'#196#177' kald'#196
  +#177'r'#196#177'r.\n"'#10'"  TrimRight(S) : string\n"'#10'"    S''nin sonund'
  +'aki bo'#197#159'luklar'#196#177' kald'#196#177'r'#196#177'r.\n"'#10'"  Html'
  +'Encode(S) : string\n"'#10'"    S i'#195#167'indeki '#195#182'zel HTML karak'
  +'terlerini varl'#196#177'klara d'#195#182'n'#195#188#197#159't'#195#188'r'
  +#195#188'r.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    S i'#195#167'indeki'
  +' HTML varl'#196#177'klar'#196#177'n'#196#177' tekrar karakterlere d'#195#182
  +'n'#195#188#197#159't'#195#188'r'#195#188'r.\n"'#10'"  UrlEncode(S) : string'
  +'\n"'#10'"    S''yi URL i'#195#167'inde g'#195#188'venli '#197#159'ekilde ku'
  +'llan'#196#177'labilmesi i'#195#167'in y'#195#188'zde kodlamas'#196#177'yla '
  +'kodlar.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Y'#195#188'zde kodlamas'
  +#196#177'yla kodlanm'#196#177#197#159' S dizesini '#195#167#195#182'zer.\n"'
  +#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'
  +#10'"    S i'#195#167'indeki t'#195#188'm OldPattern olu'#197#159'umlar'#196
  +#177'n'#196#177' NewPattern ile de'#196#159'i'#197#159'tirir.\n"'#10'"  Rege'
  +'xReplace(Input, Pattern, Replacement) : string\n"'#10'"    Input i'#195#167
  +'indeki Pattern d'#195#188'zenli ifadesiyle e'#197#159'le'#197#159'en t'#195
  +#188'm b'#195#182'l'#195#188'mleri Replacement ile de'#196#159'i'#197#159'ti'
  +'rir. B'#195#188'y'#195#188'k/k'#195#188#195#167#195#188'k harf duyarl'#196
  +#177' de'#196#159'ildir.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'
  +#10'"    Input''un Pattern d'#195#188'zenli ifadesiyle e'#197#159'le'#197#159
  +'ip e'#197#159'le'#197#159'medi'#196#159'ini kontrol eder. B'#195#188'y'#195
  +#188'k/k'#195#188#195#167#195#188'k harf duyarl'#196#177' de'#196#159'ildir.'
  +'\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10'"    S'
  +' i'#195#167'indeki StartMarker ile EndMarker aras'#196#177'ndaki alt dizeyi'
  ,' '#195#167#196#177'kar'#196#177'r.\n"'#10'"\n"'#10'"JSON i'#197#159'levleri'
  +' (JSONParse taraf'#196#177'ndan d'#195#182'nd'#195#188'r'#195#188'len bir h'
  +'andle kullan'#196#177'n):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Bir '
  +'JSON dizesini ayr'#196#177#197#159't'#196#177'r'#196#177'r ve bir handle (>'
  +'=0) d'#195#182'nd'#195#188'r'#195#188'r. Hata durumunda -1 d'#195#182'nd'
  +#195#188'r'#195#188'r.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Kullan'#196#177
  +'mdan sonra handle'''#196#177' serbest b'#196#177'rak'#196#177'r.\n"'#10'"  '
  +'JSONGetString(Handle, Path) : string\n"'#10'"    Belirtilen Path konumundak'
  +'i dize de'#196#159'erini al'#196#177'r.\n"'#10'"  JSONGetInt(Handle, Path) '
  +': Integer\n"'#10'"    Belirtilen Path konumundaki tam say'#196#177' de'#196
  +#159'erini al'#196#177'r.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'
  +#10'"    Belirtilen Path konumundaki kayan noktal'#196#177' de'#196#159'eri '
  +'al'#196#177'r.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Be'
  +'lirtilen Path konumundaki boolean de'#196#159'erini al'#196#177'r.\n"'#10'"'
  +'  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Belirtilen Path kon'
  +'umundaki dizinin eleman say'#196#177's'#196#177'n'#196#177' al'#196#177'r.\'
  +'n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Beli'
  +'rtilen Index konumundaki dizi eleman'#196#177'n'#196#177'n dize de'#196#159
  +'erini al'#196#177'r.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integ'
  +'er\n"'#10'"    Belirtilen Index konumundaki dizi eleman'#196#177'n'#196#177
  +'n tam say'#196#177' de'#196#159'erini al'#196#177'r.\n"'#10'"  JSONGetType('
  +'Handle, Path) : string\n"'#10'"    Path konumundaki de'#196#159'erin t'#195
  +#188'r'#195#188'n'#195#188' d'#195#182'nd'#195#188'r'#195#188'r: \"object\",'
  +' \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  J'
  +'SONPathExists(Handle, Path) : Boolean\n"'#10'"    Belirtilen Path konumunun'
  +' mevcut olup olmad'#196#177#196#159#196#177'n'#196#177' kontrol eder.\n"'#10
  +'"  JSONResultInit\n"'#10'"    Standart bir hata sonucu olu'#197#159'turmak '
  +'i'#195#167'in bo'#197#159' bir JSON dizisi ba'#197#159'lat'#196#177'r.\n"'
  +#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"   '
  +' Sonu'#195#167' dizisine bir hata nesnesi ekler. Replacements, \"|\" karakt'
  +'eriyle ayr'#196#177'lm'#196#177#197#159' de'#196#159'erlerden olu'#197#159
  +'an bir dizedir.\n"'#10'"  JSONResultGet : string\n"'#10'"    Ge'#195#167'er'
  +'li sonu'#195#167' dizisini JSON dizesi olarak d'#195#182'nd'#195#188'r'#195
  +#188'r.\n"'#10'"  JSONResultClear\n"'#10'"    Sonu'#195#167' dizisini temizl'
  +'er.\n"'#10'"  '#196#176#197#159'iniz bittikten sonra handle'''#196#177' ser'
  +'best b'#196#177'rakmak i'#195#167'in her zaman JSONFree '#195#167'a'#196#159
  +'r'#196#177's'#196#177'n'#196#177' yap'#196#177'n.\n"'#10'"\n"'#10'"JSON ile'
  +' '#195#167'al'#196#177#197#159'ma '#195#182'rne'#196#159'i:\n"'#10'"  var h'
  +': Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h := JSONPa'
  +'rse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'
  +#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetOutput(''t'
  +'ext'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"Kullan'#196#177'labilir parametreler (GetParam ile al'#196#177'n'
  +#196#177'r):\n"'#10'"  text - i'#197#159'lenecek giri'#197#159' metni (MaxLe'
  +'ngth de'#196#159'erine kadar k'#196#177'salt'#196#177'lm'#196#177#197#159' '
  +'olabilir)\n"'#10'"  source - kaynak dil kodu (bo'#197#159' olabilir)\n"'#10
  +'"  target - hedef dil kodu\n"'#10'"  timestamp - ge'#195#167'erli Unix zama'
  +'n damgas'#196#177', milisaniye cinsinden (dize)\n"'#10'"  random  - 9 basam'
  +'akl'#196#177' rastgele say'#196#177' (dize)\n"'#10'"  rand - random ile ayn'
  +#196#177'd'#196#177'r\n"'#10'"  rand1..rand9 - rastgele say'#196#177'n'#196
  +#177'n ilk 1..9 basama'#196#159#196#177'\n"'#10'"\n"'#10'"Ek ba'#197#159'lan'
  +'g'#196#177#195#167' ve '#195#182'zel parametreler de kullan'#196#177'labili'
  +'r."'#10#10'#: formconfig.rscriptresponsehint'#10'msgid ""'#10'"This script '
  +'processes the response data. All functions and parameters described in the '
  +'script hint are available here as well.\n"'#10'"Use GetParam(''result'') to'
  +' obtain the received text.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: strin'
  +'g;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOu'
  +'tput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can define custom '
  +'parameters in the parameters script using SetParam(''name'', ''value''),\n"'
  +#10'"and then retrieve them here with GetParam(''name'')."'#10'msgstr ""'#10
  +'"Bu betik yan'#196#177't verilerini i'#197#159'ler. Betik ipucunda a'#195
  +#167#196#177'klanan t'#195#188'm i'#197#159'levler ve parametreler burada da'
  +' kullan'#196#177'labilir.\n"'#10'"Al'#196#177'nan metni elde etmek i'#195
  +#167'in GetParam(''result'') kullan'#196#177'n.\n"'#10'"\n"'#10'"'#195#150'r'
  ,'nek:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''r'
  +'esult'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'
  +#10'"Parametre beti'#196#159'inde SetParam(''name'', ''value'') kullanarak '
  +#195#182'zel parametreler tan'#196#177'mlayabilir,\n"'#10'"ard'#196#177'ndan'
  +' bunlar'#196#177' burada GetParam(''name'') ile alabilirsiniz."'#10#10'#: f'
  +'ormconfig.rvaluetype1'#10'msgctxt "formconfig.rvaluetype1"'#10'msgid "None"'
  +#10'msgstr "Yok"'#10#10'#: formconfig.rvaluetype2'#10'msgid "Language"'#10'm'
  +'sgstr "Dil"'#10#10'#: formconfig.rvaluetype3'#10'msgid "Currency All"'#10'm'
  +'sgstr "T'#195#188'm para birimleri"'#10#10'#: formconfig.rvaluetype4'#10'ms'
  +'gid "Currency Fiat Only"'#10'msgstr "Sadece fiat para birimleri"'#10#10'#: '
  +'formconfig.rvaluetype5'#10'msgid "Currency Crypto Only"'#10'msgstr "Sadece '
  +'kripto para birimleri"'#10#10'#: formconfig.rvaluetype6'#10'msgid "Measurem'
  +'ent Units"'#10'msgstr "'#195#150'l'#195#167#195#188' birimleri"'#10#10'#: t'
