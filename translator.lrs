  +'trayslate.checkservicevisible.caption'#10'msgid "Visible in menu"'#10'msgst'
  +'r "Synlig i menu"'#10#10'#: tformconfigtrayslate.combomethod.text'#10'msgid'
  +' "GET"'#10'msgstr "GET"'#10#10'#: tformconfigtrayslate.combovaluetype.text'
  +#10'msgctxt "tformconfigtrayslate.combovaluetype.text"'#10'msgid "None"'#10
  +'msgstr "Ingen"'#10#10'#: tformconfigtrayslate.groupboxcustomparameters.capt'
  +'ion'#10'msgid "Custom Parameters"'#10'msgstr "Brugerdefinerede parametre"'
  +#10#10'#: tformconfigtrayslate.groupboxservice.caption'#10'msgctxt "tformcon'
  +'figtrayslate.groupboxservice.caption"'#10'msgid "Service"'#10'msgstr "Tjene'
  +'ste"'#10#10'#: tformconfigtrayslate.groupinitparameters.caption'#10'msgctxt'
  +' "tformconfigtrayslate.groupinitparameters.caption"'#10'msgid "Initial Requ'
  +'est"'#10'msgstr "Indledende anmodning"'#10#10'#: tformconfigtrayslate.group'
  +'languages.caption'#10'msgctxt "tformconfigtrayslate.grouplanguages.caption"'
  +#10'msgid "Languages"'#10'msgstr "Sprog"'#10#10'#: tformconfigtrayslate.grou'
  +'planguagestarget.caption'#10'msgctxt "tformconfigtrayslate.grouplanguagesta'
  +'rget.caption"'#10'msgid "Target Languages"'#10'msgstr "M'#195#165'lsprog"'
  +#10#10'#: tformconfigtrayslate.grouprequest.caption'#10'msgctxt "tformconfig'
  +'trayslate.grouprequest.caption"'#10'msgid "Request"'#10'msgstr "Anmodning"'
  +#10#10'#: tformconfigtrayslate.groupresponse.caption'#10'msgid "Json Pointer'
  +' Processing the Response"'#10'msgstr "JSON Pointer-behandling af svaret"'#10
  +#10'#: tformconfigtrayslate.groupscript.caption'#10'msgid "Script Retrieved '
  +'Parameters"'#10'msgstr "Hentede scriptparametre"'#10#10'#: tformconfigtrays'
  +'late.groupscriptresponse.caption'#10'msgid "Script Processing the Response"'
  +#10'msgstr "Scriptbehandling af svaret"'#10#10'#: tformconfigtrayslate.image'
  +'preview.hint'#10'msgid "Click to select the config icon, Middle-Click clear'
  +'s the icon"'#10'msgstr "Klik for at v'#195#166'lge konfigurationsikonet, Mi'
  +'ddle-Click rydder ikonet"'#10#10'#: tformconfigtrayslate.labelaccept.captio'
  +'n'#10'msgid "Accept"'#10'msgstr "Accept"'#10#10'#: tformconfigtrayslate.lab'
  +'elcolorrecent.caption'#10'msgid "Recent Color"'#10'msgstr "Seneste farve"'
  +#10#10'#: tformconfigtrayslate.labelcontenttype.caption'#10'msgid "Content T'
  +'ype"'#10'msgstr "Content Type"'#10#10'#: tformconfigtrayslate.labelfilllang'
  +'uages.caption'#10'msgctxt "tformconfigtrayslate.labelfilllanguages.caption"'
  +#10'msgid "Fill with default"'#10'msgstr "Udfyld med standard"'#10#10'#: tfo'
  +'rmconfigtrayslate.labelfilltargetlanguages.caption'#10'msgctxt "tformconfig'
  +'trayslate.labelfilltargetlanguages.caption"'#10'msgid "Fill with default"'
  +#10'msgstr "Udfyld med standard"'#10#10'#: tformconfigtrayslate.labelheaders'
  +'.caption'#10'msgid "Additional request headers in key=value format, key: va'
  +'lue is also supported"'#10'msgstr "Yderligere anmodningshoveder i formatet '
  +'key=value, key: value underst'#195#184'ttes ogs'#195#165'"'#10#10'#: tformc'
  +'onfigtrayslate.labelinitheaders.caption'#10'msgid "Additional initial reque'
  +'st headers in key=value format, key: value is also supported"'#10'msgstr "Y'
  +'derligere indledende anmodningshoveder i formatet key=value, key: value und'
  +'erst'#195#184'ttes ogs'#195#165'"'#10#10'#: tformconfigtrayslate.labelinith'
  +'eaders2.caption'#10'msgctxt "tformconfigtrayslate.labelinitheaders2.caption'
  +'"'#10'msgid "Headers"'#10'msgstr "Headers"'#10#10'#: tformconfigtrayslate.l'
  +'abelinitlivetime.caption'#10'msgid "Live time"'#10'msgstr "Levetid"'#10#10
  +'#: tformconfigtrayslate.labelinitparameters.caption'#10'msgid "Parameters n'
  +'ame=regexp are extracted from the response and used by name in requests"'#10
  +'msgstr "Parametre name=regexp udtr'#195#166'kkes fra svaret og bruges efter'
  +' navn i anmodninger"'#10#10'#: tformconfigtrayslate.labelinitparameters1.ca'
  +'ption'#10'msgid "Time in seconds to refresh parameters with a new request ('
  +'0 = every request)"'#10'msgstr "Tid i sekunder til at opdatere parametre me'
  +'d en ny anmodning (0 = hver anmodning)"'#10#10'#: tformconfigtrayslate.labe'
  +'linitparameters2.caption'#10'msgctxt "tformconfigtrayslate.labelinitparamet'
  +'ers2.caption"'#10'msgid "Parameters"'#10'msgstr "Parametre"'#10#10'#: tform'
  ,'configtrayslate.labelinitparameters4.caption'#10'msgid "Parameters in the f'
  +'orm key=value used by {key} in requests. If the value is omitted (key=), it'
  +' will be requested from the user."'#10'msgstr "Parametre i formatet key=val'
  +'ue, som bruges af {key} i foresp'#195#184'rgsler. Hvis v'#195#166'rdien ude'
  +'lades (key=), vil den blive anmodet fra brugeren."'#10#10'#: tformconfigtra'
  +'yslate.labelinitparemeters.caption'#10'msgid "Initial GET request to obtain'
  +' required parameters."'#10'msgstr "Indledende GET-anmodning for at f'#195
  +#165' de n'#195#184'dvendige parametre."'#10#10'#: tformconfigtrayslate.labe'
  +'liniturl.caption'#10'msgctxt "tformconfigtrayslate.labeliniturl.caption"'#10
  +'msgid "URL"'#10'msgstr "URL"'#10#10'#: tformconfigtrayslate.labelinituserag'
  +'ent.caption'#10'msgctxt "tformconfigtrayslate.labelinituseragent.caption"'
  +#10'msgid "User Agent"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslat'
  +'e.labellanguages.caption'#10'msgid "Supported languages e.g. en=en-US (en -'
  +' internal, en-US - service). \"empty\" - do not send."'#10'msgstr "Underst'
  +#195#184'ttede sprog f.eks. en=en-US (en - intern, en-US - tjeneste). \"empt'
  +'y\" - send ikke."'#10#10'#: tformconfigtrayslate.labellanguages1.caption'#10
  +'msgid "Value type for populating names. None keeps originals; None and Unit'
  +' are case-sensitive."'#10'msgstr "V'#195#166'rditype til udfyldning af navn'
  +'e. None beholder originaler; None og Unit skelner mellem store og sm'#195
  +#165' bogstaver."'#10#10'#: tformconfigtrayslate.labellanguagestarget.captio'
  +'n'#10'msgid ""'#10'"Target languages e.g. en=en-US, en - internal, en-US - '
  +'service code.\n"'#10'"If not specified, both source and target languages ar'
  +'e taken from the languages section."'#10'msgstr ""'#10'"M'#195#165'lsprog f'
  +'.eks. en=en-US, en - intern, en-US - tjenestekode.\n"'#10'"Hvis ikke angive'
  +'t, hentes b'#195#165'de kilde- og m'#195#165'lsprog fra sprogsektionen."'#10
  +#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid "Max Length, by'
  +'tes"'#10'msgstr "Maks l'#195#166'ngde, bytes"'#10#10'#: tformconfigtrayslat'
  +'e.labelmethod.caption'#10'msgid "Method"'#10'msgstr "Metode"'#10#10'#: tfor'
  +'mconfigtrayslate.labelparemeters.caption'#10'msgid "Use parameters: {text} '
  +#226#128#147' input text, {source} '#226#128#147' source language, {target} '
  +#226#128#147' target language. Prefix the name with ! for lowercase or ^ for'
  +' uppercase value. Also supported {timestamp}, {rand}. Use {parameter} from '
  +'the parameters page."'#10'msgstr "Brug parametre: {text} '#226#128#147' ind'
  +'tastet tekst, {source} '#226#128#147' kildesprog, {target} '#226#128#147' m'
  +#195#165'lsprog. Pr'#195#166'fikset ! for sm'#195#165' bogstaver eller ^ for'
  +' store bogstaver. Underst'#195#184'tter ogs'#195#165' {timestamp}, {rand}. '
  +'Brug {parameter} fra parametersiden."'#10#10'#: tformconfigtrayslate.labelp'
  +'ostdata.caption'#10'msgid "Post Data"'#10'msgstr "Post Data"'#10#10'#: tfor'
  +'mconfigtrayslate.labelpostdata1.caption'#10'msgctxt "tformconfigtrayslate.l'
  +'abelpostdata1.caption"'#10'msgid "Headers"'#10'msgstr "Headers"'#10#10'#: t'
  +'formconfigtrayslate.labelservicedescription.caption'#10'msgid "Description"'
  +#10'msgstr "Beskrivelse"'#10#10'#: tformconfigtrayslate.labelservicename.cap'
  +'tion'#10'msgid "Name"'#10'msgstr "Navn"'#10#10'#: tformconfigtrayslate.labe'
  +'lserviceorder.caption'#10'msgid "Order"'#10'msgstr "R'#195#166'kkef'#195#184
  +'lge"'#10#10'#: tformconfigtrayslate.labelsort.caption'#10'msgctxt "tformcon'
  +'figtrayslate.labelsort.caption"'#10'msgid "Sort"'#10'msgstr "Sort'#195#169
  +'r"'#10#10'#: tformconfigtrayslate.labeltargetsort.caption'#10'msgctxt "tfor'
  +'mconfigtrayslate.labeltargetsort.caption"'#10'msgid "Sort"'#10'msgstr "Sort'
  +#195#169'r"'#10#10'#: tformconfigtrayslate.labelurl.caption'#10'msgctxt "tfo'
  +'rmconfigtrayslate.labelurl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10
  +'#: tformconfigtrayslate.labeluseragent.caption'#10'msgctxt "tformconfigtray'
  +'slate.labeluseragent.caption"'#10'msgid "User Agent"'#10'msgstr "User Agent'
  +'"'#10#10'#: tformconfigtrayslate.labelvaluetype.caption'#10'msgid "Value Ty'
  +'pe"'#10'msgstr "V'#195#166'rditype"'#10#10'#: tformconfigtrayslate.pageinit'
  +'ialrequest.caption'#10'msgctxt "tformconfigtrayslate.pageinitialrequest.cap'
  +'tion"'#10'msgid "Initial Request"'#10'msgstr "Indledende anmodning"'#10#10
  +'#: tformconfigtrayslate.pagelanguages.caption'#10'msgctxt "tformconfigtrays'
  +'late.pagelanguages.caption"'#10'msgid "Languages"'#10'msgstr "Sprog"'#10#10
  +'#: tformconfigtrayslate.pagelanguagestarget.caption'#10'msgctxt "tformconfi'
  +'gtrayslate.pagelanguagestarget.caption"'#10'msgid "Target Languages"'#10'ms'
  +'gstr "M'#195#165'lsprog"'#10#10'#: tformconfigtrayslate.pageparameters.capt'
  +'ion'#10'msgctxt "tformconfigtrayslate.pageparameters.caption"'#10'msgid "Pa'
  +'rameters"'#10'msgstr "Parametre"'#10#10'#: tformconfigtrayslate.pagerequest'
  +'.caption'#10'msgctxt "tformconfigtrayslate.pagerequest.caption"'#10'msgid "'
  ,'Request"'#10'msgstr "Anmodning"'#10#10'#: tformconfigtrayslate.pageresponse'
  +'.caption'#10'msgid "Response"'#10'msgstr "Svar"'#10#10'#: tformconfigtraysl'
  +'ate.pageservice.caption'#10'msgctxt "tformconfigtrayslate.pageservice.capti'
  +'on"'#10'msgid "Service"'#10'msgstr "Tjeneste"'#10#10'#: tformconfigtrayslat'
  +'e.reloadconfigs.hint'#10'msgid "Reload configurations from disk"'#10'msgstr'
  +' "Genindl'#195#166's konfigurationer fra disken"'#10#10'#: tformconfigtrays'
  +'late.sbcopyconfig.hint'#10'msgid "Copy configuration"'#10'msgstr "Kopier ko'
