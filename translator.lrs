  +#10'msgstr "'#215#158#215#151#215#167' '#215#170#215#166#215#149#215#168#215
  +#148'"'#10#10'#: formconfig.rnamequestion'#10'msgid "Enter new config file n'
  +'ame:"'#10'msgstr "'#215#148#215#155#215#160#215#161' '#215#169#215#157' '
