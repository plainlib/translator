LazarusResources.Add('formconfig.vi','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"Report-Msgid-Bugs-T'
  +'o: \n"'#10'"POT-Creation-Date: \n"'#10'"PO-Revision-Date: 2026-08-07 21:35+'
  +'0700\n"'#10'"Last-Translator: V'#197#169' Anh V'#197#169' <vuanhvu11982@gma'
  +'il.com>\n"'#10'"Language-Team: none\n"'#10'"Language: vi\n"'#10'"MIME-Versi'
  +'on: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tra'
  +'nsfer-Encoding: 8bit\n"'#10'"Plural-Forms: nplurals=1; plural=0;\n"'#10'"X-'
  +'Generator: PoBatch 1.0.0"'#10#10'#: formconfig.rcaption'#10'msgctxt "formco'
  +'nfig.rcaption"'#10'msgid "Config Editor"'#10'msgstr "Tr'#195#172'nh ch'#225
  +#187#137'nh s'#225#187#173'a c'#225#186#165'u h'#195#172'nh"'#10#10'#: formc'
  +'onfig.rclearlanguages'#10'msgid "The list is already filled. Do you want to'
  +' clear it?"'#10'msgstr "Danh s'#195#161'ch '#196#145#195#163' '#196#145#198
  +#176#225#187#163'c l'#225#186#165'p '#196#145#225#186#167'y. B'#225#186#161
  +'n c'#195#179' mu'#225#187#145'n x'#195#179'a n'#195#179' kh'#195#180'ng?"'
  +#10#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you want to delet'
  +'e config"'#10'msgstr "B'#225#186#161'n c'#195#179' ch'#225#186#175'c ch'#225
  +#186#175'n mu'#225#187#145'n x'#195#179'a c'#225#186#165'u h'#195#172'nh"'#10
  +#10'#: formconfig.rdeleteconfigcaption'#10'msgid "Delete config"'#10'msgstr '
  +'"X'#195#179'a c'#225#186#165'u h'#195#172'nh"'#10#10'#: formconfig.rnameque'
  +'stion'#10'msgid "Enter new config file name:"'#10'msgstr "Nh'#225#186#173'p'
  +' t'#195#170'n t'#225#187#135'p c'#225#186#165'u h'#195#172'nh m'#225#187#155
  +'i:"'#10#10'#: formconfig.rneedsave'#10'msgid "The configuration was modifie'
  +'d. Save changes?"'#10'msgstr "C'#225#186#165'u h'#195#172'nh '#196#145#195
  +#163' '#196#145#198#176#225#187#163'c s'#225#187#173'a '#196#145#225#187#149
  +'i. L'#198#176'u thay '#196#145#225#187#149'i?"'#10#10'#: formconfig.rrespon'
  +'sehint'#10'msgid ""'#10'"Json Pointer: Use / for levels, keys for objects, '
  +'and numbers for indexes.\n"'#10'"Use * for all items, *#10 to join items by'
  +' newline. Use ~ at the end of the path to return the raw JSON branch.\n"'#10
  +'"Separate multiple segments with semicolon ;.\n"'#10'"Literal: Text block i'
  +'n {'#226#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to e'
  +'xtract data directly into the text.\n"'#10'"Logic: If a Pointer in a segmen'
  +'t is empty, the whole segment is skipped. If a segment has no Pointer, only'
  +' literal text blocks with embedded regular expressions are processed.\n"'#10
  +'"Regex: {prefix {regex[index]} suffix} inside a text block. If no [index] i'
  +'s specified, the first match is used.\n"'#10'"Index can be a number, [*] (j'
  +'oin by space), or [*#10] (join by newline). If the regex finds no match, th'
  +'e entire {'#226#128#166'} block is removed.\n"'#10'"Using ~ inside a regex '
  +'returns the entire text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/'
  +'path{Error}) to show its text only if the Pointer data is missing or the JS'
  +'ON is invalid.\n"'#10'"Commenting: /* text */ comments are stripped from th'
  +'e entire expression before any processing.\n"'#10'"Examples:\n"'#10'"respon'
  +'seData/translatedText; matches/*#10/translation; /texts/text; {literal text'
  +'#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10};'
  +' /translations/0/text"'#10'msgstr ""'#10'"Json Pointer: S'#225#187#173' d'
  +#225#187#165'ng / cho c'#195#161'c c'#225#186#165'p, c'#195#161'c kh'#195#179
  +'a cho '#196#145#225#187#145'i t'#198#176#225#187#163'ng, v'#195#160' s'#225
  +#187#145' cho c'#195#161'c ch'#225#187#137' m'#225#187#165'c.\n"'#10'"S'#225
  +#187#173' d'#225#187#165'ng * cho t'#225#186#165't c'#225#186#163' c'#195#161
  +'c m'#225#187#165'c, *#10 '#196#145#225#187#131' n'#225#187#145'i c'#195#161
  +'c m'#225#187#165'c theo d'#195#178'ng m'#225#187#155'i. S'#225#187#173' d'
  +#225#187#165'ng ~ '#225#187#159' cu'#225#187#145'i '#196#145#198#176#225#187
  +#157'ng d'#225#186#171'n '#196#145#225#187#131' tr'#225#186#163' v'#225#187
  +#129' nh'#195#161'nh JSON th'#195#180'.\n"'#10'"T'#195#161'ch c'#195#161'c p'
  +'h'#195#162'n '#196#145'o'#225#186#161'n nhi'#225#187#129'u b'#225#186#177'n'
  +'g d'#225#186#165'u ch'#225#186#165'm ph'#225#186#169'y ;.\n"'#10'"Nguy'#195
  +#170'n v'#196#131'n: Kh'#225#187#145'i v'#196#131'n b'#225#186#163'n trong {'
  +#226#128#166'}. Th'#225#186#187' '#196#145#225#186#183'c bi'#225#187#135't #'
  +'10 cho xu'#225#187#145'ng d'#195#178'ng. S'#225#187#173' d'#225#187#165'ng '
  +'{{regex}} b'#195#170'n trong '#196#145#225#187#131' tr'#195#173'ch xu'#225
  +#186#165't d'#225#187#175' li'#225#187#135'u tr'#225#187#177'c ti'#225#186
  +#191'p v'#195#160'o v'#196#131'n b'#225#186#163'n.\n"'#10'"Logic: N'#225#186
  +#191'u m'#225#187#153't Pointer trong m'#225#187#153't ph'#195#162'n '#196
  +#145'o'#225#186#161'n tr'#225#187#145'ng, to'#195#160'n b'#225#187#153' ph'
  +#195#162'n '#196#145'o'#225#186#161'n s'#225#186#189' b'#225#187#139' b'#225
  +#187#143' qua. N'#225#186#191'u m'#225#187#153't ph'#195#162'n '#196#145'o'
  ,#225#186#161'n kh'#195#180'ng c'#195#179' Pointer, ch'#225#187#137' c'#195
  +#161'c kh'#225#187#145'i v'#196#131'n b'#225#186#163'n nguy'#195#170'n v'#196
  +#131'n c'#195#179' bi'#225#187#131'u th'#225#187#169'c ch'#195#173'nh quy nh'
  +#195#186'ng '#196#145#198#176#225#187#163'c x'#225#187#173' l'#195#189'.\n"'
  +#10'"Regex: {prefix {regex[index]} suffix} b'#195#170'n trong m'#225#187#153
  +'t kh'#225#187#145'i v'#196#131'n b'#225#186#163'n. N'#225#186#191'u kh'#195
  +#180'ng ch'#225#187#137' '#196#145#225#187#139'nh [index], k'#225#186#191't '
  +'qu'#225#186#163' kh'#225#187#155'p '#196#145#225#186#167'u ti'#195#170'n s'
  +#225#186#189' '#196#145#198#176#225#187#163'c s'#225#187#173' d'#225#187#165
  +'ng.\n"'#10'"Index c'#195#179' th'#225#187#131' l'#195#160' m'#225#187#153't'
  +' s'#225#187#145', [*] (n'#225#187#145'i b'#225#186#177'ng kho'#225#186#163
  +'ng tr'#225#186#175'ng), ho'#225#186#183'c [*#10] (n'#225#187#145'i b'#225
  +#186#177'ng d'#195#178'ng m'#225#187#155'i). N'#225#186#191'u regex kh'#195
  +#180'ng t'#195#172'm th'#225#186#165'y k'#225#186#191't qu'#225#186#163' kh'
  +#225#187#155'p, to'#195#160'n b'#225#187#153' kh'#225#187#145'i {'#226#128
  +#166'} s'#225#186#189' b'#225#187#139' x'#195#179'a.\n"'#10'"S'#225#187#173
  +' d'#225#187#165'ng ~ b'#195#170'n trong regex s'#225#186#189' tr'#225#186
  +#163' v'#225#187#129' to'#195#160'n b'#225#187#153' v'#196#131'n b'#225#186
  +#163'n. '#196#144#225#186#163'o ng'#198#176#225#187#163'c: B'#225#186#175't '
  +#196#145#225#186#167'u m'#225#187#153't '#196#145'o'#225#186#161'n v'#225#187
  +#155'i ! (v'#195#173' d'#225#187#165': !/path{Error}) '#196#145#225#187#131
  +' ch'#225#187#137' hi'#225#187#131'n th'#225#187#139' v'#196#131'n b'#225#186
  +#163'n c'#225#187#167'a n'#195#179' n'#225#186#191'u d'#225#187#175' li'#225
  +#187#135'u Pointer b'#225#187#139' thi'#225#186#191'u ho'#225#186#183'c JSON'
  +' kh'#195#180'ng h'#225#187#163'p l'#225#187#135'.\n"'#10'"Ghi ch'#195#186':'
  +' /* text */ c'#195#161'c ghi ch'#195#186' '#196#145#198#176#225#187#163'c l'
  +'o'#225#186#161'i b'#225#187#143' kh'#225#187#143'i to'#195#160'n b'#225#187
  +#153' bi'#225#187#131'u th'#225#187#169'c tr'#198#176#225#187#155'c khi x'
  +#225#187#173' l'#195#189'.\n"'#10'"V'#195#173' d'#225#187#165':\n"'#10'"resp'
  +'onseData/translatedText; matches/*#10/translation; /texts/text; {literal te'
  +'xt#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10'
  +'}; /translations/0/text"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10
  +'"The script is a standard Pascal program: optional var section, then a main'
  +' begin ... end. block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n'
  +'"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := Replac'
  +'eAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'" '
  +' end.\n"'#10'"\n"'#10'"You can also use standard Pascal constructs (if, for'
  +', while, repeat, etc.). You can define your own functions and procedures be'
  +'fore the main begin ... end. block.\n"'#10'"\n"'#10'"Available functions:\n'
  +'"'#10'"  GetParam(''name'') : string\n"'#10'"    Retrieve an input paramete'
  +'r value.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an outp'
  +'ut value for the host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current'
  +' Unix timestamp in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\'
  +'n"'#10'"    Random integer with exactly Length decimal digits.\n"'#10'"  Ra'
  +'ndom : Extended\n"'#10'"    Random float in the range [0, 1).\n"'#10'"  Int'
  +'ToHex(Value, Digits) : string\n"'#10'"    Convert integer to hexadecimal st'
  +'ring with at least Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10
  +'"    Convert a string to an integer. Raises an exception on invalid input.\'
  +'n"'#10'"  IntToStr(Value) : string\n"'#10'"    Convert an integer to its st'
  +'ring representation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading '
  +'and trailing whitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    '
  +'Remove leading whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'" '
  +'   Remove trailing whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'
  +#10'"    Encode special HTML characters in S into entities.\n"'#10'"  HtmlDe'
  +'code(S) : string\n"'#10'"    Decode HTML entities in S back to characters.\'
  +'n"'#10'"  UrlEncode(S) : string\n"'#10'"    Percent-encode S for safe URL i'
  +'nclusion.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-enco'
  +'ded string S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=Fa'
  +'lse) : string\n"'#10'"    Replace all occurrences of OldPattern with NewPat'
  +'tern in S.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'
  +#10'"    Replace all regex matches of Pattern with Replacement in Input. Cas'
  +'e-insensitive.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    C'
  +'heck if Input matches the regex Pattern. Case-insensitive.\n"'#10'"  Extrac'
  +'tBetween(S, StartMarker, EndMarker) : string\n"'#10'"    Extract the substr'
  ,'ing of S between StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions'
  +' (use a handle returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'
  +#10'"    Parse a JSON string and return a handle (>=0). Returns -1 on error.'
