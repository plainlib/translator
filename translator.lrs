  +'#: formconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Anulu'
  +'j"'#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Keep my'
  +' changes"'#13#10'msgstr "Zachowaj moje zmiany"'#13#10#13#10'#: formconfig.r'
  +'filechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The file \"%s\"'
