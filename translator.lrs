  +'nfigtrayslate.sbnewconfig.hint'#10'msgid "New configuration"'#10'msgstr "'
  +#208#157#208#190#208#178#208#176#209#143' '#208#186#208#190#208#189#209#132
  +#208#184#208#179#209#131#209#128#208#176#209#134#208#184#209#143'"'#10#10
