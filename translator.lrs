  +'msgid "Target Languages"'#10'msgstr "Idiomas de destino"'#10#10'#: tformcon'
  +'figtrayslate.pageparameters.caption'#10'msgctxt "tformconfigtrayslate.pagep'
  +'arameters.caption"'#10'msgid "Parameters"'#10'msgstr "Par'#195#161'metros"'
  +#10#10'#: tformconfigtrayslate.pagerequest.caption'#10'msgctxt "tformconfigt'
  +'rayslate.pagerequest.caption"'#10'msgid "Request"'#10'msgstr "Solicitud"'#10
  +#10'#: tformconfigtrayslate.pageresponse.caption'#10'msgid "Response"'#10'ms'
