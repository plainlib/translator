  +#215#153' '#215#144#215#153#215#160#215#149' '#215#158#215#149#215#166#215
  +#144' '#215#148#215#170#215#144#215#158#215#148', '#215#155#215#156' '#215
  +#148#215#145#215#156#215#149#215#167' {'#226#128#166'} '#215#153#215#149#215
  +#161#215#168'. '#215#169#215#153#215#158#215#149#215#169' '#215#145#214#190
