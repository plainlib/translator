  +'a key=value, my'#195#182's key: value tuetaan"'#10#10'#: tformconfigtraysla'
  +'te.labelinitheaders.caption'#10'msgid "Additional initial request headers i'
  +'n key=value format, key: value is also supported"'#10'msgstr "Lis'#195#164
  +'otsikot alkupyynn'#195#182'lle muodossa key=value, my'#195#182's key: value'
