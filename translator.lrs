LazarusResources.Add('formconfig.sv','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: sv\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Konfigurationsredigerare"'#13#10#13#10'#: formconfig.rclearlanguages'#13
  +#10'msgid "The list is already filled. Do you want to clear it?"'#13#10'msgs'
  +'tr "Listan '#195#164'r redan ifylld. Vill du rensa den?"'#13#10#13#10'#: fo'
  +'rmconfig.rconfigeditor'#13#10'msgid "Config Editor..."'#13#10'msgstr "Konfi'
  +'gurationsredigerare..."'#13#10#13#10'#: formconfig.rdeleteconfig'#13#10'msg'
  +'id "Are you sure you want to delete config"'#13#10'msgstr "'#195#132'r du s'
  +#195#164'ker p'#195#165' att du vill ta bort konfigurationen"'#13#10#13#10'#'
  +': formconfig.rdeleteconfigcaption'#13#10'msgid "Delete config"'#13#10'msgst'
  +'r "Ta bort konfiguration"'#13#10#13#10'#: formconfig.rfilechangedcancel'#13
  +#10'msgid "Cancel"'#13#10'msgstr "Avbryt"'#13#10#13#10'#: formconfig.rfilech'
  +'angedkeepchanges'#13#10'msgid "Keep my changes"'#13#10'msgstr "Beh'#195#165
  +'ll mina '#195#164'ndringar"'#13#10#13#10'#: formconfig.rfilechangedmsg'#13
  +#10'#, object-pascal-format'#13#10'msgid "The file \"%s\" has been modified '
  +'by another application since it was opened."'#13#10'msgstr "Filen \"%s\" ha'
  +'r '#195#164'ndrats av ett annat program sedan den '#195#182'ppnades."'#13#10
  +#13#10'#: formconfig.rfilechangedmsgactivate'#13#10'msgid "You have unsaved '
  +'changes. Keep them or reload from disk?"'#13#10'msgstr "Du har osparade '
  +#195#164'ndringar. Vill du beh'#195#165'lla dem eller l'#195#164'sa in filen'
  +' fr'#195#165'n disken igen?"'#13#10#13#10'#: formconfig.rfilechangedreloadd'
  +'isk'#13#10'msgid "Reload from disk"'#13#10'msgstr "L'#195#164's in fr'#195
  +#165'n disken igen"'#13#10#13#10'#: formconfig.rfilechangedtitle'#13#10'msgi'
  +'d "File changed on disk"'#13#10'msgstr "Filen har '#195#164'ndrats p'#195
  +#165' disken"'#13#10#13#10'#: formconfig.rnamequestion'#13#10'msgid "Enter n'
  +'ew config file name:"'#13#10'msgstr "Ange namn p'#195#165' ny konfiguration'
  +'sfil:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The configuration'
  +' was modified. Save changes?"'#13#10'msgstr "Konfigurationen har '#195#164
  +'ndrats. Spara '#195#164'ndringar?"'#13#10#13#10'#: formconfig.rresponsehint'
  +#13#10'msgid ""'#13#10'"Json Pointer: Use / for levels, keys for objects, an'
  +'d numbers for indexes.\n"'#13#10'"Use * for all items, *#10 to join items b'
  +'y newline. Use ~ at the end of the path to return the raw JSON branch.\n"'
  +#13#10'"Separate multiple segments with semicolon ;.\n"'#13#10'"Literal: Tex'
  +'t block in {'#226#128#166'}. Special tag #10 for newlines. Use {{regex}} in'
  +'side to extract data directly into the text.\n"'#13#10'"Logic: If a Pointer'
  +' in a segment is empty, the whole segment is skipped. If a segment has no P'
  +'ointer, only literal text blocks with embedded regular expressions are proc'
  +'essed.\n"'#13#10'"Regex: {prefix {regex[index]} suffix} inside a text block'
  +'. If no [index] is specified, the first match is used.\n"'#13#10'"Index can'
  +' be a number, [*] (join by space), or [*#10] (join by newline). If the rege'
  +'x finds no match, the entire {'#226#128#166'} block is removed.\n"'#13#10'"'
  +'Using ~ inside a regex returns the entire text.\n"'#13#10'"Inversion: Start'
  +' a segment with ! (e.g. !/path{Error}) to show its text only if the Pointer'
  +' data is missing or the JSON is invalid.\n"'#13#10'"Commenting: /* text */ '
  +'comments are stripped from the entire expression before any processing.\n"'
  +#13#10'"Examples:\n"'#13#10'"responseData/translatedText; matches/*#10/trans'
  +'lation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !'
  +'/translations{Error: No data!#10}; /translations/0/text"'#13#10'msgstr ""'
  +#13#10'"JSON Pointer: Anv'#195#164'nd / f'#195#182'r niv'#195#165'er, nyckla'
  +'r f'#195#182'r objekt och siffror f'#195#182'r index. Anv'#195#164'nd * f'
  +#195#182'r alla objekt och *#10 f'#195#182'r att sammanfoga objekt med en ny'
  +' rad. Anv'#195#164'nd ~ i slutet av s'#195#182'kv'#195#164'gen f'#195#182'r'
  +' att returnera den r'#195#165'a JSON-grenen. Separera flera segment med sem'
  +'ikolon ;.\n"'#13#10'"Literal: Textblock i {'#226#128#166'}. Speciell tagg #'
  +'10 f'#195#182'r nya rader. Anv'#195#164'nd {{regex}} inuti f'#195#182'r att'
  +' extrahera data direkt till texten.\n"'#13#10'"Logik: Om en Pointer i ett s'
  +'egment '#195#164'r tom hoppas hela segmentet '#195#182'ver. Om ett segment '
  +'inte har n'#195#165'gon Pointer bearbetas endast textblock med inb'#195#164
  +'ddade regulj'#195#164'ra uttryck.\n"'#13#10'"Regex: {prefix {regex[index]} '
  ,'suffix} inuti ett textblock. Om [index] inte anges anv'#195#164'nds den f'
  +#195#182'rsta matchningen. Index kan vara ett tal, [*] (sammanfoga med mella'
  +'nslag) eller [*#10] (sammanfoga med ny rad). Om det regulj'#195#164'ra uttr'
  +'ycket inte hittar n'#195#165'gon matchning tas hela blocket {'#226#128#166
  +'} bort. Anv'#195#164'ndning av ~ i ett regulj'#195#164'rt uttryck returnera'
  +'r hela texten.\n"'#13#10'"Invertering: B'#195#182'rja ett segment med ! (t.'
  +'ex. !/path{Error}) f'#195#182'r att visa dess text endast om Pointer-data s'
  +'aknas eller om JSON '#195#164'r ogiltig.\n"'#13#10'"Kommentarer: Kommentare'
  +'r /* text */ tas bort fr'#195#165'n hela uttrycket innan n'#195#165'gon bea'
  +'rbetning sker.\n"'#13#10'"Exempel:\n"'#13#10'"responseData/translatedText; '
  +'matches/*#10/translation; /texts/text; {literal text#10}; /result/text; /te'
  +'xt{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#13#10
  +#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"The script is a sta'
  +'ndard Pascal program: optional var section, then a main begin ... end. bloc'
  +'k.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'" '
  +' begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceA'
  +'ll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10
  +'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standard Pascal constructs '
  +'(if, for, while, repeat, etc.). You can define your own functions and proce'
  +'dures before the main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Availabl'
  +'e functions:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Retrie'
  +'ve an input parameter value.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'
  +#13#10'"    Store an output value for the host.\n"'#13#10'"  GetTimestamp() '
  +': Int64\n"'#13#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#13
  +#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random integer with exactly '
  +'Length decimal digits.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random'
  +' float in the range [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n'
  +'"'#13#10'"    Convert integer to hexadecimal string with at least Digits ch'
  +'aracters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convert a strin'
  +'g to an integer. Raises an exception on invalid input.\n"'#13#10'"  IntToSt'
  +'r(Value) : string\n"'#13#10'"    Convert an integer to its string represent'
  +'ation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove leading and trai'
  +'ling whitespace from S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Re'
  +'move leading whitespace from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10
  +'"    Remove trailing whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string'
  +'\n"'#13#10'"    Encode special HTML characters in S into entities.\n"'#13#10
  +'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTML entities in S back to '
  +'characters.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encod'
  +'e S for safe URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'" '
  +'   Decode a percent-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern'
  +', NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Replace all occurre'
  +'nces of OldPattern with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, P'
  +'attern, Replacement) : string\n"'#13#10'"    Replace all regex matches of P'
  +'attern with Replacement in Input. Case-insensitive.\n"'#13#10'"  RegexMatch'
  +'(Input, Pattern) : Boolean\n"'#13#10'"    Check if Input matches the regex '
  +'Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndM'
  +'arker) : string\n"'#13#10'"    Extract the substring of S between StartMark'
  +'er and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a handle retur'
  +'ned by JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse'
  +' a JSON string and return a handle (>=0). Returns -1 on error.\n"'#13#10'" '
  +' JSONFree(Handle)\n"'#13#10'"    Release the handle after use.\n"'#13#10'" '
  +' JSONGetString(Handle, Path) : string\n"'#13#10'"    Get a string value at '
  +'the specified Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13
  +#10'"    Get an integer value at the specified Path.\n"'#13#10'"  JSONGetFlo'
  +'at(Handle, Path) : Extended\n"'#13#10'"    Get a floating-point value at th'
  +'e specified Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10
  +'"    Get a boolean value at the specified Path.\n"'#13#10'"  JSONGetArrayCo'
  +'unt(Handle, Path) : Integer\n"'#13#10'"    Get the number of elements in an'
  +' array at the specified Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path,'
  +' Index) : string\n"'#13#10'"    Get the string value of an array element at'
  +' the given Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integ'
  +'er\n"'#13#10'"    Get the integer value of an array element at the given In'
  +'dex.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Return '
  +'the type of the value at Path: \"object\", \"array\", \"string\", \"int\", '
  ,'\"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : '
  +'Boolean\n"'#13#10'"    Check if the specified Path exists.\n"'#13#10'"  JSO'
  +'NResultInit\n"'#13#10'"    Initialize an empty JSON array for building a st'
  +'andard error result.\n"'#13#10'"  JSONResultAddError(Offset, Length, Messag'
  +'e, Replacements)\n"'#13#10'"    Add an error object to the result array. Re'
  +'placements is a string of values separated by \"|\".\n"'#13#10'"  JSONResul'
  +'tGet : string\n"'#13#10'"    Return the current result array as a JSON stri'
  +'ng.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Clear the result array.\n"'
  +#13#10'"  Always call JSONFree to release the handle after you are done.\n"'
  +#13#10'"\n"'#13#10'"Example of working with JSON:\n"'#13#10'"  var h: Intege'
  +'r;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONP'
  +'arse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    be'
  +'gin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"     '
  +' SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Available parameters (retrieved wi'
  +'th GetParam):\n"'#13#10'"  text - the input text to process (possibly trunc'
  +'ated to MaxLength)\n"'#13#10'"  source - source language code (may be empty'
  +')\n"'#13#10'"  target - target language code\n"'#13#10'"  timestamp - curre'
  +'nt Unix timestamp in milliseconds (string)\n"'#13#10'"  random  - 9-digit r'
  +'andom number (string)\n"'#13#10'"  rand - same as random\n"'#13#10'"  rand1'
  +'..rand9 - first 1..9 digits of the random number\n"'#13#10'"\n"'#13#10'"Add'
  +'itional initial and custom parameters are also available."'#13#10'msgstr ""'
  +#13#10'"Skriptet '#195#164'r ett standardprogram i Pascal: en valfri var-sek'
  +'tion, f'#195#182'ljd av ett huvudblock begin ... end.\n"'#13#10'"\n"'#13#10
  +'"Exempel:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s :'
  +'= GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False'
  +');\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'
  +#13#10'"Du kan ocks'#195#165' anv'#195#164'nda standardkonstruktioner i Pasc'
  +'al (if, for, while, repeat osv.). Du kan definiera egna funktioner och proc'
  +'edurer f'#195#182're huvudblocket begin ... end.\n"'#13#10'"\n"'#13#10'"Til'
  +'lg'#195#164'ngliga funktioner:\n"'#13#10'"  GetParam(''name'') : string\n"'
  +#13#10'"    H'#195#164'mtar v'#195#164'rdet f'#195#182'r en indataparameter.'
  +'\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Lagrar ett utda'
  +'tav'#195#164'rde f'#195#182'r v'#195#164'rdenheten.\n"'#13#10'"  GetTimesta'
  +'mp() : Int64\n"'#13#10'"    Aktuell Unix-tidsst'#195#164'mpel i millisekund'
  +'er (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Slumpm'#195
  +#164'ssigt heltal med exakt Length decimaler.\n"'#13#10'"  Random : Extended'
  +'\n"'#13#10'"    Slumpm'#195#164'ssigt flyttal i intervallet [0, 1).\n"'#13
  +#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Konverterar ett helta'
  +'l till en hexadecimal str'#195#164'ng med minst Digits tecken.\n"'#13#10'" '
  +' StrToInt(S) : Integer\n"'#13#10'"    Konverterar en str'#195#164'ng till e'
  +'tt heltal. Orsakar ett undantag vid ogiltig indata.\n"'#13#10'"  IntToStr(V'
  +'alue) : string\n"'#13#10'"    Konverterar ett heltal till dess str'#195#164
  +'ngrepresentation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Tar bort inl'
  +'edande och avslutande blanksteg fr'#195#165'n S.\n"'#13#10'"  TrimLeft(S) :'
  +' string\n"'#13#10'"    Tar bort inledande blanksteg fr'#195#165'n S.\n"'#13
  +#10'"  TrimRight(S) : string\n"'#13#10'"    Tar bort avslutande blanksteg fr'
  +#195#165'n S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Kodar s'#195
  +#164'rskilda HTML-tecken i S som entiteter.\n"'#13#10'"  HtmlDecode(S) : str'
  +'ing\n"'#13#10'"    Avkodar HTML-entiteter i S tillbaka till tecken.\n"'#13
  +#10'"  UrlEncode(S) : string\n"'#13#10'"    Procentkodar S f'#195#182'r s'
  +#195#164'ker inkludering i en URL.\n"'#13#10'"  UrlDecode(S) : string\n"'#13
  +#10'"    Avkodar en procentkodad str'#195#164'ng S.\n"'#13#10'"  ReplaceAll('
  +'S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Ers'
  +#195#164'tter alla f'#195#182'rekomster av OldPattern med NewPattern i S.\n"'
  +#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    '
  +'Ers'#195#164'tter alla matchningar av det regulj'#195#164'ra uttrycket Patt'
  +'ern med Replacement i Input. Skiftl'#195#164'gesok'#195#164'nsligt.\n"'#13
  +#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Kontrollerar om I'
  +'nput matchar det regulj'#195#164'ra uttrycket Pattern. Skiftl'#195#164'geso'
  +'k'#195#164'nsligt.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) :'
  +' string\n"'#13#10'"    H'#195#164'mtar delstr'#195#164'ngen i S mellan Star'
  +'tMarker och EndMarker.\n"'#13#10'"\n"'#13#10'"JSON-funktioner (anv'#195#164
  +'nd ett handle som returneras av JSONParse):\n"'#13#10'"  JSONParse(S) : Int'
  ,'eger\n"'#13#10'"    Tolkar en JSON-str'#195#164'ng och returnerar ett handl'
  +'e (>=0). Returnerar -1 vid fel.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"  '
  +'  Frig'#195#182'r handle efter anv'#195#164'ndning.\n"'#13#10'"  JSONGetStr'
  +'ing(Handle, Path) : string\n"'#13#10'"    H'#195#164'mtar ett str'#195#164
  +'ngv'#195#164'rde fr'#195#165'n den angivna s'#195#182'kv'#195#164'gen Path.'
  +'\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    H'#195#164
  +'mtar ett heltalsv'#195#164'rde fr'#195#165'n den angivna s'#195#182'kv'#195
  +#164'gen Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10
  +'"    H'#195#164'mtar ett flyttalsv'#195#164'rde fr'#195#165'n den angivna s'
  +#195#182'kv'#195#164'gen Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Bool'
  +'ean\n"'#13#10'"    H'#195#164'mtar ett booleskt v'#195#164'rde fr'#195#165
  +'n den angivna s'#195#182'kv'#195#164'gen Path.\n"'#13#10'"  JSONGetArrayCou'
  +'nt(Handle, Path) : Integer\n"'#13#10'"    H'#195#164'mtar antalet element i'
  +' en array p'#195#165' den angivna s'#195#182'kv'#195#164'gen Path.\n"'#13#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    H'#195
  +#164'mtar str'#195#164'ngv'#195#164'rdet f'#195#182'r ett arrayelement vid d'
  +'et angivna indexet Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index)'
  +' : Integer\n"'#13#10'"    H'#195#164'mtar heltalsv'#195#164'rdet f'#195#182
  +'r ett arrayelement vid det angivna indexet Index.\n"'#13#10'"  JSONGetType('
  +'Handle, Path) : string\n"'#13#10'"    Returnerar typen f'#195#182'r v'#195
  +#164'rdet p'#195#165' Path: \"object\", \"array\", \"string\", \"int\", \"fl'
  +'oat\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Bool'
  +'ean\n"'#13#10'"    Kontrollerar om den angivna s'#195#182'kv'#195#164'gen P'
  +'ath finns.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initierar en tom JSON'
  +'-array f'#195#182'r att skapa ett standardiserat felresultat.\n"'#13#10'"  '
  +'JSONResultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"    L'
  +#195#164'gger till ett felobjekt i resultatarrayen. Replacements '#195#164'r'
  +' en str'#195#164'ng med v'#195#164'rden separerade med \"|\".\n"'#13#10'"  '
  +'JSONResultGet : string\n"'#13#10'"    Returnerar den aktuella resultatarray'
  +'en som en JSON-str'#195#164'ng.\n"'#13#10'"  JSONResultClear\n"'#13#10'"   '
  +' Rensar resultatarrayen.\n"'#13#10'"  Anropa alltid JSONFree f'#195#182'r a'
  +'tt frig'#195#182'ra handle n'#195#164'r du '#195#164'r klar med det.\n"'#13
  +#10'"\n"'#13#10'"Exempel p'#195#165' arbete med JSON:\n"'#13#10'"  var h: In'
  +'teger;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := J'
  +'SONParse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"  '
  +'  begin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'" '
  +'     SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    e'
  +'nd;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Tillg'#195#164'ngliga parametr'
  +'ar (h'#195#164'mtas med GetParam):\n"'#13#10'"  text - indatatexten som ska'
  +' bearbetas (kan vara trunkerad till MaxLength)\n"'#13#10'"  source - koden '
  +'f'#195#182'r k'#195#164'llspr'#195#165'ket (kan vara tom)\n"'#13#10'"  targ'
  +'et - koden f'#195#182'r m'#195#165'lspr'#195#165'ket\n"'#13#10'"  timestamp'
  +' - aktuell Unix-tidsst'#195#164'mpel i millisekunder (str'#195#164'ng)\n"'
  +#13#10'"  random  - slumpm'#195#164'ssigt 9-siffrigt nummer (str'#195#164'ng'
  +')\n"'#13#10'"  rand - samma som random\n"'#13#10'"  rand1..rand9 - de f'#195
  +#182'rsta 1..9 siffrorna i det slumpm'#195#164'ssiga numret\n"'#13#10'"\n"'
  +#13#10'"Ytterligare initiala och anpassade parametrar '#195#164'r ocks'#195
  +#165' tillg'#195#164'ngliga.g'#195#164'ngliga."'#13#10#13#10'#: formconfig.r'
  +'scriptresponsehint'#13#10'msgid ""'#13#10'"This script processes the respon'
  +'se data. All functions and parameters described in the script hint are avai'
  +'lable here as well.\n"'#13#10'"Use GetParam(''result'') to obtain the recei'
  +'ved text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13
  +#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOut'
  +'put(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define'
  +' custom parameters in the parameters script using SetParam(''name'', ''valu'
  +'e''),\n"'#13#10'"and then retrieve them here with GetParam(''name'')."'#13
  +#10'msgstr ""'#13#10'"Detta skript bearbetar svarsdata. Alla funktioner och '
  +'parametrar som beskrivs i skripthj'#195#164'lpen finns '#195#164'ven tillg'
  +#195#164'ngliga h'#195#164'r.\n"'#13#10'"Anv'#195#164'nd GetParam(''result'''
  +') f'#195#182'r att h'#195#164'mta den mottagna texten.\n"'#13#10'"\n"'#13#10
  +'"Exempel:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s :'
  +'= GetParam(''result'');\n"'#13#10'"    SetOutput(''result'', s);\n"'#13#10
  +'"  end.\n"'#13#10'"\n"'#13#10'"Du kan definiera anpassade parametrar i para'
  +'meterskriptet med hj'#195#164'lp av SetParam(''name'', ''value''),\n"'#13#10
  ,'"och sedan h'#195#164'mta dem h'#195#164'r med GetParam(''name'')."'#13#10
  +#13#10'#: formconfig.rvaluetype1'#13#10'msgctxt "formconfig.rvaluetype1"'#13
  +#10'msgid "None"'#13#10'msgstr "Ingen"'#13#10#13#10'#: formconfig.rvaluetype'
  +'2'#13#10'msgid "Language"'#13#10'msgstr "Spr'#195#165'k"'#13#10#13#10'#: fo'
  +'rmconfig.rvaluetype3'#13#10'msgid "Currency All"'#13#10'msgstr "Alla valuto'
  +'r"'#13#10#13#10'#: formconfig.rvaluetype4'#13#10'msgid "Currency Fiat Only"'
  +#13#10'msgstr "Endast fiatvalutor"'#13#10#13#10'#: formconfig.rvaluetype5'#13
  +#10'msgid "Currency Crypto Only"'#13#10'msgstr "Endast kryptovalutor"'#13#10
  +#13#10'#: formconfig.rvaluetype6'#13#10'msgid "Measurement Units"'#13#10'msg'
  +'str "M'#195#165'ttenheter"'#13#10#13#10'#: tformconfigtrayslate.aclearicon.'
  +'caption'#13#10'msgid "Clear Icon"'#13#10'msgstr "Rensa ikon"'#13#10#13#10'#'
  +': tformconfigtrayslate.aeditfile.caption'#13#10'msgid "Edit File..."'#13#10
