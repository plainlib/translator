]);
LazarusResources.Add('formconfig.pt','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: pt\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Editor de configura'#195#167#195#163'o"'#10#10'#: formconfig.rclear'
  +'languages'#10'msgid "The list is already filled. Do you want to clear it?"'
  +#10'msgstr "A lista j'#195#161' est'#195#161' preenchida. Deseja limp'#195
  +#161'-la?"'#10#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you wa'
  +'nt to delete config"'#10'msgstr "Tem a certeza de que pretende eliminar a c'
  +'onfigura'#195#167#195#163'o"'#10#10'#: formconfig.rdeleteconfigcaption'#10
  +'msgid "Delete config"'#10'msgstr "Eliminar configura'#195#167#195#163'o"'#10
  +#10'#: formconfig.rnamequestion'#10'msgid "Enter new config file name:"'#10
  +'msgstr "Introduza o nome do novo ficheiro de configura'#195#167#195#163'o:"'
  +#10#10'#: formconfig.rneedsave'#10'msgid "The configuration was modified. Sa'
  +'ve changes?"'#10'msgstr "A configura'#195#167#195#163'o foi modificada. Gua'
  +'rdar altera'#195#167#195#181'es?"'#10#10'#: formconfig.rresponsehint'#10'ms'
  +'gid ""'#10'"Json Pointer: Use / for levels, keys for objects, and numbers f'
  +'or indexes.\n"'#10'"Use * for all items, *#10 to join items by newline. Use'
  +' ~ at the end of the path to return the raw JSON branch.\n"'#10'"Separate m'
  +'ultiple segments with semicolon ;.\n"'#10'"Literal: Text block in {'#226#128
  +#166'}. Special tag #10 for newlines. Use {{regex}} inside to extract data d'
  +'irectly into the text.\n"'#10'"Logic: If a Pointer in a segment is empty, t'
  +'he whole segment is skipped. If a segment has no Pointer, only literal text'
  +' blocks with embedded regular expressions are processed.\n"'#10'"Regex: {pr'
  +'efix {regex[index]} suffix} inside a text block. If no [index] is specified'
  +', the first match is used.\n"'#10'"Index can be a number, [*] (join by spac'
  +'e), or [*#10] (join by newline). If the regex finds no match, the entire {'
  +#226#128#166'} block is removed.\n"'#10'"Using ~ inside a regex returns the '
  +'entire text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/path{Error})'
  +' to show its text only if the Pointer data is missing or the JSON is invali'
  +'d.\n"'#10'"Commenting: /* text */ comments are stripped from the entire exp'
  +'ression before any processing.\n"'#10'"Examples:\n"'#10'"responseData/trans'
  +'latedText; matches/*#10/translation; /texts/text; {literal text#10}; /resul'
  +'t/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translatio'
  +'ns/0/text"'#10'msgstr ""'#10'"Ponteiro JSON: Use / para n'#195#173'veis, ch'
  +'aves para objetos e n'#195#186'meros para '#195#173'ndices. Use * para todo'
  +'s os itens e *#10 para juntar itens por nova linha. Use ~ no final do camin'
  +'ho para retornar o ramo JSON bruto. Separe v'#195#161'rios segmentos com po'
  +'nto e v'#195#173'rgula ;.\n"'#10'"Literal: Bloco de texto em {'#226#128#166
  +'}. Tag especial #10 para novas linhas. Use {{regex}} dentro dele para extra'
  +'ir dados diretamente para o texto.\n"'#10'"L'#195#179'gica: Se um ponteiro '
  +'em um segmento estiver vazio, todo o segmento ser'#195#161' ignorado. Se um'
  +' segmento n'#195#163'o tiver ponteiro, apenas blocos de texto literal com e'
  +'xpress'#195#181'es regulares incorporadas ser'#195#163'o processados.\n"'#10
  +'"Regex: {prefixo {regex[index]} sufixo} dentro de um bloco de texto. Se [in'
  +'dex] n'#195#163'o for especificado, a primeira correspond'#195#170'ncia ser'
  +#195#161' usada. O '#195#173'ndice pode ser um n'#195#186'mero, [*] (juntar '
  +'por espa'#195#167'o) ou [*#10] (juntar por nova linha). Se a express'#195
  +#163'o regular n'#195#163'o encontrar nenhuma correspond'#195#170'ncia, todo'
  +' o bloco {'#226#128#166'} ser'#195#161' removido. O uso de ~ dentro de uma '
  +'express'#195#163'o regular retorna todo o texto.\n"'#10'"Invers'#195#163'o:'
  +' Inicie um segmento com ! (por exemplo, !/path{Error}) para exibir seu text'
  +'o somente se os dados do ponteiro estiverem ausentes ou se o JSON for inv'
  +#195#161'lido.\n"'#10'"Coment'#195#161'rios: Coment'#195#161'rios /* texto *'
  +'/ s'#195#163'o removidos de toda a express'#195#163'o antes de qualquer pro'
  +'cessamento.\n"'#10'"Exemplos:\n"'#10'"responseData/translatedText; matches/'
  +'*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({(\'
  +'\w+)})}; !/translations{Error: No data!#10}; /translations"'#10#10'#: formc'
  +'onfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal program'
  +': optional var section, then a main begin ... end. block.\n"'#10'"\n"'#10'"'
  +'Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam'
  +'(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"  '
  ,'  SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also use '
  +'standard Pascal constructs (if, for, while, repeat, etc.). You can define y'
  +'our own functions and procedures before the main begin ... end. block.\n"'
  +#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : string\n"'
  +#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''name'', '''
  +'value'')\n"'#10'"    Store an output value for the host.\n"'#10'"  GetTimes'
  +'tamp() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (UTC).\n"'
  +#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with exactly Len'
  +'gth decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random float in'
  +' the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    C'
  +'onvert integer to hexadecimal string with at least Digits characters.\n"'#10
  +'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to an integer. Raises'
  +' an exception on invalid input.\n"'#10'"  IntToStr(Value) : string\n"'#10'"'
  +'    Convert an integer to its string representation.\n"'#10'"  Trim(S) : st'
  +'ring\n"'#10'"    Remove leading and trailing whitespace from S.\n"'#10'"  T'
  +'rimLeft(S) : string\n"'#10'"    Remove leading whitespace from S.\n"'#10'" '
  +' TrimRight(S) : string\n"'#10'"    Remove trailing whitespace from S.\n"'#10
  +'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML characters in S i'
  +'nto entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HTML enti'
  +'ties in S back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    P'
  +'ercent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : string\n"'
  +#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, OldPatte'
  +'rn, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replace all occurren'
  +'ces of OldPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input, Patte'
  +'rn, Replacement) : string\n"'#10'"    Replace all regex matches of Pattern '
  +'with Replacement in Input. Case-insensitive.\n"'#10'"  RegexMatch(Input, Pa'
  +'ttern) : Boolean\n"'#10'"    Check if Input matches the regex Pattern. Case'
  +'-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\'
  +'n"'#10'"    Extract the substring of S between StartMarker and EndMarker.\n'
  +'"'#10'"\n"'#10'"JSON functions (use a handle returned by JSONParse):\n"'#10
  +'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string and return a hand'
  +'le (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Relea'
  +'se the handle after use.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'
  +#10'"    Get a string value at the specified Path.\n"'#10'"  JSONGetInt(Hand'
  +'le, Path) : Integer\n"'#10'"    Get an integer value at the specified Path.'
  +'\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a floating'
  +'-point value at the specified Path.\n"'#10'"  JSONGetBool(Handle, Path) : B'
  +'oolean\n"'#10'"    Get a boolean value at the specified Path.\n"'#10'"  JSO'
  +'NGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the number of elemen'
  +'ts in an array at the specified Path.\n"'#10'"  JSONGetArrayString(Handle, '
  +'Path, Index) : string\n"'#10'"    Get the string value of an array element '
  +'at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Intege'
  +'r\n"'#10'"    Get the integer value of an array element at the given Index.'
  +'\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Return the type o'
  +'f the value at Path: \"object\", \"array\", \"string\", \"int\", \"float\",'
  +' \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10
  +'"    Check if the specified Path exists.\n"'#10'"  JSONResultInit\n"'#10'" '
  +'   Initialize an empty JSON array for building a standard error result.\n"'
  +#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"   '
  +' Add an error object to the result array. Replacements is a string of value'
  +'s separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Return t'
  +'he current result array as a JSON string.\n"'#10'"  JSONResultClear\n"'#10
  +'"    Clear the result array.\n"'#10'"  Always call JSONFree to release the '
  +'handle after you are done.\n"'#10'"\n"'#10'"Example of working with JSON:\n'
  +'"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'" '
  +'   h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10
  +'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"    '
  +'  SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10
  +'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'
  +#10'"  text - the input text to process (possibly truncated to MaxLength)\n"'
  +#10'"  source - source language code (may be empty)\n"'#10'"  target - targe'
  +'t language code\n"'#10'"  timestamp - current Unix timestamp in millisecond'
  +'s (string)\n"'#10'"  random  - 9-digit random number (string)\n"'#10'"  ran'
  +'d - same as random\n"'#10'"  rand1..rand9 - first 1..9 digits of the random'
  ,' number\n"'#10'"\n"'#10'"Additional initial and custom parameters are also '
  +'available."'#10'msgstr ""'#10'"O script '#195#169' um programa Pascal padr'
  +#195#163'o: uma se'#195#167#195#163'o var opcional, seguida de um bloco prin'
  +'cipal begin ... end.\n"'#10'"\n"'#10'"Exemplo:\n"'#10'"  var s: string;\n"'
  +#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAl'
  +'l(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  en'
  +'d.\n"'#10'"\n"'#10'"Voc'#195#170' tamb'#195#169'm pode usar constru'#195#167
  +#195#181'es padr'#195#163'o do Pascal (if, for, while, repeat etc.). Voc'#195
  +#170' pode definir suas pr'#195#179'prias fun'#195#167#195#181'es e procedim'
  +'entos antes do bloco principal begin ... end.\n"'#10'"\n"'#10'"Fun'#195#167
  +#195#181'es dispon'#195#173'veis:\n"'#10'"  GetParam(''name'') : string\n"'
  +#10'"    Recupera o valor de um par'#195#162'metro de entrada.\n"'#10'"  Set'
  +'Output(''name'', ''value'')\n"'#10'"    Armazena um valor de sa'#195#173'da'
  +' para o host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Timestamp Unix a'
  +'tual em milissegundos (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"  '
  +'  N'#195#186'mero inteiro aleat'#195#179'rio com exatamente Length d'#195
  +#173'gitos decimais.\n"'#10'"  Random : Extended\n"'#10'"    N'#195#186'mero'
  +' de ponto flutuante aleat'#195#179'rio no intervalo [0, 1).\n"'#10'"  IntTo'
  +'Hex(Value, Digits) : string\n"'#10'"    Converte um n'#195#186'mero inteiro'
  +' em uma string hexadecimal com pelo menos Digits caracteres.\n"'#10'"  StrT'
  +'oInt(S) : Integer\n"'#10'"    Converte uma string em um n'#195#186'mero int'
  +'eiro. Gera uma exce'#195#167#195#163'o em caso de entrada inv'#195#161'lida'
  +'.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Converte um n'#195#186'mer'
  +'o inteiro em sua representa'#195#167#195#163'o como string.\n"'#10'"  Trim('
  +'S) : string\n"'#10'"    Remove espa'#195#167'os em branco do in'#195#173'ci'
  +'o e do fim de S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove espa'#195
  +#167'os em branco do in'#195#173'cio de S.\n"'#10'"  TrimRight(S) : string\n'
  +'"'#10'"    Remove espa'#195#167'os em branco do fim de S.\n"'#10'"  HtmlEnc'
  +'ode(S) : string\n"'#10'"    Codifica caracteres HTML especiais em S como en'
  +'tidades.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decodifica entidades '
  +'HTML em S de volta para caracteres.\n"'#10'"  UrlEncode(S) : string\n"'#10
  +'"    Codifica S usando codifica'#195#167#195#163'o percentual para inclus'
  +#195#163'o segura em uma URL.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    De'
  +'codifica uma string S codificada com codifica'#195#167#195#163'o percentual'
  +'.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : strin'
  +'g\n"'#10'"    Substitui todas as ocorr'#195#170'ncias de OldPattern por New'
  +'Pattern em S.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\'
  +'n"'#10'"    Substitui todas as correspond'#195#170'ncias da express'#195#163
  +'o regular Pattern por Replacement em Input. N'#195#163'o diferencia mai'#195
  +#186'sculas de min'#195#186'sculas.\n"'#10'"  RegexMatch(Input, Pattern) : B'
  +'oolean\n"'#10'"    Verifica se Input corresponde '#195#160' express'#195#163
  +'o regular Pattern. N'#195#163'o diferencia mai'#195#186'sculas de min'#195
  +#186'sculas.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'
  +#10'"    Extrai a substring de S entre StartMarker e EndMarker.\n"'#10'"\n"'
  +#10'"Fun'#195#167#195#181'es JSON (use um handle retornado por JSONParse):\n'
  +'"'#10'"  JSONParse(S) : Integer\n"'#10'"    Analisa uma string JSON e retor'
  +'na um handle (>=0). Retorna -1 em caso de erro.\n"'#10'"  JSONFree(Handle)\'
  +'n"'#10'"    Libera o handle ap'#195#179's o uso.\n"'#10'"  JSONGetString(Ha'
  +'ndle, Path) : string\n"'#10'"    Obt'#195#169'm um valor de string no Path '
  +'especificado.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Obt'
  +#195#169'm um valor inteiro no Path especificado.\n"'#10'"  JSONGetFloat(Han'
  +'dle, Path) : Extended\n"'#10'"    Obt'#195#169'm um valor de ponto flutuant'
  +'e no Path especificado.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10
  +'"    Obt'#195#169'm um valor booleano no Path especificado.\n"'#10'"  JSONG'
  +'etArrayCount(Handle, Path) : Integer\n"'#10'"    Obt'#195#169'm o n'#195#186
  +'mero de elementos de um array no Path especificado.\n"'#10'"  JSONGetArrayS'
  +'tring(Handle, Path, Index) : string\n"'#10'"    Obt'#195#169'm o valor de s'
  +'tring de um elemento do array no Index especificado.\n"'#10'"  JSONGetArray'
  +'Int(Handle, Path, Index) : Integer\n"'#10'"    Obt'#195#169'm o valor intei'
  +'ro de um elemento do array no Index especificado.\n"'#10'"  JSONGetType(Han'
  +'dle, Path) : string\n"'#10'"    Retorna o tipo do valor em Path: \"object\"'
  +', \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  '
  +'JSONPathExists(Handle, Path) : Boolean\n"'#10'"    Verifica se o Path espec'
  +'ificado existe.\n"'#10'"  JSONResultInit\n"'#10'"    Inicializa um array JS'
  ,'ON vazio para criar um resultado de erro padr'#195#163'o.\n"'#10'"  JSONRes'
  +'ultAddError(Offset, Length, Message, Replacements)\n"'#10'"    Adiciona um '
  +'objeto de erro ao array de resultados. Replacements '#195#169' uma string d'
  +'e valores separados por \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"   '
  +' Retorna o array de resultados atual como uma string JSON.\n"'#10'"  JSONRe'
  +'sultClear\n"'#10'"    Limpa o array de resultados.\n"'#10'"  Sempre chame J'
  +'SONFree para liberar o handle depois de terminar de us'#195#161'-lo.\n"'#10
  +'"\n"'#10'"Exemplo de uso de JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s'
  +': string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));'
  +'\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetStr'
  +'ing(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      '
  +'JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Par'#195#162
  +'metros dispon'#195#173'veis (obtidos com GetParam):\n"'#10'"  text - o text'
  +'o de entrada a ser processado (possivelmente truncado para MaxLength)\n"'#10
  +'"  source - c'#195#179'digo do idioma de origem (pode estar vazio)\n"'#10'"'
  +'  target - c'#195#179'digo do idioma de destino\n"'#10'"  timestamp - times'
  +'tamp Unix atual em milissegundos (string)\n"'#10'"  random  - n'#195#186'me'
  +'ro aleat'#195#179'rio de 9 d'#195#173'gitos (string)\n"'#10'"  rand - igual'
  +' a random\n"'#10'"  rand1..rand9 - os primeiros 1..9 d'#195#173'gitos do n'
  +#195#186'mero aleat'#195#179'rio\n"'#10'"\n"'#10'"Par'#195#162'metros inicia'
  +'is e personalizados adicionais tamb'#195#169'm est'#195#163'o dispon'#195
  +#173'veis."'#10#10'#: formconfig.rscriptresponsehint'#10'msgid ""'#10'"This '
  +'script processes the response data. All functions and parameters described '
  +'in the script hint are available here as well.\n"'#10'"Use GetParam(''resul'
  +'t'') to obtain the received text.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s'
  +': string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"  '
  +'  SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can define '
  +'custom parameters in the parameters script using SetParam(''name'', ''value'
  +'''),\n"'#10'"and then retrieve them here with GetParam(''name'')."'#10'msgs'
  +'tr ""'#10'"Este script processa os dados da resposta. Todas as fun'#195#167
  +#195#181'es e par'#195#162'metros descritos na dica do script tamb'#195#169
  +'m est'#195#163'o dispon'#195#173'veis aqui.\n"'#10'"Use GetParam(''result'''
  +') para obter o texto recebido.\n"'#10'"\n"'#10'"Exemplo:\n"'#10'"  var s: s'
  +'tring;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    S'
  +'etOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Voc'#195#170' pode'
  +' definir par'#195#162'metros personalizados no script de par'#195#162'metro'
  +'s usando SetParam(''name'', ''value''),\n"'#10'"e depois recuper'#195#161'-'
  +'los aqui com GetParam(''name'')."'#10#10'#: formconfig.rvaluetype1'#10'msgc'
  +'txt "formconfig.rvaluetype1"'#10'msgid "None"'#10'msgstr "Nenhum"'#10#10'#:'
  +' formconfig.rvaluetype2'#10'msgid "Language"'#10'msgstr "Idioma"'#10#10'#: '
  +'formconfig.rvaluetype3'#10'msgid "Currency All"'#10'msgstr "Todas as moedas'
  +'"'#10#10'#: formconfig.rvaluetype4'#10'msgid "Currency Fiat Only"'#10'msgst'
  +'r "Apenas moedas fiduci'#195#161'rias"'#10#10'#: formconfig.rvaluetype5'#10
  +'msgid "Currency Crypto Only"'#10'msgstr "Apenas criptomoedas"'#10#10'#: for'
  +'mconfig.rvaluetype6'#10'msgid "Measurement Units"'#10'msgstr "Unidades de m'
  +'edida"'#10#10'#: tformconfigtrayslate.aclearicon.caption'#10'msgid "Clear I'
  +'con"'#10'msgstr "Limpar '#195#173'cone"'#10#10'#: tformconfigtrayslate.asav'
  +'e.caption'#10'msgid "Save"'#10'msgstr "Guardar"'#10#10'#: tformconfigtraysl'
  +'ate.asaveiconas.caption'#10'msgid "Save Icon As..."'#10'msgstr "Salvar '#195
  +#173'cone como..."'#10#10'#: tformconfigtrayslate.btnclose.caption'#10'msgid'
  +' "Close"'#10'msgstr "Fechar"'#10#10'#: tformconfigtrayslate.btninitparamete'
  +'rstest.hint'#10'msgid "Execute request and view the parameters"'#10'msgstr '
  +'"Executar pedido e ver os par'#195#162'metros"'#10#10'#: tformconfigtraysla'
  +'te.btniniturltest.hint'#10'msgid "Execute request and view the result"'#10
