  +'.\n"'#10'"'#206#160#206#177#207#129#206#177#206#180#206#181#206#175#206#179
  +#206#188#206#177#207#132#206#177':\n"'#10'"responseData/translatedText; matc'
  +'hes/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ '
  +'({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#10#10'#: f'
  +'ormconfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal pro'
  +'gram: optional var section, then a main begin ... end. block.\n"'#10'"\n"'
  +#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetP'
  +'aram(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10
  +'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also u'
  +'se standard Pascal constructs (if, for, while, repeat, etc.). You can defin'
  +'e your own functions and procedures before the main begin ... end. block.\n'
  +'"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : string\'
  +'n"'#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''name'''
  +', ''value'')\n"'#10'"    Store an output value for the host.\n"'#10'"  GetT'
  +'imestamp() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (UTC)'
  ,'.\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with exact'
  +'ly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random fl'
  +'oat in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10
  +'"    Convert integer to hexadecimal string with at least Digits characters.'
  +'\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to an integer'
  +'. Raises an exception on invalid input.\n"'#10'"  IntToStr(Value) : string\'
  +'n"'#10'"    Convert an integer to its string representation.\n"'#10'"  Trim'
  +'(S) : string\n"'#10'"    Remove leading and trailing whitespace from S.\n"'
  +#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whitespace from S.\n"'
  +#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing whitespace from S.\'
  +'n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML characters'
  +' in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HT'
  +'ML entities in S back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10
  +'"    Percent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : stri'
  +'ng\n"'#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, O'
  +'ldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replace all o'
  +'ccurrences of OldPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input'
  +', Pattern, Replacement) : string\n"'#10'"    Replace all regex matches of P'
  +'attern with Replacement in Input. Case-insensitive.\n"'#10'"  RegexMatch(In'
  +'put, Pattern) : Boolean\n"'#10'"    Check if Input matches the regex Patter'
  +'n. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : '
  +'string\n"'#10'"    Extract the substring of S between StartMarker and EndMa'
  +'rker.\n"'#10'"\n"'#10'"JSON functions (use a handle returned by JSONParse):'
  +'\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string and retur'
  +'n a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'" '
  +'   Release the handle after use.\n"'#10'"  JSONGetString(Handle, Path) : st'
  +'ring\n"'#10'"    Get a string value at the specified Path.\n"'#10'"  JSONGe'
  +'tInt(Handle, Path) : Integer\n"'#10'"    Get an integer value at the specif'
  +'ied Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a'
  +' floating-point value at the specified Path.\n"'#10'"  JSONGetBool(Handle, '
  +'Path) : Boolean\n"'#10'"    Get a boolean value at the specified Path.\n"'
  +#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the number '
  +'of elements in an array at the specified Path.\n"'#10'"  JSONGetArrayString'
  +'(Handle, Path, Index) : string\n"'#10'"    Get the string value of an array'
  +' element at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index)'
  +' : Integer\n"'#10'"    Get the integer value of an array element at the giv'
  +'en Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Return t'
  +'he type of the value at Path: \"object\", \"array\", \"string\", \"int\", \'
  +'"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Bool'
  +'ean\n"'#10'"    Check if the specified Path exists.\n"'#10'"  JSONResultIni'
  +'t\n"'#10'"    Initialize an empty JSON array for building a standard error '
  +'result.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Replacements)'
  +'\n"'#10'"    Add an error object to the result array. Replacements is a str'
  +'ing of values separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"'
  +'    Return the current result array as a JSON string.\n"'#10'"  JSONResultC'
  +'lear\n"'#10'"    Clear the result array.\n"'#10'"  Always call JSONFree to '
  +'release the handle after you are done.\n"'#10'"\n"'#10'"Example of working '
  +'with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  beg'
  +'in\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 '
  +'then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\'
  +'n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"  '
  +'  end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved with'
  +' GetParam):\n"'#10'"  text - the input text to process (possibly truncated '
  +'to MaxLength)\n"'#10'"  source - source language code (may be empty)\n"'#10
  +'"  target - target language code\n"'#10'"  timestamp - current Unix timesta'
  +'mp in milliseconds (string)\n"'#10'"  random  - 9-digit random number (stri'
  +'ng)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 - first 1..9 dig'
  +'its of the random number\n"'#10'"\n"'#10'"Additional initial and custom par'
  +'ameters are also available."'#10'msgstr ""'#10'"'#206#164#206#191' script '
