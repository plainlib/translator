  +#13#10'"responseData/translatedText; matches/*#10/translation; /texts/text; '
  +'{literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: '
  +'No data!#10}; /translations"'#13#10#13#10'#: formconfig.rscripthint'#13#10
  +'msgid ""'#13#10'"The script is a standard Pascal program: optional var sect'
  +'ion, then a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'
  +#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''t'
  +'ext'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"'
  +'    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You ca'
  +'n also use standard Pascal constructs (if, for, while, repeat, etc.). You c'
  +'an define your own functions and procedures before the main begin ... end. '
  +'block.\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam('''
  +'name'') : string\n"'#13#10'"    Retrieve an input parameter value.\n"'#13#10
  +'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Store an output value for '
  +'the host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix t'
  +'imestamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'
  +#13#10'"    Random integer with exactly Length decimal digits.\n"'#13#10'"  '
  +'Random : Extended\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10
  +'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Convert integer to hexad'
  +'ecimal string with at least Digits characters.\n"'#13#10'"  StrToInt(S) : I'
  +'nteger\n"'#13#10'"    Convert a string to an integer. Raises an exception o'
  +'n invalid input.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Conve'
  +'rt an integer to its string representation.\n"'#13#10'"  Trim(S) : string\n'
  +'"'#13#10'"    Remove leading and trailing whitespace from S.\n"'#13#10'"  T'
  +'rimLeft(S) : string\n"'#13#10'"    Remove leading whitespace from S.\n"'#13
  +#10'"  TrimRight(S) : string\n"'#13#10'"    Remove trailing whitespace from '
  +'S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Encode special HTML c'
  +'haracters in S into entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10
  +'"    Decode HTML entities in S back to characters.\n"'#13#10'"  UrlEncode(S'
  +') : string\n"'#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13#10
  +'"  UrlDecode(S) : string\n"'#13#10'"    Decode a percent-encoded string S.\'
  +'n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : stri'
  +'ng\n"'#13#10'"    Replace all occurrences of OldPattern with NewPattern in '
  +'S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10
  +'"    Replace all regex matches of Pattern with Replacement in Input. Case-i'
  +'nsensitive.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"  '
  +'  Check if Input matches the regex Pattern. Case-insensitive.\n"'#13#10'"  '
  +'ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extract t'
  +'he substring of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10
  +'"JSON functions (use a handle returned by JSONParse):\n"'#13#10'"  JSONPars'
  +'e(S) : Integer\n"'#13#10'"    Parse a JSON string and return a handle (>=0)'
  +'. Returns -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release'
  +' the handle after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'
  +#13#10'"    Get a string value at the specified Path.\n"'#13#10'"  JSONGetIn'
  +'t(Handle, Path) : Integer\n"'#13#10'"    Get an integer value at the specif'
  +'ied Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"   '
  +' Get a floating-point value at the specified Path.\n"'#13#10'"  JSONGetBool'
  +'(Handle, Path) : Boolean\n"'#13#10'"    Get a boolean value at the specifie'
  +'d Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'" '
  +'   Get the number of elements in an array at the specified Path.\n"'#13#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#13#10'"  JSONGetAr'
  +'rayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Get the integer value '
  +'of an array element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Pa'
  +'th) : string\n"'#13#10'"    Return the type of the value at Path: \"object\'
  +'", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10
  +'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the speci'
  +'fied Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an '
  +'empty JSON array for building a standard error result.\n"'#13#10'"  JSONRes'
  +'ultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an er'
  +'ror object to the result array. Replacements is a string of values separate'
  +'d by \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the c'
  +'urrent result array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10
  ,'"    Clear the result array.\n"'#13#10'"  Always call JSONFree to release t'
  +'he handle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working wit'
  +'h JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10
  +'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"  '
  +'  if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h'
  +', ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"     '
  +' JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'Available parameters (retrieved with GetParam):\n"'#13#10'"  text - the inp'
  +'ut text to process (possibly truncated to MaxLength)\n"'#13#10'"  source - '
  +'source language code (may be empty)\n"'#13#10'"  target - target language c'
  +'ode\n"'#13#10'"  timestamp - current Unix timestamp in milliseconds (string'
  +')\n"'#13#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand -'
  +' same as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are'
  +' also available."'#13#10'msgstr ""'#13#10'"'#208#161#208#186#209#128#209#139
