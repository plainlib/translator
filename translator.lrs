  +#172#236#154#169': {text} '#226#128#147' '#236#158#133#235#160#165' '#237#133
  +#141#236#138#164#237#138#184', {source} '#226#128#147' '#236#134#140#236#138
  +#164' '#236#150#184#236#150#180', {target} '#226#128#147' '#235#140#128#236
  +#131#129' '#236#150#184#236#150#180'. '#236#157#180#235#166#132' '#236#149
  +#158#236#151#144' !'#235#165#188' '#235#182#153#236#157#180#235#169#180' '
  +#236#134#140#235#172#184#236#158#144', ^'#235#165#188' '#235#182#153#236#157
