  +'configtrayslate.labelheaders.caption'#10'msgid "Additional request headers '
  +'in key=value format, key: value is also supported"'#10'msgstr "Header permi'
  +'ntaan tambahan dalam format key=value, key: value juga didukung"'#10#10'#: '
  +'tformconfigtrayslate.labelinitheaders.caption'#10'msgid "Additional initial'
  +' request headers in key=value format, key: value is also supported"'#10'msg'
  +'str "Header permintaan awal tambahan dalam format key=value, key: value jug'
  +'a didukung"'#10#10'#: tformconfigtrayslate.labelinitheaders2.caption'#10'ms'
  +'gctxt "tformconfigtrayslate.labelinitheaders2.caption"'#10'msgid "Headers"'
  +#10'msgstr "Headers"'#10#10'#: tformconfigtrayslate.labelinitlivetime.captio'
  +'n'#10'msgid "Live time"'#10'msgstr "Waktu hidup"'#10#10'#: tformconfigtrays'
  +'late.labelinitparameters.caption'#10'msgid "Parameters name=regexp are extr'
  +'acted from the response and used by name in requests"'#10'msgstr "Parameter'
  +' name=regexp diekstrak dari respons dan digunakan berdasarkan nama dalam pe'
  +'rmintaan"'#10#10'#: tformconfigtrayslate.labelinitparameters1.caption'#10'm'
  +'sgid "Time in seconds to refresh parameters with a new request (0 = every r'
  +'equest)"'#10'msgstr "Waktu dalam detik untuk menyegarkan parameter dengan p'
  +'ermintaan baru (0 = setiap permintaan)"'#10#10'#: tformconfigtrayslate.labe'
  +'linitparameters2.caption'#10'msgctxt "tformconfigtrayslate.labelinitparamet'
  +'ers2.caption"'#10'msgid "Parameters"'#10'msgstr "Parameter"'#10#10'#: tform'
  +'configtrayslate.labelinitparameters4.caption'#10'msgid "Parameters in the f'
  +'orm key=value used by {key} in requests. If the value is omitted (key=), it'
  +' will be requested from the user."'#10'msgstr "Parameter dalam bentuk key=v'
  +'alue yang digunakan oleh {key} dalam permintaan. Jika nilainya dihilangkan '
  +'(key=), nilainya akan diminta dari pengguna."'#10#10'#: tformconfigtrayslat'
  ,'e.labelinitparemeters.caption'#10'msgid "Initial GET request to obtain requ'
  +'ired parameters."'#10'msgstr "Permintaan GET awal untuk mendapatkan paramet'
  +'er yang diperlukan."'#10#10'#: tformconfigtrayslate.labeliniturl.caption'#10
  +'msgctxt "tformconfigtrayslate.labeliniturl.caption"'#10'msgid "URL"'#10'msg'
  +'str "URL"'#10#10'#: tformconfigtrayslate.labelinituseragent.caption'#10'msg'
  +'ctxt "tformconfigtrayslate.labelinituseragent.caption"'#10'msgid "User Agen'
  +'t"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labellanguages.ca'
  +'ption'#10'msgid "Supported languages e.g. en=en-US (en - internal, en-US - '
  +'service). \"empty\" - do not send."'#10'msgstr "Bahasa yang didukung misaln'
  +'ya en=en-US (en - internal, en-US - layanan). \"empty\" - jangan kirim."'#10
  +#10'#: tformconfigtrayslate.labellanguages1.caption'#10'msgid "Value type fo'
  +'r populating names. None keeps originals; None and Unit are case-sensitive.'
  +'"'#10'msgstr "Tipe nilai untuk mengisi nama. None mempertahankan asli; None'
  +' dan Unit peka huruf besar/kecil."'#10#10'#: tformconfigtrayslate.labellang'
  +'uagestarget.caption'#10'msgid ""'#10'"Target languages e.g. en=en-US, en - '
  +'internal, en-US - service code.\n"'#10'"If not specified, both source and t'
  +'arget languages are taken from the languages section."'#10'msgstr ""'#10'"B'
  +'ahasa sasaran misalnya en=en-US, en - internal, en-US - kode layanan.\n"'#10
  +'"Jika tidak ditentukan, baik bahasa sumber maupun sasaran diambil dari bagi'
  +'an bahasa."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid'
  +' "Max Length, bytes"'#10'msgstr "Lunghezza massima, byte"'#10#10'#: tformco'
  +'nfigtrayslate.labelmethod.caption'#10'msgid "Method"'#10'msgstr "Metode"'#10
  +#10'#: tformconfigtrayslate.labelparemeters.caption'#10'msgid "Use parameter'
  +'s: {text} '#226#128#147' input text, {source} '#226#128#147' source languag'
  +'e, {target} '#226#128#147' target language. Prefix the name with ! for lowe'
  +'rcase or ^ for uppercase value. Also supported {timestamp}, {rand}. Use {pa'
  +'rameter} from the parameters page."'#10'msgstr "Gunakan parameter: {text} '
  +#226#128#147' teks masukan, {source} '#226#128#147' bahasa sumber, {target} '
  +#226#128#147' bahasa sasaran. Awali nama dengan ! untuk nilai huruf kecil at'
  +'au ^ untuk huruf besar. Juga didukung {timestamp}, {rand}. Gunakan {paramet'
  +'er} dari halaman parameter."'#10#10'#: tformconfigtrayslate.labelpostdata.c'
  +'aption'#10'msgid "Post Data"'#10'msgstr "Post Data"'#10#10'#: tformconfigtr'
  +'ayslate.labelpostdata1.caption'#10'msgctxt "tformconfigtrayslate.labelpostd'
  +'ata1.caption"'#10'msgid "Headers"'#10'msgstr "Headers"'#10#10'#: tformconfi'
  +'gtrayslate.labelservicedescription.caption'#10'msgid "Description"'#10'msgs'
  +'tr "Deskripsi"'#10#10'#: tformconfigtrayslate.labelservicename.caption'#10
  +'msgid "Name"'#10'msgstr "Nama"'#10#10'#: tformconfigtrayslate.labelserviceo'
  +'rder.caption'#10'msgid "Order"'#10'msgstr "Urutan"'#10#10'#: tformconfigtra'
  +'yslate.labelsort.caption'#10'msgctxt "tformconfigtrayslate.labelsort.captio'
  +'n"'#10'msgid "Sort"'#10'msgstr "Urutkan"'#10#10'#: tformconfigtrayslate.lab'
  +'eltargetsort.caption'#10'msgctxt "tformconfigtrayslate.labeltargetsort.capt'
  +'ion"'#10'msgid "Sort"'#10'msgstr "Urutkan"'#10#10'#: tformconfigtrayslate.l'
  +'abelurl.caption'#10'msgctxt "tformconfigtrayslate.labelurl.caption"'#10'msg'
  +'id "URL"'#10'msgstr "URL"'#10#10'#: tformconfigtrayslate.labeluseragent.cap'
  +'tion'#10'msgctxt "tformconfigtrayslate.labeluseragent.caption"'#10'msgid "U'
  +'ser Agent"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labelvalu'
  +'etype.caption'#10'msgid "Value Type"'#10'msgstr "Tipe Nilai"'#10#10'#: tfor'
  +'mconfigtrayslate.pageinitialrequest.caption'#10'msgctxt "tformconfigtraysla'
  +'te.pageinitialrequest.caption"'#10'msgid "Initial Request"'#10'msgstr "Perm'
  +'intaan Awal"'#10#10'#: tformconfigtrayslate.pagelanguages.caption'#10'msgct'
  +'xt "tformconfigtrayslate.pagelanguages.caption"'#10'msgid "Languages"'#10'm'
  +'sgstr "Bahasa"'#10#10'#: tformconfigtrayslate.pagelanguagestarget.caption'
  +#10'msgctxt "tformconfigtrayslate.pagelanguagestarget.caption"'#10'msgid "Ta'
  +'rget Languages"'#10'msgstr "Bahasa Sasaran"'#10#10'#: tformconfigtrayslate.'
  +'pageparameters.caption'#10'msgctxt "tformconfigtrayslate.pageparameters.cap'
  +'tion"'#10'msgid "Parameters"'#10'msgstr "Parameter"'#10#10'#: tformconfigtr'
  +'ayslate.pagerequest.caption'#10'msgctxt "tformconfigtrayslate.pagerequest.c'
  +'aption"'#10'msgid "Request"'#10'msgstr "Permintaan"'#10#10'#: tformconfigtr'
  +'ayslate.pageresponse.caption'#10'msgid "Response"'#10'msgstr "Respons"'#10
  +#10'#: tformconfigtrayslate.pageservice.caption'#10'msgctxt "tformconfigtray'
  +'slate.pageservice.caption"'#10'msgid "Service"'#10'msgstr "Layanan"'#10#10
  +'#: tformconfigtrayslate.reloadconfigs.hint'#10'msgid "Reload configurations'
  +' from disk"'#10'msgstr "Muat ulang konfigurasi dari disk"'#10#10'#: tformco'
  +'nfigtrayslate.sbcopyconfig.hint'#10'msgid "Copy configuration"'#10'msgstr "'
  ,'Salin konfigurasi"'#10#10'#: tformconfigtrayslate.sbnewconfig.hint'#10'msgi'
  +'d "New configuration"'#10'msgstr "Konfigurasi baru"'#10#10
]);
LazarusResources.Add('formconfig.it','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: Trayslate - Italian - 18.10.'
  +'2026\n"'#10'"POT-Creation-Date: \n"'#10'"PO-Revision-Date: \n"'#10'"Last-Tr'
  +'anslator: bovirus <bovirus@gmail.com>\n"'#10'"Language-Team: bovirus (bovir'
  +'us@gmail.com)\n"'#10'"Language: it\n"'#10'"MIME-Version: 1.0\n"'#10'"Conten'
  +'t-Type: text/plain; charset=UTF-8\n"'#10'"Content-Transfer-Encoding: 8bit\n'
  +'"'#10'"X-Generator: PoBatch 1.0.0\n"'#10'"X-Poedit-SourceCharset: UTF-8"'#10
  +#10'#: formconfig.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Conf'
  +'ig Editor"'#10'msgstr "Editor configurazione"'#10#10'#: formconfig.rclearla'
  +'nguages'#10'msgid "The list is already filled. Do you want to clear it?"'#10
  +'msgstr ""'#10'"L''elenco '#195#168' gi'#195#160' pieno.\n"'#10'"Vuoi cancel'
  +'larlo?"'#10#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you want'
  +' to delete config"'#10'msgstr "Vuoi eliminare la configurazione"'#10#10'#: '
  +'formconfig.rdeleteconfigcaption'#10'msgid "Delete config"'#10'msgstr "Elimi'
  +'na configurazione"'#10#10'#: formconfig.rnamequestion'#10'msgid "Enter new '
  +'config file name:"'#10'msgstr "Inserisci nome nuovo file configurazione:"'
  +#10#10'#: formconfig.rneedsave'#10'msgid "The configuration was modified. Sa'
  +'ve changes?"'#10'msgstr ""'#10'"La configurazione '#195#168' stata modifica'
  +'ta.\n"'#10'"Vuoi salvare le modifiche?"'#10#10'#: formconfig.rresponsehint'
  +#10'msgid ""'#10'"Json Pointer: Use / for levels, keys for objects, and numb'
  +'ers for indexes.\n"'#10'"Use * for all items, *#10 to join items by newline'
  +'. Use ~ at the end of the path to return the raw JSON branch.\n"'#10'"Separ'
  +'ate multiple segments with semicolon ;.\n"'#10'"Literal: Text block in {'
  +#226#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to extrac'
  +'t data directly into the text.\n"'#10'"Logic: If a Pointer in a segment is '
  +'empty, the whole segment is skipped. If a segment has no Pointer, only lite'
  +'ral text blocks with embedded regular expressions are processed.\n"'#10'"Re'
  +'gex: {prefix {regex[index]} suffix} inside a text block. If no [index] is s'
  +'pecified, the first match is used.\n"'#10'"Index can be a number, [*] (join'
  +' by space), or [*#10] (join by newline). If the regex finds no match, the e'
  +'ntire {'#226#128#166'} block is removed.\n"'#10'"Using ~ inside a regex ret'
  +'urns the entire text.\n"'#10'"Inversion: Start a segment with ! (e.g. !/pat'
  +'h{Error}) to show its text only if the Pointer data is missing or the JSON '
  +'is invalid.\n"'#10'"Commenting: /* text */ comments are stripped from the e'
  +'ntire expression before any processing.\n"'#10'"Examples:\n"'#10'"responseD'
  +'ata/translatedText; matches/*#10/translation; /texts/text; {literal text#10'
  +'}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /t'
  +'ranslations/0/text"'#10'msgstr ""'#10'"Json Pointer: Usa / per i livelli, l'
  +'e chiavi per gli oggetti e i numeri per gli indici. Usa * per tutti gli ele'
  +'menti, *#10 per unire gli elementi con nuova riga. Usa ~ alla fine del perc'
  +'orso per restituire il ramo JSON grezzo. Separa pi'#195#185' segmenti con i'
  +'l punto e virgola ;.\n"'#10'"Letterale: Blocco di testo in {'#226#128#166'}'
  +'. Tag speciale #10 per le nuove righe. Usa {{regex}} all''interno per estra'
  +'rre i dati direttamente nel testo.\n"'#10'"Logica: Se un puntatore in un se'
  +'gmento '#195#168' vuoto, l''intero segmento viene saltato. Se un segmento n'
  +'on ha un puntatore, vengono elaborati solo i blocchi di testo letterale con'
  +' espressioni regolari incorporate.\n"'#10'"Regex: {prefisso {regex[indice]}'
  +' suffisso} all''interno di un blocco di testo. Se non viene specificato [in'
  +'dice], viene usata la prima corrispondenza. L''indice pu'#195#178' essere u'
  +'n numero, [*] (unisci con spazio) o [*#10] (unisci con nuova riga). Se l''e'
  +'spressione regolare non trova corrispondenze, l''intero blocco {'#226#128
  +#166'} viene rimosso. L''uso di ~ all''interno di un''espressione regolare r'
  +'estituisce l''intero testo.\n"'#10'"Inversione: Inizia un segmento con ! (e'
  +'s. !/path{Error}) per visualizzarne il testo solo se i dati del puntatore m'
  +'ancano o il JSON non '#195#168' valido.\n"'#10'"Commenti: i commenti /* tes'
  +'to */ vengono rimossi dall''intera espressione prima di qualsiasi elaborazi'
  +'one.\n"'#10'"Esempi:\n"'#10'"responseData/translatedText; matches/*#10/tran'
  +'slation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; '
  +'!/translations{Error: No data!#10}; /translations/0/text"'#10#10'#: formcon'
  +'fig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal program: '
  +'optional var section, then a main begin ... end. block.\n"'#10'"\n"'#10'"Ex'
  +'ample:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam('
  +'''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"   '
  +' SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also use s'
  +'tandard Pascal constructs (if, for, while, repeat, etc.). You can define yo'
  ,'ur own functions and procedures before the main begin ... end. block.\n"'#10
  +'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : string\n"'#10
  +'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''name'', ''val'
  +'ue'')\n"'#10'"    Store an output value for the host.\n"'#10'"  GetTimestam'
  +'p() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#10
  +'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with exactly Length'
  +' decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random float in th'
  +'e range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Conv'
  +'ert integer to hexadecimal string with at least Digits characters.\n"'#10'"'
  +'  StrToInt(S) : Integer\n"'#10'"    Convert a string to an integer. Raises '
  +'an exception on invalid input.\n"'#10'"  IntToStr(Value) : string\n"'#10'" '
  +'   Convert an integer to its string representation.\n"'#10'"  Trim(S) : str'
  +'ing\n"'#10'"    Remove leading and trailing whitespace from S.\n"'#10'"  Tr'
  +'imLeft(S) : string\n"'#10'"    Remove leading whitespace from S.\n"'#10'"  '
  +'TrimRight(S) : string\n"'#10'"    Remove trailing whitespace from S.\n"'#10
  +'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML characters in S i'
  +'nto entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HTML enti'
  +'ties in S back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    P'
  +'ercent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : string\n"'
  +#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, OldPatte'
  +'rn, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replace all occurren'
  +'ces of OldPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input, Patte'
  +'rn, Replacement) : string\n"'#10'"    Replace all regex matches of Pattern '
  +'with Replacement in Input. Case-insensitive.\n"'#10'"  RegexMatch(Input, Pa'
  +'ttern) : Boolean\n"'#10'"    Check if Input matches the regex Pattern. Case'
  +'-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\'
  +'n"'#10'"    Extract the substring of S between StartMarker and EndMarker.\n'
  +'"'#10'"\n"'#10'"JSON functions (use a handle returned by JSONParse):\n"'#10
  +'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string and return a hand'
  +'le (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Relea'
  +'se the handle after use.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'
  +#10'"    Get a string value at the specified Path.\n"'#10'"  JSONGetInt(Hand'
  +'le, Path) : Integer\n"'#10'"    Get an integer value at the specified Path.'
  +'\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a floating'
  +'-point value at the specified Path.\n"'#10'"  JSONGetBool(Handle, Path) : B'
  +'oolean\n"'#10'"    Get a boolean value at the specified Path.\n"'#10'"  JSO'
  +'NGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the number of elemen'
  +'ts in an array at the specified Path.\n"'#10'"  JSONGetArrayString(Handle, '
  +'Path, Index) : string\n"'#10'"    Get the string value of an array element '
  +'at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Intege'
  +'r\n"'#10'"    Get the integer value of an array element at the given Index.'
  +'\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Return the type o'
  +'f the value at Path: \"object\", \"array\", \"string\", \"int\", \"float\",'
  +' \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10
  +'"    Check if the specified Path exists.\n"'#10'"  JSONResultInit\n"'#10'" '
  +'   Initialize an empty JSON array for building a standard error result.\n"'
  +#10'"  JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"   '
  +' Add an error object to the result array. Replacements is a string of value'
  +'s separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Return t'
  +'he current result array as a JSON string.\n"'#10'"  JSONResultClear\n"'#10
  +'"    Clear the result array.\n"'#10'"  Always call JSONFree to release the '
  +'handle after you are done.\n"'#10'"\n"'#10'"Example of working with JSON:\n'
  +'"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'" '
  +'   h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10
  +'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"    '
  +'  SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10
  +'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'
  +#10'"  text - the input text to process (possibly truncated to MaxLength)\n"'
  +#10'"  source - source language code (may be empty)\n"'#10'"  target - targe'
  +'t language code\n"'#10'"  timestamp - current Unix timestamp in millisecond'
  +'s (string)\n"'#10'"  random  - 9-digit random number (string)\n"'#10'"  ran'
  +'d - same as random\n"'#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#10'"\n"'#10'"Additional initial and custom parameters are also '
  +'available."'#10'msgstr ""'#10'"Lo script '#195#168' un programma Pascal sta'
  ,'ndard: una sezione var facoltativa, seguita da un blocco principale begin .'
  +'.. end.\n"'#10'"\n"'#10'"Esempio:\n"'#10'"  var s: string;\n"'#10'"  begin\'
  +'n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', '
  +'''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\'
  +'n"'#10'"Puoi anche utilizzare le strutture standard di Pascal (if, for, whi'
  +'le, repeat, ecc.). Puoi definire le tue funzioni e procedure prima del bloc'
  +'co principale begin ... end.\n"'#10'"\n"'#10'"Funzioni disponibili:\n"'#10
  +'"  GetParam(''name'') : string\n"'#10'"    Recupera il valore di un paramet'
  +'ro di input.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Memorizza'
  +' un valore di output per l''host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"'
  +'    Timestamp Unix attuale in millisecondi (UTC).\n"'#10'"  GetRandom(Lengt'
  +'h) : Int64\n"'#10'"    Numero intero casuale con esattamente Lenght cifre d'
  +'ecimali.\n"'#10'"  Random : Extended\n"'#10'"    Numero in virgola mobile c'
  +'asuale nell''intervallo [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\'
  +'n"'#10'"    Converte un numero intero in una stringa esadecimale con almeno'
  +' Digits caratteri.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Converte una'
  +' stringa in un numero intero. In caso di input non valido genera un''eccezi'
  +'one.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Converte un numero inte'
  +'ro nella sua rappresentazione come stringa.\n"'#10'"  Trim(S) : string\n"'
  +#10'"    Rimuove da S gli spazi iniziali e finali.\n"'#10'"  TrimLeft(S) : s'
  +'tring\n"'#10'"    Rimuove da S gli spazi iniziali.\n"'#10'"  TrimRight(S) :'
  +' string\n"'#10'"    Rimuove da S gli spazi finali.\n"'#10'"  HtmlEncode(S) '
  +': string\n"'#10'"    Codifica i caratteri HTML speciali presenti in S come '
  +'entit'#195#160'.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decodifica le'
  +' entit'#195#160' HTML presenti in S riportandole ai caratteri originali.\n"'
  +#10'"  UrlEncode(S) : string\n"'#10'"    Codifica S con la codifica percentu'
  +'ale per un''inclusione sicura negli URL.\n"'#10'"  UrlDecode(S) : string\n"'
  +#10'"    Decodifica una stringa S codificata con la codifica percentuale.\n"'
  +#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'
  +#10'"    Sostituisce tutte le occorrenze di OldPattern con NewPattern in S.\'
  +'n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    So'
  +'stituisce tutte le corrispondenze dell''espressione regolare Pattern con Re'
  +'placement in Input. Senza distinzione tra maiuscole e minuscole.\n"'#10'"  '
  +'RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Verifica se Input corrispo'
  +'nde all''espressione regolare Pattern. Senza distinzione tra maiuscole e mi'
  +'nuscole.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10
  +'"    Estrae la sottostringa di S compresa tra StartMarker e EndMarker.\n"'
  +#10'"\n"'#10'"Funzioni JSON (usare un handle restituito da JSONParse):\n"'#10
  +'"  JSONParse(S) : Integer\n"'#10'"    Analizza una stringa JSON e restituis'
  +'ce un handle (>=0). In caso di errore restituisce -1.\n"'#10'"  JSONFree(Ha'
  +'ndle)\n"'#10'"    Rilascia l''handle dopo l''uso.\n"'#10'"  JSONGetString(H'
  +'andle, Path) : string\n"'#10'"    Ottiene un valore stringa dal Path specif'
  +'icato.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Ottiene un '
  +'valore intero dal Path specificato.\n"'#10'"  JSONGetFloat(Handle, Path) : '
  +'Extended\n"'#10'"    Ottiene un valore a virgola mobile dal Path specificat'
  +'o.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Ottiene un val'
  +'ore booleano dal Path specificato.\n"'#10'"  JSONGetArrayCount(Handle, Path'
  +') : Integer\n"'#10'"    Ottiene il numero di elementi di un array dal Path '
  +'specificato.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'
  +#10'"    Ottiene il valore stringa di un elemento dell''array all''Index spe'
  +'cificato.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#10'"'
  +'    Ottiene il valore intero di un elemento dell''array all''Index specific'
  +'ato.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Restituisce i'
  +'l tipo del valore in Path: \"object\", \"array\", \"string\", \"int\", \"fl'
  +'oat\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean'
  +'\n"'#10'"    Verifica se il Path specificato esiste.\n"'#10'"  JSONResultIn'
  +'it\n"'#10'"    Inizializza un array JSON vuoto per creare un risultato di e'
  +'rrore standard.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Repla'
  +'cements)\n"'#10'"    Aggiunge un oggetto errore all''array risultati. Repla'
  +'cements '#195#168' una stringa di valori separati da \"|\".\n"'#10'"  JSONR'
  +'esultGet : string\n"'#10'"    Restituisce l''array dei risultati attuale co'
  +'me stringa JSON.\n"'#10'"  JSONResultClear\n"'#10'"    Cancella l''array ri'
  +'sultati.\n"'#10'"  Chiama sempre JSONFree per rilasciare l''handle dopo ave'
  +'r terminato di usarlo.\n"'#10'"\n"'#10'"Esempio uso JSON:\n"'#10'"  var h: '
  ,'Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h := JSONPars'
  +'e(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10
  +'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetOutput(''text'
  +''', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"'
  +'\n"'#10'"Parametri disponibili (recuperati con GetParam):\n"'#10'"  text - '
  +'il testo in input da elaborare (potrebbe essere troncato a MaxLength)\n"'#10
  +'"  source - codice lingua sorgente (pu'#195#178' essere vuoto)\n"'#10'"  ta'
  +'rget - codice lingua destinazione\n"'#10'"  timestamp - timestamp Unix attu'
  +'ale in millisecondi (stringa)\n"'#10'"  random  - numero casuale di 9 cifre'
  +' (stringa)\n"'#10'"  rand - uguale a random\n"'#10'"  rand1..rand9 - le pri'
  +'me 1..9 cifre del numero casuale\n"'#10'"\n"'#10'"Sono disponibili anche ul'
  +'teriori parametri iniziali e personalizzati.onibili parametri iniziali e pe'
  +'rsonalizzati aggiuntivi."'#10#10'#: formconfig.rscriptresponsehint'#10'msgi'
  +'d ""'#10'"This script processes the response data. All functions and parame'
  +'ters described in the script hint are available here as well.\n"'#10'"Use G'
  +'etParam(''result'') to obtain the received text.\n"'#10'"\n"'#10'"Example:\'
  +'n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'
  +''');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"'
  +'You can define custom parameters in the parameters script using SetParam('''
  +'name'', ''value''),\n"'#10'"and then retrieve them here with GetParam(''nam'
  +'e'')."'#10'msgstr ""'#10'"Questo script elabora i dati della risposta. Tutt'
  +'e le funzioni e i parametri descritti nel suggerimento dello script sono di'
  +'sponibili anche qui.\n"'#10'"Per ottenere il testo ricevuto usa GetParam('''
  +'result'') .\n"'#10'"\n"'#10'"Esempio:\n"'#10'"  var s: string;\n"'#10'"  be'
  +'gin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''result'''
  +', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"'#195#136' possibile definire paramet'
  +'ri personalizzati nello script parametri usando SetParam(''name'', ''value'
  +'''),\n"'#10'"e quindi recuperarli qui con GetParam(''name'')."'#10#10'#: fo'
  +'rmconfig.rvaluetype1'#10'msgctxt "formconfig.rvaluetype1"'#10'msgid "None"'
  +#10'msgstr "Nessuno"'#10#10'#: formconfig.rvaluetype2'#10'msgid "Language"'
  +#10'msgstr "Lingua"'#10#10'#: formconfig.rvaluetype3'#10'msgid "Currency All'
  +'"'#10'msgstr "Tutte le valute"'#10#10'#: formconfig.rvaluetype4'#10'msgid "'
  +'Currency Fiat Only"'#10'msgstr "Solo valuta Fiat"'#10#10'#: formconfig.rval'
  +'uetype5'#10'msgid "Currency Crypto Only"'#10'msgstr "Solo valuta crypto"'#10
  +#10'#: formconfig.rvaluetype6'#10'msgid "Measurement Units"'#10'msgstr "Unit'
  +#195#160' di misura"'#10#10'#: tformconfigtrayslate.aclearicon.caption'#10'm'
  +'sgid "Clear Icon"'#10'msgstr "Cancella icona"'#10#10'#: tformconfigtrayslat'
  +'e.asave.caption'#10'msgid "Save"'#10'msgstr "Salva"'#10#10'#: tformconfigtr'
  +'ayslate.asaveiconas.caption'#10'msgid "Save Icon As..."'#10'msgstr "Salva i'
  +'cona con nome..."'#10#10'#: tformconfigtrayslate.btnclose.caption'#10'msgid'
  +' "Close"'#10'msgstr "Chiudi"'#10#10'#: tformconfigtrayslate.btninitparamete'
  +'rstest.hint'#10'msgid "Execute request and view the parameters"'#10'msgstr '
  +'"Esegui richiesta e visualizza i parametri"'#10#10'#: tformconfigtrayslate.'
  +'btniniturltest.hint'#10'msgid "Execute request and view the result"'#10'msg'
