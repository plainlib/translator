  +#13#10#13#10'#: tformconfigtrayslate.labelcontenttype.caption'#13#10'msgid "'
  +'Content Type"'#13#10'msgstr "Content Type"'#13#10#13#10'#: tformconfigtrays'
  +'late.labelcustomparameters.caption'#13#10'msgctxt "tformconfigtrayslate.lab'
  +'elcustomparameters.caption"'#13#10'msgid "Parameters in the form key=value '
  +'used by {key} in requests. If the value is omitted (key=), it will be reque'
  +'sted from the user."'#13#10'msgstr "Parameter dalam bentuk key=value yang d'
  +'igunakan melalui {key} dalam permintaan. Jika nilainya tidak disertakan (ke'
  +'y=), nilainya akan diminta dari pengguna."'#13#10#13#10'#: tformconfigtrays'
  +'late.labelfilllanguages.caption'#13#10'msgctxt "tformconfigtrayslate.labelf'
  +'illlanguages.caption"'#13#10'msgid "Fill with default"'#13#10'msgstr "Isi d'
  +'engan bawaan"'#13#10#13#10'#: tformconfigtrayslate.labelfilltargetlanguages'
  +'.caption'#13#10'msgctxt "tformconfigtrayslate.labelfilltargetlanguages.capt'
  +'ion"'#13#10'msgid "Fill with default"'#13#10'msgstr "Isi dengan bawaan"'#13
  +#10#13#10'#: tformconfigtrayslate.labelheaders.caption'#13#10'msgid "Additio'
  +'nal request headers in key=value format, key: value is also supported"'#13
  +#10'msgstr "Header permintaan tambahan dalam format key=value, key: value ju'
  +'ga didukung"'#13#10#13#10'#: tformconfigtrayslate.labelinitheaders.caption'
  +#13#10'msgid "Additional initial request headers in key=value format, key: v'
