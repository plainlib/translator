  +#166#224#164#190#224#164#185#224#164#176#224#164#163':\n"'#13#10'"responseDa'
  +'ta/translatedText; matches/*#10/translation; /texts/text; {literal text#10}'
  +'; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /tr'
  +'anslations"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"'
  +'The script is a standard Pascal program: optional var section, then a main '
  +'begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: s'
  +'tring;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10
  +'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''te'
  +'xt'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standar'
  +'d Pascal constructs (if, for, while, repeat, etc.). You can define your own'
  +' functions and procedures before the main begin ... end. block.\n"'#13#10'"'
  +'\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'') : string\n'
  +'"'#13#10'"    Retrieve an input parameter value.\n"'#13#10'"  SetOutput(''n'
  +'ame'', ''value'')\n"'#13#10'"    Store an output value for the host.\n"'#13
  +#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix timestamp in milli'
  +'seconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random'
  +' integer with exactly Length decimal digits.\n"'#13#10'"  Random : Extended'
  +'\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10'"  IntToHex(Val'
  +'ue, Digits) : string\n"'#13#10'"    Convert integer to hexadecimal string w'
  +'ith at least Digits characters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10
  +'"    Convert a string to an integer. Raises an exception on invalid input.\'
  +'n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Convert an integer to '
  +'its string representation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Rem'
  +'ove leading and trailing whitespace from S.\n"'#13#10'"  TrimLeft(S) : stri'
  +'ng\n"'#13#10'"    Remove leading whitespace from S.\n"'#13#10'"  TrimRight('
  +'S) : string\n"'#13#10'"    Remove trailing whitespace from S.\n"'#13#10'"  '
  +'HtmlEncode(S) : string\n"'#13#10'"    Encode special HTML characters in S i'
  +'nto entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTM'
  +'L entities in S back to characters.\n"'#13#10'"  UrlEncode(S) : string\n"'
  +#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13#10'"  UrlDecode('
  +'S) : string\n"'#13#10'"    Decode a percent-encoded string S.\n"'#13#10'"  '
  +'ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13#10
  +'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'#13#10
  +'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    Replac'
  +'e all regex matches of Pattern with Replacement in Input. Case-insensitive.'
  +'\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Check if '
  +'Input matches the regex Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetw'
  +'een(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extract the substrin'
  +'g of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON funct'
  +'ions (use a handle returned by JSONParse):\n"'#13#10'"  JSONParse(S) : Inte'
  +'ger\n"'#13#10'"    Parse a JSON string and return a handle (>=0). Returns -'
  +'1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release the handle'
  +' after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"  '
  +'  Get a string value at the specified Path.\n"'#13#10'"  JSONGetInt(Handle,'
  +' Path) : Integer\n"'#13#10'"    Get an integer value at the specified Path.'
  +'\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Get a fl'
  +'oating-point value at the specified Path.\n"'#13#10'"  JSONGetBool(Handle, '
  +'Path) : Boolean\n"'#13#10'"    Get a boolean value at the specified Path.\n'
  +'"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Get th'
  +'e number of elements in an array at the specified Path.\n"'#13#10'"  JSONGe'
  +'tArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the string va'
  +'lue of an array element at the given Index.\n"'#13#10'"  JSONGetArrayInt(Ha'
  +'ndle, Path, Index) : Integer\n"'#13#10'"    Get the integer value of an arr'
  +'ay element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Path) : str'
  +'ing\n"'#13#10'"    Return the type of the value at Path: \"object\", \"arra'
  +'y\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONP'
  +'athExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the specified Pat'
  +'h exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an empty JS'
  ,'ON array for building a standard error result.\n"'#13#10'"  JSONResultAddEr'
  +'ror(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an error obje'
  +'ct to the result array. Replacements is a string of values separated by \"|'
  +'\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the current r'
  +'esult array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    C'
  +'lear the result array.\n"'#13#10'"  Always call JSONFree to release the han'
  +'dle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working with JSON'
  +':\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  beg'
  +'in\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h'
  +' >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''so'
  +'me.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONF'
  +'ree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Availa'
  +'ble parameters (retrieved with GetParam):\n"'#13#10'"  text - the input tex'
  +'t to process (possibly truncated to MaxLength)\n"'#13#10'"  source - source'
  +' language code (may be empty)\n"'#13#10'"  target - target language code\n"'
  +#13#10'"  timestamp - current Unix timestamp in milliseconds (string)\n"'#13
  +#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand - same as '
