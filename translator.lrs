  +'ormconfigtrayslate.labelparemeters.caption'#13#10'msgid "Use parameters: {t'
  ,'ext} '#226#128#147' input text, {source} '#226#128#147' source language, {t'
  +'arget} '#226#128#147' target language. Prefix the name with ! for lowercase'
