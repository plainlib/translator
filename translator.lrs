  +'ve changes?"'#10'msgstr "'#224#164#149#224#165#137#224#164#168#224#165#141
  +#224#164#171#224#164#188#224#164#191#224#164#151#224#164#176#224#165#135#224
  +#164#182#224#164#168' '#224#164#172#224#164#166#224#164#178' '#224#164#166
