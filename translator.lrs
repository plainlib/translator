  +#164#234#176#156#235#179#128#236#136#152#235#165#188' '#234#176#177#236#139
  +#160#237#149#152#235#138#148' '#236#139#156#234#176#132'('#236#180#136') (0 '
  +'= '#235#170#168#235#147#160' '#236#154#148#236#178#173#235#167#136#235#139
  +#164')"'#10#10'#: tformconfigtrayslate.labelinitparameters2.caption'#10'msgc'
  +'txt "tformconfigtrayslate.labelinitparameters2.caption"'#10'msgid "Paramete'
  +'rs"'#10'msgstr "'#235#167#164#234#176#156#235#179#128#236#136#152'"'#10#10
  +'#: tformconfigtrayslate.labelinitparameters4.caption'#10'msgid "Parameters '
  +'in the form key=value used by {key} in requests. If the value is omitted (k'
  +'ey=), it will be requested from the user."'#10'msgstr "'#236#154#148#236#178
  +#173#236#151#144#236#132#156' {key}'#234#176#128' '#236#130#172#236#154#169
  +#237#149#152#235#138#148' key=value '#237#152#149#236#139#157#236#157#152' '
  +#235#167#164#234#176#156#235#179#128#236#136#152#236#158#133#235#139#136#235
  +#139#164'. '#234#176#146#236#157#180' '#236#131#157#235#158#181#235#144#152
  +#235#169#180'(key=) '#236#130#172#236#154#169#236#158#144#236#151#144#234#178
