  +'ate.btnresponsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnresponsehelp.'
  +'hint"'#10'msgid "Help"'#10'msgstr "Ajuda"'#10#10'#: tformconfigtrayslate.bt'
  +'nresponsetest.hint'#10'msgid "Converts the current response"'#10'msgstr "Co'
  +'nverte a resposta atual"'#10#10'#: tformconfigtrayslate.btnscripthelp.hint'
  +#10'msgctxt "tformconfigtrayslate.btnscripthelp.hint"'#10'msgid "Help"'#10'm'
  +'sgstr "Ajuda"'#10#10'#: tformconfigtrayslate.btnscriptresponsehelp.hint'#10
  +'msgctxt "tformconfigtrayslate.btnscriptresponsehelp.hint"'#10'msgid "Help"'
  ,#10'msgstr "Ajuda"'#10#10'#: tformconfigtrayslate.btnscriptresponsetest.hint'
  +#10'msgctxt "tformconfigtrayslate.btnscriptresponsetest.hint"'#10'msgid "Exe'
