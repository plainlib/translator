  +'msgstr "'#215#162#215#149#215#168#215#154' '#215#170#215#166#215#149#215#168
  +#215#148'"'#10#10'#: formconfig.rclearlanguages'#10'msgid "The list is alrea'
  +'dy filled. Do you want to clear it?"'#10'msgstr "'#215#148#215#168#215#169
  +#215#153#215#158#215#148' '#215#155#215#145#215#168' '#215#158#215#156#215
  +#144#215#148'. '#215#148#215#144#215#157' '#215#156#215#160#215#167#215#149
