  +'e.labelvaluetype.caption'#10'msgid "Value Type"'#10'msgstr "Tipo de valor"'
  +#10#10'#: tformconfigtrayslate.pageinitialrequest.caption'#10'msgctxt "tform'
  +'configtrayslate.pageinitialrequest.caption"'#10'msgid "Initial Request"'#10
  +'msgstr "Pedido inicial"'#10#10'#: tformconfigtrayslate.pagelanguages.captio'
