  +'on"'#13#10'msgstr "Kopiuj konfiguracj'#196#153'"'#13#10#13#10'#: tformconfi'
  +'gtrayslate.sbnewconfig.hint'#13#10'msgid "New configuration"'#13#10'msgstr '
  +'"Nowa konfiguracja"'#13#10#13#10
]);
LazarusResources.Add('formconfig.pt','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: pt\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Editor de configura'#195#167#195#163'o"'#13#10#13#10'#: formconfig.rclear'
  +'languages'#13#10'msgid "The list is already filled. Do you want to clear it'
  +'?"'#13#10'msgstr "A lista j'#195#161' est'#195#161' preenchida. Deseja limp'
  +#195#161'-la?"'#13#10#13#10'#: formconfig.rconfigeditor'#13#10'msgid "Config'
  +' Editor..."'#13#10'msgstr "Editor de configura'#195#167#195#163'o..."'#13#10
  +#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you sure you want to de'
  +'lete config"'#13#10'msgstr "Tem a certeza de que pretende eliminar a config'
  +'ura'#195#167#195#163'o"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13
  +#10'msgid "Delete config"'#13#10'msgstr "Eliminar configura'#195#167#195#163
  +'o"'#13#10#13#10'#: formconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13
  +#10'msgstr "Cancelar"'#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13
  +#10'msgid "Keep my changes"'#13#10'msgstr "Manter minhas altera'#195#167#195
  +#181'es"'#13#10#13#10'#: formconfig.rfilechangedmsg'#13#10'#, object-pascal-'
  +'format'#13#10'msgid "The file \"%s\" has been modified by another applicati'
  +'on since it was opened."'#13#10'msgstr "O arquivo \"%s\" foi modificado por'
  +' outro aplicativo desde que foi aberto."'#13#10#13#10'#: formconfig.rfilech'
  +'angedmsgactivate'#13#10'msgid "You have unsaved changes. Keep them or reloa'
  +'d from disk?"'#13#10'msgstr "Voc'#195#170' tem altera'#195#167#195#181'es n'
  +#195#163'o salvas. Deseja mant'#195#170'-las ou recarregar o arquivo do disc'
  +'o?"'#13#10#13#10'#: formconfig.rfilechangedreloaddisk'#13#10'msgid "Reload '
  +'from disk"'#13#10'msgstr "Recarregar do disco"'#13#10#13#10'#: formconfig.r'
  +'filechangedtitle'#13#10'msgid "File changed on disk"'#13#10'msgstr "Arquivo'
  +' alterado no disco"'#13#10#13#10'#: formconfig.rnamequestion'#13#10'msgid "'
  +'Enter new config file name:"'#13#10'msgstr "Introduza o nome do novo fichei'
  +'ro de configura'#195#167#195#163'o:"'#13#10#13#10'#: formconfig.rneedsave'
  +#13#10'msgid "The configuration was modified. Save changes?"'#13#10'msgstr "'
  +'A configura'#195#167#195#163'o foi modificada. Guardar altera'#195#167#195
  +#181'es?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgid ""'#13#10'"J'
  +'son Pointer: Use / for levels, keys for objects, and numbers for indexes.\n'
  +'"'#13#10'"Use * for all items, *#10 to join items by newline. Use ~ at the '
  +'end of the path to return the raw JSON branch.\n"'#13#10'"Separate multiple'
  +' segments with semicolon ;.\n"'#13#10'"Literal: Text block in {'#226#128#166
  +'}. Special tag #10 for newlines. Use {{regex}} inside to extract data direc'
  +'tly into the text.\n"'#13#10'"Logic: If a Pointer in a segment is empty, th'
  +'e whole segment is skipped. If a segment has no Pointer, only literal text '
  +'blocks with embedded regular expressions are processed.\n"'#13#10'"Regex: {'
  +'prefix {regex[index]} suffix} inside a text block. If no [index] is specifi'
  +'ed, the first match is used.\n"'#13#10'"Index can be a number, [*] (join by'
  +' space), or [*#10] (join by newline). If the regex finds no match, the enti'
  +'re {'#226#128#166'} block is removed.\n"'#13#10'"Using ~ inside a regex ret'
  +'urns the entire text.\n"'#13#10'"Inversion: Start a segment with ! (e.g. !/'
  +'path{Error}) to show its text only if the Pointer data is missing or the JS'
  +'ON is invalid.\n"'#13#10'"Commenting: /* text */ comments are stripped from'
  +' the entire expression before any processing.\n"'#13#10'"Examples:\n"'#13#10
  +'"responseData/translatedText; matches/*#10/translation; /texts/text; {liter'
  +'al text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No dat'
  +'a!#10}; /translations/0/text"'#13#10'msgstr ""'#13#10'"Ponteiro JSON: Use /'
  +' para n'#195#173'veis, chaves para objetos e n'#195#186'meros para '#195#173
  +'ndices. Use * para todos os itens e *#10 para juntar itens por nova linha. '
  +'Use ~ no final do caminho para retornar o ramo JSON bruto. Separe v'#195#161
  +'rios segmentos com ponto e v'#195#173'rgula ;.\n"'#13#10'"Literal: Bloco de'
  +' texto em {'#226#128#166'}. Tag especial #10 para novas linhas. Use {{regex'
  +'}} dentro dele para extrair dados diretamente para o texto.\n"'#13#10'"L'
  +#195#179'gica: Se um ponteiro em um segmento estiver vazio, todo o segmento '
  +'ser'#195#161' ignorado. Se um segmento n'#195#163'o tiver ponteiro, apenas '
  +'blocos de texto literal com express'#195#181'es regulares incorporadas ser'
  +#195#163'o processados.\n"'#13#10'"Regex: {prefixo {regex[index]} sufixo} de'
  ,'ntro de um bloco de texto. Se [index] n'#195#163'o for especificado, a prim'
  +'eira correspond'#195#170'ncia ser'#195#161' usada. O '#195#173'ndice pode s'
  +'er um n'#195#186'mero, [*] (juntar por espa'#195#167'o) ou [*#10] (juntar p'
  +'or nova linha). Se a express'#195#163'o regular n'#195#163'o encontrar nenh'
  +'uma correspond'#195#170'ncia, todo o bloco {'#226#128#166'} ser'#195#161' r'
  +'emovido. O uso de ~ dentro de uma express'#195#163'o regular retorna todo o'
  +' texto.\n"'#13#10'"Invers'#195#163'o: Inicie um segmento com ! (por exemplo'
  +', !/path{Error}) para exibir seu texto somente se os dados do ponteiro esti'
  +'verem ausentes ou se o JSON for inv'#195#161'lido.\n"'#13#10'"Coment'#195
  +#161'rios: Coment'#195#161'rios /* texto */ s'#195#163'o removidos de toda a'
  +' express'#195#163'o antes de qualquer processamento.\n"'#13#10'"Exemplos:\n'
  +'"'#13#10'"responseData/translatedText; matches/*#10/translation; /texts/tex'
  +'t; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Erro'
  +'r: No data!#10}; /translations"'#13#10#13#10'#: formconfig.rscripthint'#13
  +#10'msgid ""'#13#10'"The script is a standard Pascal program: optional var s'
  +'ection, then a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n'
  +'"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam('
  +'''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10
  +'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You c'
  +'an also use standard Pascal constructs (if, for, while, repeat, etc.). You '
  +'can define your own functions and procedures before the main begin ... end.'
  +' block.\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam('
  +'''name'') : string\n"'#13#10'"    Retrieve an input parameter value.\n"'#13
  +#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"    Store an output value f'
  +'or the host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Uni'
  +'x timestamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n'
  +'"'#13#10'"    Random integer with exactly Length decimal digits.\n"'#13#10
  +'"  Random : Extended\n"'#13#10'"    Random float in the range [0, 1).\n"'#13
  +#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"    Convert integer to he'
  +'xadecimal string with at least Digits characters.\n"'#13#10'"  StrToInt(S) '
  +': Integer\n"'#13#10'"    Convert a string to an integer. Raises an exceptio'
  +'n on invalid input.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Co'
  +'nvert an integer to its string representation.\n"'#13#10'"  Trim(S) : strin'
  +'g\n"'#13#10'"    Remove leading and trailing whitespace from S.\n"'#13#10'"'
  +'  TrimLeft(S) : string\n"'#13#10'"    Remove leading whitespace from S.\n"'
  +#13#10'"  TrimRight(S) : string\n"'#13#10'"    Remove trailing whitespace fr'
  +'om S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Encode special HTM'
  +'L characters in S into entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13
  +#10'"    Decode HTML entities in S back to characters.\n"'#13#10'"  UrlEncod'
  +'e(S) : string\n"'#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13
  +#10'"  UrlDecode(S) : string\n"'#13#10'"    Decode a percent-encoded string '
  +'S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : s'
  +'tring\n"'#13#10'"    Replace all occurrences of OldPattern with NewPattern '
  +'in S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13
  +#10'"    Replace all regex matches of Pattern with Replacement in Input. Cas'
  +'e-insensitive.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10
  +'"    Check if Input matches the regex Pattern. Case-insensitive.\n"'#13#10
  +'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extrac'
  +'t the substring of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13
  +#10'"JSON functions (use a handle returned by JSONParse):\n"'#13#10'"  JSONP'
  +'arse(S) : Integer\n"'#13#10'"    Parse a JSON string and return a handle (>'
  +'=0). Returns -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Rele'
  +'ase the handle after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string'
  +'\n"'#13#10'"    Get a string value at the specified Path.\n"'#13#10'"  JSON'
  +'GetInt(Handle, Path) : Integer\n"'#13#10'"    Get an integer value at the s'
  +'pecified Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10
  +'"    Get a floating-point value at the specified Path.\n"'#13#10'"  JSONGet'
  +'Bool(Handle, Path) : Boolean\n"'#13#10'"    Get a boolean value at the spec'
  +'ified Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10
  +'"    Get the number of elements in an array at the specified Path.\n"'#13#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#13#10'"  JSONGetAr'
  +'rayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Get the integer value '
  +'of an array element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Pa'
  ,'th) : string\n"'#13#10'"    Return the type of the value at Path: \"object\'
  +'", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10
  +'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the speci'
  +'fied Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an '
  +'empty JSON array for building a standard error result.\n"'#13#10'"  JSONRes'
  +'ultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an er'
  +'ror object to the result array. Replacements is a string of values separate'
  +'d by \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the c'
  +'urrent result array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10
  +'"    Clear the result array.\n"'#13#10'"  Always call JSONFree to release t'
  +'he handle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working wit'
  +'h JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10
  +'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"  '
  +'  if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h'
  +', ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"     '
  +' JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'Available parameters (retrieved with GetParam):\n"'#13#10'"  text - the inp'
  +'ut text to process (possibly truncated to MaxLength)\n"'#13#10'"  source - '
  +'source language code (may be empty)\n"'#13#10'"  target - target language c'
  +'ode\n"'#13#10'"  timestamp - current Unix timestamp in milliseconds (string'
  +')\n"'#13#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand -'
  +' same as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are'
  +' also available."'#13#10'msgstr ""'#13#10'"O script '#195#169' um programa '
  +'Pascal padr'#195#163'o: uma se'#195#167#195#163'o var opcional, seguida de '
  +'um bloco principal begin ... end.\n"'#13#10'"\n"'#13#10'"Exemplo:\n"'#13#10
  +'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'')'
  +';\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    Se'
  +'tOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Voc'#195#170
  +' tamb'#195#169'm pode usar constru'#195#167#195#181'es padr'#195#163'o do P'
  +'ascal (if, for, while, repeat etc.). Voc'#195#170' pode definir suas pr'#195
  +#179'prias fun'#195#167#195#181'es e procedimentos antes do bloco principal '
  +'begin ... end.\n"'#13#10'"\n"'#13#10'"Fun'#195#167#195#181'es dispon'#195
  +#173'veis:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Recupera '
  +'o valor de um par'#195#162'metro de entrada.\n"'#13#10'"  SetOutput(''name'
  +''', ''value'')\n"'#13#10'"    Armazena um valor de sa'#195#173'da para o ho'
  +'st.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Timestamp Unix atual'
  +' em milissegundos (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"'
  +'    N'#195#186'mero inteiro aleat'#195#179'rio com exatamente Length d'#195
  +#173'gitos decimais.\n"'#13#10'"  Random : Extended\n"'#13#10'"    N'#195#186
  +'mero de ponto flutuante aleat'#195#179'rio no intervalo [0, 1).\n"'#13#10'"'
  +'  IntToHex(Value, Digits) : string\n"'#13#10'"    Converte um n'#195#186'me'
  +'ro inteiro em uma string hexadecimal com pelo menos Digits caracteres.\n"'
  +#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Converte uma string em um n'
  +#195#186'mero inteiro. Gera uma exce'#195#167#195#163'o em caso de entrada i'
  +'nv'#195#161'lida.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Conv'
  +'erte um n'#195#186'mero inteiro em sua representa'#195#167#195#163'o como s'
  +'tring.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove espa'#195#167'os'
  +' em branco do in'#195#173'cio e do fim de S.\n"'#13#10'"  TrimLeft(S) : str'
  +'ing\n"'#13#10'"    Remove espa'#195#167'os em branco do in'#195#173'cio de '
  +'S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Remove espa'#195#167'o'
  +'s em branco do fim de S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"   '
  +' Codifica caracteres HTML especiais em S como entidades.\n"'#13#10'"  HtmlD'
  +'ecode(S) : string\n"'#13#10'"    Decodifica entidades HTML em S de volta pa'
  +'ra caracteres.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Codifica S'
  +' usando codifica'#195#167#195#163'o percentual para inclus'#195#163'o segur'
  +'a em uma URL.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Decodifica '
  +'uma string S codificada com codifica'#195#167#195#163'o percentual.\n"'#13
  +#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'
  +#13#10'"    Substitui todas as ocorr'#195#170'ncias de OldPattern por NewPat'
  +'tern em S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\'
  +'n"'#13#10'"    Substitui todas as correspond'#195#170'ncias da express'#195
  +#163'o regular Pattern por Replacement em Input. N'#195#163'o diferencia mai'
  +#195#186'sculas de min'#195#186'sculas.\n"'#13#10'"  RegexMatch(Input, Patte'
  ,'rn) : Boolean\n"'#13#10'"    Verifica se Input corresponde '#195#160' expre'
  +'ss'#195#163'o regular Pattern. N'#195#163'o diferencia mai'#195#186'sculas '
  +'de min'#195#186'sculas.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMark'
  +'er) : string\n"'#13#10'"    Extrai a substring de S entre StartMarker e End'
  +'Marker.\n"'#13#10'"\n"'#13#10'"Fun'#195#167#195#181'es JSON (use um handle '
  +'retornado por JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"  '
  +'  Analisa uma string JSON e retorna um handle (>=0). Retorna -1 em caso de '
  +'erro.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Libera o handle ap'#195
  +#179's o uso.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'" '
  +'   Obt'#195#169'm um valor de string no Path especificado.\n"'#13#10'"  JSO'
  +'NGetInt(Handle, Path) : Integer\n"'#13#10'"    Obt'#195#169'm um valor inte'
  +'iro no Path especificado.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extende'
  +'d\n"'#13#10'"    Obt'#195#169'm um valor de ponto flutuante no Path especif'
  +'icado.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Obt'
  +#195#169'm um valor booleano no Path especificado.\n"'#13#10'"  JSONGetArray'
  +'Count(Handle, Path) : Integer\n"'#13#10'"    Obt'#195#169'm o n'#195#186'me'
  +'ro de elementos de um array no Path especificado.\n"'#13#10'"  JSONGetArray'
  +'String(Handle, Path, Index) : string\n"'#13#10'"    Obt'#195#169'm o valor '
  +'de string de um elemento do array no Index especificado.\n"'#13#10'"  JSONG'
  +'etArrayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Obt'#195#169'm o v'
  +'alor inteiro de um elemento do array no Index especificado.\n"'#13#10'"  JS'
  +'ONGetType(Handle, Path) : string\n"'#13#10'"    Retorna o tipo do valor em '
  +'Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"nu'
  +'ll\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Ve'
  +'rifica se o Path especificado existe.\n"'#13#10'"  JSONResultInit\n"'#13#10
  +'"    Inicializa um array JSON vazio para criar um resultado de erro padr'
  +#195#163'o.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replace'
  +'ments)\n"'#13#10'"    Adiciona um objeto de erro ao array de resultados. Re'
  +'placements '#195#169' uma string de valores separados por \"|\".\n"'#13#10
  +'"  JSONResultGet : string\n"'#13#10'"    Retorna o array de resultados atua'
  +'l como uma string JSON.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Limpa o'
  +' array de resultados.\n"'#13#10'"  Sempre chame JSONFree para liberar o han'
  +'dle depois de terminar de us'#195#161'-lo.\n"'#13#10'"\n"'#13#10'"Exemplo d'
  +'e uso de JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'
  +#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13
  +#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetSt'
  +'ring(h, ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10
  +'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13
  +#10'"Par'#195#162'metros dispon'#195#173'veis (obtidos com GetParam):\n"'#13
  +#10'"  text - o texto de entrada a ser processado (possivelmente truncado pa'
  +'ra MaxLength)\n"'#13#10'"  source - c'#195#179'digo do idioma de origem (po'
  +'de estar vazio)\n"'#13#10'"  target - c'#195#179'digo do idioma de destino\'
  +'n"'#13#10'"  timestamp - timestamp Unix atual em milissegundos (string)\n"'
  +#13#10'"  random  - n'#195#186'mero aleat'#195#179'rio de 9 d'#195#173'gitos'
  +' (string)\n"'#13#10'"  rand - igual a random\n"'#13#10'"  rand1..rand9 - os'
  +' primeiros 1..9 d'#195#173'gitos do n'#195#186'mero aleat'#195#179'rio\n"'
  +#13#10'"\n"'#13#10'"Par'#195#162'metros iniciais e personalizados adicionais'
  +' tamb'#195#169'm est'#195#163'o dispon'#195#173'veis."'#13#10#13#10'#: form'
  +'config.rscriptresponsehint'#13#10'msgid ""'#13#10'"This script processes th'
  +'e response data. All functions and parameters described in the script hint '
  +'are available here as well.\n"'#13#10'"Use GetParam(''result'') to obtain t'
  +'he received text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: strin'
  +'g;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"'
  +'    SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You '
  +'can define custom parameters in the parameters script using SetParam(''name'
  +''', ''value''),\n"'#13#10'"and then retrieve them here with GetParam(''name'
  +''')."'#13#10'msgstr ""'#13#10'"Este script processa os dados da resposta. T'
  +'odas as fun'#195#167#195#181'es e par'#195#162'metros descritos na dica do '
  +'script tamb'#195#169'm est'#195#163'o dispon'#195#173'veis aqui.\n"'#13#10
  +'"Use GetParam(''result'') para obter o texto recebido.\n"'#13#10'"\n"'#13#10
  +'"Exemplo:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s :'
  +'= GetParam(''result'');\n"'#13#10'"    SetOutput(''result'', s);\n"'#13#10
  +'"  end.\n"'#13#10'"\n"'#13#10'"Voc'#195#170' pode definir par'#195#162'metr'
  +'os personalizados no script de par'#195#162'metros usando SetParam(''name'''
  ,', ''value''),\n"'#13#10'"e depois recuper'#195#161'-los aqui com GetParam('
  +'''name'')."'#13#10#13#10'#: formconfig.rvaluetype1'#13#10'msgctxt "formconf'
  +'ig.rvaluetype1"'#13#10'msgid "None"'#13#10'msgstr "Nenhum"'#13#10#13#10'#: '
  +'formconfig.rvaluetype2'#13#10'msgid "Language"'#13#10'msgstr "Idioma"'#13#10
  +#13#10'#: formconfig.rvaluetype3'#13#10'msgid "Currency All"'#13#10'msgstr "'
  +'Todas as moedas"'#13#10#13#10'#: formconfig.rvaluetype4'#13#10'msgid "Curre'
