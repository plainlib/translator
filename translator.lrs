LazarusResources.Add('formconfig.fr','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: fr\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "'#195#137'diteur de configuration"'#13#10#13#10'#: formconfig.rclearlangu'
  +'ages'#13#10'msgid "The list is already filled. Do you want to clear it?"'#13
  +#10'msgstr "La liste est d'#195#169'j'#195#160' remplie. Voulez-vous l''effa'
  +'cer ?"'#13#10#13#10'#: formconfig.rconfigeditor'#13#10'msgid "Config Editor'
  +'..."'#13#10'msgstr "'#195#137'diteur de configuration..."'#13#10#13#10'#: f'
  +'ormconfig.rdeleteconfig'#13#10'msgid "Are you sure you want to delete confi'
  +'g"'#13#10'msgstr "'#195#138'tes-vous s'#195#187'r de vouloir supprimer la c'
  +'onfiguration"'#13#10#13#10'#: formconfig.rdeleteconfigcaption'#13#10'msgid '
  +'"Delete config"'#13#10'msgstr "Supprimer la configuration"'#13#10#13#10'#: '
  +'formconfig.rfilechangedcancel'#13#10'msgid "Cancel"'#13#10'msgstr "Annuler"'
  +#13#10#13#10'#: formconfig.rfilechangedkeepchanges'#13#10'msgid "Keep my cha'
  +'nges"'#13#10'msgstr "Conserver mes modifications"'#13#10#13#10'#: formconfi'
  +'g.rfilechangedmsg'#13#10'#, object-pascal-format'#13#10'msgid "The file \"%'
  +'s\" has been modified by another application since it was opened."'#13#10'm'
  +'sgstr "Le fichier \"%s\" a '#195#169't'#195#169' modifi'#195#169' par une a'
  +'utre application depuis son ouverture."'#13#10#13#10'#: formconfig.rfilecha'
  +'ngedmsgactivate'#13#10'msgid "You have unsaved changes. Keep them or reload'
  +' from disk?"'#13#10'msgstr "Vous avez des modifications non enregistr'#195
  +#169'es. Voulez-vous les conserver ou recharger le fichier depuis le disque '
  +'?"'#13#10#13#10'#: formconfig.rfilechangedreloaddisk'#13#10'msgid "Reload f'
  +'rom disk"'#13#10'msgstr "Recharger depuis le disque"'#13#10#13#10'#: formco'
  +'nfig.rfilechangedtitle'#13#10'msgid "File changed on disk"'#13#10'msgstr "F'
  +'ichier modifi'#195#169' sur le disque"'#13#10#13#10'#: formconfig.rnameques'
  +'tion'#13#10'msgid "Enter new config file name:"'#13#10'msgstr "Entrez le no'
  +'m du nouveau fichier de configuration :"'#13#10#13#10'#: formconfig.rneedsa'
  +'ve'#13#10'msgid "The configuration was modified. Save changes?"'#13#10'msgs'
  +'tr "La configuration a '#195#169't'#195#169' modifi'#195#169'e. Enregistrer'
  +' les modifications ?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgid'
  +' ""'#13#10'"Json Pointer: Use / for levels, keys for objects, and numbers f'
  +'or indexes.\n"'#13#10'"Use * for all items, *#10 to join items by newline. '
  +'Use ~ at the end of the path to return the raw JSON branch.\n"'#13#10'"Sepa'
  +'rate multiple segments with semicolon ;.\n"'#13#10'"Literal: Text block in '
  +'{'#226#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to ext'
  +'ract data directly into the text.\n"'#13#10'"Logic: If a Pointer in a segme'
  +'nt is empty, the whole segment is skipped. If a segment has no Pointer, onl'
  +'y literal text blocks with embedded regular expressions are processed.\n"'
  +#13#10'"Regex: {prefix {regex[index]} suffix} inside a text block. If no [in'
  +'dex] is specified, the first match is used.\n"'#13#10'"Index can be a numbe'
  +'r, [*] (join by space), or [*#10] (join by newline). If the regex finds no '
  +'match, the entire {'#226#128#166'} block is removed.\n"'#13#10'"Using ~ ins'
  +'ide a regex returns the entire text.\n"'#13#10'"Inversion: Start a segment '
  +'with ! (e.g. !/path{Error}) to show its text only if the Pointer data is mi'
  +'ssing or the JSON is invalid.\n"'#13#10'"Commenting: /* text */ comments ar'
  +'e stripped from the entire expression before any processing.\n"'#13#10'"Exa'
  +'mples:\n"'#13#10'"responseData/translatedText; matches/*#10/translation; /t'
  +'exts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translati'
  +'ons{Error: No data!#10}; /translations/0/text"'#13#10'msgstr ""'#13#10'"Poi'
  +'nteur JSON : utilisez / pour les niveaux, les cl'#195#169's pour les objets'
  +' et les nombres pour les index. Utilisez * pour tous les '#195#169'l'#195
  +#169'ments et *#10 pour les joindre avec un saut de ligne. Utilisez ~ '#195
  +#160' la fin du chemin pour renvoyer la branche JSON brute. S'#195#169'parez'
  +' plusieurs segments par un point-virgule ;.\n"'#13#10'"Litt'#195#169'ral : '
  +'bloc de texte entre {'#226#128#166'}. Balise sp'#195#169'ciale #10 pour les'
  +' sauts de ligne. Utilisez {{regex}} '#195#160' l''int'#195#169'rieur pour e'
  +'xtraire directement les donn'#195#169'es dans le texte.\n"'#13#10'"Logique '
  +': si un pointeur dans un segment est vide, tout le segment est ignor'#195
  +#169'. Si un segment ne contient aucun pointeur, seuls les blocs de texte li'
  ,'tt'#195#169'ral avec des expressions r'#195#169'guli'#195#168'res int'#195
  +#169'gr'#195#169'es sont trait'#195#169's.\n"'#13#10'"Regex : {pr'#195#169'f'
  +'ixe {regex[index]} suffixe} '#195#160' l''int'#195#169'rieur d''un bloc de '
  +'texte. Si [index] n''est pas sp'#195#169'cifi'#195#169', la premi'#195#168
  +'re correspondance est utilis'#195#169'e. L''index peut '#195#170'tre un nom'
  +'bre, [*] (joindre avec un espace) ou [*#10] (joindre avec un saut de ligne)'
  +'. Si l''expression r'#195#169'guli'#195#168're ne trouve aucune corresponda'
  +'nce, tout le bloc {'#226#128#166'} est supprim'#195#169'. L''utilisation de'
  +' ~ dans une expression r'#195#169'guli'#195#168're renvoie le texte complet'
  +'.\n"'#13#10'"Inversion : commencez un segment par ! (par exemple !/path{Err'
  +'or}) pour afficher son texte uniquement si les donn'#195#169'es du pointeur'
  +' sont absentes ou si le JSON est invalide.\n"'#13#10'"Commentaires : les co'
  +'mmentaires /* texte */ sont supprim'#195#169's de l''expression enti'#195
  +#168're avant tout traitement.\n"'#13#10'"Exemples :\n"'#13#10'"responseData'
  +'/translatedText; matches/*#10/translation; /texts/text; {literal text#10}; '
  +'/result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /tran'
  +'slations"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"Th'
  +'e script is a standard Pascal program: optional var section, then a main be'
  +'gin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: str'
  +'ing;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"'
  +'    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''tex'
  +'t'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standard'
  +' Pascal constructs (if, for, while, repeat, etc.). You can define your own '
  +'functions and procedures before the main begin ... end. block.\n"'#13#10'"\'
  +'n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''name'') : string\n"'
  +#13#10'"    Retrieve an input parameter value.\n"'#13#10'"  SetOutput(''name'
  +''', ''value'')\n"'#13#10'"    Store an output value for the host.\n"'#13#10
  +'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix timestamp in millisec'
  +'onds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random in'
  +'teger with exactly Length decimal digits.\n"'#13#10'"  Random : Extended\n"'
  +#13#10'"    Random float in the range [0, 1).\n"'#13#10'"  IntToHex(Value, D'
  +'igits) : string\n"'#13#10'"    Convert integer to hexadecimal string with a'
  +'t least Digits characters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"  '
  +'  Convert a string to an integer. Raises an exception on invalid input.\n"'
  +#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Convert an integer to its '
  +'string representation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove '
  +'leading and trailing whitespace from S.\n"'#13#10'"  TrimLeft(S) : string\n'
  +'"'#13#10'"    Remove leading whitespace from S.\n"'#13#10'"  TrimRight(S) :'
  +' string\n"'#13#10'"    Remove trailing whitespace from S.\n"'#13#10'"  Html'
  +'Encode(S) : string\n"'#13#10'"    Encode special HTML characters in S into '
  +'entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTML en'
  +'tities in S back to characters.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10
  +'"    Percent-encode S for safe URL inclusion.\n"'#13#10'"  UrlDecode(S) : s'
  +'tring\n"'#13#10'"    Decode a percent-encoded string S.\n"'#13#10'"  Replac'
  +'eAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#13#10'"    R'
  +'eplace all occurrences of OldPattern with NewPattern in S.\n"'#13#10'"  Reg'
  +'exReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    Replace all '
  +'regex matches of Pattern with Replacement in Input. Case-insensitive.\n"'#13
  +#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Check if Input ma'
  +'tches the regex Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetween(S, S'
  +'tartMarker, EndMarker) : string\n"'#13#10'"    Extract the substring of S b'
  +'etween StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (us'
  +'e a handle returned by JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'
  +#13#10'"    Parse a JSON string and return a handle (>=0). Returns -1 on err'
  +'or.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release the handle after u'
  +'se.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"    Get a '
  +'string value at the specified Path.\n"'#13#10'"  JSONGetInt(Handle, Path) :'
  +' Integer\n"'#13#10'"    Get an integer value at the specified Path.\n"'#13
  +#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Get a floating-p'
  +'oint value at the specified Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : '
  +'Boolean\n"'#13#10'"    Get a boolean value at the specified Path.\n"'#13#10
  +'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Get the number '
  +'of elements in an array at the specified Path.\n"'#13#10'"  JSONGetArrayStr'
  +'ing(Handle, Path, Index) : string\n"'#13#10'"    Get the string value of an'
  ,' array element at the given Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Pat'
  +'h, Index) : Integer\n"'#13#10'"    Get the integer value of an array elemen'
  +'t at the given Index.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13
  +#10'"    Return the type of the value at Path: \"object\", \"array\", \"stri'
  +'ng\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(H'
  +'andle, Path) : Boolean\n"'#13#10'"    Check if the specified Path exists.\n'
  +'"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an empty JSON array fo'
  +'r building a standard error result.\n"'#13#10'"  JSONResultAddError(Offset,'
  +' Length, Message, Replacements)\n"'#13#10'"    Add an error object to the r'
  +'esult array. Replacements is a string of values separated by \"|\".\n"'#13
  +#10'"  JSONResultGet : string\n"'#13#10'"    Return the current result array'
  +' as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Clear the re'
  +'sult array.\n"'#13#10'"  Always call JSONFree to release the handle after y'
  +'ou are done.\n"'#13#10'"\n"'#13#10'"Example of working with JSON:\n"'#13#10
  +'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10
  +'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'
  +#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'
  +#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10
  +'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Available parameters (re'
  +'trieved with GetParam):\n"'#13#10'"  text - the input text to process (poss'
  +'ibly truncated to MaxLength)\n"'#13#10'"  source - source language code (ma'
  +'y be empty)\n"'#13#10'"  target - target language code\n"'#13#10'"  timesta'
  +'mp - current Unix timestamp in milliseconds (string)\n"'#13#10'"  random  -'
  +' 9-digit random number (string)\n"'#13#10'"  rand - same as random\n"'#13#10
  +'"  rand1..rand9 - first 1..9 digits of the random number\n"'#13#10'"\n"'#13
  +#10'"Additional initial and custom parameters are also available."'#13#10'ms'
  +'gstr ""'#13#10'"Le script est un programme Pascal standard : une section va'
  +'r facultative, puis un bloc principal begin ... end.\n"'#13#10'"\n"'#13#10
  +'"Exemple :\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s '
  +':= GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', Fals'
  +'e);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'
  +#13#10'"Vous pouvez '#195#169'galement utiliser les constructions Pascal sta'
  +'ndard (if, for, while, repeat, etc.). Vous pouvez d'#195#169'finir vos prop'
  +'res fonctions et proc'#195#169'dures avant le bloc principal begin ... end.'
  +'\n"'#13#10'"\n"'#13#10'"Fonctions disponibles :\n"'#13#10'"  GetParam(''nam'
  +'e'') : string\n"'#13#10'"    R'#195#169'cup'#195#168're la valeur d''un par'
  +'am'#195#168'tre d''entr'#195#169'e.\n"'#13#10'"  SetOutput(''name'', ''valu'
  +'e'')\n"'#13#10'"    Stocke une valeur de sortie pour l''h'#195#180'te.\n"'
  +#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Horodatage Unix actuel en mi'
  +'llisecondes (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10'"    En'
  +'tier al'#195#169'atoire comportant exactement Length chiffres d'#195#169'ci'
  +'maux.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Nombre '#195#160' virgu'
  +'le flottante al'#195#169'atoire dans l''intervalle [0, 1).\n"'#13#10'"  Int'
  +'ToHex(Value, Digits) : string\n"'#13#10'"    Convertit un entier en cha'#195
  +#174'ne hexad'#195#169'cimale comportant au moins Digits caract'#195#168'res'
  +'.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convertit une cha'#195
  +#174'ne en entier. G'#195#169'n'#195#168're une exception si l''entr'#195#169
  +'e n''est pas valide.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    C'
  +'onvertit un entier en sa repr'#195#169'sentation sous forme de cha'#195#174
  +'ne.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Supprime les espaces au d'
  +#195#169'but et '#195#160' la fin de S.\n"'#13#10'"  TrimLeft(S) : string\n"'
  +#13#10'"    Supprime les espaces au d'#195#169'but de S.\n"'#13#10'"  TrimRi'
  +'ght(S) : string\n"'#13#10'"    Supprime les espaces '#195#160' la fin de S.'
  +'\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Encode les caract'#195
  +#168'res HTML sp'#195#169'ciaux de S sous forme d''entit'#195#169's.\n"'#13
  +#10'"  HtmlDecode(S) : string\n"'#13#10'"    D'#195#169'code les entit'#195
  +#169's HTML de S en caract'#195#168'res.\n"'#13#10'"  UrlEncode(S) : string\'
  +'n"'#13#10'"    Encode S avec un encodage en pourcentage pour une inclusion '
  +'s'#195#187're dans une URL.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'" '
  +'   D'#195#169'code une cha'#195#174'ne S encod'#195#169'e en pourcentage.\n'
  +'"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : strin'
  +'g\n"'#13#10'"    Remplace toutes les occurrences de OldPattern par NewPatte'
  +'rn dans S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\'
  +'n"'#13#10'"    Remplace toutes les correspondances de l''expression r'#195
  ,#169'guli'#195#168're Pattern par Replacement dans Input. Insensible '#195
  +#160' la casse.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10
  +'"    V'#195#169'rifie si Input correspond '#195#160' l''expression r'#195
  +#169'guli'#195#168're Pattern. Insensible '#195#160' la casse.\n"'#13#10'"  '
  +'ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extrait l'
  +'a sous-cha'#195#174'ne de S situ'#195#169'e entre StartMarker et EndMarker.'
  +'\n"'#13#10'"\n"'#13#10'"Fonctions JSON (utilisez un handle renvoy'#195#169
  +' par JSONParse) :\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Analys'
  +'e une cha'#195#174'ne JSON et renvoie un handle (>=0). Renvoie -1 en cas d'
  +'''erreur.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Lib'#195#168're le h'
  +'andle apr'#195#168's utilisation.\n"'#13#10'"  JSONGetString(Handle, Path) '
  +': string\n"'#13#10'"    Obtient une valeur cha'#195#174'ne au chemin sp'#195
  +#169'cifi'#195#169' Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'
  +#13#10'"    Obtient une valeur enti'#195#168're au chemin sp'#195#169'cifi'
  +#195#169' Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10
  +'"    Obtient une valeur '#195#160' virgule flottante au chemin sp'#195#169
  +'cifi'#195#169' Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13
  +#10'"    Obtient une valeur bool'#195#169'enne au chemin sp'#195#169'cifi'
  +#195#169' Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13
  +#10'"    Obtient le nombre d'''#195#169'l'#195#169'ments d''un tableau au ch'
  +'emin sp'#195#169'cifi'#195#169' Path.\n"'#13#10'"  JSONGetArrayString(Handl'
  +'e, Path, Index) : string\n"'#13#10'"    Obtient la valeur cha'#195#174'ne d'
  +'''un '#195#169'l'#195#169'ment du tableau '#195#160' l''index sp'#195#169'c'
  +'ifi'#195#169' Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : In'
  +'teger\n"'#13#10'"    Obtient la valeur enti'#195#168're d''un '#195#169'l'
  +#195#169'ment du tableau '#195#160' l''index sp'#195#169'cifi'#195#169' Inde'
  +'x.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Renvoie l'
  +'e type de la valeur '#195#160' Path : \"object\", \"array\", \"string\", \"'
  +'int\", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, P'
  +'ath) : Boolean\n"'#13#10'"    V'#195#169'rifie si le chemin sp'#195#169'cif'
  +'i'#195#169' Path existe.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initial'
  +'ise un tableau JSON vide pour cr'#195#169'er un r'#195#169'sultat d''erreur'
  +' standard.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replace'
  +'ments)\n"'#13#10'"    Ajoute un objet d''erreur au tableau de r'#195#169'su'
  +'ltats. Replacements est une cha'#195#174'ne de valeurs s'#195#169'par'#195
  +#169'es par \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Renvoi'
  +'e le tableau de r'#195#169'sultats actuel sous forme de cha'#195#174'ne JSO'
  +'N.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Efface le tableau de r'#195
  +#169'sultats.\n"'#13#10'"  Appelez toujours JSONFree pour lib'#195#169'rer l'
  +'e handle lorsque vous avez termin'#195#169'.\n"'#13#10'"\n"'#13#10'"Exemple'
  +' d''utilisation de JSON :\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: '
  +'string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result'
  +'''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s'
  +' := JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''text'', s'
  +');\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'
  +#13#10'"\n"'#13#10'"Param'#195#168'tres disponibles (r'#195#169'cup'#195#169
  +'r'#195#169's avec GetParam) :\n"'#13#10'"  text - le texte d''entr'#195#169
  +'e '#195#160' traiter ('#195#169'ventuellement tronqu'#195#169' '#195#160' M'
  +'axLength)\n"'#13#10'"  source - code de la langue source (peut '#195#170'tr'
  +'e vide)\n"'#13#10'"  target - code de la langue cible\n"'#13#10'"  timestam'
  +'p - horodatage Unix actuel en millisecondes (cha'#195#174'ne)\n"'#13#10'"  '
  +'random  - nombre al'#195#169'atoire '#195#160' 9 chiffres (cha'#195#174'ne)'
  +'\n"'#13#10'"  rand - identique '#195#160' random\n"'#13#10'"  rand1..rand9 '
  +'- les 1 '#195#160' 9 premiers chiffres du nombre al'#195#169'atoire\n"'#13
  +#10'"\n"'#13#10'"Des param'#195#168'tres initiaux et personnalis'#195#169's '
  +'suppl'#195#169'mentaires sont '#195#169'galement disponibles."'#13#10#13#10
  +'#: formconfig.rscriptresponsehint'#13#10'msgid ""'#13#10'"This script proce'
  +'sses the response data. All functions and parameters described in the scrip'
  +'t hint are available here as well.\n"'#13#10'"Use GetParam(''result'') to o'
  +'btain the received text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s'
  +': string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'
  +#13#10'"    SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10
  +'"You can define custom parameters in the parameters script using SetParam('
  +'''name'', ''value''),\n"'#13#10'"and then retrieve them here with GetParam('
  ,'''name'')."'#13#10'msgstr ""'#13#10'"Ce script traite les donn'#195#169'es '
  +'de r'#195#169'ponse. Toutes les fonctions et tous les param'#195#168'tres d'
  +#195#169'crits dans l''aide du script sont '#195#169'galement disponibles ic'
  +'i.\n"'#13#10'"Utilisez GetParam(''result'') pour obtenir le texte re'#195
  +#167'u.\n"'#13#10'"\n"'#13#10'"Exemple :\n"'#13#10'"  var s: string;\n"'#13
  +#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOut'
  +'put(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Vous pouvez d'
  +#195#169'finir des param'#195#168'tres personnalis'#195#169's dans le script'
  +' des param'#195#168'tres '#195#160' l''aide de SetParam(''name'', ''value'''
  +'),\n"'#13#10'"puis les r'#195#169'cup'#195#169'rer ici avec GetParam(''name'
  +''')."'#13#10#13#10'#: formconfig.rvaluetype1'#13#10'msgctxt "formconfig.rva'
  +'luetype1"'#13#10'msgid "None"'#13#10'msgstr "Aucun"'#13#10#13#10'#: formcon'
  +'fig.rvaluetype2'#13#10'msgid "Language"'#13#10'msgstr "Langue"'#13#10#13#10
  +'#: formconfig.rvaluetype3'#13#10'msgid "Currency All"'#13#10'msgstr "Toutes'
  +' les devises"'#13#10#13#10'#: formconfig.rvaluetype4'#13#10'msgid "Currency'
  +' Fiat Only"'#13#10'msgstr "Uniquement devises fiat"'#13#10#13#10'#: formcon'
  +'fig.rvaluetype5'#13#10'msgid "Currency Crypto Only"'#13#10'msgstr "Uniqueme'
  +'nt cryptomonnaies"'#13#10#13#10'#: formconfig.rvaluetype6'#13#10'msgid "Mea'
  +'surement Units"'#13#10'msgstr "Unit'#195#169's de mesure"'#13#10#13#10'#: t'
  +'formconfigtrayslate.aclearicon.caption'#13#10'msgid "Clear Icon"'#13#10'msg'
  +'str "Effacer l'#226#128#153'ic'#195#180'ne"'#13#10#13#10'#: tformconfigtray'
  +'slate.aeditfile.caption'#13#10'msgid "Edit File..."'#13#10'msgstr "Modifier'
  +' le fichier..."'#13#10#13#10'#: tformconfigtrayslate.asave.caption'#13#10'm'
  +'sgid "Save"'#13#10'msgstr "Enregistrer"'#13#10#13#10'#: tformconfigtrayslat'
  +'e.asaveiconas.caption'#13#10'msgid "Save Icon As..."'#13#10'msgstr "Enregis'
  +'trer l'#226#128#153'ic'#195#180'ne sous..."'#13#10#13#10'#: tformconfigtray'
  +'slate.btnclose.caption'#13#10'msgid "Close"'#13#10'msgstr "Fermer"'#13#10#13
  +#10'#: tformconfigtrayslate.btninitparameterstest.hint'#13#10'msgid "Execute'
  +' request and view the parameters"'#13#10'msgstr "Ex'#195#169'cuter la requ'
  +#195#170'te et afficher les param'#195#168'tres"'#13#10#13#10'#: tformconfig'
  +'trayslate.btniniturltest.hint'#13#10'msgid "Execute request and view the re'
  +'sult"'#13#10'msgstr "Ex'#195#169'cuter la requ'#195#170'te et afficher le r'
  +#195#169'sultat"'#13#10#13#10'#: tformconfigtrayslate.btnpostdatatest.hint'
  +#13#10'msgid "Execute post request and view the result"'#13#10'msgstr "Ex'
