  +#170#227#129#132#229#160#180#229#144#136#227#128#129'{'#226#128#166'} '#227
  +#131#150#227#131#173#227#131#131#227#130#175#229#133#168#228#189#147#227#129
  +#140#229#137#138#233#153#164#227#129#149#227#130#140#227#129#190#227#129#153
  +#227#128#130#230#173#163#232#166#143#232#161#168#231#143#190#229#134#133#227
  +#129#167' ~ '#227#130#146#228#189#191#231#148#168#227#129#153#227#130#139#227
