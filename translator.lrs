  +#13#10'msgid "Save"'#13#10'msgstr "Spara"'#13#10#13#10'#: tformconfigtraysla'
  +'te.asaveiconas.caption'#13#10'msgid "Save Icon As..."'#13#10'msgstr "Spara '
  +'ikon som..."'#13#10#13#10'#: tformconfigtrayslate.btnclose.caption'#13#10'm'
  +'sgid "Close"'#13#10'msgstr "St'#195#164'ng"'#13#10#13#10'#: tformconfigtray'
  +'slate.btninitparameterstest.hint'#13#10'msgid "Execute request and view the'
  +' parameters"'#13#10'msgstr "Utf'#195#182'r beg'#195#164'ran och visa parame'
  +'trarna"'#13#10#13#10'#: tformconfigtrayslate.btniniturltest.hint'#13#10'msg'
  +'id "Execute request and view the result"'#13#10'msgstr "Utf'#195#182'r beg'
  +#195#164'ran och visa resultatet"'#13#10#13#10'#: tformconfigtrayslate.btnpo'
  +'stdatatest.hint'#13#10'msgid "Execute post request and view the result"'#13
