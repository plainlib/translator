  +'utput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  e'
  +'nd.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'#10
  +'"  text - the input text to process (possibly truncated to MaxLength)\n"'#10
  +'"  source - source language code (may be empty)\n"'#10'"  target - target l'
