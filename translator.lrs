  +'yslate.pageservice.caption'#10'msgctxt "tformconfigtrayslate.pageservice.ca'
  +'ption"'#10'msgid "Service"'#10'msgstr "Slu'#197#190'ba"'#10#10'#: tformconf'
  +'igtrayslate.reloadconfigs.hint'#10'msgid "Reload configurations from disk"'
