  +'onse.caption'#13#10'msgid "Response"'#13#10'msgstr "'#224#164#170#224#165
  +#141#224#164#176#224#164#164#224#164#191#224#164#149#224#165#141#224#164#176
  +#224#164#191#224#164#175#224#164#190'"'#13#10#13#10'#: tformconfigtrayslate.'
  +'pageservice.caption'#13#10'msgctxt "tformconfigtrayslate.pageservice.captio'
  +'n"'#13#10'msgid "Service"'#13#10'msgstr "'#224#164#184#224#165#135#224#164
  +#181#224#164#190'"'#13#10#13#10'#: tformconfigtrayslate.reloadconfigs.hint'
  +#13#10'msgid "Reload configurations from disk"'#13#10'msgstr "'#224#164#161
  +#224#164#191#224#164#184#224#165#141#224#164#149' '#224#164#184#224#165#135
  +' '#224#164#149#224#165#137#224#164#168#224#165#141#224#164#171#224#164#188
  +#224#164#191#224#164#151#224#164#176#224#165#135#224#164#182#224#164#168' '
  +#224#164#170#224#165#129#224#164#168#224#164#131' '#224#164#178#224#165#139
