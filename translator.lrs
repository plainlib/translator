  +'r o par'#195#162'metro {text}"'#10#10'#: tformconfigtrayslate.checkservicea'
  +'utoswap.caption'#10'msgid "Allow auto-swap language pair"'#10'msgstr "Permi'
  +'tir altern'#195#162'ncia autom'#195#161'tica do par de idiomas"'#10#10'#: t'
  +'formconfigtrayslate.checkserviceonlybutton.caption'#10'msgid "Allow transla'
  +'tion only by translation button"'#10'msgstr "Permitir tradu'#195#167#195#163
  +'o somente pelo bot'#195#163'o de tradu'#195#167#195#163'o"'#10#10'#: tformc'
  +'onfigtrayslate.checkserviceproxy.caption'#10'msgid "Allow proxy"'#10'msgstr'
  +' "Permitir proxy"'#10#10'#: tformconfigtrayslate.checkservicerealtime.capti'
