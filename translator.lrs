  +'txt "tformconfigtrayslate.labelinitheaders2.caption"'#10'msgid "Headers"'#10
  +'msgstr "Headers"'#10#10'#: tformconfigtrayslate.labelinitlivetime.caption'
  +#10'msgid "Live time"'#10'msgstr "Elinaika"'#10#10'#: tformconfigtrayslate.l'
  +'abelinitparameters.caption'#10'msgid "Parameters name=regexp are extracted '
  +'from the response and used by name in requests"'#10'msgstr "Parametrit name'
  +'=regexp poimitaan vastauksesta ja k'#195#164'ytet'#195#164#195#164'n nimell'
  +#195#164' pyynn'#195#182'iss'#195#164'"'#10#10'#: tformconfigtrayslate.label'
  +'initparameters1.caption'#10'msgid "Time in seconds to refresh parameters wi'
  +'th a new request (0 = every request)"'#10'msgstr "Aika sekunneissa parametr'
  +'ien p'#195#164'ivitt'#195#164'miseen uudella pyynn'#195#182'll'#195#164' (0'
  +' = joka pyynt'#195#182')"'#10#10'#: tformconfigtrayslate.labelinitparameter'
  +'s2.caption'#10'msgctxt "tformconfigtrayslate.labelinitparameters2.caption"'
  +#10'msgid "Parameters"'#10'msgstr "Parametrit"'#10#10'#: tformconfigtrayslat'
  +'e.labelinitparameters4.caption'#10'msgid "Parameters in the form key=value '
  +'used by {key} in requests. If the value is omitted (key=), it will be reque'
  +'sted from the user."'#10'msgstr "Parametrit muodossa key=value, joita {key}'
  +' k'#195#164'ytt'#195#164#195#164' pyynn'#195#182'iss'#195#164'. Jos arvo pu'
  +'uttuu (key=), sit'#195#164' pyydet'#195#164#195#164'n k'#195#164'ytt'#195
  +#164'j'#195#164'lt'#195#164'."'#10#10'#: tformconfigtrayslate.labelinitparem'
  +'eters.caption'#10'msgid "Initial GET request to obtain required parameters.'
  +'"'#10'msgstr "Alkuper'#195#164'inen GET-pyynt'#195#182' tarvittavien parame'
  +'trien saamiseksi."'#10#10'#: tformconfigtrayslate.labeliniturl.caption'#10
  +'msgctxt "tformconfigtrayslate.labeliniturl.caption"'#10'msgid "URL"'#10'msg'
  +'str "URL"'#10#10'#: tformconfigtrayslate.labelinituseragent.caption'#10'msg'
  +'ctxt "tformconfigtrayslate.labelinituseragent.caption"'#10'msgid "User Agen'
  +'t"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labellanguages.ca'
  +'ption'#10'msgid "Supported languages e.g. en=en-US (en - internal, en-US - '
  +'service). \"empty\" - do not send."'#10'msgstr "Tuetut kielet, esim. en=en-'
  +'US (en - sis'#195#164'inen, en-US - palvelu). \"empty\" - '#195#164'l'#195
  +#164' l'#195#164'het'#195#164'."'#10#10'#: tformconfigtrayslate.labellanguag'
  +'es1.caption'#10'msgid "Value type for populating names. None keeps original'
  +'s; None and Unit are case-sensitive."'#10'msgstr "Arvotyyppi nimien t'#195
  +#164'ytt'#195#164'miselle. None s'#195#164'ilytt'#195#164#195#164' alkuper'
  +#195#164'iset; None ja Unit ovat kirjainkoolla merkityksellisi'#195#164'."'
  +#10#10'#: tformconfigtrayslate.labellanguagestarget.caption'#10'msgid ""'#10
  +'"Target languages e.g. en=en-US, en - internal, en-US - service code.\n"'#10
  +'"If not specified, both source and target languages are taken from the lang'
  +'uages section."'#10'msgstr ""'#10'"Kohdekielet, esim. en=en-US, en - sis'
  +#195#164'inen, en-US - palvelukoodi.\n"'#10'"Jos ei ole m'#195#164#195#164'r'
  +'itetty, sek'#195#164' l'#195#164'hde- ett'#195#164' kohdekielet otetaan kie'
  +'liosiosta."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid'
  +' "Max Length, bytes"'#10'msgstr "Enimm'#195#164'ispituus, tavuja"'#10#10'#:'
  +' tformconfigtrayslate.labelmethod.caption'#10'msgid "Method"'#10'msgstr "Me'
  +'netelm'#195#164'"'#10#10'#: tformconfigtrayslate.labelparemeters.caption'#10
  +'msgid "Use parameters: {text} '#226#128#147' input text, {source} '#226#128
  +#147' source language, {target} '#226#128#147' target language. Prefix the n'
  +'ame with ! for lowercase or ^ for uppercase value. Also supported {timestam'
  +'p}, {rand}. Use {parameter} from the parameters page."'#10'msgstr "K'#195
  +#164'yt'#195#164' parametreja: {text} '#226#128#147' sy'#195#182'teteksti, {'
  +'source} '#226#128#147' l'#195#164'hdekieli, {target} '#226#128#147' kohdeki'
  +'eli. Lis'#195#164#195#164' etuliite ! pienille kirjaimille tai ^ suurille k'
  +'irjaimille. My'#195#182's {timestamp}, {rand} tuetaan. K'#195#164'yt'#195
  +#164' {parameter}-parametria parametrisivulta."'#10#10'#: tformconfigtraysla'
  ,'te.labelpostdata.caption'#10'msgid "Post Data"'#10'msgstr "Post Data"'#10#10
  +'#: tformconfigtrayslate.labelpostdata1.caption'#10'msgctxt "tformconfigtray'
  +'slate.labelpostdata1.caption"'#10'msgid "Headers"'#10'msgstr "Headers"'#10
  +#10'#: tformconfigtrayslate.labelservicedescription.caption'#10'msgid "Descr'
  +'iption"'#10'msgstr "Kuvaus"'#10#10'#: tformconfigtrayslate.labelservicename'
  +'.caption'#10'msgid "Name"'#10'msgstr "Nimi"'#10#10'#: tformconfigtrayslate.'
  +'labelserviceorder.caption'#10'msgid "Order"'#10'msgstr "J'#195#164'rjestys"'
  +#10#10'#: tformconfigtrayslate.labelsort.caption'#10'msgctxt "tformconfigtra'
  +'yslate.labelsort.caption"'#10'msgid "Sort"'#10'msgstr "Lajittele"'#10#10'#:'
  +' tformconfigtrayslate.labeltargetsort.caption'#10'msgctxt "tformconfigtrays'
  +'late.labeltargetsort.caption"'#10'msgid "Sort"'#10'msgstr "Lajittele"'#10#10
  +'#: tformconfigtrayslate.labelurl.caption'#10'msgctxt "tformconfigtrayslate.'
  +'labelurl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10'#: tformconfigtra'
  +'yslate.labeluseragent.caption'#10'msgctxt "tformconfigtrayslate.labeluserag'
  +'ent.caption"'#10'msgid "User Agent"'#10'msgstr "User Agent"'#10#10'#: tform'
  +'configtrayslate.labelvaluetype.caption'#10'msgid "Value Type"'#10'msgstr "A'
  +'rvotyyppi"'#10#10'#: tformconfigtrayslate.pageinitialrequest.caption'#10'ms'
  +'gctxt "tformconfigtrayslate.pageinitialrequest.caption"'#10'msgid "Initial '
  +'Request"'#10'msgstr "Alkupyynt'#195#182'"'#10#10'#: tformconfigtrayslate.pa'
  +'gelanguages.caption'#10'msgctxt "tformconfigtrayslate.pagelanguages.caption'
  +'"'#10'msgid "Languages"'#10'msgstr "Kielet"'#10#10'#: tformconfigtrayslate.'
  +'pagelanguagestarget.caption'#10'msgctxt "tformconfigtrayslate.pagelanguages'
  +'target.caption"'#10'msgid "Target Languages"'#10'msgstr "Kohdekielet"'#10#10
  +'#: tformconfigtrayslate.pageparameters.caption'#10'msgctxt "tformconfigtray'
  +'slate.pageparameters.caption"'#10'msgid "Parameters"'#10'msgstr "Parametrit'
  +'"'#10#10'#: tformconfigtrayslate.pagerequest.caption'#10'msgctxt "tformconf'
  +'igtrayslate.pagerequest.caption"'#10'msgid "Request"'#10'msgstr "Pyynt'#195
  +#182'"'#10#10'#: tformconfigtrayslate.pageresponse.caption'#10'msgid "Respon'
  +'se"'#10'msgstr "Vastaus"'#10#10'#: tformconfigtrayslate.pageservice.caption'
  +#10'msgctxt "tformconfigtrayslate.pageservice.caption"'#10'msgid "Service"'
  +#10'msgstr "Palvelu"'#10#10'#: tformconfigtrayslate.reloadconfigs.hint'#10'm'
  +'sgid "Reload configurations from disk"'#10'msgstr "Lataa asetukset uudellee'
  +'n levylt'#195#164'"'#10#10'#: tformconfigtrayslate.sbcopyconfig.hint'#10'ms'
  +'gid "Copy configuration"'#10'msgstr "Kopioi konfiguraatio"'#10#10'#: tformc'
  +'onfigtrayslate.sbnewconfig.hint'#10'msgid "New configuration"'#10'msgstr "U'
  +'usi konfiguraatio"'#10#10
]);
LazarusResources.Add('formconfig.fr','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: fr\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "'#195#137'diteur de configuration"'#10#10'#: formconfig.rclearlangu'
  +'ages'#10'msgid "The list is already filled. Do you want to clear it?"'#10'm'
  +'sgstr "La liste est d'#195#169'j'#195#160' remplie. Voulez-vous l''effacer '
  +'?"'#10#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you want to d'
  +'elete config"'#10'msgstr "'#195#138'tes-vous s'#195#187'r de vouloir suppri'
  +'mer la configuration"'#10#10'#: formconfig.rdeleteconfigcaption'#10'msgid "'
  +'Delete config"'#10'msgstr "Supprimer la configuration"'#10#10'#: formconfig'
  +'.rnamequestion'#10'msgid "Enter new config file name:"'#10'msgstr "Entrez l'
  +'e nom du nouveau fichier de configuration :"'#10#10'#: formconfig.rneedsave'
  +#10'msgid "The configuration was modified. Save changes?"'#10'msgstr "La con'
  +'figuration a '#195#169't'#195#169' modifi'#195#169'e. Enregistrer les modif'
  +'ications ?"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Point'
  +'er: Use / for levels, keys for objects, and numbers for indexes.\n"'#10'"Us'
  +'e * for all items, *#10 to join items by newline. Use ~ at the end of the p'
  +'ath to return the raw JSON branch.\n"'#10'"Separate multiple segments with '
  +'semicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag #'
  +'10 for newlines. Use {{regex}} inside to extract data directly into the tex'
  +'t.\n"'#10'"Logic: If a Pointer in a segment is empty, the whole segment is '
  +'skipped. If a segment has no Pointer, only literal text blocks with embedde'
  +'d regular expressions are processed.\n"'#10'"Regex: {prefix {regex[index]} '
  +'suffix} inside a text block. If no [index] is specified, the first match is'
  +' used.\n"'#10'"Index can be a number, [*] (join by space), or [*#10] (join '
  +'by newline). If the regex finds no match, the entire {'#226#128#166'} block'
  +' is removed.\n"'#10'"Using ~ inside a regex returns the entire text.\n"'#10
  +'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show its text on'
  +'ly if the Pointer data is missing or the JSON is invalid.\n"'#10'"Commentin'
  +'g: /* text */ comments are stripped from the entire expression before any p'
  +'rocessing.\n"'#10'"Examples:\n"'#10'"responseData/translatedText; matches/*'
  +'#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\'
  +'w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#10'msgst'
  +'r ""'#10'"Pointeur JSON : utilisez / pour les niveaux, les cl'#195#169's po'
  +'ur les objets et les nombres pour les index. Utilisez * pour tous les '#195
  +#169'l'#195#169'ments et *#10 pour les joindre avec un saut de ligne. Utilis'
  +'ez ~ '#195#160' la fin du chemin pour renvoyer la branche JSON brute. S'#195
  +#169'parez plusieurs segments par un point-virgule ;.\n"'#10'"Litt'#195#169
  +'ral : bloc de texte entre {'#226#128#166'}. Balise sp'#195#169'ciale #10 po'
  +'ur les sauts de ligne. Utilisez {{regex}} '#195#160' l''int'#195#169'rieur '
  +'pour extraire directement les donn'#195#169'es dans le texte.\n"'#10'"Logiq'
  +'ue : si un pointeur dans un segment est vide, tout le segment est ignor'#195
  +#169'. Si un segment ne contient aucun pointeur, seuls les blocs de texte li'
  +'tt'#195#169'ral avec des expressions r'#195#169'guli'#195#168'res int'#195
  +#169'gr'#195#169'es sont trait'#195#169's.\n"'#10'"Regex : {pr'#195#169'fixe'
  +' {regex[index]} suffixe} '#195#160' l''int'#195#169'rieur d''un bloc de tex'
  +'te. Si [index] n''est pas sp'#195#169'cifi'#195#169', la premi'#195#168're '
  +'correspondance est utilis'#195#169'e. L''index peut '#195#170'tre un nombre'
  +', [*] (joindre avec un espace) ou [*#10] (joindre avec un saut de ligne). S'
  +'i l''expression r'#195#169'guli'#195#168're ne trouve aucune correspondance'
  +', tout le bloc {'#226#128#166'} est supprim'#195#169'. L''utilisation de ~ '
  +'dans une expression r'#195#169'guli'#195#168're renvoie le texte complet.\n'
  +'"'#10'"Inversion : commencez un segment par ! (par exemple !/path{Error}) p'
  +'our afficher son texte uniquement si les donn'#195#169'es du pointeur sont '
  +'absentes ou si le JSON est invalide.\n"'#10'"Commentaires : les commentaire'
  +'s /* texte */ sont supprim'#195#169's de l''expression enti'#195#168're ava'
  +'nt tout traitement.\n"'#10'"Exemples :\n"'#10'"responseData/translatedText;'
  +' matches/*#10/translation; /texts/text; {literal text#10}; /result/text; /t'
  +'ext{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#10#10
  +'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a standard Pascal'
  +' program: optional var section, then a main begin ... end. block.\n"'#10'"\'
  ,'n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := '
  +'GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'
  +#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can als'
  +'o use standard Pascal constructs (if, for, while, repeat, etc.). You can de'
  +'fine your own functions and procedures before the main begin ... end. block'
  +'.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'') : stri'
  +'ng\n"'#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutput(''nam'
  +'e'', ''value'')\n"'#10'"    Store an output value for the host.\n"'#10'"  G'
  +'etTimestamp() : Int64\n"'#10'"    Current Unix timestamp in milliseconds (U'
  +'TC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer with ex'
  +'actly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10'"    Random'
  +' float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'
  +#10'"    Convert integer to hexadecimal string with at least Digits characte'
  +'rs.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to an inte'
  +'ger. Raises an exception on invalid input.\n"'#10'"  IntToStr(Value) : stri'
  +'ng\n"'#10'"    Convert an integer to its string representation.\n"'#10'"  T'
  +'rim(S) : string\n"'#10'"    Remove leading and trailing whitespace from S.\'
  +'n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whitespace from S'
  +'.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing whitespace fr'
  +'om S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode special HTML char'
  +'acters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Dec'
  +'ode HTML entities in S back to characters.\n"'#10'"  UrlEncode(S) : string\'
  +'n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"  UrlDecode(S)'
  +' : string\n"'#10'"    Decode a percent-encoded string S.\n"'#10'"  ReplaceA'
  +'ll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Replac'
  +'e all occurrences of OldPattern with NewPattern in S.\n"'#10'"  RegexReplac'
  +'e(Input, Pattern, Replacement) : string\n"'#10'"    Replace all regex match'
  +'es of Pattern with Replacement in Input. Case-insensitive.\n"'#10'"  RegexM'
  +'atch(Input, Pattern) : Boolean\n"'#10'"    Check if Input matches the regex'
  +' Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMar'
  +'ker) : string\n"'#10'"    Extract the substring of S between StartMarker an'
  +'d EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle returned by JSON'
  +'Parse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON string an'
  +'d return a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'
  +#10'"    Release the handle after use.\n"'#10'"  JSONGetString(Handle, Path)'
  +' : string\n"'#10'"    Get a string value at the specified Path.\n"'#10'"  J'
  +'SONGetInt(Handle, Path) : Integer\n"'#10'"    Get an integer value at the s'
  +'pecified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    '
  +'Get a floating-point value at the specified Path.\n"'#10'"  JSONGetBool(Han'
  +'dle, Path) : Boolean\n"'#10'"    Get a boolean value at the specified Path.'
  +'\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get the nu'
  +'mber of elements in an array at the specified Path.\n"'#10'"  JSONGetArrayS'
  +'tring(Handle, Path, Index) : string\n"'#10'"    Get the string value of an '
  +'array element at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, I'
  +'ndex) : Integer\n"'#10'"    Get the integer value of an array element at th'
  +'e given Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Ret'
  +'urn the type of the value at Path: \"object\", \"array\", \"string\", \"int'
  +'\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) :'
  +' Boolean\n"'#10'"    Check if the specified Path exists.\n"'#10'"  JSONResu'
  +'ltInit\n"'#10'"    Initialize an empty JSON array for building a standard e'
  +'rror result.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Replacem'
  +'ents)\n"'#10'"    Add an error object to the result array. Replacements is '
  +'a string of values separated by \"|\".\n"'#10'"  JSONResultGet : string\n"'
  +#10'"    Return the current result array as a JSON string.\n"'#10'"  JSONRes'
  +'ultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always call JSONFree'
  +' to release the handle after you are done.\n"'#10'"\n"'#10'"Example of work'
  +'ing with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'" '
  +' begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    if h >'
  +'= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.path'
  +''');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10
  +'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters (retrieved w'
  +'ith GetParam):\n"'#10'"  text - the input text to process (possibly truncat'
  +'ed to MaxLength)\n"'#10'"  source - source language code (may be empty)\n"'
  +#10'"  target - target language code\n"'#10'"  timestamp - current Unix time'
  ,'stamp in milliseconds (string)\n"'#10'"  random  - 9-digit random number (s'
  +'tring)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 - first 1..9 '
  +'digits of the random number\n"'#10'"\n"'#10'"Additional initial and custom '
  +'parameters are also available."'#10'msgstr ""'#10'"Le script est un program'
  +'me Pascal standard : une section var facultative, puis un bloc principal be'
  +'gin ... end.\n"'#10'"\n"'#10'"Exemple :\n"'#10'"  var s: string;\n"'#10'"  '
  +'begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, '
  +'''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'
  +#10'"\n"'#10'"Vous pouvez '#195#169'galement utiliser les constructions Pasc'
  +'al standard (if, for, while, repeat, etc.). Vous pouvez d'#195#169'finir vo'
  +'s propres fonctions et proc'#195#169'dures avant le bloc principal begin ..'
  +'. end.\n"'#10'"\n"'#10'"Fonctions disponibles :\n"'#10'"  GetParam(''name'''
  +') : string\n"'#10'"    R'#195#169'cup'#195#168're la valeur d''un param'#195
  +#168'tre d''entr'#195#169'e.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10
  +'"    Stocke une valeur de sortie pour l''h'#195#180'te.\n"'#10'"  GetTimest'
  +'amp() : Int64\n"'#10'"    Horodatage Unix actuel en millisecondes (UTC).\n"'
  +#10'"  GetRandom(Length) : Int64\n"'#10'"    Entier al'#195#169'atoire compo'
  +'rtant exactement Length chiffres d'#195#169'cimaux.\n"'#10'"  Random : Exte'
  +'nded\n"'#10'"    Nombre '#195#160' virgule flottante al'#195#169'atoire dan'
  +'s l''intervalle [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"'
  +'    Convertit un entier en cha'#195#174'ne hexad'#195#169'cimale comportant'
  +' au moins Digits caract'#195#168'res.\n"'#10'"  StrToInt(S) : Integer\n"'#10
  +'"    Convertit une cha'#195#174'ne en entier. G'#195#169'n'#195#168're une '
  +'exception si l''entr'#195#169'e n''est pas valide.\n"'#10'"  IntToStr(Value'
  +') : string\n"'#10'"    Convertit un entier en sa repr'#195#169'sentation so'
  +'us forme de cha'#195#174'ne.\n"'#10'"  Trim(S) : string\n"'#10'"    Supprim'
  +'e les espaces au d'#195#169'but et '#195#160' la fin de S.\n"'#10'"  TrimLe'
  +'ft(S) : string\n"'#10'"    Supprime les espaces au d'#195#169'but de S.\n"'
  +#10'"  TrimRight(S) : string\n"'#10'"    Supprime les espaces '#195#160' la '
  +'fin de S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode les caract'
  +#195#168'res HTML sp'#195#169'ciaux de S sous forme d''entit'#195#169's.\n"'
  +#10'"  HtmlDecode(S) : string\n"'#10'"    D'#195#169'code les entit'#195#169
  +'s HTML de S en caract'#195#168'res.\n"'#10'"  UrlEncode(S) : string\n"'#10
  +'"    Encode S avec un encodage en pourcentage pour une inclusion s'#195#187
  +'re dans une URL.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    D'#195#169'cod'
  +'e une cha'#195#174'ne S encod'#195#169'e en pourcentage.\n"'#10'"  ReplaceA'
  +'ll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Rempla'
  +'ce toutes les occurrences de OldPattern par NewPattern dans S.\n"'#10'"  Re'
  +'gexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Remplace toute'
  +'s les correspondances de l''expression r'#195#169'guli'#195#168're Pattern '
  +'par Replacement dans Input. Insensible '#195#160' la casse.\n"'#10'"  Regex'
  +'Match(Input, Pattern) : Boolean\n"'#10'"    V'#195#169'rifie si Input corre'
  +'spond '#195#160' l''expression r'#195#169'guli'#195#168're Pattern. Insensi'
  +'ble '#195#160' la casse.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker'
  +') : string\n"'#10'"    Extrait la sous-cha'#195#174'ne de S situ'#195#169'e'
  +' entre StartMarker et EndMarker.\n"'#10'"\n"'#10'"Fonctions JSON (utilisez '
  +'un handle renvoy'#195#169' par JSONParse) :\n"'#10'"  JSONParse(S) : Intege'
  +'r\n"'#10'"    Analyse une cha'#195#174'ne JSON et renvoie un handle (>=0). '
  +'Renvoie -1 en cas d''erreur.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Lib'#195
  +#168're le handle apr'#195#168's utilisation.\n"'#10'"  JSONGetString(Handle'
  +', Path) : string\n"'#10'"    Obtient une valeur cha'#195#174'ne au chemin s'
  +'p'#195#169'cifi'#195#169' Path.\n"'#10'"  JSONGetInt(Handle, Path) : Intege'
  +'r\n"'#10'"    Obtient une valeur enti'#195#168're au chemin sp'#195#169'cif'
  +'i'#195#169' Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'" '
  +'   Obtient une valeur '#195#160' virgule flottante au chemin sp'#195#169'ci'
  +'fi'#195#169' Path.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"  '
  +'  Obtient une valeur bool'#195#169'enne au chemin sp'#195#169'cifi'#195#169
  +' Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Obti'
  +'ent le nombre d'''#195#169'l'#195#169'ments d''un tableau au chemin sp'#195
  +#169'cifi'#195#169' Path.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) '
  +': string\n"'#10'"    Obtient la valeur cha'#195#174'ne d''un '#195#169'l'
  +#195#169'ment du tableau '#195#160' l''index sp'#195#169'cifi'#195#169' Inde'
  +'x.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#10'"    Obt'
  +'ient la valeur enti'#195#168're d''un '#195#169'l'#195#169'ment du tableau '
  ,#195#160' l''index sp'#195#169'cifi'#195#169' Index.\n"'#10'"  JSONGetType(H'
  +'andle, Path) : string\n"'#10'"    Renvoie le type de la valeur '#195#160' P'
  +'ath : \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"nu'
  +'ll\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10'"    V'#195
  +#169'rifie si le chemin sp'#195#169'cifi'#195#169' Path existe.\n"'#10'"  JS'
  +'ONResultInit\n"'#10'"    Initialise un tableau JSON vide pour cr'#195#169'e'
  +'r un r'#195#169'sultat d''erreur standard.\n"'#10'"  JSONResultAddError(Off'
  +'set, Length, Message, Replacements)\n"'#10'"    Ajoute un objet d''erreur a'
  +'u tableau de r'#195#169'sultats. Replacements est une cha'#195#174'ne de va'
  +'leurs s'#195#169'par'#195#169'es par \"|\".\n"'#10'"  JSONResultGet : strin'
  +'g\n"'#10'"    Renvoie le tableau de r'#195#169'sultats actuel sous forme de'
  +' cha'#195#174'ne JSON.\n"'#10'"  JSONResultClear\n"'#10'"    Efface le tabl'
  +'eau de r'#195#169'sultats.\n"'#10'"  Appelez toujours JSONFree pour lib'#195
  +#169'rer le handle lorsque vous avez termin'#195#169'.\n"'#10'"\n"'#10'"Exem'
  +'ple d''utilisation de JSON :\n"'#10'"  var h: Integer;\n"'#10'"      s: str'
  +'ing;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'
  +#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h'
  +', ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONF'
  +'ree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Param'#195#168'tre'
  +'s disponibles (r'#195#169'cup'#195#169'r'#195#169's avec GetParam) :\n"'#10
  +'"  text - le texte d''entr'#195#169'e '#195#160' traiter ('#195#169'ventuel'
  +'lement tronqu'#195#169' '#195#160' MaxLength)\n"'#10'"  source - code de la'
  +' langue source (peut '#195#170'tre vide)\n"'#10'"  target - code de la lang'
  +'ue cible\n"'#10'"  timestamp - horodatage Unix actuel en millisecondes (cha'
  +#195#174'ne)\n"'#10'"  random  - nombre al'#195#169'atoire '#195#160' 9 chif'
  +'fres (cha'#195#174'ne)\n"'#10'"  rand - identique '#195#160' random\n"'#10
  +'"  rand1..rand9 - les 1 '#195#160' 9 premiers chiffres du nombre al'#195#169
  +'atoire\n"'#10'"\n"'#10'"Des param'#195#168'tres initiaux et personnalis'#195
  +#169's suppl'#195#169'mentaires sont '#195#169'galement disponibles."'#10#10
  +'#: formconfig.rscriptresponsehint'#10'msgid ""'#10'"This script processes t'
  +'he response data. All functions and parameters described in the script hint'
  +' are available here as well.\n"'#10'"Use GetParam(''result'') to obtain the'
  +' received text.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"'
  +'  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"    SetOutput(''resu'
  +'lt'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can define custom parameters '
  +'in the parameters script using SetParam(''name'', ''value''),\n"'#10'"and t'
  +'hen retrieve them here with GetParam(''name'')."'#10'msgstr ""'#10'"Ce scri'
  +'pt traite les donn'#195#169'es de r'#195#169'ponse. Toutes les fonctions et'
  +' tous les param'#195#168'tres d'#195#169'crits dans l''aide du script sont '
  +#195#169'galement disponibles ici.\n"'#10'"Utilisez GetParam(''result'') pou'
  +'r obtenir le texte re'#195#167'u.\n"'#10'"\n"'#10'"Exemple :\n"'#10'"  var '
  +'s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'" '
  +'   SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Vous pouvez d'
  +#195#169'finir des param'#195#168'tres personnalis'#195#169's dans le script'
  +' des param'#195#168'tres '#195#160' l''aide de SetParam(''name'', ''value'''
  +'),\n"'#10'"puis les r'#195#169'cup'#195#169'rer ici avec GetParam(''name'')'
  +'."'#10#10'#: formconfig.rvaluetype1'#10'msgctxt "formconfig.rvaluetype1"'#10
  +'msgid "None"'#10'msgstr "Aucun"'#10#10'#: formconfig.rvaluetype2'#10'msgid '
  +'"Language"'#10'msgstr "Langue"'#10#10'#: formconfig.rvaluetype3'#10'msgid "'
  +'Currency All"'#10'msgstr "Toutes les devises"'#10#10'#: formconfig.rvaluety'
  +'pe4'#10'msgid "Currency Fiat Only"'#10'msgstr "Uniquement devises fiat"'#10
  +#10'#: formconfig.rvaluetype5'#10'msgid "Currency Crypto Only"'#10'msgstr "U'
  +'niquement cryptomonnaies"'#10#10'#: formconfig.rvaluetype6'#10'msgid "Measu'
  +'rement Units"'#10'msgstr "Unit'#195#169's de mesure"'#10#10'#: tformconfigt'
  +'rayslate.aclearicon.caption'#10'msgid "Clear Icon"'#10'msgstr "Effacer l'
  +#226#128#153'ic'#195#180'ne"'#10#10'#: tformconfigtrayslate.asave.caption'#10
  +'msgid "Save"'#10'msgstr "Enregistrer"'#10#10'#: tformconfigtrayslate.asavei'
  +'conas.caption'#10'msgid "Save Icon As..."'#10'msgstr "Enregistrer l'#226#128
  +#153'ic'#195#180'ne sous..."'#10#10'#: tformconfigtrayslate.btnclose.caption'
  +#10'msgid "Close"'#10'msgstr "Fermer"'#10#10'#: tformconfigtrayslate.btninit'
  +'parameterstest.hint'#10'msgid "Execute request and view the parameters"'#10
  +'msgstr "Ex'#195#169'cuter la requ'#195#170'te et afficher les param'#195#168
  +'tres"'#10#10'#: tformconfigtrayslate.btniniturltest.hint'#10'msgid "Execute'
  +' request and view the result"'#10'msgstr "Ex'#195#169'cuter la requ'#195#170
  ,'te et afficher le r'#195#169'sultat"'#10#10'#: tformconfigtrayslate.btnpost'
  +'datatest.hint'#10'msgid "Execute post request and view the result"'#10'msgs'
  +'tr "Ex'#195#169'cuter la requ'#195#170'te POST et afficher le r'#195#169'su'
  +'ltat"'#10#10'#: tformconfigtrayslate.btnresponsehelp.hint'#10'msgctxt "tfor'
  +'mconfigtrayslate.btnresponsehelp.hint"'#10'msgid "Help"'#10'msgstr "Aide"'
  +#10#10'#: tformconfigtrayslate.btnresponsetest.hint'#10'msgid "Converts the '
  +'current response"'#10'msgstr "Convertit la r'#195#169'ponse actuelle"'#10#10
  +'#: tformconfigtrayslate.btnscripthelp.hint'#10'msgctxt "tformconfigtrayslat'
  +'e.btnscripthelp.hint"'#10'msgid "Help"'#10'msgstr "Aide"'#10#10'#: tformcon'
  +'figtrayslate.btnscriptresponsehelp.hint'#10'msgctxt "tformconfigtrayslate.b'
  +'tnscriptresponsehelp.hint"'#10'msgid "Help"'#10'msgstr "Aide"'#10#10'#: tfo'
  +'rmconfigtrayslate.btnscriptresponsetest.hint'#10'msgctxt "tformconfigtraysl'
  +'ate.btnscriptresponsetest.hint"'#10'msgid "Execute script and view the resu'
  +'lt"'#10'msgstr "Ex'#195#169'cuter le script et afficher le r'#195#169'sulta'
  +'t"'#10#10'#: tformconfigtrayslate.btnscripttest.hint'#10'msgctxt "tformconf'
  +'igtrayslate.btnscripttest.hint"'#10'msgid "Execute script and view the resu'
  +'lt"'#10'msgstr "Ex'#195#169'cuter le script et afficher le r'#195#169'sulta'
  +'t"'#10#10'#: tformconfigtrayslate.btnurltest.hint'#10'msgid "Execute get re'
  +'quest and view the result"'#10'msgstr "Ex'#195#169'cuter la requ'#195#170't'
  +'e GET et afficher le r'#195#169'sultat"'#10#10'#: tformconfigtrayslate.capt'
  +'ion'#10'msgctxt "tformconfigtrayslate.caption"'#10'msgid "Config Editor"'#10
  +'msgstr "'#195#137'diteur de configuration"'#10#10'#: tformconfigtrayslate.c'
  +'heckencodecustomparameters.caption'#10'msgid "Encode parameters"'#10'msgstr'
