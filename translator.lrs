  +'-Click tyhjent'#195#164#195#164' kuvakkeen"'#10#10'#: tformconfigtrayslate.'
  +'labelaccept.caption'#10'msgid "Accept"'#10'msgstr "Accept"'#10#10'#: tformc'
  +'onfigtrayslate.labelcolorrecent.caption'#10'msgid "Recent Color"'#10'msgstr'
  +' "Viimeaikainen v'#195#164'ri"'#10#10'#: tformconfigtrayslate.labelcontentt'
  +'ype.caption'#10'msgid "Content Type"'#10'msgstr "Content Type"'#10#10'#: tf'
  +'ormconfigtrayslate.labelfilllanguages.caption'#10'msgctxt "tformconfigtrays'
  +'late.labelfilllanguages.caption"'#10'msgid "Fill with default"'#10'msgstr "'
  ,'T'#195#164'yt'#195#164' oletusarvoilla"'#10#10'#: tformconfigtrayslate.labe'
  +'lfilltargetlanguages.caption'#10'msgctxt "tformconfigtrayslate.labelfilltar'
  +'getlanguages.caption"'#10'msgid "Fill with default"'#10'msgstr "T'#195#164
  +'yt'#195#164' oletusarvoilla"'#10#10'#: tformconfigtrayslate.labelheaders.ca'
  +'ption'#10'msgid "Additional request headers in key=value format, key: value'
