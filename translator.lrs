  +#10#13#10'#: formconfig.rnamequestion'#13#10'msgid "Enter new config file na'
  +'me:"'#13#10'msgstr "Wprowad'#197#186' nazw'#196#153' nowego pliku konfigura'
  +'cyjnego:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The configurat'
  +'ion was modified. Save changes?"'#13#10'msgstr "Konfiguracja zosta'#197#130
  +'a zmodyfikowana. Zapisa'#196#135' zmiany?"'#13#10#13#10'#: formconfig.rresp'
  +'onsehint'#13#10'msgid ""'#13#10'"Json Pointer: Use / for levels, keys for o'
  +'bjects, and numbers for indexes.\n"'#13#10'"Use * for all items, *#10 to jo'
  +'in items by newline. Use ~ at the end of the path to return the raw JSON br'
  +'anch.\n"'#13#10'"Separate multiple segments with semicolon ;.\n"'#13#10'"Li'
  +'teral: Text block in {'#226#128#166'}. Special tag #10 for newlines. Use {{'
  +'regex}} inside to extract data directly into the text.\n"'#13#10'"Logic: If'
  +' a Pointer in a segment is empty, the whole segment is skipped. If a segmen'
  +'t has no Pointer, only literal text blocks with embedded regular expression'
  +'s are processed.\n"'#13#10'"Regex: {prefix {regex[index]} suffix} inside a '
  +'text block. If no [index] is specified, the first match is used.\n"'#13#10
  +'"Index can be a number, [*] (join by space), or [*#10] (join by newline). I'
  +'f the regex finds no match, the entire {'#226#128#166'} block is removed.\n'
  +'"'#13#10'"Using ~ inside a regex returns the entire text.\n"'#13#10'"Invers'
  +'ion: Start a segment with ! (e.g. !/path{Error}) to show its text only if t'
  +'he Pointer data is missing or the JSON is invalid.\n"'#13#10'"Commenting: /'
  +'* text */ comments are stripped from the entire expression before any proce'
  +'ssing.\n"'#13#10'"Examples:\n"'#13#10'"responseData/translatedText; matches'
  +'/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({('
  +'\\w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#13#10
  +'msgstr ""'#13#10'"Wska'#197#186'nik JSON: U'#197#188'yj / dla poziom'#195
  +#179'w, kluczy dla obiekt'#195#179'w i liczb dla indeks'#195#179'w. U'#197
  +#188'yj * dla wszystkich element'#195#179'w oraz *#10 do '#197#130#196#133'c'
  +'zenia element'#195#179'w za pomoc'#196#133' nowej linii. U'#197#188'yj ~ na'
  +' ko'#197#132'cu '#197#155'cie'#197#188'ki, aby zwr'#195#179'ci'#196#135' su'
  +'row'#196#133' ga'#197#130#196#133#197#186' JSON. Oddziel wiele segment'#195
  +#179'w '#197#155'rednikiem ;.\n"'#13#10'"Litera'#197#130': Blok tekstu w {'
  +#226#128#166'}. Specjalny znacznik #10 dla nowych linii. U'#197#188'yj {{reg'
  +'ex}} wewn'#196#133'trz, aby wyodr'#196#153'bni'#196#135' dane bezpo'#197#155
  +'rednio do tekstu.\n"'#13#10'"Logika: Je'#197#155'li wska'#197#186'nik w seg'
  +'mencie jest pusty, ca'#197#130'y segment jest pomijany. Je'#197#155'li segm'
  ,'ent nie zawiera wska'#197#186'nika, przetwarzane s'#196#133' tylko litera'
  +#197#130'y tekstowe z osadzonymi wyra'#197#188'eniami regularnymi.\n"'#13#10
  +'"Regex: {prefiks {regex[index]} sufiks} wewn'#196#133'trz bloku tekstowego.'
  +' Je'#197#155'li [index] nie zostanie okre'#197#155'lony, u'#197#188'ywane j'
  +'est pierwsze dopasowanie. Indeks mo'#197#188'e by'#196#135' liczb'#196#133
  +', [*] ('#197#130#196#133'czenie spacj'#196#133') lub [*#10] ('#197#130#196
  +#133'czenie now'#196#133' lini'#196#133'). Je'#197#155'li wyra'#197#188'enie'
  +' regularne nie znajdzie dopasowania, ca'#197#130'y blok {'#226#128#166'} zo'
  +'staje usuni'#196#153'ty. U'#197#188'ycie ~ wewn'#196#133'trz wyra'#197#188
  +'enia regularnego zwraca ca'#197#130'y tekst.\n"'#13#10'"Odwr'#195#179'cenie'
  +': Rozpocznij segment od ! (np. !/path{Error}), aby wy'#197#155'wietli'#196
  +#135' jego tekst tylko wtedy, gdy brakuje danych wska'#197#186'nika lub JSON'
  +' jest nieprawid'#197#130'owy.\n"'#13#10'"Komentarze: Komentarze /* tekst */'
  +' s'#196#133' usuwane z ca'#197#130'ego wyra'#197#188'enia przed rozpocz'#196
  +#153'ciem jakiegokolwiek przetwarzania.\n"'#13#10'"Przyk'#197#130'ady:\n"'#13
  +#10'"responseData/translatedText; matches/*#10/translation; /texts/text; {li'
  +'teral text#10}; /result/text; /text{ ({(\\w+)})}; !/translations{Error: No '
  +'data!#10}; /translations"'#13#10#13#10'#: formconfig.rscripthint'#13#10'msg'
  +'id ""'#13#10'"The script is a standard Pascal program: optional var section'
  +', then a main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13
  +#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'
  +''');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"   '
  +' SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can a'
  +'lso use standard Pascal constructs (if, for, while, repeat, etc.). You can '
  +'define your own functions and procedures before the main begin ... end. blo'
  +'ck.\n"'#13#10'"\n"'#13#10'"Available functions:\n"'#13#10'"  GetParam(''nam'
  +'e'') : string\n"'#13#10'"    Retrieve an input parameter value.\n"'#13#10'"'
  +'  SetOutput(''name'', ''value'')\n"'#13#10'"    Store an output value for t'
  +'he host.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Current Unix ti'
  +'mestamp in milliseconds (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13
  +#10'"    Random integer with exactly Length decimal digits.\n"'#13#10'"  Ran'
  +'dom : Extended\n"'#13#10'"    Random float in the range [0, 1).\n"'#13#10'"'
  +'  IntToHex(Value, Digits) : string\n"'#13#10'"    Convert integer to hexade'
  +'cimal string with at least Digits characters.\n"'#13#10'"  StrToInt(S) : In'
  +'teger\n"'#13#10'"    Convert a string to an integer. Raises an exception on'
  +' invalid input.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Conver'
  +'t an integer to its string representation.\n"'#13#10'"  Trim(S) : string\n"'
  +#13#10'"    Remove leading and trailing whitespace from S.\n"'#13#10'"  Trim'
  +'Left(S) : string\n"'#13#10'"    Remove leading whitespace from S.\n"'#13#10
  +'"  TrimRight(S) : string\n"'#13#10'"    Remove trailing whitespace from S.\'
  +'n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Encode special HTML char'
  +'acters in S into entities.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'" '
  +'   Decode HTML entities in S back to characters.\n"'#13#10'"  UrlEncode(S) '
  +': string\n"'#13#10'"    Percent-encode S for safe URL inclusion.\n"'#13#10
  +'"  UrlDecode(S) : string\n"'#13#10'"    Decode a percent-encoded string S.\'
  +'n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : stri'
  +'ng\n"'#13#10'"    Replace all occurrences of OldPattern with NewPattern in '
  +'S.\n"'#13#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10
  +'"    Replace all regex matches of Pattern with Replacement in Input. Case-i'
  +'nsensitive.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"  '
  +'  Check if Input matches the regex Pattern. Case-insensitive.\n"'#13#10'"  '
  +'ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Extract t'
  +'he substring of S between StartMarker and EndMarker.\n"'#13#10'"\n"'#13#10
  +'"JSON functions (use a handle returned by JSONParse):\n"'#13#10'"  JSONPars'
  +'e(S) : Integer\n"'#13#10'"    Parse a JSON string and return a handle (>=0)'
  +'. Returns -1 on error.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Release'
  +' the handle after use.\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'
  +#13#10'"    Get a string value at the specified Path.\n"'#13#10'"  JSONGetIn'
  +'t(Handle, Path) : Integer\n"'#13#10'"    Get an integer value at the specif'
  +'ied Path.\n"'#13#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"   '
  +' Get a floating-point value at the specified Path.\n"'#13#10'"  JSONGetBool'
  +'(Handle, Path) : Boolean\n"'#13#10'"    Get a boolean value at the specifie'
  +'d Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'" '
  +'   Get the number of elements in an array at the specified Path.\n"'#13#10
  ,'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13#10'"    Get the '
  +'string value of an array element at the given Index.\n"'#13#10'"  JSONGetAr'
  +'rayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Get the integer value '
  +'of an array element at the given Index.\n"'#13#10'"  JSONGetType(Handle, Pa'
  +'th) : string\n"'#13#10'"    Return the type of the value at Path: \"object\'
  +'", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#13#10
  +'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Check if the speci'
  +'fied Path exists.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Initialize an '
  +'empty JSON array for building a standard error result.\n"'#13#10'"  JSONRes'
  +'ultAddError(Offset, Length, Message, Replacements)\n"'#13#10'"    Add an er'
  +'ror object to the result array. Replacements is a string of values separate'
  +'d by \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Return the c'
  +'urrent result array as a JSON string.\n"'#13#10'"  JSONResultClear\n"'#13#10
  +'"    Clear the result array.\n"'#13#10'"  Always call JSONFree to release t'
  +'he handle after you are done.\n"'#13#10'"\n"'#13#10'"Example of working wit'
  +'h JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10
  +'"  begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"  '
  +'  if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h'
  +', ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"     '
  +' JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'Available parameters (retrieved with GetParam):\n"'#13#10'"  text - the inp'
  +'ut text to process (possibly truncated to MaxLength)\n"'#13#10'"  source - '
  +'source language code (may be empty)\n"'#13#10'"  target - target language c'
  +'ode\n"'#13#10'"  timestamp - current Unix timestamp in milliseconds (string'
  +')\n"'#13#10'"  random  - 9-digit random number (string)\n"'#13#10'"  rand -'
  +' same as random\n"'#13#10'"  rand1..rand9 - first 1..9 digits of the random'
  +' number\n"'#13#10'"\n"'#13#10'"Additional initial and custom parameters are'
  +' also available."'#13#10'msgstr ""'#13#10'"Skrypt jest standardowym program'
  +'em Pascal: opcjonalna sekcja var, a nast'#196#153'pnie g'#197#130#195#179'w'
  +'ny blok begin ... end.\n"'#13#10'"\n"'#13#10'"Przyk'#197#130'ad:\n"'#13#10
  +'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''text'')'
  +';\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#13#10'"    Se'
  +'tOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Mo'#197#188
  +'esz r'#195#179'wnie'#197#188' u'#197#188'ywa'#196#135' standardowych konstr'
  +'ukcji Pascala (if, for, while, repeat itd.). Mo'#197#188'esz definiowa'#196
  +#135' w'#197#130'asne funkcje i procedury przed g'#197#130#195#179'wnym blok'
  +'iem begin ... end.\n"'#13#10'"\n"'#13#10'"Dost'#196#153'pne funkcje:\n"'#13
  +#10'"  GetParam(''name'') : string\n"'#13#10'"    Pobiera warto'#197#155#196
  +#135' parametru wej'#197#155'ciowego.\n"'#13#10'"  SetOutput(''name'', ''val'
  +'ue'')\n"'#13#10'"    Zapisuje warto'#197#155#196#135' wyj'#197#155'ciow'#196
  +#133' dla hosta.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Bie'#197
  +#188#196#133'cy znacznik czasu Unix w milisekundach (UTC).\n"'#13#10'"  GetR'
  +'andom(Length) : Int64\n"'#13#10'"    Losowa liczba ca'#197#130'kowita zawie'
  +'raj'#196#133'ca dok'#197#130'adnie Length cyfr dziesi'#196#153'tnych.\n"'#13
  +#10'"  Random : Extended\n"'#13#10'"    Losowa liczba zmiennoprzecinkowa z z'
  +'akresu [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'"   '
  +' Konwertuje liczb'#196#153' ca'#197#130'kowit'#196#133' na ci'#196#133'g sz'
  +'esnastkowy zawieraj'#196#133'cy co najmniej Digits znak'#195#179'w.\n"'#13
  +#10'"  StrToInt(S) : Integer\n"'#13#10'"    Konwertuje ci'#196#133'g znak'
  +#195#179'w na liczb'#196#153' ca'#197#130'kowit'#196#133'. Zg'#197#130'asza '
  +'wyj'#196#133'tek w przypadku nieprawid'#197#130'owego wej'#197#155'cia.\n"'
  +#13#10'"  IntToStr(Value) : string\n"'#13#10'"    Konwertuje liczb'#196#153
  +' ca'#197#130'kowit'#196#133' na jej reprezentacj'#196#153' tekstow'#196#133
  +'.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Usuwa bia'#197#130'e znaki z'
  +' pocz'#196#133'tku i ko'#197#132'ca S.\n"'#13#10'"  TrimLeft(S) : string\n"'
  +#13#10'"    Usuwa bia'#197#130'e znaki z pocz'#196#133'tku S.\n"'#13#10'"  T'
  +'rimRight(S) : string\n"'#13#10'"    Usuwa bia'#197#130'e znaki z ko'#197#132
  +'ca S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Koduje specjalne z'
  +'naki HTML w S jako encje.\n"'#13#10'"  HtmlDecode(S) : string\n"'#13#10'"  '
  +'  Dekoduje encje HTML w S z powrotem do znak'#195#179'w.\n"'#13#10'"  UrlEn'
  +'code(S) : string\n"'#13#10'"    Koduje S za pomoc'#196#133' kodowania proce'
  +'ntowego, aby mo'#197#188'na by'#197#130'o bezpiecznie umie'#197#155'ci'#196
  +#135' je w adresie URL.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    De'
  +'koduje ci'#196#133'g S zakodowany za pomoc'#196#133' kodowania procentowego'
  ,'.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : st'
  +'ring\n"'#13#10'"    Zast'#196#153'puje wszystkie wyst'#196#133'pienia OldPa'
  +'ttern w S ci'#196#133'giem NewPattern.\n"'#13#10'"  RegexReplace(Input, Pat'
  +'tern, Replacement) : string\n"'#13#10'"    Zast'#196#153'puje wszystkie dop'
  +'asowania wyra'#197#188'enia regularnego Pattern ci'#196#133'giem Replacemen'
  +'t w Input. Nie rozr'#195#179#197#188'nia wielko'#197#155'ci liter.\n"'#13#10
  +'"  RegexMatch(Input, Pattern) : Boolean\n"'#13#10'"    Sprawdza, czy Input '
  +'pasuje do wyra'#197#188'enia regularnego Pattern. Nie rozr'#195#179#197#188
  +'nia wielko'#197#155'ci liter.\n"'#13#10'"  ExtractBetween(S, StartMarker, E'
  +'ndMarker) : string\n"'#13#10'"    Wyodr'#196#153'bnia podci'#196#133'g S zn'
  +'ajduj'#196#133'cy si'#196#153' mi'#196#153'dzy StartMarker i EndMarker.\n"'
  +#13#10'"\n"'#13#10'"Funkcje JSON (u'#197#188'yj uchwytu zwr'#195#179'conego '
  +'przez JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Analiz'
  +'uje ci'#196#133'g JSON i zwraca uchwyt (>=0). Zwraca -1 w przypadku b'#197
  +#130#196#153'du.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Zwalnia uchwyt'
  +' po zako'#197#132'czeniu u'#197#188'ycia.\n"'#13#10'"  JSONGetString(Handle'
  +', Path) : string\n"'#13#10'"    Pobiera warto'#197#155#196#135' tekstow'#196
  +#133' ze wskazanej '#197#155'cie'#197#188'ki Path.\n"'#13#10'"  JSONGetInt(H'
  +'andle, Path) : Integer\n"'#13#10'"    Pobiera warto'#197#155#196#135' ca'
  +#197#130'kowit'#196#133' ze wskazanej '#197#155'cie'#197#188'ki Path.\n"'#13
  +#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#13#10'"    Pobiera warto'
  +#197#155#196#135' zmiennoprzecinkow'#196#133' ze wskazanej '#197#155'cie'#197
  +#188'ki Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"  '
  +'  Pobiera warto'#197#155#196#135' logiczn'#196#133' ze wskazanej '#197#155
  +'cie'#197#188'ki Path.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Intege'
  +'r\n"'#13#10'"    Pobiera liczb'#196#153' element'#195#179'w tablicy ze wska'
  +'zanej '#197#155'cie'#197#188'ki Path.\n"'#13#10'"  JSONGetArrayString(Handl'
  +'e, Path, Index) : string\n"'#13#10'"    Pobiera warto'#197#155#196#135' tek'
  +'stow'#196#133' elementu tablicy o podanym indeksie Index.\n"'#13#10'"  JSON'
  +'GetArrayInt(Handle, Path, Index) : Integer\n"'#13#10'"    Pobiera warto'#197
  +#155#196#135' ca'#197#130'kowit'#196#133' elementu tablicy o podanym indeksi'
  +'e Index.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Zwr'
  +'aca typ warto'#197#155'ci w Path: \"object\", \"array\", \"string\", \"int\'
  +'", \"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path)'
  +' : Boolean\n"'#13#10'"    Sprawdza, czy okre'#197#155'lona '#197#155'cie'
  +#197#188'ka Path istnieje.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Inicja'
  +'lizuje pust'#196#133' tablic'#196#153' JSON do tworzenia standardowego wyni'
  +'ku b'#197#130#196#153'du.\n"'#13#10'"  JSONResultAddError(Offset, Length, M'
  +'essage, Replacements)\n"'#13#10'"    Dodaje obiekt b'#197#130#196#153'du do'
  +' tablicy wynik'#195#179'w. Replacements to ci'#196#133'g warto'#197#155'ci '
  +'rozdzielonych znakiem \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10
  +'"    Zwraca bie'#197#188#196#133'c'#196#133' tablic'#196#153' wynik'#195#179
  +'w jako ci'#196#133'g JSON.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Czy'
  +#197#155'ci tablic'#196#153' wynik'#195#179'w.\n"'#13#10'"  Zawsze wywo'#197
  +#130'uj JSONFree, aby zwolni'#196#135' uchwyt po zako'#197#132'czeniu jego u'
  +#197#188'ywania.\n"'#13#10'"\n"'#13#10'"Przyk'#197#130'ad pracy z JSON:\n"'
  +#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'
  +#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    if h >= 0 t'
  +'hen\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, ''some.path'
  +''');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);'
  +'\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Dost'#196#153
  +'pne parametry (pobierane za pomoc'#196#133' GetParam):\n"'#13#10'"  text - '
  +'tekst wej'#197#155'ciowy do przetworzenia (mo'#197#188'e zosta'#196#135' ob'
  +'ci'#196#153'ty do MaxLength)\n"'#13#10'"  source - kod j'#196#153'zyka '#197
  +#186'r'#195#179'd'#197#130'owego (mo'#197#188'e by'#196#135' pusty)\n"'#13#10
  +'"  target - kod j'#196#153'zyka docelowego\n"'#13#10'"  timestamp - bie'#197
  +#188#196#133'cy znacznik czasu Unix w milisekundach (ci'#196#133'g znak'#195
  +#179'w)\n"'#13#10'"  random  - losowa liczba 9-cyfrowa (ci'#196#133'g znak'
  +#195#179'w)\n"'#13#10'"  rand - to samo co random\n"'#13#10'"  rand1..rand9 '
  +'- pierwsze 1..9 cyfr liczby losowej\n"'#13#10'"\n"'#13#10'"Dost'#196#153'pn'
  +'e s'#196#133' r'#195#179'wnie'#197#188' dodatkowe parametry pocz'#196#133't'
  +'kowe i niestandardowe."'#13#10#13#10'#: formconfig.rscriptresponsehint'#13
  +#10'msgid ""'#13#10'"This script processes the response data. All functions '
  +'and parameters described in the script hint are available here as well.\n"'
  ,#13#10'"Use GetParam(''result'') to obtain the received text.\n"'#13#10'"\n"'
  +#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'" '
  +'   s := GetParam(''result'');\n"'#13#10'"    SetOutput(''result'', s);\n"'
  +#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define custom parameters in th'
  +'e parameters script using SetParam(''name'', ''value''),\n"'#13#10'"and the'
  +'n retrieve them here with GetParam(''name'')."'#13#10'msgstr ""'#13#10'"Ten'
  +' skrypt przetwarza dane odpowiedzi. Wszystkie funkcje i parametry opisane w'
  +' podpowiedzi skryptu s'#196#133' r'#195#179'wnie'#197#188' dost'#196#153'pn'
  +'e tutaj.\n"'#13#10'"U'#197#188'yj GetParam(''result''), aby uzyska'#196#135
  +' otrzymany tekst.\n"'#13#10'"\n"'#13#10'"Przyk'#197#130'ad:\n"'#13#10'"  va'
  +'r s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n'
  +'"'#13#10'"    SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13
  +#10'"Mo'#197#188'esz zdefiniowa'#196#135' w'#197#130'asne parametry w skrypc'
  +'ie parametr'#195#179'w za pomoc'#196#133' SetParam(''name'', ''value''),\n"'
  +#13#10'"a nast'#196#153'pnie pobra'#196#135' je tutaj za pomoc'#196#133' Get'
  +'Param(''name'')."'#13#10#13#10'#: formconfig.rvaluetype1'#13#10'msgctxt "fo'
  +'rmconfig.rvaluetype1"'#13#10'msgid "None"'#13#10'msgstr "Brak"'#13#10#13#10
