  +'ages"'#10'msgstr "Idiomas"'#10#10'#: tformconfigtrayslate.pagelanguagestarg'
  +'et.caption'#10'msgctxt "tformconfigtrayslate.pagelanguagestarget.caption"'
  +#10'msgid "Target Languages"'#10'msgstr "Idiomas de destino"'#10#10'#: tform'
  +'configtrayslate.pageparameters.caption'#10'msgctxt "tformconfigtrayslate.pa'
  +'geparameters.caption"'#10'msgid "Parameters"'#10'msgstr "Par'#195#162'metro'
  +'s"'#10#10'#: tformconfigtrayslate.pagerequest.caption'#10'msgctxt "tformcon'
  +'figtrayslate.pagerequest.caption"'#10'msgid "Request"'#10'msgstr "Pedido"'
