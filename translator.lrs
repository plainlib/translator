  +#224#164#151' '#224#164#185#224#164#159#224#164#190#224#164#143#224#164#129
  +'"'#10#10'#: formconfig.rnamequestion'#10'msgid "Enter new config file name:'
  +'"'#10'msgstr "'#224#164#168#224#164#136' '#224#164#149#224#165#137#224#164
