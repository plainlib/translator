  +'r Agent"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labellangua'
  +'ges.caption'#10'msgid "Supported languages e.g. en=en-US (en - internal, en'
  +'-US - service). \"empty\" - do not send."'#10'msgstr "Supported languages e'
  +'.g. en=en-US (en - internal, en-US - service). \"empty\" - do not send."'#10
  ,#10'#: tformconfigtrayslate.labellanguages1.caption'#10'msgid "Value type fo'
  +'r populating names. None keeps originals; None and Unit are case-sensitive.'
  +'"'#10'msgstr "Value type for populating names. None keeps originals; None a'
  +'nd Unit are case-sensitive."'#10#10'#: tformconfigtrayslate.labellanguagest'
  +'arget.caption'#10'msgid ""'#10'"Target languages e.g. en=en-US, en - intern'
  +'al, en-US - service code.\n"'#10'"If not specified, both source and target '
  +'languages are taken from the languages section."'#10'msgstr ""'#10'"Target '
  +'languages e.g. en=en-US, en - internal, en-US - service code.\n"'#10'"If no'
  +'t specified, both source and target languages are taken from the languages '
  +'section."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid "'
  +'Max Length, bytes"'#10'msgstr "Max Length, bytes"'#10#10'#: tformconfigtray'
  +'slate.labelmethod.caption'#10'msgid "Method"'#10'msgstr "Method"'#10#10'#: '
  +'tformconfigtrayslate.labelparemeters.caption'#10'msgid "Use parameters: {te'
  +'xt} '#226#128#147' input text, {source} '#226#128#147' source language, {ta'
  +'rget} '#226#128#147' target language. Prefix the name with ! for lowercase '
  +'or ^ for uppercase value. Also supported {timestamp}, {rand}. Use {paramete'
  +'r} from the parameters page."'#10'msgstr "Use parameters: {text} '#226#128
  +#147' input text, {source} '#226#128#147' source language, {target} '#226#128
  +#147' target language. Prefix the name with ! for lowercase or ^ for upperca'
  +'se value. Also supported {timestamp}, {rand}. Use {parameter} from the para'
  +'meters page."'#10#10'#: tformconfigtrayslate.labelpostdata.caption'#10'msgi'
  +'d "Post Data"'#10'msgstr "Post Data"'#10#10'#: tformconfigtrayslate.labelpo'
  +'stdata1.caption'#10'msgctxt "tformconfigtrayslate.labelpostdata1.caption"'
  +#10'msgid "Headers"'#10'msgstr "Headers"'#10#10'#: tformconfigtrayslate.labe'
  +'lservicedescription.caption'#10'msgid "Description"'#10'msgstr "Description'
  +'"'#10#10'#: tformconfigtrayslate.labelservicename.caption'#10'msgid "Name"'
  +#10'msgstr "Name"'#10#10'#: tformconfigtrayslate.labelserviceorder.caption'
  +#10'msgid "Order"'#10'msgstr "Order"'#10#10'#: tformconfigtrayslate.labelsor'
  +'t.caption'#10'msgctxt "tformconfigtrayslate.labelsort.caption"'#10'msgid "S'
  +'ort"'#10'msgstr "Sort"'#10#10'#: tformconfigtrayslate.labeltargetsort.capti'
  +'on'#10'msgctxt "tformconfigtrayslate.labeltargetsort.caption"'#10'msgid "So'
  +'rt"'#10'msgstr "Sort"'#10#10'#: tformconfigtrayslate.labelurl.caption'#10'm'
  +'sgctxt "tformconfigtrayslate.labelurl.caption"'#10'msgid "URL"'#10'msgstr "'
  +'URL"'#10#10'#: tformconfigtrayslate.labeluseragent.caption'#10'msgctxt "tfo'
  +'rmconfigtrayslate.labeluseragent.caption"'#10'msgid "User Agent"'#10'msgstr'
  +' "User Agent"'#10#10'#: tformconfigtrayslate.labelvaluetype.caption'#10'msg'
  +'id "Value Type"'#10'msgstr "Value Type"'#10#10'#: tformconfigtrayslate.page'
  +'initialrequest.caption'#10'msgctxt "tformconfigtrayslate.pageinitialrequest'
  +'.caption"'#10'msgid "Initial Request"'#10'msgstr "Initial Request"'#10#10'#'
  +': tformconfigtrayslate.pagelanguages.caption'#10'msgctxt "tformconfigtraysl'
  +'ate.pagelanguages.caption"'#10'msgid "Languages"'#10'msgstr "Languages"'#10
  +#10'#: tformconfigtrayslate.pagelanguagestarget.caption'#10'msgctxt "tformco'
  +'nfigtrayslate.pagelanguagestarget.caption"'#10'msgid "Target Languages"'#10
  +'msgstr "Target Languages"'#10#10'#: tformconfigtrayslate.pageparameters.cap'
  +'tion'#10'msgctxt "tformconfigtrayslate.pageparameters.caption"'#10'msgid "P'
  +'arameters"'#10'msgstr "Parameters"'#10#10'#: tformconfigtrayslate.pagereque'
  +'st.caption'#10'msgctxt "tformconfigtrayslate.pagerequest.caption"'#10'msgid'
  +' "Request"'#10'msgstr "Request"'#10#10'#: tformconfigtrayslate.pageresponse'
  +'.caption'#10'msgid "Response"'#10'msgstr "Response"'#10#10'#: tformconfigtr'
  +'ayslate.pageservice.caption'#10'msgctxt "tformconfigtrayslate.pageservice.c'
  +'aption"'#10'msgid "Service"'#10'msgstr "Service"'#10#10'#: tformconfigtrays'
  +'late.reloadconfigs.hint'#10'msgid "Reload configurations from disk"'#10'msg'
  +'str "Reload configurations from disk"'#10#10'#: tformconfigtrayslate.sbcopy'
  +'config.hint'#10'msgid "Copy configuration"'#10'msgstr "Copy configuration"'
  +#10#10'#: tformconfigtrayslate.sbnewconfig.hint'#10'msgid "New configuration'
  +'"'#10'msgstr "New configuration"'#10#10
]);
LazarusResources.Add('formconfig.es','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: es\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Editor de configuraci'#195#179'n"'#10#10'#: formconfig.rclearlangua'
  +'ges'#10'msgid "The list is already filled. Do you want to clear it?"'#10'ms'
  +'gstr "La lista ya est'#195#161' llena. '#194#191'Quiere vaciarla?"'#10#10'#'
  +': formconfig.rdeleteconfig'#10'msgid "Are you sure you want to delete confi'
  +'g"'#10'msgstr "'#194#191'Est'#195#161' seguro de que desea eliminar la conf'
  +'iguraci'#195#179'n"'#10#10'#: formconfig.rdeleteconfigcaption'#10'msgid "De'
  +'lete config"'#10'msgstr "Eliminar configuraci'#195#179'n"'#10#10'#: formcon'
  +'fig.rnamequestion'#10'msgid "Enter new config file name:"'#10'msgstr "Intro'
  +'duzca el nombre del nuevo archivo de configuraci'#195#179'n:"'#10#10'#: for'
  +'mconfig.rneedsave'#10'msgid "The configuration was modified. Save changes?"'
  +#10'msgstr "La configuraci'#195#179'n ha sido modificada. '#194#191'Guardar '
  +'los cambios?"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Poi'
  +'nter: Use / for levels, keys for objects, and numbers for indexes.\n"'#10'"'
  +'Use * for all items, *#10 to join items by newline. Use ~ at the end of the'
  +' path to return the raw JSON branch.\n"'#10'"Separate multiple segments wit'
  +'h semicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag'
  +' #10 for newlines. Use {{regex}} inside to extract data directly into the t'
  +'ext.\n"'#10'"Logic: If a Pointer in a segment is empty, the whole segment i'
  +'s skipped. If a segment has no Pointer, only literal text blocks with embed'
  +'ded regular expressions are processed.\n"'#10'"Regex: {prefix {regex[index]'
  +'} suffix} inside a text block. If no [index] is specified, the first match '
  +'is used.\n"'#10'"Index can be a number, [*] (join by space), or [*#10] (joi'
  +'n by newline). If the regex finds no match, the entire {'#226#128#166'} blo'
  +'ck is removed.\n"'#10'"Using ~ inside a regex returns the entire text.\n"'
  +#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show its text'
  +' only if the Pointer data is missing or the JSON is invalid.\n"'#10'"Commen'
  +'ting: /* text */ comments are stripped from the entire expression before an'
  +'y processing.\n"'#10'"Examples:\n"'#10'"responseData/translatedText; matche'
  +'s/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({'
  +'(\\w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#10'ms'
  +'gstr ""'#10'"Puntero JSON: Use / para los niveles, claves para los objetos '
  +'y n'#195#186'meros para los '#195#173'ndices. Use * para todos los elemento'
  +'s y *#10 para unir los elementos mediante un salto de l'#195#173'nea. Use ~'
  +' al final de la ruta para devolver la rama JSON sin procesar. Separe varios'
  +' segmentos con punto y coma ;.\n"'#10'"Literal: Bloque de texto entre {'#226
  +#128#166'}. Etiqueta especial #10 para los saltos de l'#195#173'nea. Use {{r'
  +'egex}} dentro para extraer datos directamente en el texto.\n"'#10'"L'#195
  +#179'gica: Si un puntero de un segmento est'#195#161' vac'#195#173'o, se omi'
  +'te todo el segmento. Si un segmento no tiene puntero, solo se procesan los '
  +'bloques de texto literal con expresiones regulares incrustadas.\n"'#10'"Reg'
  +'ex: {prefijo {regex[index]} sufijo} dentro de un bloque de texto. Si no se '
  +'especifica [index], se utiliza la primera coincidencia. El '#195#173'ndice '
  +'puede ser un n'#195#186'mero, [*] (unir con un espacio) o [*#10] (unir con '
  +'un salto de l'#195#173'nea). Si la expresi'#195#179'n regular no encuentra '
  +'ninguna coincidencia, se elimina todo el bloque {'#226#128#166'}. El uso de'
  +' ~ dentro de una expresi'#195#179'n regular devuelve el texto completo.\n"'
  +#10'"Inversi'#195#179'n: Comience un segmento con ! (por ejemplo, !/path{Err'
  +'or}) para mostrar su texto solo si faltan los datos del puntero o el JSON n'
  +'o es v'#195#161'lido.\n"'#10'"Comentarios: Los comentarios /* texto */ se e'
  +'liminan de toda la expresi'#195#179'n antes de cualquier procesamiento.\n"'
  +#10'"Ejemplos:\n"'#10'"responseData/translatedText; matches/*#10/translation'
  +'; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/trans'
  +'lations{Error: No data!#10}; /translations"'#10#10'#: formconfig.rscripthin'
  +'t'#10'msgid ""'#10'"The script is a standard Pascal program: optional var s'
  +'ection, then a main begin ... end. block.\n"'#10'"\n"'#10'"Example:\n"'#10
  +'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'
  +#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''te'
  +'xt'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can also use standard Pascal '
  ,'constructs (if, for, while, repeat, etc.). You can define your own function'
  +'s and procedures before the main begin ... end. block.\n"'#10'"\n"'#10'"Ava'
  +'ilable functions:\n"'#10'"  GetParam(''name'') : string\n"'#10'"    Retriev'
  +'e an input parameter value.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10
  +'"    Store an output value for the host.\n"'#10'"  GetTimestamp() : Int64\n'
  +'"'#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#10'"  GetRando'
  +'m(Length) : Int64\n"'#10'"    Random integer with exactly Length decimal di'
  +'gits.\n"'#10'"  Random : Extended\n"'#10'"    Random float in the range [0,'
  +' 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Convert integer'
  +' to hexadecimal string with at least Digits characters.\n"'#10'"  StrToInt('
  +'S) : Integer\n"'#10'"    Convert a string to an integer. Raises an exceptio'
  +'n on invalid input.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Convert '
  +'an integer to its string representation.\n"'#10'"  Trim(S) : string\n"'#10
  +'"    Remove leading and trailing whitespace from S.\n"'#10'"  TrimLeft(S) :'
  +' string\n"'#10'"    Remove leading whitespace from S.\n"'#10'"  TrimRight(S'
  +') : string\n"'#10'"    Remove trailing whitespace from S.\n"'#10'"  HtmlEnc'
  +'ode(S) : string\n"'#10'"    Encode special HTML characters in S into entiti'
  +'es.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decode HTML entities in S '
  +'back to characters.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    Percent-enc'
  +'ode S for safe URL inclusion.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    D'
  +'ecode a percent-encoded string S.\n"'#10'"  ReplaceAll(S, OldPattern, NewPa'
  +'ttern, IgnoreCase=False) : string\n"'#10'"    Replace all occurrences of Ol'
  +'dPattern with NewPattern in S.\n"'#10'"  RegexReplace(Input, Pattern, Repla'
  +'cement) : string\n"'#10'"    Replace all regex matches of Pattern with Repl'
  +'acement in Input. Case-insensitive.\n"'#10'"  RegexMatch(Input, Pattern) : '
  +'Boolean\n"'#10'"    Check if Input matches the regex Pattern. Case-insensit'
  +'ive.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10'" '
  +'   Extract the substring of S between StartMarker and EndMarker.\n"'#10'"\n'
  +'"'#10'"JSON functions (use a handle returned by JSONParse):\n"'#10'"  JSONP'
  +'arse(S) : Integer\n"'#10'"    Parse a JSON string and return a handle (>=0)'
  +'. Returns -1 on error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Release the h'
  +'andle after use.\n"'#10'"  JSONGetString(Handle, Path) : string\n"'#10'"   '
  +' Get a string value at the specified Path.\n"'#10'"  JSONGetInt(Handle, Pat'
  +'h) : Integer\n"'#10'"    Get an integer value at the specified Path.\n"'#10
  +'"  JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Get a floating-point v'
  +'alue at the specified Path.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n'
  +'"'#10'"    Get a boolean value at the specified Path.\n"'#10'"  JSONGetArra'
  +'yCount(Handle, Path) : Integer\n"'#10'"    Get the number of elements in an'
  +' array at the specified Path.\n"'#10'"  JSONGetArrayString(Handle, Path, In'
  +'dex) : string\n"'#10'"    Get the string value of an array element at the g'
  +'iven Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#10
  +'"    Get the integer value of an array element at the given Index.\n"'#10'"'
  +'  JSONGetType(Handle, Path) : string\n"'#10'"    Return the type of the val'
  +'ue at Path: \"object\", \"array\", \"string\", \"int\", \"float\", \"bool\"'
  +', \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10'"    Ch'
  +'eck if the specified Path exists.\n"'#10'"  JSONResultInit\n"'#10'"    Init'
  +'ialize an empty JSON array for building a standard error result.\n"'#10'"  '
  +'JSONResultAddError(Offset, Length, Message, Replacements)\n"'#10'"    Add a'
  +'n error object to the result array. Replacements is a string of values sepa'
  +'rated by \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"    Return the cur'
  +'rent result array as a JSON string.\n"'#10'"  JSONResultClear\n"'#10'"    C'
  +'lear the result array.\n"'#10'"  Always call JSONFree to release the handle'
  +' after you are done.\n"'#10'"\n"'#10'"Example of working with JSON:\n"'#10
  +'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h :'
  +'= JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    b'
  +'egin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetO'
  +'utput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  e'
  +'nd.\n"'#10'"\n"'#10'"Available parameters (retrieved with GetParam):\n"'#10
  +'"  text - the input text to process (possibly truncated to MaxLength)\n"'#10
  +'"  source - source language code (may be empty)\n"'#10'"  target - target l'
  +'anguage code\n"'#10'"  timestamp - current Unix timestamp in milliseconds ('
  +'string)\n"'#10'"  random  - 9-digit random number (string)\n"'#10'"  rand -'
  +' same as random\n"'#10'"  rand1..rand9 - first 1..9 digits of the random nu'
  +'mber\n"'#10'"\n"'#10'"Additional initial and custom parameters are also ava'
  ,'ilable."'#10'msgstr ""'#10'"El script es un programa Pascal est'#195#161'nd'
  +'ar: una secci'#195#179'n var opcional, seguida de un bloque principal begin'
  +' ... end.\n"'#10'"\n"'#10'"Ejemplo:\n"'#10'"  var s: string;\n"'#10'"  begi'
  +'n\n"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'''
  +', ''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"Tambi'#195#169'n puedes utilizar las construcciones est'#195#161
  +'ndar de Pascal (if, for, while, repeat, etc.). Puedes definir tus propias f'
  +'unciones y procedimientos antes del bloque principal begin ... end.\n"'#10
  +'"\n"'#10'"Funciones disponibles:\n"'#10'"  GetParam(''name'') : string\n"'
  +#10'"    Recupera el valor de un par'#195#161'metro de entrada.\n"'#10'"  Se'
  +'tOutput(''name'', ''value'')\n"'#10'"    Almacena un valor de salida para e'
  +'l host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Marca de tiempo Unix a'
  +'ctual en milisegundos (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"  '
  +'  N'#195#186'mero entero aleatorio con exactamente Length d'#195#173'gitos '
  +'decimales.\n"'#10'"  Random : Extended\n"'#10'"    N'#195#186'mero de coma '
  +'flotante aleatorio en el rango [0, 1).\n"'#10'"  IntToHex(Value, Digits) : '
  +'string\n"'#10'"    Convierte un n'#195#186'mero entero en una cadena hexade'
  +'cimal con al menos Digits caracteres.\n"'#10'"  StrToInt(S) : Integer\n"'#10
  +'"    Convierte una cadena en un n'#195#186'mero entero. Genera una excepci'
  +#195#179'n si la entrada no es v'#195#161'lida.\n"'#10'"  IntToStr(Value) : '
  +'string\n"'#10'"    Convierte un n'#195#186'mero entero en su representaci'
  +#195#179'n como cadena.\n"'#10'"  Trim(S) : string\n"'#10'"    Elimina los e'
  +'spacios en blanco iniciales y finales de S.\n"'#10'"  TrimLeft(S) : string\'
  +'n"'#10'"    Elimina los espacios en blanco iniciales de S.\n"'#10'"  TrimRi'
  +'ght(S) : string\n"'#10'"    Elimina los espacios en blanco finales de S.\n"'
  +#10'"  HtmlEncode(S) : string\n"'#10'"    Codifica los caracteres HTML espec'
  +'iales de S como entidades.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Dec'
  +'odifica las entidades HTML de S y las convierte de nuevo en caracteres.\n"'
  +#10'"  UrlEncode(S) : string\n"'#10'"    Codifica S mediante codificaci'#195
  +#179'n porcentual para incluirlo de forma segura en una URL.\n"'#10'"  UrlDe'
  +'code(S) : string\n"'#10'"    Decodifica una cadena S codificada mediante po'
  +'rcentajes.\n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False'
  +') : string\n"'#10'"    Reemplaza todas las apariciones de OldPattern por Ne'
  +'wPattern en S.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string'
  +'\n"'#10'"    Reemplaza todas las coincidencias de la expresi'#195#179'n reg'
  +'ular Pattern por Replacement en Input. No distingue entre may'#195#186'scul'
  +'as y min'#195#186'sculas.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'
  +#10'"    Comprueba si Input coincide con la expresi'#195#179'n regular Patte'
  +'rn. No distingue entre may'#195#186'sculas y min'#195#186'sculas.\n"'#10'" '
  +' ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10'"    Extrae la s'
  +'ubcadena de S situada entre StartMarker y EndMarker.\n"'#10'"\n"'#10'"Funci'
  +'ones JSON (utiliza un handle devuelto por JSONParse):\n"'#10'"  JSONParse(S'
  +') : Integer\n"'#10'"    Analiza una cadena JSON y devuelve un handle (>=0).'
  +' Devuelve -1 en caso de error.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Liber'
  +'a el handle despu'#195#169's de su uso.\n"'#10'"  JSONGetString(Handle, Pat'
  +'h) : string\n"'#10'"    Obtiene un valor de tipo cadena en la ruta especifi'
  +'cada Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Obtiene'
  +' un valor entero en la ruta especificada Path.\n"'#10'"  JSONGetFloat(Handl'
  +'e, Path) : Extended\n"'#10'"    Obtiene un valor de coma flotante en la rut'
  +'a especificada Path.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"'
  +'    Obtiene un valor booleano en la ruta especificada Path.\n"'#10'"  JSONG'
  +'etArrayCount(Handle, Path) : Integer\n"'#10'"    Obtiene el n'#195#186'mero'
  +' de elementos de un array en la ruta especificada Path.\n"'#10'"  JSONGetAr'
  +'rayString(Handle, Path, Index) : string\n"'#10'"    Obtiene el valor de tip'
  +'o cadena de un elemento del array en el '#195#173'ndice indicado Index.\n"'
  +#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'#10'"    Obtiene el'
  +' valor entero de un elemento del array en el '#195#173'ndice indicado Index'
  +'.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Devuelve el tipo'
  +' del valor en Path: \"object\", \"array\", \"string\", \"int\", \"float\", '
  +'\"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#10
  +'"    Comprueba si existe la ruta especificada Path.\n"'#10'"  JSONResultIni'
  +'t\n"'#10'"    Inicializa un array JSON vac'#195#173'o para crear un resulta'
  +'do de error est'#195#161'ndar.\n"'#10'"  JSONResultAddError(Offset, Length,'
  +' Message, Replacements)\n"'#10'"    A'#195#177'ade un objeto de error al ar'
  ,'ray de resultados. Replacements es una cadena de valores separados por \"|\'
  +'".\n"'#10'"  JSONResultGet : string\n"'#10'"    Devuelve el array de result'
  +'ados actual como una cadena JSON.\n"'#10'"  JSONResultClear\n"'#10'"    Bor'
  +'ra el array de resultados.\n"'#10'"  Llama siempre a JSONFree para liberar '
  +'el handle cuando hayas terminado de utilizarlo.\n"'#10'"\n"'#10'"Ejemplo de'
  +' trabajo con JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10
  +'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    if h'
  +' >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.pat'
  +'h'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'
  +#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Par'#195#161'metros disponible'
  +'s (recuperados mediante GetParam):\n"'#10'"  text - el texto de entrada que'
  +' se va a procesar (posiblemente truncado a MaxLength)\n"'#10'"  source - c'
  +#195#179'digo del idioma de origen (puede estar vac'#195#173'o)\n"'#10'"  ta'
  +'rget - c'#195#179'digo del idioma de destino\n"'#10'"  timestamp - marca de'
  +' tiempo Unix actual en milisegundos (cadena)\n"'#10'"  random  - n'#195#186
  +'mero aleatorio de 9 d'#195#173'gitos (cadena)\n"'#10'"  rand - igual que ra'
  +'ndom\n"'#10'"  rand1..rand9 - los primeros 1..9 d'#195#173'gitos del n'#195
  +#186'mero aleatorio\n"'#10'"\n"'#10'"Tambi'#195#169'n est'#195#161'n disponi'
  +'bles par'#195#161'metros iniciales y personalizados adicionales. personaliz'
  +'ados adicionales."'#10#10'#: formconfig.rscriptresponsehint'#10'msgid ""'#10
  +'"This script processes the response data. All functions and parameters desc'
  +'ribed in the script hint are available here as well.\n"'#10'"Use GetParam('
  +'''result'') to obtain the received text.\n"'#10'"\n"'#10'"Example:\n"'#10'"'
  +'  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'
  +#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You can d'
  +'efine custom parameters in the parameters script using SetParam(''name'', '
  +'''value''),\n"'#10'"and then retrieve them here with GetParam(''name'')."'
  +#10'msgstr ""'#10'"Este script procesa los datos de respuesta. Todas las fun'
  +'ciones y par'#195#161'metros descritos en la ayuda del script tambi'#195#169
  +'n est'#195#161'n disponibles aqu'#195#173'.\n"'#10'"Use GetParam(''result'''
  +') para obtener el texto recibido.\n"'#10'"\n"'#10'"Ejemplo:\n"'#10'"  var s'
  +': string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');\n"'#10'"  '
  +'  SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Puede definir p'
  +'ar'#195#161'metros personalizados en el script de par'#195#161'metros media'
  +'nte SetParam(''name'', ''value''),\n"'#10'"y luego recuperarlos aqu'#195#173
  +' con GetParam(''name'')."'#10#10'#: formconfig.rvaluetype1'#10'msgctxt "for'
  +'mconfig.rvaluetype1"'#10'msgid "None"'#10'msgstr "Ninguno"'#10#10'#: formco'
  +'nfig.rvaluetype2'#10'msgid "Language"'#10'msgstr "Idioma"'#10#10'#: formcon'
  +'fig.rvaluetype3'#10'msgid "Currency All"'#10'msgstr "Todas las monedas"'#10
  +#10'#: formconfig.rvaluetype4'#10'msgid "Currency Fiat Only"'#10'msgstr "Sol'
  +'o monedas fiat"'#10#10'#: formconfig.rvaluetype5'#10'msgid "Currency Crypto'
  +' Only"'#10'msgstr "Solo criptomonedas"'#10#10'#: formconfig.rvaluetype6'#10
  +'msgid "Measurement Units"'#10'msgstr "Unidades de medida"'#10#10'#: tformco'
  +'nfigtrayslate.aclearicon.caption'#10'msgid "Clear Icon"'#10'msgstr "Borrar '
  +'icono"'#10#10'#: tformconfigtrayslate.asave.caption'#10'msgid "Save"'#10'ms'
  +'gstr "Guardar"'#10#10'#: tformconfigtrayslate.asaveiconas.caption'#10'msgid'
  +' "Save Icon As..."'#10'msgstr "Guardar icono como..."'#10#10'#: tformconfig'
  +'trayslate.btnclose.caption'#10'msgid "Close"'#10'msgstr "Cerrar"'#10#10'#: '
