  +'#: tformconfigtrayslate.pageinitialrequest.caption'#10'msgctxt "tformconfig'
  +'trayslate.pageinitialrequest.caption"'#10'msgid "Initial Request"'#10'msgst'
  +'r "Solicitud inicial"'#10#10'#: tformconfigtrayslate.pagelanguages.caption'
