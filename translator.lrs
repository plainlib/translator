  +#143#132' '#236#167#128#236#155#144#235#144#169#235#139#136#235#139#164'. '
  +#235#167#164#234#176#156#235#179#128#236#136#152' '#237#142#152#236#157#180
  +#236#167#128#236#157#152' {parameter}'#235#165#188' '#236#130#172#236#154#169
  +#237#149#152#236#132#184#236#154#148'."'#10#10'#: tformconfigtrayslate.label'
