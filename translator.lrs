LazarusResources.Add('formconfig.fi','PO',[
  'msgid ""'#13#10'msgstr ""'#13#10'"Project-Id-Version: \n"'#13#10'"POT-Creati'
  +'on-Date: \n"'#13#10'"PO-Revision-Date: 2026-11-04 14:41-0300\n"'#13#10'"Las'
  +'t-Translator: plaintool <astverskoy@gmail.com>\n"'#13#10'"Language-Team: \n'
  +'"'#13#10'"Language: fi\n"'#13#10'"MIME-Version: 1.0\n"'#13#10'"Content-Type'
  +': text/plain; charset=UTF-8\n"'#13#10'"Content-Transfer-Encoding: 8bit\n"'
  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Konfiguraatioeditori"'#13#10#13#10'#: formconfig.rclearlanguages'#13#10'm'
  +'sgid "The list is already filled. Do you want to clear it?"'#13#10'msgstr "'
  +'Luettelo on jo t'#195#164'ytetty. Tyhjennet'#195#164#195#164'nk'#195#182' s'
  +'e?"'#13#10#13#10'#: formconfig.rconfigeditor'#13#10'msgid "Config Editor...'
  +'"'#13#10'msgstr "Konfiguraatioeditori..."'#13#10#13#10'#: formconfig.rdelet'
  +'econfig'#13#10'msgid "Are you sure you want to delete config"'#13#10'msgstr'
  +' "Oletko varma, ett'#195#164' haluat poistaa konfiguraation"'#13#10#13#10'#'
  +': formconfig.rdeleteconfigcaption'#13#10'msgid "Delete config"'#13#10'msgst'
  +'r "Poista konfiguraatio"'#13#10#13#10'#: formconfig.rfilechangedcancel'#13
  +#10'msgid "Cancel"'#13#10'msgstr "Peruuta"'#13#10#13#10'#: formconfig.rfilec'
  +'hangedkeepchanges'#13#10'msgid "Keep my changes"'#13#10'msgstr "S'#195#164
  +'ilyt'#195#164' muutokseni"'#13#10#13#10'#: formconfig.rfilechangedmsg'#13#10
  +'#, object-pascal-format'#13#10'msgid "The file \"%s\" has been modified by '
  +'another application since it was opened."'#13#10'msgstr "Toinen sovellus on'
  +' muuttanut tiedostoa \"%s\" sen avaamisen j'#195#164'lkeen."'#13#10#13#10'#'
  +': formconfig.rfilechangedmsgactivate'#13#10'msgid "You have unsaved changes'
  +'. Keep them or reload from disk?"'#13#10'msgstr "Sinulla on tallentamattomi'
  +'a muutoksia. S'#195#164'ilytet'#195#164#195#164'nk'#195#182' ne vai ladataa'
  +'nko tiedosto uudelleen levylt'#195#164'?"'#13#10#13#10'#: formconfig.rfilec'
  +'hangedreloaddisk'#13#10'msgid "Reload from disk"'#13#10'msgstr "Lataa levyl'
  +'t'#195#164' uudelleen"'#13#10#13#10'#: formconfig.rfilechangedtitle'#13#10
  +'msgid "File changed on disk"'#13#10'msgstr "Tiedostoa on muutettu levyll'
  +#195#164'"'#13#10#13#10'#: formconfig.rnamequestion'#13#10'msgid "Enter new '
  +'config file name:"'#13#10'msgstr "Sy'#195#182't'#195#164' uuden konfiguraat'
  +'iotiedoston nimi:"'#13#10#13#10'#: formconfig.rneedsave'#13#10'msgid "The c'
  +'onfiguration was modified. Save changes?"'#13#10'msgstr "Konfiguraatiota on'
  +' muutettu. Tallennetaanko muutokset?"'#13#10#13#10'#: formconfig.rresponseh'
  +'int'#13#10'msgid ""'#13#10'"Json Pointer: Use / for levels, keys for object'
  +'s, and numbers for indexes.\n"'#13#10'"Use * for all items, *#10 to join it'
  +'ems by newline. Use ~ at the end of the path to return the raw JSON branch.'
  +'\n"'#13#10'"Separate multiple segments with semicolon ;.\n"'#13#10'"Literal'
  +': Text block in {'#226#128#166'}. Special tag #10 for newlines. Use {{regex'
  +'}} inside to extract data directly into the text.\n"'#13#10'"Logic: If a Po'
  +'inter in a segment is empty, the whole segment is skipped. If a segment has'
  +' no Pointer, only literal text blocks with embedded regular expressions are'
  +' processed.\n"'#13#10'"Regex: {prefix {regex[index]} suffix} inside a text '
  +'block. If no [index] is specified, the first match is used.\n"'#13#10'"Inde'
  +'x can be a number, [*] (join by space), or [*#10] (join by newline). If the'
  +' regex finds no match, the entire {'#226#128#166'} block is removed.\n"'#13
  +#10'"Using ~ inside a regex returns the entire text.\n"'#13#10'"Inversion: S'
  +'tart a segment with ! (e.g. !/path{Error}) to show its text only if the Poi'
  +'nter data is missing or the JSON is invalid.\n"'#13#10'"Commenting: /* text'
  +' */ comments are stripped from the entire expression before any processing.'
  +'\n"'#13#10'"Examples:\n"'#13#10'"responseData/translatedText; matches/*#10/'
  +'translation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)}'
  +')}; !/translations{Error: No data!#10}; /translations/0/text"'#13#10'msgstr'
  +' ""'#13#10'"JSON-osoitin: K'#195#164'yt'#195#164' /-merkki'#195#164' tasoil'
  +'le, avaimia objekteille ja numeroita indekseille. K'#195#164'yt'#195#164' *'
  +'-merkki'#195#164' kaikille kohteille ja *#10 yhdist'#195#164'm'#195#164#195
  +#164'n kohteet rivinvaihdolla. K'#195#164'yt'#195#164' ~-merkki'#195#164' po'
  +'lun lopussa palauttaaksesi k'#195#164'sittelem'#195#164'tt'#195#182'm'#195
  +#164'n JSON-haaran. Erottele useita segmenttej'#195#164' puolipisteell'#195
  +#164' ;.\n"'#13#10'"Literaali: Tekstilohko muodossa {'#226#128#166'}. Erikoi'
  +'stunniste #10 rivinvaihdoille. K'#195#164'yt'#195#164' {{regex}}-rakennetta'
  +' lohkon sis'#195#164'll'#195#164' poimiaksesi tiedot suoraan tekstiin.\n"'
  +#13#10'"Logiikka: Jos segmentin osoitin on tyhj'#195#164', koko segmentti oh'
  +'itetaan. Jos segmentill'#195#164' ei ole osoitinta, k'#195#164'sitell'#195
  ,#164#195#164'n vain literaaliset tekstilohkot, joissa on upotettuja s'#195
  +#164#195#164'nn'#195#182'llisi'#195#164' lausekkeita.\n"'#13#10'"Regex: {etu'
  +'liite {regex[index]} j'#195#164'lkiliite} tekstilohkon sis'#195#164'll'#195
  +#164'. Jos [index]-arvoa ei ole m'#195#164#195#164'ritetty, k'#195#164'ytet'
  +#195#164#195#164'n ensimm'#195#164'ist'#195#164' osumaa. Indeksi voi olla nu'
  +'mero, [*] (yhdist'#195#164' v'#195#164'lily'#195#182'nnill'#195#164') tai ['
  +'*#10] (yhdist'#195#164' rivinvaihdolla). Jos s'#195#164#195#164'nn'#195#182
  +'llinen lauseke ei l'#195#182'yd'#195#164' osumaa, koko {'#226#128#166'}-loh'
  +'ko poistetaan. Merkin ~ k'#195#164'ytt'#195#164'minen s'#195#164#195#164'nn'
  +#195#182'llisen lausekkeen sis'#195#164'll'#195#164' palauttaa koko tekstin.'
  +'\n"'#13#10'"K'#195#164#195#164'nteinen ehto: Aloita segmentti merkill'#195
  +#164' ! (esim. !/path{Error}), jotta sen teksti n'#195#164'ytet'#195#164#195
  +#164'n vain, jos osoittimen tiedot puuttuvat tai JSON ei ole kelvollinen.\n"'
  +#13#10'"Kommentit: Kommentit muodossa /* teksti */ poistetaan koko lausekkee'
  +'sta ennen mit'#195#164#195#164'n k'#195#164'sittely'#195#164'.\n"'#13#10'"E'
  +'simerkkej'#195#164':\n"'#13#10'"responseData/translatedText; matches/*#10/t'
  +'ranslation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})'
  +'}; !/translations{Error: No data!#10}; /translations"'#13#10#13#10'#: formc'
  +'onfig.rscripthint'#13#10'msgid ""'#13#10'"The script is a standard Pascal p'
  +'rogram: optional var section, then a main begin ... end. block.\n"'#13#10'"'
  +'\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13
  +#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', '
  +'''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'
  +#13#10'"\n"'#13#10'"You can also use standard Pascal constructs (if, for, wh'
  +'ile, repeat, etc.). You can define your own functions and procedures before'
  +' the main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Available functions:'
  +'\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Retrieve an input '
  +'parameter value.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'#13#10'"   '
  +' Store an output value for the host.\n"'#13#10'"  GetTimestamp() : Int64\n"'
  +#13#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#13#10'"  GetRa'
  +'ndom(Length) : Int64\n"'#13#10'"    Random integer with exactly Length deci'
  +'mal digits.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random float in t'
  +'he range [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n"'#13#10'" '
  +'   Convert integer to hexadecimal string with at least Digits characters.\n'
  +'"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convert a string to an int'
  +'eger. Raises an exception on invalid input.\n"'#13#10'"  IntToStr(Value) : '
  +'string\n"'#13#10'"    Convert an integer to its string representation.\n"'
  +#13#10'"  Trim(S) : string\n"'#13#10'"    Remove leading and trailing whites'
  +'pace from S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Remove leadin'
  +'g whitespace from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10'"    Remo'
  +'ve trailing whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10
  +'"    Encode special HTML characters in S into entities.\n"'#13#10'"  HtmlDe'
  +'code(S) : string\n"'#13#10'"    Decode HTML entities in S back to character'
  +'s.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encode S for s'
  +'afe URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'"    Decode'
  +' a percent-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPatt'
  +'ern, IgnoreCase=False) : string\n"'#13#10'"    Replace all occurrences of O'
  +'ldPattern with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, Pattern, R'
  +'eplacement) : string\n"'#13#10'"    Replace all regex matches of Pattern wi'
  +'th Replacement in Input. Case-insensitive.\n"'#13#10'"  RegexMatch(Input, P'
  +'attern) : Boolean\n"'#13#10'"    Check if Input matches the regex Pattern. '
  +'Case-insensitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndMarker) : '
  +'string\n"'#13#10'"    Extract the substring of S between StartMarker and En'
  +'dMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a handle returned by JS'
  +'ONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse a JSON s'
  +'tring and return a handle (>=0). Returns -1 on error.\n"'#13#10'"  JSONFree'
  +'(Handle)\n"'#13#10'"    Release the handle after use.\n"'#13#10'"  JSONGetS'
  +'tring(Handle, Path) : string\n"'#13#10'"    Get a string value at the speci'
  +'fied Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    G'
  +'et an integer value at the specified Path.\n"'#13#10'"  JSONGetFloat(Handle'
  +', Path) : Extended\n"'#13#10'"    Get a floating-point value at the specifi'
  +'ed Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Ge'
  +'t a boolean value at the specified Path.\n"'#13#10'"  JSONGetArrayCount(Han'
  +'dle, Path) : Integer\n"'#13#10'"    Get the number of elements in an array '
  ,'at the specified Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Index)'
  +' : string\n"'#13#10'"    Get the string value of an array element at the gi'
  +'ven Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'
  +#13#10'"    Get the integer value of an array element at the given Index.\n"'
  +#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Return the type '
  +'of the value at Path: \"object\", \"array\", \"string\", \"int\", \"float\"'
  +', \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n'
  +'"'#13#10'"    Check if the specified Path exists.\n"'#13#10'"  JSONResultIn'
  +'it\n"'#13#10'"    Initialize an empty JSON array for building a standard er'
  +'ror result.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Replac'
  +'ements)\n"'#13#10'"    Add an error object to the result array. Replacement'
  +'s is a string of values separated by \"|\".\n"'#13#10'"  JSONResultGet : st'
  +'ring\n"'#13#10'"    Return the current result array as a JSON string.\n"'#13
  +#10'"  JSONResultClear\n"'#13#10'"    Clear the result array.\n"'#13#10'"  A'
  +'lways call JSONFree to release the handle after you are done.\n"'#13#10'"\n'
  +'"'#13#10'"Example of working with JSON:\n"'#13#10'"  var h: Integer;\n"'#13
  +#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetPa'
  +'ram(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13
  +#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput('
  +'''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"'
  +'  end.\n"'#13#10'"\n"'#13#10'"Available parameters (retrieved with GetParam'
  +'):\n"'#13#10'"  text - the input text to process (possibly truncated to Max'
  +'Length)\n"'#13#10'"  source - source language code (may be empty)\n"'#13#10
  +'"  target - target language code\n"'#13#10'"  timestamp - current Unix time'
  +'stamp in milliseconds (string)\n"'#13#10'"  random  - 9-digit random number'
  +' (string)\n"'#13#10'"  rand - same as random\n"'#13#10'"  rand1..rand9 - fi'
  +'rst 1..9 digits of the random number\n"'#13#10'"\n"'#13#10'"Additional init'
  +'ial and custom parameters are also available."'#13#10'msgstr ""'#13#10'"Skr'
  +'ipti on tavallinen Pascal-ohjelma: valinnainen var-osio ja sen j'#195#164'l'
  +'keen p'#195#164#195#164'lohko begin ... end.\n"'#13#10'"\n"'#13#10'"Esimerk'
  +'ki:\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetP'
  +'aram(''text'');\n"'#13#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'
  +#13#10'"    SetOutput(''text'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10
  +'"Voit k'#195#164'ytt'#195#164#195#164' my'#195#182's Pascalin tavallisia ra'
  +'kenteita (if, for, while, repeat jne.). Voit m'#195#164#195#164'ritell'#195
  +#164' omia funktioita ja proseduureja ennen p'#195#164#195#164'lohkoa begin '
  +'... end.\n"'#13#10'"\n"'#13#10'"K'#195#164'ytett'#195#164'viss'#195#164' ol'
  +'evat funktiot:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Hake'
  +'e sy'#195#182'teparametrin arvon.\n"'#13#10'"  SetOutput(''name'', ''value'
  +''')\n"'#13#10'"    Tallentaa tulosarvon is'#195#164'nt'#195#164'sovelluksel'
  +'le.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Nykyinen Unix-aikale'
  +'ima millisekunteina (UTC).\n"'#13#10'"  GetRandom(Length) : Int64\n"'#13#10
  +'"    Satunnainen kokonaisluku, jossa on t'#195#164'sm'#195#164'lleen Length'
  +' desimaalinumeroa.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Satunnaine'
  +'n liukuluku v'#195#164'lill'#195#164' [0, 1).\n"'#13#10'"  IntToHex(Value, '
  +'Digits) : string\n"'#13#10'"    Muuntaa kokonaisluvun heksadesimaalimerkkij'
  +'onoksi, jossa on v'#195#164'hint'#195#164#195#164'n Digits merkki'#195#164
  +'.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Muuntaa merkkijonon kok'
  +'onaisluvuksi. Aiheuttaa poikkeuksen, jos sy'#195#182'te ei kelpaa.\n"'#13#10
  +'"  IntToStr(Value) : string\n"'#13#10'"    Muuntaa kokonaisluvun merkkijono'
  +'muotoon.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Poistaa S:n alussa ja'
  +' lopussa olevat tyhj'#195#164't merkit.\n"'#13#10'"  TrimLeft(S) : string\n'
  +'"'#13#10'"    Poistaa S:n alussa olevat tyhj'#195#164't merkit.\n"'#13#10'"'
  +'  TrimRight(S) : string\n"'#13#10'"    Poistaa S:n lopussa olevat tyhj'#195
  +#164't merkit.\n"'#13#10'"  HtmlEncode(S) : string\n"'#13#10'"    Koodaa S:n'
  +' erityiset HTML-merkit entiteeteiksi.\n"'#13#10'"  HtmlDecode(S) : string\n'
  +'"'#13#10'"    Purkaa S:n HTML-entiteetit takaisin merkeiksi.\n"'#13#10'"  U'
  +'rlEncode(S) : string\n"'#13#10'"    Koodaa S:n prosenttikoodauksella turval'
  +'lista k'#195#164'ytt'#195#182#195#164' varten URL-osoitteissa.\n"'#13#10'" '
  +' UrlDecode(S) : string\n"'#13#10'"    Purkaa prosenttikoodatun merkkijonon '
  +'S.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : s'
  +'tring\n"'#13#10'"    Korvaa kaikki OldPattern-merkkijonon esiintym'#195#164
  +'t NewPattern-merkkijonolla S:ss'#195#164'.\n"'#13#10'"  RegexReplace(Input,'
  +' Pattern, Replacement) : string\n"'#13#10'"    Korvaa kaikki s'#195#164#195
  ,#164'nn'#195#182'llisen lausekkeen Pattern osumat Replacement-merkkijonolla '
  +'Inputissa. Ei huomioi kirjainkokoa.\n"'#13#10'"  RegexMatch(Input, Pattern)'
  +' : Boolean\n"'#13#10'"    Tarkistaa, vastaako Input s'#195#164#195#164'nn'
  +#195#182'llist'#195#164' lauseketta Pattern. Ei huomioi kirjainkokoa.\n"'#13
  +#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#13#10'"    Poi'
  +'mii S:st'#195#164' alimerkkijonon StartMarker- ja EndMarker-merkkien v'#195
  +#164'list'#195#164'.\n"'#13#10'"\n"'#13#10'"JSON-funktiot (k'#195#164'yt'#195
  +#164' JSONParse-funktion palauttamaa k'#195#164'sittelytunnistetta):\n"'#13
  +#10'"  JSONParse(S) : Integer\n"'#13#10'"    J'#195#164'sent'#195#164#195#164
  +' JSON-merkkijonon ja palauttaa k'#195#164'sittelytunnisteen (>=0). Palautta'
  +'a -1 virheen sattuessa.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Vapaut'
  +'taa k'#195#164'sittelytunnisteen k'#195#164'yt'#195#182'n j'#195#164'lkeen.'
  +'\n"'#13#10'"  JSONGetString(Handle, Path) : string\n"'#13#10'"    Hakee mer'
  +'kkijonoarvon m'#195#164#195#164'ritetyst'#195#164' Path-polusta.\n"'#13#10
  +'"  JSONGetInt(Handle, Path) : Integer\n"'#13#10'"    Hakee kokonaislukuarvo'
  +'n m'#195#164#195#164'ritetyst'#195#164' Path-polusta.\n"'#13#10'"  JSONGetF'
  +'loat(Handle, Path) : Extended\n"'#13#10'"    Hakee liukulukuarvon m'#195#164
  +#195#164'ritetyst'#195#164' Path-polusta.\n"'#13#10'"  JSONGetBool(Handle, P'
  +'ath) : Boolean\n"'#13#10'"    Hakee totuusarvon m'#195#164#195#164'ritetyst'
  +#195#164' Path-polusta.\n"'#13#10'"  JSONGetArrayCount(Handle, Path) : Integ'
  +'er\n"'#13#10'"    Hakee m'#195#164#195#164'ritetyn Path-polun taulukon elem'
  +'enttien m'#195#164#195#164'r'#195#164'n.\n"'#13#10'"  JSONGetArrayString(Ha'
  +'ndle, Path, Index) : string\n"'#13#10'"    Hakee taulukon elementin merkkij'
  +'onoarvon annetusta Index-indeksist'#195#164'.\n"'#13#10'"  JSONGetArrayInt('
  +'Handle, Path, Index) : Integer\n"'#13#10'"    Hakee taulukon elementin koko'
  +'naislukuarvon annetusta Index-indeksist'#195#164'.\n"'#13#10'"  JSONGetType'
  +'(Handle, Path) : string\n"'#13#10'"    Palauttaa Path-polun arvon tyypin: \'
  +'"object\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n'
  +'"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n"'#13#10'"    Tarkistaa'
  +', onko m'#195#164#195#164'ritetty Path-polku olemassa.\n"'#13#10'"  JSONRes'
  +'ultInit\n"'#13#10'"    Alustaa tyhj'#195#164'n JSON-taulukon tavallisen vir'
  +'hetuloksen muodostamista varten.\n"'#13#10'"  JSONResultAddError(Offset, Le'
  +'ngth, Message, Replacements)\n"'#13#10'"    Lis'#195#164#195#164' virheobje'
  +'ktin tulostaulukkoon. Replacements on merkkijono arvoista, jotka on erotett'
  +'u merkill'#195#164' \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'" '
  +'   Palauttaa nykyisen tulostaulukon JSON-merkkijonona.\n"'#13#10'"  JSONRes'
  +'ultClear\n"'#13#10'"    Tyhjent'#195#164#195#164' tulostaulukon.\n"'#13#10
  +'"  Kutsu aina JSONFree vapauttaaksesi k'#195#164'sittelytunnisteen, kun ole'
  +'t valmis.\n"'#13#10'"\n"'#13#10'"Esimerkki JSON:n k'#195#164'sittelyst'#195
  +#164':\n"'#13#10'"  var h: Integer;\n"'#13#10'"      s: string;\n"'#13#10'" '
  +' begin\n"'#13#10'"    h := JSONParse(GetParam(''result''));\n"'#13#10'"    '
  +'if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h, '
  +'''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"      J'
  +'SONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"K'
  +#195#164'ytett'#195#164'viss'#195#164' olevat parametrit (haetaan GetParam-f'
  +'unktiolla):\n"'#13#10'"  text - k'#195#164'sitelt'#195#164'v'#195#164' sy'
  +#195#182'tt'#195#182'teksti (saatetaan katkaista MaxLength-arvoon)\n"'#13#10
  +'"  source - l'#195#164'hdekielen koodi (voi olla tyhj'#195#164')\n"'#13#10
  +'"  target - kohdekielen koodi\n"'#13#10'"  timestamp - nykyinen Unix-aikale'
  +'ima millisekunteina (merkkijono)\n"'#13#10'"  random  - satunnainen 9-numer'
  +'oinen luku (merkkijono)\n"'#13#10'"  rand - sama kuin random\n"'#13#10'"  r'
  +'and1..rand9 - satunnaisluvun ensimm'#195#164'iset 1..9 numeroa\n"'#13#10'"\'
  +'n"'#13#10'"Saatavilla on my'#195#182's muita alkuper'#195#164'isi'#195#164
  +' ja mukautettuja parametreja.ss'#195#164'."'#13#10#13#10'#: formconfig.rscr'
  +'iptresponsehint'#13#10'msgid ""'#13#10'"This script processes the response '
  +'data. All functions and parameters described in the script hint are availab'
  +'le here as well.\n"'#13#10'"Use GetParam(''result'') to obtain the received'
  +' text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10
  +'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13#10'"    SetOutput'
  +'(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"You can define cu'
  +'stom parameters in the parameters script using SetParam(''name'', ''value'''
  +'),\n"'#13#10'"and then retrieve them here with GetParam(''name'')."'#13#10
  +'msgstr ""'#13#10'"T'#195#164'm'#195#164' komentosarja k'#195#164'sittelee v'
  +'astaustietoja. Kaikki komentosarjan ohjeessa kuvatut funktiot ja parametrit'
  ,' ovat k'#195#164'ytett'#195#164'viss'#195#164' my'#195#182's t'#195#164#195
  +#164'll'#195#164'.\n"'#13#10'"K'#195#164'yt'#195#164' GetParam(''result'')-f'
  +'unktiota vastaanotetun tekstin hakemiseen.\n"'#13#10'"\n"'#13#10'"Esimerkki'
  +':\n"'#13#10'"  var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetPar'
  +'am(''result'');\n"'#13#10'"    SetOutput(''result'', s);\n"'#13#10'"  end.\'
  +'n"'#13#10'"\n"'#13#10'"Voit m'#195#164#195#164'ritt'#195#164#195#164' mukau'
  +'tettuja parametreja parametrikomentosarjassa k'#195#164'ytt'#195#164'm'#195
  +#164'll'#195#164' SetParam(''name'', ''value''),\n"'#13#10'"ja hakea ne sitt'
  +'en t'#195#164#195#164'll'#195#164' GetParam(''name'')-funktiolla."'#13#10#13
  +#10'#: formconfig.rvaluetype1'#13#10'msgctxt "formconfig.rvaluetype1"'#13#10
  +'msgid "None"'#13#10'msgstr "Ei mit'#195#164#195#164'n"'#13#10#13#10'#: form'
  +'config.rvaluetype2'#13#10'msgid "Language"'#13#10'msgstr "Kieli"'#13#10#13
  +#10'#: formconfig.rvaluetype3'#13#10'msgid "Currency All"'#13#10'msgstr "Kai'
  +'kki valuutat"'#13#10#13#10'#: formconfig.rvaluetype4'#13#10'msgid "Currency'
  +' Fiat Only"'#13#10'msgstr "Vain fiat-valuutat"'#13#10#13#10'#: formconfig.r'
  +'valuetype5'#13#10'msgid "Currency Crypto Only"'#13#10'msgstr "Vain kryptova'
  +'luutat"'#13#10#13#10'#: formconfig.rvaluetype6'#13#10'msgid "Measurement Un'
  +'its"'#13#10'msgstr "Mittayksik'#195#182't"'#13#10#13#10'#: tformconfigtrays'
  +'late.aclearicon.caption'#13#10'msgid "Clear Icon"'#13#10'msgstr "Tyhjenn'
  +#195#164' kuvake"'#13#10#13#10'#: tformconfigtrayslate.aeditfile.caption'#13
  +#10'msgid "Edit File..."'#13#10'msgstr "Muokkaa tiedostoa..."'#13#10#13#10'#'
  +': tformconfigtrayslate.asave.caption'#13#10'msgid "Save"'#13#10'msgstr "Tal'
  +'lenna"'#13#10#13#10'#: tformconfigtrayslate.asaveiconas.caption'#13#10'msgi'
  +'d "Save Icon As..."'#13#10'msgstr "Tallenna kuvake nimell'#195#164'..."'#13
  +#10#13#10'#: tformconfigtrayslate.btnclose.caption'#13#10'msgid "Close"'#13
  +#10'msgstr "Sulje"'#13#10#13#10'#: tformconfigtrayslate.btninitparameterstes'
  +'t.hint'#13#10'msgid "Execute request and view the parameters"'#13#10'msgstr'
  +' "Suorita pyynt'#195#182' ja tarkastele parametreja"'#13#10#13#10'#: tformc'
  +'onfigtrayslate.btniniturltest.hint'#13#10'msgid "Execute request and view t'
  +'he result"'#13#10'msgstr "Suorita pyynt'#195#182' ja tarkastele tulosta"'#13
  +#10#13#10'#: tformconfigtrayslate.btnpostdatatest.hint'#13#10'msgid "Execute'
  +' post request and view the result"'#13#10'msgstr "Suorita POST-pyynt'#195
  +#182' ja tarkastele tulosta"'#13#10#13#10'#: tformconfigtrayslate.btnrespons'
  +'ehelp.hint'#13#10'msgctxt "tformconfigtrayslate.btnresponsehelp.hint"'#13#10
  +'msgid "Help"'#13#10'msgstr "Ohje"'#13#10#13#10'#: tformconfigtrayslate.btnr'
  +'esponsetest.hint'#13#10'msgid "Converts the current response"'#13#10'msgstr'
  +' "Muuntaa nykyisen vastauksen"'#13#10#13#10'#: tformconfigtrayslate.btnscri'
  +'pthelp.hint'#13#10'msgctxt "tformconfigtrayslate.btnscripthelp.hint"'#13#10
  +'msgid "Help"'#13#10'msgstr "Ohje"'#13#10#13#10'#: tformconfigtrayslate.btns'
