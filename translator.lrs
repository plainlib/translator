  +'msgid "Name"'#10'msgstr "N'#195#161'zev"'#10#10'#: tformconfigtrayslate.lab'
  +'elserviceorder.caption'#10'msgid "Order"'#10'msgstr "Po'#197#153'ad'#195#173
  +'"'#10#10'#: tformconfigtrayslate.labelsort.caption'#10'msgctxt "tformconfig'
  +'trayslate.labelsort.caption"'#10'msgid "Sort"'#10'msgstr "Se'#197#153'adit"'
