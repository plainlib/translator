  +#13#10'"X-Generator: PoBatch 1.0.0\n"'#13#10#13#10'#: formconfig.rcaption'#13
  +#10'msgctxt "formconfig.rcaption"'#13#10'msgid "Config Editor"'#13#10'msgstr'
  +' "Editor de configura'#200#155'ii"'#13#10#13#10'#: formconfig.rclearlanguag'
  +'es'#13#10'msgid "The list is already filled. Do you want to clear it?"'#13
  +#10'msgstr "Lista este deja completat'#196#131'. Dori'#200#155'i s'#196#131
  +' o goli'#200#155'i?"'#13#10#13#10'#: formconfig.rconfigeditor'#13#10'msgid '
  +'"Config Editor..."'#13#10'msgstr "Editor de configura'#200#155'ii..."'#13#10
  +#13#10'#: formconfig.rdeleteconfig'#13#10'msgid "Are you sure you want to de'
  +'lete config"'#13#10'msgstr "Sigur dori'#200#155'i s'#196#131' '#200#153'ter'
  +'ge'#200#155'i configura'#200#155'ia"'#13#10#13#10'#: formconfig.rdeleteconf'
  +'igcaption'#13#10'msgid "Delete config"'#13#10'msgstr "'#200#152'terge confi'
  +'gura'#200#155'ia"'#13#10#13#10'#: formconfig.rfilechangedcancel'#13#10'msgi'
  +'d "Cancel"'#13#10'msgstr "Anulare"'#13#10#13#10'#: formconfig.rfilechangedk'
  +'eepchanges'#13#10'msgid "Keep my changes"'#13#10'msgstr "P'#196#131'streaz'
  +#196#131' modific'#196#131'rile mele"'#13#10#13#10'#: formconfig.rfilechange'
  +'dmsg'#13#10'#, object-pascal-format'#13#10'msgid "The file \"%s\" has been '
  +'modified by another application since it was opened."'#13#10'msgstr "Fi'#200
  +#153'ierul \"%s\" a fost modificat de o alt'#196#131' aplica'#200#155'ie de '
  +'c'#195#162'nd a fost deschis."'#13#10#13#10'#: formconfig.rfilechangedmsgac'
  +'tivate'#13#10'msgid "You have unsaved changes. Keep them or reload from dis'
  +'k?"'#13#10'msgstr "Ave'#200#155'i modific'#196#131'ri nesalvate. Dori'#200
  +#155'i s'#196#131' le p'#196#131'stra'#200#155'i sau s'#196#131' re'#195#174
  +'nc'#196#131'rca'#200#155'i fi'#200#153'ierul de pe disc?"'#13#10#13#10'#: f'
  +'ormconfig.rfilechangedreloaddisk'#13#10'msgid "Reload from disk"'#13#10'msg'
  +'str "Re'#195#174'ncarc'#196#131' de pe disc"'#13#10#13#10'#: formconfig.rfi'
  +'lechangedtitle'#13#10'msgid "File changed on disk"'#13#10'msgstr "Fi'#200
  +#153'ier modificat pe disc"'#13#10#13#10'#: formconfig.rnamequestion'#13#10
  +'msgid "Enter new config file name:"'#13#10'msgstr "Introduce'#200#155'i num'
  +'ele noului fi'#200#153'ier de configurare:"'#13#10#13#10'#: formconfig.rnee'
  +'dsave'#13#10'msgid "The configuration was modified. Save changes?"'#13#10'm'
  +'sgstr "Configura'#200#155'ia a fost modificat'#196#131'. Salva'#200#155'i m'
  +'odific'#196#131'rile?"'#13#10#13#10'#: formconfig.rresponsehint'#13#10'msgi'
  +'d ""'#13#10'"Json Pointer: Use / for levels, keys for objects, and numbers '
  +'for indexes.\n"'#13#10'"Use * for all items, *#10 to join items by newline.'
  +' Use ~ at the end of the path to return the raw JSON branch.\n"'#13#10'"Sep'
  +'arate multiple segments with semicolon ;.\n"'#13#10'"Literal: Text block in'
  +' {'#226#128#166'}. Special tag #10 for newlines. Use {{regex}} inside to ex'
  +'tract data directly into the text.\n"'#13#10'"Logic: If a Pointer in a segm'
  +'ent is empty, the whole segment is skipped. If a segment has no Pointer, on'
  +'ly literal text blocks with embedded regular expressions are processed.\n"'
  +#13#10'"Regex: {prefix {regex[index]} suffix} inside a text block. If no [in'
  +'dex] is specified, the first match is used.\n"'#13#10'"Index can be a numbe'
  +'r, [*] (join by space), or [*#10] (join by newline). If the regex finds no '
  +'match, the entire {'#226#128#166'} block is removed.\n"'#13#10'"Using ~ ins'
  +'ide a regex returns the entire text.\n"'#13#10'"Inversion: Start a segment '
  +'with ! (e.g. !/path{Error}) to show its text only if the Pointer data is mi'
  +'ssing or the JSON is invalid.\n"'#13#10'"Commenting: /* text */ comments ar'
  +'e stripped from the entire expression before any processing.\n"'#13#10'"Exa'
  +'mples:\n"'#13#10'"responseData/translatedText; matches/*#10/translation; /t'
  +'exts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/translati'
  +'ons{Error: No data!#10}; /translations/0/text"'#13#10'msgstr ""'#13#10'"Poi'
  +'nter JSON: Folosi'#200#155'i / pentru niveluri, chei pentru obiecte '#200
  +#153'i numere pentru indec'#200#153'i. Folosi'#200#155'i * pentru toate elem'
  +'entele '#200#153'i *#10 pentru a uni elementele prin linie nou'#196#131'. F'
  +'olosi'#200#155'i ~ la sf'#195#162'r'#200#153'itul c'#196#131'ii pentru a re'
  +'turna ramura JSON brut'#196#131'. Separa'#200#155'i mai multe segmente cu p'
  +'unct '#200#153'i virgul'#196#131' ;.\n"'#13#10'"Literal: Bloc de text '#195
  +#174'n {'#226#128#166'}. Etichet'#196#131' special'#196#131' #10 pentru lini'
  +'i noi. Folosi'#200#155'i {{regex}} '#195#174'n interior pentru a extrage da'
  ,'te direct '#195#174'n text.\n"'#13#10'"Logic'#196#131': Dac'#196#131' un Po'
  +'inter dintr-un segment este gol, '#195#174'ntregul segment este ignorat. Da'
  +'c'#196#131' un segment nu are Pointer, sunt procesate doar blocurile de tex'
  +'t literal cu expresii regulate '#195#174'ncorporate.\n"'#13#10'"Regex: {pre'
  +'fix {regex[index]} sufix} '#195#174'n interiorul unui bloc de text. Dac'#196
  +#131' [index] nu este specificat, este utilizat'#196#131' prima potrivire. I'
  +'ndexul poate fi un num'#196#131'r, [*] (unire prin spa'#200#155'iu) sau [*#'
  +'10] (unire prin linie nou'#196#131'). Dac'#196#131' expresia regulat'#196
  +#131' nu g'#196#131'se'#200#153'te nicio potrivire, '#195#174'ntregul bloc {'
  +#226#128#166'} este eliminat. Utilizarea lui ~ '#195#174'n interiorul unei e'
  +'xpresii regulate returneaz'#196#131' '#195#174'ntregul text.\n"'#13#10'"Inv'
  +'ersare: '#195#142'ncepe'#200#155'i un segment cu ! (de exemplu !/path{Error'
  +'}) pentru a afi'#200#153'a textul acestuia doar dac'#196#131' datele Pointe'
  +'r lipsesc sau JSON-ul este invalid.\n"'#13#10'"Comentarii: Comentariile /* '
  +'text */ sunt eliminate din '#195#174'ntreaga expresie '#195#174'nainte de o'
  +'rice procesare.\n"'#13#10'"Exemple:\n"'#13#10'"responseData/translatedText;'
  +' matches/*#10/translation; /texts/text; {literal text#10}; /result/text; /t'
  +'ext{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translations"'#13#10
  +#13#10'#: formconfig.rscripthint'#13#10'msgid ""'#13#10'"The script is a sta'
  +'ndard Pascal program: optional var section, then a main begin ... end. bloc'
  +'k.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: string;\n"'#13#10'" '
  +' begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceA'
  +'ll(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10
  +'"  end.\n"'#13#10'"\n"'#13#10'"You can also use standard Pascal constructs '
  +'(if, for, while, repeat, etc.). You can define your own functions and proce'
  +'dures before the main begin ... end. block.\n"'#13#10'"\n"'#13#10'"Availabl'
  +'e functions:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Retrie'
  +'ve an input parameter value.\n"'#13#10'"  SetOutput(''name'', ''value'')\n"'
  +#13#10'"    Store an output value for the host.\n"'#13#10'"  GetTimestamp() '
  +': Int64\n"'#13#10'"    Current Unix timestamp in milliseconds (UTC).\n"'#13
  +#10'"  GetRandom(Length) : Int64\n"'#13#10'"    Random integer with exactly '
  +'Length decimal digits.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Random'
  +' float in the range [0, 1).\n"'#13#10'"  IntToHex(Value, Digits) : string\n'
  +'"'#13#10'"    Convert integer to hexadecimal string with at least Digits ch'
  +'aracters.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"    Convert a strin'
  +'g to an integer. Raises an exception on invalid input.\n"'#13#10'"  IntToSt'
  +'r(Value) : string\n"'#13#10'"    Convert an integer to its string represent'
  +'ation.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"    Remove leading and trai'
  +'ling whitespace from S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10'"    Re'
  +'move leading whitespace from S.\n"'#13#10'"  TrimRight(S) : string\n"'#13#10
  +'"    Remove trailing whitespace from S.\n"'#13#10'"  HtmlEncode(S) : string'
  +'\n"'#13#10'"    Encode special HTML characters in S into entities.\n"'#13#10
  +'"  HtmlDecode(S) : string\n"'#13#10'"    Decode HTML entities in S back to '
  +'characters.\n"'#13#10'"  UrlEncode(S) : string\n"'#13#10'"    Percent-encod'
  +'e S for safe URL inclusion.\n"'#13#10'"  UrlDecode(S) : string\n"'#13#10'" '
  +'   Decode a percent-encoded string S.\n"'#13#10'"  ReplaceAll(S, OldPattern'
  +', NewPattern, IgnoreCase=False) : string\n"'#13#10'"    Replace all occurre'
  +'nces of OldPattern with NewPattern in S.\n"'#13#10'"  RegexReplace(Input, P'
  +'attern, Replacement) : string\n"'#13#10'"    Replace all regex matches of P'
  +'attern with Replacement in Input. Case-insensitive.\n"'#13#10'"  RegexMatch'
  +'(Input, Pattern) : Boolean\n"'#13#10'"    Check if Input matches the regex '
  +'Pattern. Case-insensitive.\n"'#13#10'"  ExtractBetween(S, StartMarker, EndM'
  +'arker) : string\n"'#13#10'"    Extract the substring of S between StartMark'
  +'er and EndMarker.\n"'#13#10'"\n"'#13#10'"JSON functions (use a handle retur'
  +'ned by JSONParse):\n"'#13#10'"  JSONParse(S) : Integer\n"'#13#10'"    Parse'
  +' a JSON string and return a handle (>=0). Returns -1 on error.\n"'#13#10'" '
  +' JSONFree(Handle)\n"'#13#10'"    Release the handle after use.\n"'#13#10'" '
  +' JSONGetString(Handle, Path) : string\n"'#13#10'"    Get a string value at '
  +'the specified Path.\n"'#13#10'"  JSONGetInt(Handle, Path) : Integer\n"'#13
  +#10'"    Get an integer value at the specified Path.\n"'#13#10'"  JSONGetFlo'
  +'at(Handle, Path) : Extended\n"'#13#10'"    Get a floating-point value at th'
  +'e specified Path.\n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10
  +'"    Get a boolean value at the specified Path.\n"'#13#10'"  JSONGetArrayCo'
  +'unt(Handle, Path) : Integer\n"'#13#10'"    Get the number of elements in an'
  ,' array at the specified Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path,'
  +' Index) : string\n"'#13#10'"    Get the string value of an array element at'
  +' the given Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, Index) : Integ'
  +'er\n"'#13#10'"    Get the integer value of an array element at the given In'
  +'dex.\n"'#13#10'"  JSONGetType(Handle, Path) : string\n"'#13#10'"    Return '
  +'the type of the value at Path: \"object\", \"array\", \"string\", \"int\", '
  +'\"float\", \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : '
  +'Boolean\n"'#13#10'"    Check if the specified Path exists.\n"'#13#10'"  JSO'
  +'NResultInit\n"'#13#10'"    Initialize an empty JSON array for building a st'
  +'andard error result.\n"'#13#10'"  JSONResultAddError(Offset, Length, Messag'
  +'e, Replacements)\n"'#13#10'"    Add an error object to the result array. Re'
  +'placements is a string of values separated by \"|\".\n"'#13#10'"  JSONResul'
  +'tGet : string\n"'#13#10'"    Return the current result array as a JSON stri'
  +'ng.\n"'#13#10'"  JSONResultClear\n"'#13#10'"    Clear the result array.\n"'
  +#13#10'"  Always call JSONFree to release the handle after you are done.\n"'
  +#13#10'"\n"'#13#10'"Example of working with JSON:\n"'#13#10'"  var h: Intege'
  +'r;\n"'#13#10'"      s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONP'
  +'arse(GetParam(''result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    be'
  +'gin\n"'#13#10'"      s := JSONGetString(h, ''some.path'');\n"'#13#10'"     '
  +' SetOutput(''text'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\'
  +'n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"Available parameters (retrieved wi'
  +'th GetParam):\n"'#13#10'"  text - the input text to process (possibly trunc'
  +'ated to MaxLength)\n"'#13#10'"  source - source language code (may be empty'
  +')\n"'#13#10'"  target - target language code\n"'#13#10'"  timestamp - curre'
  +'nt Unix timestamp in milliseconds (string)\n"'#13#10'"  random  - 9-digit r'
  +'andom number (string)\n"'#13#10'"  rand - same as random\n"'#13#10'"  rand1'
  +'..rand9 - first 1..9 digits of the random number\n"'#13#10'"\n"'#13#10'"Add'
  +'itional initial and custom parameters are also available."'#13#10'msgstr ""'
  +#13#10'"Scriptul este un program Pascal standard: o sec'#200#155'iune var op'
  +#200#155'ional'#196#131', urmat'#196#131' de un bloc principal begin ... end'
  +'.\n"'#13#10'"\n"'#13#10'"Exemplu:\n"'#13#10'"  var s: string;\n"'#13#10'"  '
  +'begin\n"'#13#10'"    s := GetParam(''text'');\n"'#13#10'"    s := ReplaceAl'
  +'l(s, ''-'', ''_'', False);\n"'#13#10'"    SetOutput(''text'', s);\n"'#13#10
  +'"  end.\n"'#13#10'"\n"'#13#10'"De asemenea, pute'#200#155'i utiliza constru'
  +'c'#200#155'iile standard Pascal (if, for, while, repeat etc.). Pute'#200#155
  +'i defini propriile func'#200#155'ii '#200#153'i proceduri '#195#174'nainte '
  +'de blocul principal begin ... end.\n"'#13#10'"\n"'#13#10'"Func'#200#155'ii '
  +'disponibile:\n"'#13#10'"  GetParam(''name'') : string\n"'#13#10'"    Preia '
  +'valoarea unui parametru de intrare.\n"'#13#10'"  SetOutput(''name'', ''valu'
  +'e'')\n"'#13#10'"    Stocheaz'#196#131' o valoare de ie'#200#153'ire pentru '
  +'gazd'#196#131'.\n"'#13#10'"  GetTimestamp() : Int64\n"'#13#10'"    Timestam'
  +'p-ul Unix curent '#195#174'n milisecunde (UTC).\n"'#13#10'"  GetRandom(Leng'
  +'th) : Int64\n"'#13#10'"    Num'#196#131'r '#195#174'ntreg aleatoriu cu exac'
  +'t Length cifre zecimale.\n"'#13#10'"  Random : Extended\n"'#13#10'"    Num'
  +#196#131'r real aleatoriu '#195#174'n intervalul [0, 1).\n"'#13#10'"  IntToH'
  +'ex(Value, Digits) : string\n"'#13#10'"    Converte'#200#153'te un num'#196
  +#131'r '#195#174'ntreg '#195#174'ntr-un '#200#153'ir hexazecimal cu cel pu'
  +#200#155'in Digits caractere.\n"'#13#10'"  StrToInt(S) : Integer\n"'#13#10'"'
  +'    Converte'#200#153'te un '#200#153'ir '#195#174'ntr-un num'#196#131'r '
  +#195#174'ntreg. Genereaz'#196#131' o excep'#200#155'ie dac'#196#131' intrare'
  +'a nu este valid'#196#131'.\n"'#13#10'"  IntToStr(Value) : string\n"'#13#10
  +'"    Converte'#200#153'te un num'#196#131'r '#195#174'ntreg '#195#174'n rep'
  +'rezentarea sa ca '#200#153'ir.\n"'#13#10'"  Trim(S) : string\n"'#13#10'"   '
  +' Elimin'#196#131' spa'#200#155'iile de la '#195#174'nceputul '#200#153'i sf'
  +#195#162'r'#200#153'itul lui S.\n"'#13#10'"  TrimLeft(S) : string\n"'#13#10
  +'"    Elimin'#196#131' spa'#200#155'iile de la '#195#174'nceputul lui S.\n"'
  +#13#10'"  TrimRight(S) : string\n"'#13#10'"    Elimin'#196#131' spa'#200#155
  +'iile de la sf'#195#162'r'#200#153'itul lui S.\n"'#13#10'"  HtmlEncode(S) : '
  +'string\n"'#13#10'"    Codific'#196#131' caracterele HTML speciale din S sub'
  +' form'#196#131' de entit'#196#131#200#155'i.\n"'#13#10'"  HtmlDecode(S) : s'
  +'tring\n"'#13#10'"    Decodeaz'#196#131' entit'#196#131#200#155'ile HTML din'
  +' S '#195#174'napoi '#195#174'n caractere.\n"'#13#10'"  UrlEncode(S) : strin'
  +'g\n"'#13#10'"    Codific'#196#131' S folosind codificarea procentual'#196
  +#131' pentru includerea sigur'#196#131' '#195#174'ntr-un URL.\n"'#13#10'"  U'
  ,'rlDecode(S) : string\n"'#13#10'"    Decodeaz'#196#131' un '#200#153'ir S co'
  +'dificat procentual.\n"'#13#10'"  ReplaceAll(S, OldPattern, NewPattern, Igno'
  +'reCase=False) : string\n"'#13#10'"    '#195#142'nlocuie'#200#153'te toate a'
  +'pari'#200#155'iile lui OldPattern cu NewPattern '#195#174'n S.\n"'#13#10'" '
  +' RegexReplace(Input, Pattern, Replacement) : string\n"'#13#10'"    '#195#142
  +'nlocuie'#200#153'te toate potrivirile expresiei regulate Pattern cu Replace'
  +'ment '#195#174'n Input. Nu '#200#155'ine cont de diferen'#200#155'a dintre '
  +'litere mari '#200#153'i mici.\n"'#13#10'"  RegexMatch(Input, Pattern) : Boo'
  +'lean\n"'#13#10'"    Verific'#196#131' dac'#196#131' Input corespunde expres'
  +'iei regulate Pattern. Nu '#200#155'ine cont de diferen'#200#155'a dintre li'
  +'tere mari '#200#153'i mici.\n"'#13#10'"  ExtractBetween(S, StartMarker, End'
  +'Marker) : string\n"'#13#10'"    Extrage sub'#200#153'irul din S dintre Star'
  +'tMarker '#200#153'i EndMarker.\n"'#13#10'"\n"'#13#10'"Func'#200#155'ii JSON'
  +' (utiliza'#200#155'i un handle returnat de JSONParse):\n"'#13#10'"  JSONPar'
  +'se(S) : Integer\n"'#13#10'"    Analizeaz'#196#131' un '#200#153'ir JSON '
  +#200#153'i returneaz'#196#131' un handle (>=0). Returneaz'#196#131' -1 '#195
  +#174'n caz de eroare.\n"'#13#10'"  JSONFree(Handle)\n"'#13#10'"    Elibereaz'
  +#196#131' handle-ul dup'#196#131' utilizare.\n"'#13#10'"  JSONGetString(Hand'
  +'le, Path) : string\n"'#13#10'"    Ob'#200#155'ine o valoare de tip '#200#153
  +'ir de caractere la calea specificat'#196#131' Path.\n"'#13#10'"  JSONGetInt'
  +'(Handle, Path) : Integer\n"'#13#10'"    Ob'#200#155'ine o valoare '#195#174
  +'ntreag'#196#131' la calea specificat'#196#131' Path.\n"'#13#10'"  JSONGetFl'
  +'oat(Handle, Path) : Extended\n"'#13#10'"    Ob'#200#155'ine o valoare '#195
  +#174'n virgul'#196#131' mobil'#196#131' la calea specificat'#196#131' Path.\'
  +'n"'#13#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#13#10'"    Ob'#200#155
  +'ine o valoare boolean'#196#131' la calea specificat'#196#131' Path.\n"'#13
  +#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#13#10'"    Ob'#200#155
  +'ine num'#196#131'rul de elemente dintr-un array la calea specificat'#196#131
  +' Path.\n"'#13#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#13
  +#10'"    Ob'#200#155'ine valoarea de tip '#200#153'ir a unui element din arr'
  +'ay la indexul specificat Index.\n"'#13#10'"  JSONGetArrayInt(Handle, Path, '
  +'Index) : Integer\n"'#13#10'"    Ob'#200#155'ine valoarea '#195#174'ntreag'
  +#196#131' a unui element din array la indexul specificat Index.\n"'#13#10'" '
  +' JSONGetType(Handle, Path) : string\n"'#13#10'"    Returneaz'#196#131' tipu'
  +'l valorii de la Path: \"object\", \"array\", \"string\", \"int\", \"float\"'
  +', \"bool\", \"null\".\n"'#13#10'"  JSONPathExists(Handle, Path) : Boolean\n'
  +'"'#13#10'"    Verific'#196#131' dac'#196#131' calea specificat'#196#131' Pa'
  +'th exist'#196#131'.\n"'#13#10'"  JSONResultInit\n"'#13#10'"    Ini'#200#155
  +'ializeaz'#196#131' un array JSON gol pentru construirea unui rezultat stand'
  +'ard de eroare.\n"'#13#10'"  JSONResultAddError(Offset, Length, Message, Rep'
  +'lacements)\n"'#13#10'"    Adaug'#196#131' un obiect de eroare '#195#174'n a'
  +'rray-ul de rezultate. Replacements este un '#200#153'ir de valori separate '
  +'prin \"|\".\n"'#13#10'"  JSONResultGet : string\n"'#13#10'"    Returneaz'
  +#196#131' array-ul de rezultate curent ca '#200#153'ir JSON.\n"'#13#10'"  JS'
  +'ONResultClear\n"'#13#10'"    Gole'#200#153'te array-ul de rezultate.\n"'#13
  +#10'"  Apela'#200#155'i '#195#174'ntotdeauna JSONFree pentru a elibera handl'
  +'e-ul dup'#196#131' ce a'#200#155'i terminat de utilizat.\n"'#13#10'"\n"'#13
  +#10'"Exemplu de utilizare a JSON:\n"'#13#10'"  var h: Integer;\n"'#13#10'"  '
  +'    s: string;\n"'#13#10'"  begin\n"'#13#10'"    h := JSONParse(GetParam('''
  +'result''));\n"'#13#10'"    if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'" '
  +'     s := JSONGetString(h, ''some.path'');\n"'#13#10'"      SetOutput(''tex'
  +'t'', s);\n"'#13#10'"      JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end'
  +'.\n"'#13#10'"\n"'#13#10'"Parametri disponibili (ob'#200#155'inu'#200#155'i '
  +'cu GetParam):\n"'#13#10'"  text - textul de intrare care trebuie procesat ('
  +'poate fi trunchiat la MaxLength)\n"'#13#10'"  source - codul limbii surs'
  +#196#131' (poate fi gol)\n"'#13#10'"  target - codul limbii '#200#155'int'
  +#196#131'\n"'#13#10'"  timestamp - timestamp-ul Unix curent '#195#174'n mili'
  +'secunde ('#200#153'ir)\n"'#13#10'"  random  - num'#196#131'r aleatoriu de 9'
  +' cifre ('#200#153'ir)\n"'#13#10'"  rand - acela'#200#153'i lucru ca random\'
  +'n"'#13#10'"  rand1..rand9 - primele 1..9 cifre ale num'#196#131'rului aleat'
  +'oriu\n"'#13#10'"\n"'#13#10'"Sunt disponibili '#200#153'i parametri ini'#200
  +#155'iali '#200#153'i personaliza'#200#155'i suplimentari."'#13#10#13#10'#: '
  +'formconfig.rscriptresponsehint'#13#10'msgid ""'#13#10'"This script processe'
  +'s the response data. All functions and parameters described in the script h'
  ,'int are available here as well.\n"'#13#10'"Use GetParam(''result'') to obta'
  +'in the received text.\n"'#13#10'"\n"'#13#10'"Example:\n"'#13#10'"  var s: s'
  +'tring;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'');\n"'#13
  +#10'"    SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'You can define custom parameters in the parameters script using SetParam('''
  +'name'', ''value''),\n"'#13#10'"and then retrieve them here with GetParam('''
  +'name'')."'#13#10'msgstr ""'#13#10'"Acest script proceseaz'#196#131' datele '
  +'r'#196#131'spunsului. Toate func'#200#155'iile '#200#153'i parametrii descr'
  +'i'#200#153'i '#195#174'n indica'#200#155'ia scriptului sunt disponibili '
  +#200#153'i aici.\n"'#13#10'"Folosi'#200#155'i GetParam(''result'') pentru a '
  +'ob'#200#155'ine textul primit.\n"'#13#10'"\n"'#13#10'"Exemplu:\n"'#13#10'" '
  +' var s: string;\n"'#13#10'"  begin\n"'#13#10'"    s := GetParam(''result'')'
  +';\n"'#13#10'"    SetOutput(''result'', s);\n"'#13#10'"  end.\n"'#13#10'"\n"'
  +#13#10'"Pute'#200#155'i defini parametri personaliza'#200#155'i '#195#174'n '
  +'scriptul de parametri folosind SetParam(''name'', ''value''),\n"'#13#10'"ia'
  +'r apoi '#195#174'i pute'#200#155'i recupera aici cu GetParam(''name'')."'#13
  +#10#13#10'#: formconfig.rvaluetype1'#13#10'msgctxt "formconfig.rvaluetype1"'
  +#13#10'msgid "None"'#13#10'msgstr "Niciunul"'#13#10#13#10'#: formconfig.rval'
  +'uetype2'#13#10'msgid "Language"'#13#10'msgstr "Limb'#196#131'"'#13#10#13#10
