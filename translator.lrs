  +'figtrayslate.btnresponsehelp.hint"'#13#10'msgid "Help"'#13#10'msgstr "Hj'
  +#195#164'lp"'#13#10#13#10'#: tformconfigtrayslate.btnresponsetest.hint'#13#10
  +'msgid "Converts the current response"'#13#10'msgstr "Konverterar det aktuel'
  +'la svaret"'#13#10#13#10'#: tformconfigtrayslate.btnscripthelp.hint'#13#10'm'
  +'sgctxt "tformconfigtrayslate.btnscripthelp.hint"'#13#10'msgid "Help"'#13#10
