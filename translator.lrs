  +'ers"'#13#10'msgstr "Headers"'#13#10#13#10'#: tformconfigtrayslate.labelinit'
  +'livetime.caption'#13#10'msgctxt "tformconfigtrayslate.labelinitlivetime.cap'
  +'tion"'#13#10'msgid "Time in seconds to refresh parameters with a new reques'
