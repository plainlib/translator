  +' "tformconfigtrayslate.caption"'#13#10'msgid "Config Editor"'#13#10'msgstr '
  +'"Konfigurationsredigerare"'#13#10#13#10'#: tformconfigtrayslate.checkencode'
  +'customparameters.caption'#13#10'msgid "Encode parameters"'#13#10'msgstr "Ko'
