  +'est.caption'#10'msgctxt "tformconfigtrayslate.pageinitialrequest.caption"'
  +#10'msgid "Initial Request"'#10'msgstr "Po'#196#141#195#161'te'#196#141'n'
  +#195#173' po'#197#190'adavek"'#10#10'#: tformconfigtrayslate.pagelanguages.c'
