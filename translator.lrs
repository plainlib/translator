  +'figtrayslate.labeltargetsort.caption"'#10'msgid "Sort"'#10'msgstr "Se'#197
  +#153'adit"'#10#10'#: tformconfigtrayslate.labelurl.caption'#10'msgctxt "tfor'
  +'mconfigtrayslate.labelurl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10
