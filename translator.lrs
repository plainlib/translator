  ,'id "User Agent"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labe'
  +'llanguages.caption'#10'msgid "Supported languages e.g. en=en-US (en - inter'
  +'nal, en-US - service). \"empty\" - do not send."'#10'msgstr "Podporovan'#195
  +#169' jazyky nap'#197#153'. en=en-US (en - intern'#195#173', en-US - slu'#197
  +#190'ba). \"empty\" - nepos'#195#173'lat."'#10#10'#: tformconfigtrayslate.la'
  +'bellanguages1.caption'#10'msgid "Value type for populating names. None keep'
  +'s originals; None and Unit are case-sensitive."'#10'msgstr "Typ hodnoty pro'
  +' vypln'#196#155'n'#195#173' n'#195#161'zv'#197#175'. None zachov'#195#161'v'
  +#195#161' origin'#195#161'ly; None a Unit rozli'#197#161'uj'#195#173' veliko'
  +'st p'#195#173'smen."'#10#10'#: tformconfigtrayslate.labellanguagestarget.ca'
  +'ption'#10'msgid ""'#10'"Target languages e.g. en=en-US, en - internal, en-U'
  +'S - service code.\n"'#10'"If not specified, both source and target language'
  +'s are taken from the languages section."'#10'msgstr ""'#10'"C'#195#173'lov'
  +#195#169' jazyky nap'#197#153'. en=en-US, en - intern'#195#173', en-US - k'
  +#195#179'd slu'#197#190'by.\n"'#10'"Pokud nen'#195#173' uvedeno, zdrojov'#195
  +#169' i c'#195#173'lov'#195#169' jazyky se berou z '#196#141#195#161'sti jaz'
  +'yky."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid "Max '
  +'Length, bytes"'#10'msgstr "Maxim'#195#161'ln'#195#173' d'#195#169'lka, bajt'
  +'y"'#10#10'#: tformconfigtrayslate.labelmethod.caption'#10'msgid "Method"'#10
  +'msgstr "Metoda"'#10#10'#: tformconfigtrayslate.labelparemeters.caption'#10
  +'msgid "Use parameters: {text} '#226#128#147' input text, {source} '#226#128
  +#147' source language, {target} '#226#128#147' target language. Prefix the n'
  +'ame with ! for lowercase or ^ for uppercase value. Also supported {timestam'
  +'p}, {rand}. Use {parameter} from the parameters page."'#10'msgstr "Pou'#197
  +#190'ijte parametry: {text} '#226#128#147' vstupn'#195#173' text, {source} '
  +#226#128#147' zdrojov'#195#189' jazyk, {target} '#226#128#147' c'#195#173'lo'
  +'v'#195#189' jazyk. P'#197#153'edpona ! pro hodnotu mal'#195#189'mi p'#195
  +#173'smeny nebo ^ pro velk'#195#189'mi p'#195#173'smeny. Podporov'#195#161'n'
  +'o tak'#195#169' {timestamp}, {rand}. Pou'#197#190'ijte {parameter} ze str'
  +#195#161'nky parametr'#197#175'."'#10#10'#: tformconfigtrayslate.labelpostda'
  +'ta.caption'#10'msgid "Post Data"'#10'msgstr "Post Data"'#10#10'#: tformconf'
  +'igtrayslate.labelpostdata1.caption'#10'msgctxt "tformconfigtrayslate.labelp'
  +'ostdata1.caption"'#10'msgid "Headers"'#10'msgstr "Headers"'#10#10'#: tformc'
