  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "'#217#133#216#173#216#177#216#177' '#216#167#217#132#216#170#217#131
  +#217#136#217#138#217#134'"'#10#10'#: formconfig.rclearlanguages'#10'msgid "T'
  +'he list is already filled. Do you want to clear it?"'#10'msgstr "'#216#167
  +#217#132#217#130#216#167#216#166#217#133#216#169' '#217#133#217#133#216#170
  +#217#132#216#166#216#169' '#216#168#216#167#217#132#217#129#216#185#217#132
  +'. '#217#135#217#132' '#216#170#216#177#217#138#216#175' '#217#133#216#179
  +#216#173#217#135#216#167#216#159'"'#10#10'#: formconfig.rdeleteconfig'#10'ms'
  +'gid "Are you sure you want to delete config"'#10'msgstr "'#217#135#217#132
  +' '#216#163#217#134#216#170' '#217#133#216#170#216#163#217#131#216#175' '#216
  +#163#217#134#217#131' '#216#170#216#177#217#138#216#175' '#216#173#216#176
  +#217#129' '#216#167#217#132#216#170#217#131#217#136#217#138#217#134'"'#10#10
  +'#: formconfig.rdeleteconfigcaption'#10'msgid "Delete config"'#10'msgstr "'
  +#216#173#216#176#217#129' '#216#167#217#132#216#170#217#131#217#136#217#138
  +#217#134'"'#10#10'#: formconfig.rnamequestion'#10'msgid "Enter new config fi'
  +'le name:"'#10'msgstr "'#216#163#216#175#216#174#217#132' '#216#167#216#179
  +#217#133' '#217#133#217#132#217#129' '#216#167#217#132#216#170#217#131#217
  +#136#217#138#217#134' '#216#167#217#132#216#172#216#175#217#138#216#175':"'
  +#10#10'#: formconfig.rneedsave'#10'msgid "The configuration was modified. Sa'
  +'ve changes?"'#10'msgstr "'#216#170#217#133' '#216#170#216#185#216#175#217
  +#138#217#132' '#216#167#217#132#216#170#217#131#217#136#217#138#217#134'. '
  +#217#135#217#132' '#216#170#216#177#217#138#216#175' '#216#173#217#129#216
  +#184' '#216#167#217#132#216#170#216#186#217#138#217#138#216#177#216#167#216
  +#170#216#159'"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Poi'
  +'nter: Use / for levels, keys for objects, and numbers for indexes.\n"'#10'"'
  +'Use * for all items, *#10 to join items by newline. Use ~ at the end of the'
  +' path to return the raw JSON branch.\n"'#10'"Separate multiple segments wit'
  +'h semicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag'
  +' #10 for newlines. Use {{regex}} inside to extract data directly into the t'
  +'ext.\n"'#10'"Logic: If a Pointer in a segment is empty, the whole segment i'
  +'s skipped. If a segment has no Pointer, only literal text blocks with embed'
  +'ded regular expressions are processed.\n"'#10'"Regex: {prefix {regex[index]'
  +'} suffix} inside a text block. If no [index] is specified, the first match '
  +'is used.\n"'#10'"Index can be a number, [*] (join by space), or [*#10] (joi'
  +'n by newline). If the regex finds no match, the entire {'#226#128#166'} blo'
  +'ck is removed.\n"'#10'"Using ~ inside a regex returns the entire text.\n"'
  +#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show its text'
  +' only if the Pointer data is missing or the JSON is invalid.\n"'#10'"Commen'
  +'ting: /* text */ comments are stripped from the entire expression before an'
  +'y processing.\n"'#10'"Examples:\n"'#10'"responseData/translatedText; matche'
  +'s/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({'
  +'(\\w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#10'ms'
  +'gstr ""'#10'"'#217#133#216#164#216#180#216#177' JSON: '#216#167#216#179#216
  +#170#216#174#216#175#217#133' / '#217#132#217#132#217#133#216#179#216#170#217
