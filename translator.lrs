  +#150#180' '#235#170#168#235#145#144' '#236#150#184#236#150#180' '#236#132#185
  +#236#133#152#236#151#144#236#132#156' '#234#176#128#236#160#184#236#152#181
  +#235#139#136#235#139#164'."'#10#10'#: tformconfigtrayslate.labelmaxlength.ca'
  +'ption'#10'msgid "Max Length, bytes"'#10'msgstr "'#236#181#156#235#140#128' '
