  +#149' '#215#145#214#190'{{regex}} '#215#145#215#170#215#149#215#154' '#215
  +#148#215#145#215#156#215#149#215#167' '#215#155#215#147#215#153' '#215#156
  +#215#151#215#156#215#165' '#215#160#215#170#215#149#215#160#215#153#215#157
  +' '#215#153#215#169#215#153#215#168#215#149#215#170' '#215#144#215#156' '#215
