  +' configuration"'#10'msgstr "Ny konfiguration"'#10#10
]);
LazarusResources.Add('formconfig.de','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: de\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Konfigurationseditor"'#10#10'#: formconfig.rclearlanguages'#10'msgi'
  +'d "The list is already filled. Do you want to clear it?"'#10'msgstr "Die Li'
  +'ste ist bereits gef'#195#188'llt. M'#195#182'chten Sie sie leeren?"'#10#10
  +'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you want to delete conf'
  +'ig"'#10'msgstr "Sind Sie sicher, dass Sie die Konfiguration l'#195#182'sche'
  +'n m'#195#182'chten"'#10#10'#: formconfig.rdeleteconfigcaption'#10'msgid "De'
  +'lete config"'#10'msgstr "Konfiguration l'#195#182'schen"'#10#10'#: formconf'
  +'ig.rnamequestion'#10'msgid "Enter new config file name:"'#10'msgstr "Geben '
  +'Sie den Namen der neuen Konfigurationsdatei ein:"'#10#10'#: formconfig.rnee'
  +'dsave'#10'msgid "The configuration was modified. Save changes?"'#10'msgstr '
  +'"Die Konfiguration wurde ge'#195#164'ndert. '#195#132'nderungen speichern?"'
  +#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Pointer: Use / for'
  +' levels, keys for objects, and numbers for indexes.\n"'#10'"Use * for all i'
  +'tems, *#10 to join items by newline. Use ~ at the end of the path to return'
  +' the raw JSON branch.\n"'#10'"Separate multiple segments with semicolon ;.\'
  +'n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag #10 for newlin'
  +'es. Use {{regex}} inside to extract data directly into the text.\n"'#10'"Lo'
  +'gic: If a Pointer in a segment is empty, the whole segment is skipped. If a'
  +' segment has no Pointer, only literal text blocks with embedded regular exp'
  +'ressions are processed.\n"'#10'"Regex: {prefix {regex[index]} suffix} insid'
  +'e a text block. If no [index] is specified, the first match is used.\n"'#10
  +'"Index can be a number, [*] (join by space), or [*#10] (join by newline). I'
  +'f the regex finds no match, the entire {'#226#128#166'} block is removed.\n'
  +'"'#10'"Using ~ inside a regex returns the entire text.\n"'#10'"Inversion: S'
  +'tart a segment with ! (e.g. !/path{Error}) to show its text only if the Poi'
  +'nter data is missing or the JSON is invalid.\n"'#10'"Commenting: /* text */'
  +' comments are stripped from the entire expression before any processing.\n"'
  +#10'"Examples:\n"'#10'"responseData/translatedText; matches/*#10/translation'
  +'; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+)})}; !/trans'
  +'lations{Error: No data!#10}; /translations/0/text"'#10'msgstr ""'#10'"JSON-'
  +'Zeiger: Verwenden Sie / f'#195#188'r Ebenen, Schl'#195#188'ssel f'#195#188
  +'r Objekte und Zahlen f'#195#188'r Indizes. Verwenden Sie * f'#195#188'r all'
  +'e Elemente und *#10, um Elemente mit einem Zeilenumbruch zu verbinden. Verw'
  +'enden Sie ~ am Ende des Pfads, um den unverarbeiteten JSON-Zweig zur'#195
  +#188'ckzugeben. Trennen Sie mehrere Segmente mit einem Semikolon ;.\n"'#10'"'
  +'Literal: Textblock in {'#226#128#166'}. Spezielles Tag #10 f'#195#188'r Zei'
  +'lenumbr'#195#188'che. Verwenden Sie {{regex}} innerhalb des Blocks, um Date'
  +'n direkt in den Text einzuf'#195#188'gen.\n"'#10'"Logik: Wenn ein Zeiger in'
  +' einem Segment leer ist, wird das gesamte Segment '#195#188'bersprungen. We'
  +'nn ein Segment keinen Zeiger enth'#195#164'lt, werden nur Textbl'#195#182'c'
  +'ke mit eingebetteten regul'#195#164'ren Ausdr'#195#188'cken verarbeitet.\n"'
  +#10'"Regex: {Pr'#195#164'fix {regex[index]} Suffix} innerhalb eines Textbloc'
  +'ks. Wenn kein [index] angegeben ist, wird die erste '#195#156'bereinstimmun'
  +'g verwendet. Der Index kann eine Zahl, [*] (mit Leerzeichen verbinden) oder'
  +' [*#10] (mit Zeilenumbruch verbinden) sein. Findet der regul'#195#164're Au'
  +'sdruck keine '#195#156'bereinstimmung, wird der gesamte Block {'#226#128#166
  +'} entfernt. Die Verwendung von ~ innerhalb eines regul'#195#164'ren Ausdruc'
  +'ks gibt den gesamten Text zur'#195#188'ck.\n"'#10'"Invertierung: Beginnen S'
  +'ie ein Segment mit ! (z. B. !/path{Error}), damit sein Text nur angezeigt w'
  +'ird, wenn die Zeigerdaten fehlen oder das JSON ung'#195#188'ltig ist.\n"'#10
  +'"Kommentare: Kommentare der Form /* Text */ werden vor jeder Verarbeitung a'
  +'us dem gesamten Ausdruck entfernt.\n"'#10'"Beispiele:\n"'#10'"responseData/'
  +'translatedText; matches/*#10/translation; /texts/text; {literal text#10}; /'
  +'result/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /trans'
  +'lations"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a'
  +' standard Pascal program: optional var section, then a main begin ... end. '
  +'block.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n'
  +'"'#10'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', '
  ,'''_'', False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\'
  +'n"'#10'"You can also use standard Pascal constructs (if, for, while, repeat'
  +', etc.). You can define your own functions and procedures before the main b'
  +'egin ... end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetPar'
  +'am(''name'') : string\n"'#10'"    Retrieve an input parameter value.\n"'#10
  +'"  SetOutput(''name'', ''value'')\n"'#10'"    Store an output value for the'
  +' host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timestamp '
  +'in milliseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Rand'
  +'om integer with exactly Length decimal digits.\n"'#10'"  Random : Extended\'
  +'n"'#10'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, Dig'
  +'its) : string\n"'#10'"    Convert integer to hexadecimal string with at lea'
  +'st Digits characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a'
  +' string to an integer. Raises an exception on invalid input.\n"'#10'"  IntT'
  +'oStr(Value) : string\n"'#10'"    Convert an integer to its string represent'
  +'ation.\n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailing w'
  +'hitespace from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading'
  +' whitespace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trai'
  +'ling whitespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode'
  +' special HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : stri'
  +'ng\n"'#10'"    Decode HTML entities in S back to characters.\n"'#10'"  UrlE'
  +'ncode(S) : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n"'
  +#10'"  UrlDecode(S) : string\n"'#10'"    Decode a percent-encoded string S.\'
  +'n"'#10'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\'
  +'n"'#10'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'
  +#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Replac'
  +'e all regex matches of Pattern with Replacement in Input. Case-insensitive.'
  +'\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if Input '
  +'matches the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, St'
  +'artMarker, EndMarker) : string\n"'#10'"    Extract the substring of S betwe'
  +'en StartMarker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle'
  +' returned by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse'
  +' a JSON string and return a handle (>=0). Returns -1 on error.\n"'#10'"  JS'
  +'ONFree(Handle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSONGetS'
  +'tring(Handle, Path) : string\n"'#10'"    Get a string value at the specifie'
  +'d Path.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an int'
  +'eger value at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Ex'
  +'tended\n"'#10'"    Get a floating-point value at the specified Path.\n"'#10
  +'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value at t'
  +'he specified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'
  +#10'"    Get the number of elements in an array at the specified Path.\n"'#10
  +'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the str'
  +'ing value of an array element at the given Index.\n"'#10'"  JSONGetArrayInt'
  +'(Handle, Path, Index) : Integer\n"'#10'"    Get the integer value of an arr'
  +'ay element at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : string'
  +'\n"'#10'"    Return the type of the value at Path: \"object\", \"array\", \'
  +'"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists'
  +'(Handle, Path) : Boolean\n"'#10'"    Check if the specified Path exists.\n"'
  +#10'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for buildin'
  +'g a standard error result.\n"'#10'"  JSONResultAddError(Offset, Length, Mes'
  +'sage, Replacements)\n"'#10'"    Add an error object to the result array. Re'
  +'placements is a string of values separated by \"|\".\n"'#10'"  JSONResultGe'
  +'t : string\n"'#10'"    Return the current result array as a JSON string.\n"'
  +#10'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always '
  +'call JSONFree to release the handle after you are done.\n"'#10'"\n"'#10'"Ex'
  +'ample of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: stri'
  +'ng;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10
  +'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, '
  +'''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFre'
  +'e(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters'
  +' (retrieved with GetParam):\n"'#10'"  text - the input text to process (pos'
  +'sibly truncated to MaxLength)\n"'#10'"  source - source language code (may '
  +'be empty)\n"'#10'"  target - target language code\n"'#10'"  timestamp - cur'
  +'rent Unix timestamp in milliseconds (string)\n"'#10'"  random  - 9-digit ra'
  +'ndom number (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9'
  ,' - first 1..9 digits of the random number\n"'#10'"\n"'#10'"Additional initi'
  +'al and custom parameters are also available."'#10'msgstr ""'#10'"Das Skript'
  +' ist ein Standard-Pascal-Programm: ein optionaler var-Abschnitt, gefolgt vo'
  +'n einem Hauptblock begin ... end.\n"'#10'"\n"'#10'"Beispiel:\n"'#10'"  var '
  +'s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"   '
  +' s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''text'', s'
  +');\n"'#10'"  end.\n"'#10'"\n"'#10'"Sie k'#195#182'nnen auch Standard-Pascal'
  +'-Konstrukte verwenden (if, for, while, repeat usw.). Sie k'#195#182'nnen ei'
  +'gene Funktionen und Prozeduren vor dem Hauptblock begin ... end definieren.'
  +'\n"'#10'"\n"'#10'"Verf'#195#188'gbare Funktionen:\n"'#10'"  GetParam(''name'
  +''') : string\n"'#10'"    Ruft den Wert eines Eingabeparameters ab.\n"'#10'"'
  +'  SetOutput(''name'', ''value'')\n"'#10'"    Speichert einen Ausgabewert f'
  +#195#188'r den Host.\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Aktueller '
  +'Unix-Zeitstempel in Millisekunden (UTC).\n"'#10'"  GetRandom(Length) : Int6'
  +'4\n"'#10'"    Zuf'#195#164'llige Ganzzahl mit genau Length Dezimalziffern.\'
  +'n"'#10'"  Random : Extended\n"'#10'"    Zuf'#195#164'llige Gleitkommazahl i'
  +'m Bereich [0, 1).\n"'#10'"  IntToHex(Value, Digits) : string\n"'#10'"    Ko'
  +'nvertiert eine Ganzzahl in eine hexadezimale Zeichenfolge mit mindestens Di'
  +'gits Zeichen.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Konvertiert eine '
  +'Zeichenfolge in eine Ganzzahl. L'#195#182'st bei ung'#195#188'ltiger Eingab'
  +'e eine Ausnahme aus.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Konvert'
  +'iert eine Ganzzahl in ihre Zeichenfolgendarstellung.\n"'#10'"  Trim(S) : st'
  +'ring\n"'#10'"    Entfernt f'#195#188'hrende und nachfolgende Leerzeichen au'
  +'s S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Entfernt f'#195#188'hrende '
  +'Leerzeichen aus S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Entfernt nac'
  +'hfolgende Leerzeichen aus S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    K'
  +'odiert spezielle HTML-Zeichen in S als Entit'#195#164'ten.\n"'#10'"  HtmlDe'
  +'code(S) : string\n"'#10'"    Dekodiert HTML-Entit'#195#164'ten in S zur'#195
  +#188'ck in Zeichen.\n"'#10'"  UrlEncode(S) : string\n"'#10'"    Prozentkodie'
  +'rt S f'#195#188'r die sichere Verwendung in URLs.\n"'#10'"  UrlDecode(S) : '
  +'string\n"'#10'"    Dekodiert eine prozentkodierte Zeichenfolge S.\n"'#10'" '
  +' ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'" '
  +'   Ersetzt alle Vorkommen von OldPattern durch NewPattern in S.\n"'#10'"  R'
  +'egexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Ersetzt alle '
  +#195#156'bereinstimmungen des regul'#195#164'ren Ausdrucks Pattern durch Rep'
  +'lacement in Input. Gro'#195#159'-/Kleinschreibung wird ignoriert.\n"'#10'" '
  +' RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Pr'#195#188'ft, ob Input '
  +'dem regul'#195#164'ren Ausdruck Pattern entspricht. Gro'#195#159'-/Kleinsch'
  +'reibung wird ignoriert.\n"'#10'"  ExtractBetween(S, StartMarker, EndMarker)'
  +' : string\n"'#10'"    Extrahiert den Teilstring aus S zwischen StartMarker '
  +'und EndMarker.\n"'#10'"\n"'#10'"JSON-Funktionen (verwenden Sie ein von JSON'
  +'Parse zur'#195#188'ckgegebenes Handle):\n"'#10'"  JSONParse(S) : Integer\n"'
  +#10'"    Analysiert eine JSON-Zeichenfolge und gibt ein Handle (>=0) zur'#195
  +#188'ck. Gibt bei einem Fehler -1 zur'#195#188'ck.\n"'#10'"  JSONFree(Handle'
  +')\n"'#10'"    Gibt das Handle nach der Verwendung frei.\n"'#10'"  JSONGetSt'
  +'ring(Handle, Path) : string\n"'#10'"    Ruft einen Zeichenfolgenwert am ang'
  +'egebenen Path ab.\n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    '
  +'Ruft einen Ganzzahlwert am angegebenen Path ab.\n"'#10'"  JSONGetFloat(Hand'
  +'le, Path) : Extended\n"'#10'"    Ruft einen Gleitkommawert am angegebenen P'
  +'ath ab.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Ruft eine'
  +'n booleschen Wert am angegebenen Path ab.\n"'#10'"  JSONGetArrayCount(Handl'
  +'e, Path) : Integer\n"'#10'"    Ruft die Anzahl der Elemente eines Arrays am'
  +' angegebenen Path ab.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : s'
  +'tring\n"'#10'"    Ruft den Zeichenfolgenwert eines Array-Elements am angege'
  +'benen Index ab.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Integer\n"'
  +#10'"    Ruft den Ganzzahlwert eines Array-Elements am angegebenen Index ab.'
  +'\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    Gibt den Typ des '
  +'Werts unter Path zur'#195#188'ck: \"object\", \"array\", \"string\", \"int\'
  +'", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : '
  +'Boolean\n"'#10'"    Pr'#195#188'ft, ob der angegebene Path existiert.\n"'#10
  +'"  JSONResultInit\n"'#10'"    Initialisiert ein leeres JSON-Array zum Erste'
  +'llen eines Standard-Fehlerergebnisses.\n"'#10'"  JSONResultAddError(Offset,'
  +' Length, Message, Replacements)\n"'#10'"    F'#195#188'gt dem Ergebnisarray'
  +' ein Fehlerobjekt hinzu. Replacements ist eine Zeichenfolge mit durch \"|\"'
  ,' getrennten Werten.\n"'#10'"  JSONResultGet : string\n"'#10'"    Gibt das a'
  +'ktuelle Ergebnisarray als JSON-Zeichenfolge zur'#195#188'ck.\n"'#10'"  JSON'
  +'ResultClear\n"'#10'"    Leert das Ergebnisarray.\n"'#10'"  Rufen Sie immer '
  +'JSONFree auf, um das Handle freizugeben, nachdem Sie es nicht mehr ben'#195
  +#182'tigen.\n"'#10'"\n"'#10'"Beispiel f'#195#188'r die Arbeit mit JSON:\n"'
  +#10'"  var h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    '
  +'h := JSONParse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"  '
  +'  begin\n"'#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      S'
  +'etOutput(''text'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"'
  +'  end.\n"'#10'"\n"'#10'"Verf'#195#188'gbare Parameter (abgerufen mit GetPar'
  +'am):\n"'#10'"  text - der zu verarbeitende Eingabetext (m'#195#182'glicherw'
  +'eise auf MaxLength gek'#195#188'rzt)\n"'#10'"  source - Sprachcode der Ausg'
  +'angssprache (kann leer sein)\n"'#10'"  target - Sprachcode der Zielsprache\'
  +'n"'#10'"  timestamp - aktueller Unix-Zeitstempel in Millisekunden (Zeichenf'
  +'olge)\n"'#10'"  random  - zuf'#195#164'llige 9-stellige Zahl (Zeichenfolge)'
  +'\n"'#10'"  rand - dasselbe wie random\n"'#10'"  rand1..rand9 - die ersten 1'
  +'..9 Ziffern der Zufallszahl\n"'#10'"\n"'#10'"Zus'#195#164'tzliche initiale '
  +'und benutzerdefinierte Parameter sind ebenfalls verf'#195#188'gbar.Paramete'
  +'r sind ebenfalls verf'#195#188'gbar."'#10#10'#: formconfig.rscriptresponseh'
  +'int'#10'msgid ""'#10'"This script processes the response data. All function'
  +'s and parameters described in the script hint are available here as well.\n'
  +'"'#10'"Use GetParam(''result'') to obtain the received text.\n"'#10'"\n"'#10
  +'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetPara'
  +'m(''result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"You can define custom parameters in the parameters script using S'
  +'etParam(''name'', ''value''),\n"'#10'"and then retrieve them here with GetP'
  +'aram(''name'')."'#10'msgstr ""'#10'"Dieses Skript verarbeitet die Antwortda'
  +'ten. Alle Funktionen und Parameter, die im Skript-Hinweis beschrieben sind,'
  +' stehen auch hier zur Verf'#195#188'gung.\n"'#10'"Verwenden Sie GetParam('''
  +'result''), um den empfangenen Text abzurufen.\n"'#10'"\n"'#10'"Beispiel:\n"'
  +#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'');'
  +'\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Sie '
  +'k'#195#182'nnen benutzerdefinierte Parameter im Parameterskript mit SetPara'
  +'m(''name'', ''value'') definieren\n"'#10'"und sie anschlie'#195#159'end hie'
  +'r mit GetParam(''name'') abrufen."'#10#10'#: formconfig.rvaluetype1'#10'msg'
  +'ctxt "formconfig.rvaluetype1"'#10'msgid "None"'#10'msgstr "Keine"'#10#10'#:'
  +' formconfig.rvaluetype2'#10'msgid "Language"'#10'msgstr "Sprache"'#10#10'#:'
  +' formconfig.rvaluetype3'#10'msgid "Currency All"'#10'msgstr "Alle W'#195#164
  +'hrungen"'#10#10'#: formconfig.rvaluetype4'#10'msgid "Currency Fiat Only"'#10
  +'msgstr "Nur Fiat-W'#195#164'hrungen"'#10#10'#: formconfig.rvaluetype5'#10'm'
  +'sgid "Currency Crypto Only"'#10'msgstr "Nur Kryptow'#195#164'hrungen"'#10#10
  +'#: formconfig.rvaluetype6'#10'msgid "Measurement Units"'#10'msgstr "Ma'#195
  +#159'einheiten"'#10#10'#: tformconfigtrayslate.aclearicon.caption'#10'msgid '
  +'"Clear Icon"'#10'msgstr "Symbol l'#195#182'schen"'#10#10'#: tformconfigtray'
  +'slate.asave.caption'#10'msgid "Save"'#10'msgstr "Speichern"'#10#10'#: tform'
  +'configtrayslate.asaveiconas.caption'#10'msgid "Save Icon As..."'#10'msgstr '
  +'"Symbol speichern unter..."'#10#10'#: tformconfigtrayslate.btnclose.caption'
  +#10'msgid "Close"'#10'msgstr "Schlie'#195#159'en"'#10#10'#: tformconfigtrays'
  +'late.btninitparameterstest.hint'#10'msgid "Execute request and view the par'
  +'ameters"'#10'msgstr "Anfrage ausf'#195#188'hren und Parameter anzeigen"'#10
  +#10'#: tformconfigtrayslate.btniniturltest.hint'#10'msgid "Execute request a'
  +'nd view the result"'#10'msgstr "Anfrage ausf'#195#188'hren und Ergebnis anz'
  +'eigen"'#10#10'#: tformconfigtrayslate.btnpostdatatest.hint'#10'msgid "Execu'
  +'te post request and view the result"'#10'msgstr "POST-Anfrage ausf'#195#188
  +'hren und Ergebnis anzeigen"'#10#10'#: tformconfigtrayslate.btnresponsehelp.'
  +'hint'#10'msgctxt "tformconfigtrayslate.btnresponsehelp.hint"'#10'msgid "Hel'
  +'p"'#10'msgstr "Hilfe"'#10#10'#: tformconfigtrayslate.btnresponsetest.hint'
  +#10'msgid "Converts the current response"'#10'msgstr "Konvertiert die aktuel'
  +'le Antwort"'#10#10'#: tformconfigtrayslate.btnscripthelp.hint'#10'msgctxt "'
  +'tformconfigtrayslate.btnscripthelp.hint"'#10'msgid "Help"'#10'msgstr "Hilfe'
  +'"'#10#10'#: tformconfigtrayslate.btnscriptresponsehelp.hint'#10'msgctxt "tf'
  +'ormconfigtrayslate.btnscriptresponsehelp.hint"'#10'msgid "Help"'#10'msgstr '
  +'"Hilfe"'#10#10'#: tformconfigtrayslate.btnscriptresponsetest.hint'#10'msgct'
  +'xt "tformconfigtrayslate.btnscriptresponsetest.hint"'#10'msgid "Execute scr'
  ,'ipt and view the result"'#10'msgstr "Skript ausf'#195#188'hren und Ergebnis'
  +' anzeigen"'#10#10'#: tformconfigtrayslate.btnscripttest.hint'#10'msgctxt "t'
  +'formconfigtrayslate.btnscripttest.hint"'#10'msgid "Execute script and view '
  +'the result"'#10'msgstr "Skript ausf'#195#188'hren und Ergebnis anzeigen"'#10
  +#10'#: tformconfigtrayslate.btnurltest.hint'#10'msgid "Execute get request a'
  +'nd view the result"'#10'msgstr "GET-Anfrage ausf'#195#188'hren und Ergebnis'
  +' anzeigen"'#10#10'#: tformconfigtrayslate.caption'#10'msgctxt "tformconfigt'
  +'rayslate.caption"'#10'msgid "Config Editor"'#10'msgstr "Konfigurationsedito'
  +'r"'#10#10'#: tformconfigtrayslate.checkencodecustomparameters.caption'#10'm'
  +'sgid "Encode parameters"'#10'msgstr "Parameter kodieren"'#10#10'#: tformcon'
  +'figtrayslate.checkencodetext.caption'#10'msgid "Encode {text} parameter"'#10
  +'msgstr "{text}-Parameter kodieren"'#10#10'#: tformconfigtrayslate.checkserv'
  +'iceautoswap.caption'#10'msgid "Allow auto-swap language pair"'#10'msgstr "A'
  +'utomatischen Wechsel des Sprachpaars erlauben"'#10#10'#: tformconfigtraysla'
  +'te.checkserviceonlybutton.caption'#10'msgid "Allow translation only by tran'
  +'slation button"'#10'msgstr "'#195#156'bersetzung nur '#195#188'ber die '#195
  +#156'bersetzungsschaltfl'#195#164'che erlauben"'#10#10'#: tformconfigtraysla'
  +'te.checkserviceproxy.caption'#10'msgid "Allow proxy"'#10'msgstr "Proxy zula'
  +'ssen"'#10#10'#: tformconfigtrayslate.checkservicerealtime.caption'#10'msgid'
  +' "Allow translate as you type"'#10'msgstr "'#195#156'bersetzung w'#195#164
  +'hrend der Eingabe erlauben"'#10#10'#: tformconfigtrayslate.checkservicevisi'
  +'ble.caption'#10'msgid "Visible in menu"'#10'msgstr "Im Men'#195#188' sichtb'
  +'ar"'#10#10'#: tformconfigtrayslate.combomethod.text'#10'msgid "GET"'#10'msg'
  +'str "GET"'#10#10'#: tformconfigtrayslate.combovaluetype.text'#10'msgctxt "t'
  +'formconfigtrayslate.combovaluetype.text"'#10'msgid "None"'#10'msgstr "Keine'
  +'"'#10#10'#: tformconfigtrayslate.groupboxcustomparameters.caption'#10'msgid'
  +' "Custom Parameters"'#10'msgstr "Benutzerdefinierte Parameter"'#10#10'#: tf'
  +'ormconfigtrayslate.groupboxservice.caption'#10'msgctxt "tformconfigtrayslat'
  +'e.groupboxservice.caption"'#10'msgid "Service"'#10'msgstr "Dienst"'#10#10'#'
  +': tformconfigtrayslate.groupinitparameters.caption'#10'msgctxt "tformconfig'
  +'trayslate.groupinitparameters.caption"'#10'msgid "Initial Request"'#10'msgs'
  +'tr "Erste Anfrage"'#10#10'#: tformconfigtrayslate.grouplanguages.caption'#10
  +'msgctxt "tformconfigtrayslate.grouplanguages.caption"'#10'msgid "Languages"'
  +#10'msgstr "Sprachen"'#10#10'#: tformconfigtrayslate.grouplanguagestarget.ca'
  +'ption'#10'msgctxt "tformconfigtrayslate.grouplanguagestarget.caption"'#10'm'
  +'sgid "Target Languages"'#10'msgstr "Zielsprachen"'#10#10'#: tformconfigtray'
  +'slate.grouprequest.caption'#10'msgctxt "tformconfigtrayslate.grouprequest.c'
  +'aption"'#10'msgid "Request"'#10'msgstr "Anfrage"'#10#10'#: tformconfigtrays'
  +'late.groupresponse.caption'#10'msgid "Json Pointer Processing the Response"'
  +#10'msgstr "Verarbeitung der Antwort mit JSON Pointer"'#10#10'#: tformconfig'
  +'trayslate.groupscript.caption'#10'msgid "Script Retrieved Parameters"'#10'm'
  +'sgstr "Abgerufene Skriptparameter"'#10#10'#: tformconfigtrayslate.groupscri'
  +'ptresponse.caption'#10'msgid "Script Processing the Response"'#10'msgstr "S'
  +'kriptverarbeitung der Antwort"'#10#10'#: tformconfigtrayslate.imagepreview.'
  +'hint'#10'msgid "Click to select the config icon, Middle-Click clears the ic'
  +'on"'#10'msgstr "Klicken Sie, um das Konfigurationssymbol auszuw'#195#164'hl'
  +'en, Middle-Click l'#195#182'scht das Symbol"'#10#10'#: tformconfigtrayslate'
  +'.labelaccept.caption'#10'msgid "Accept"'#10'msgstr "Accept"'#10#10'#: tform'
  +'configtrayslate.labelcolorrecent.caption'#10'msgid "Recent Color"'#10'msgst'
  +'r "Letzte Farbe"'#10#10'#: tformconfigtrayslate.labelcontenttype.caption'#10
  +'msgid "Content Type"'#10'msgstr "Content Type"'#10#10'#: tformconfigtraysla'
  +'te.labelfilllanguages.caption'#10'msgctxt "tformconfigtrayslate.labelfillla'
  +'nguages.caption"'#10'msgid "Fill with default"'#10'msgstr "Mit Standardwert'
  +'en f'#195#188'llen"'#10#10'#: tformconfigtrayslate.labelfilltargetlanguages'
  +'.caption'#10'msgctxt "tformconfigtrayslate.labelfilltargetlanguages.caption'
  +'"'#10'msgid "Fill with default"'#10'msgstr "Mit Standardwerten f'#195#188'l'
  +'len"'#10#10'#: tformconfigtrayslate.labelheaders.caption'#10'msgid "Additio'
  +'nal request headers in key=value format, key: value is also supported"'#10
  +'msgstr "Zus'#195#164'tzliche Anfrage-Header im Format key=value, auch key: '
  +'value wird unterst'#195#188'tzt"'#10#10'#: tformconfigtrayslate.labelinithe'
  +'aders.caption'#10'msgid "Additional initial request headers in key=value fo'
  +'rmat, key: value is also supported"'#10'msgstr "Zus'#195#164'tzliche Header'
  +' f'#195#188'r die erste Anfrage im Format key=value, auch key: value wird u'
  +'nterst'#195#188'tzt"'#10#10'#: tformconfigtrayslate.labelinitheaders2.capti'
  ,'on'#10'msgctxt "tformconfigtrayslate.labelinitheaders2.caption"'#10'msgid "'
  +'Headers"'#10'msgstr "Headers"'#10#10'#: tformconfigtrayslate.labelinitlivet'
  +'ime.caption'#10'msgid "Live time"'#10'msgstr "Lebensdauer"'#10#10'#: tformc'
  +'onfigtrayslate.labelinitparameters.caption'#10'msgid "Parameters name=regex'
  +'p are extracted from the response and used by name in requests"'#10'msgstr '
  +'"Parameter name=regexp werden aus der Antwort extrahiert und in Anfragen na'
  +'mentlich verwendet"'#10#10'#: tformconfigtrayslate.labelinitparameters1.cap'
  +'tion'#10'msgid "Time in seconds to refresh parameters with a new request (0'
  +' = every request)"'#10'msgstr "Zeit in Sekunden zum Aktualisieren der Param'
  +'eter mit einer neuen Anfrage (0 = jede Anfrage)"'#10#10'#: tformconfigtrays'
  +'late.labelinitparameters2.caption'#10'msgctxt "tformconfigtrayslate.labelin'
  +'itparameters2.caption"'#10'msgid "Parameters"'#10'msgstr "Parameter"'#10#10
  +'#: tformconfigtrayslate.labelinitparameters4.caption'#10'msgid "Parameters '
  +'in the form key=value used by {key} in requests. If the value is omitted (k'
  +'ey=), it will be requested from the user."'#10'msgstr "Parameter im Format '
  +'key=value, die von {key} in Anfragen verwendet werden. Wenn der Wert weggel'
  +'assen wird (key=), wird er vom Benutzer angefordert."'#10#10'#: tformconfig'
  +'trayslate.labelinitparemeters.caption'#10'msgid "Initial GET request to obt'
  +'ain required parameters."'#10'msgstr "Erste GET-Anfrage zum Abrufen der erf'
  +'orderlichen Parameter."'#10#10'#: tformconfigtrayslate.labeliniturl.caption'
  +#10'msgctxt "tformconfigtrayslate.labeliniturl.caption"'#10'msgid "URL"'#10
  +'msgstr "URL"'#10#10'#: tformconfigtrayslate.labelinituseragent.caption'#10
  +'msgctxt "tformconfigtrayslate.labelinituseragent.caption"'#10'msgid "User A'
  +'gent"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labellanguages'
  +'.caption'#10'msgid "Supported languages e.g. en=en-US (en - internal, en-US'
  +' - service). \"empty\" - do not send."'#10'msgstr "Unterst'#195#188'tzte Sp'
  +'rachen, z. B. en=en-US (en - intern, en-US - Dienst). \"empty\" - nicht sen'
  +'den."'#10#10'#: tformconfigtrayslate.labellanguages1.caption'#10'msgid "Val'
  +'ue type for populating names. None keeps originals; None and Unit are case-'
  +'sensitive."'#10'msgstr "Wertetyp zum Bef'#195#188'llen der Namen. None beh'
  +#195#164'lt Originale; None und Unit unterscheiden Gro'#195#159'-/Kleinschre'
  +'ibung."'#10#10'#: tformconfigtrayslate.labellanguagestarget.caption'#10'msg'
  +'id ""'#10'"Target languages e.g. en=en-US, en - internal, en-US - service c'
  +'ode.\n"'#10'"If not specified, both source and target languages are taken f'
  +'rom the languages section."'#10'msgstr ""'#10'"Zielsprachen, z. B. en=en-US'
  +', en - intern, en-US - Dienstcode.\n"'#10'"Wenn nicht angegeben, werden sow'
  +'ohl Quell- als auch Zielsprachen aus dem Sprachenabschnitt '#195#188'bernom'
  +'men."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10'msgid "Max '
  +'Length, bytes"'#10'msgstr "Maximale L'#195#164'nge, Bytes"'#10#10'#: tformc'
  +'onfigtrayslate.labelmethod.caption'#10'msgid "Method"'#10'msgstr "Methode"'
  +#10#10'#: tformconfigtrayslate.labelparemeters.caption'#10'msgid "Use parame'
  +'ters: {text} '#226#128#147' input text, {source} '#226#128#147' source lang'
  +'uage, {target} '#226#128#147' target language. Prefix the name with ! for l'
  +'owercase or ^ for uppercase value. Also supported {timestamp}, {rand}. Use '
  +'{parameter} from the parameters page."'#10'msgstr "Verwenden Sie Parameter:'
  +' {text} '#226#128#147' Eingabetext, {source} '#226#128#147' Quellsprache, {'
  +'target} '#226#128#147' Zielsprache. F'#195#188'gen Sie dem Namen ! f'#195
