  +'"Live time"'#10'msgstr "'#236#131#157#236#161#180' '#236#139#156#234#176#132
  +'"'#10#10'#: tformconfigtrayslate.labelinitparameters.caption'#10'msgid "Par'
  +'ameters name=regexp are extracted from the response and used by name in req'
  +'uests"'#10'msgstr "'#235#167#164#234#176#156#235#179#128#236#136#152' name='
  +'regexp'#235#138#148' '#236#157#145#235#139#181#236#151#144#236#132#156' '
  +#236#182#148#236#182#156#235#144#152#236#150#180' '#236#154#148#236#178#173
  +#236#151#144#236#132#156' '#236#157#180#235#166#132#236#156#188#235#161#156
  +' '#236#130#172#236#154#169#235#144#169#235#139#136#235#139#164'"'#10#10'#: '
  +'tformconfigtrayslate.labelinitparameters1.caption'#10'msgid "Time in second'
