  +'  if h >= 0 then\n"'#13#10'"    begin\n"'#13#10'"      s := JSONGetString(h'
  +', ''some.path'');\n"'#13#10'"      SetOutput(''text'', s);\n"'#13#10'"     '
  +' JSONFree(h);\n"'#13#10'"    end;\n"'#13#10'"  end.\n"'#13#10'"\n"'#13#10'"'
  +'Available parameters (retrieved with GetParam):\n"'#13#10'"  text - the inp'
