  +'#: tformconfigtrayslate.groupinitparameters.caption'#10'msgctxt "tformconfi'
  +'gtrayslate.groupinitparameters.caption"'#10'msgid "Initial Request"'#10'msg'
  +'str "Initieel verzoek"'#10#10'#: tformconfigtrayslate.grouplanguages.captio'
  +'n'#10'msgctxt "tformconfigtrayslate.grouplanguages.caption"'#10'msgid "Lang'
  +'uages"'#10'msgstr "Talen"'#10#10'#: tformconfigtrayslate.grouplanguagestarg'
  +'et.caption'#10'msgctxt "tformconfigtrayslate.grouplanguagestarget.caption"'
  +#10'msgid "Target Languages"'#10'msgstr "Doeltalen"'#10#10'#: tformconfigtra'
  +'yslate.grouprequest.caption'#10'msgctxt "tformconfigtrayslate.grouprequest.'
  +'caption"'#10'msgid "Request"'#10'msgstr "Verzoek"'#10#10'#: tformconfigtray'
  +'slate.groupresponse.caption'#10'msgid "Json Pointer Processing the Response'
  +'"'#10'msgstr "Verwerking van de respons met Json Pointer"'#10#10'#: tformco'
  +'nfigtrayslate.groupscript.caption'#10'msgid "Script Retrieved Parameters"'
  +#10'msgstr "Door het script opgehaalde parameters"'#10#10'#: tformconfigtray'
  +'slate.groupscriptresponse.caption'#10'msgid "Script Processing the Response'
  +'"'#10'msgstr "Verwerking van de respons door het script"'#10#10'#: tformcon'
  +'figtrayslate.imagepreview.hint'#10'msgid "Click to select the config icon, '
  +'Middle-Click clears the icon"'#10'msgstr "Klik om het configuratiepictogram'
  +' te selecteren, Middle-Click wist het pictogram"'#10#10'#: tformconfigtrays'
  +'late.labelaccept.caption'#10'msgid "Accept"'#10'msgstr "Accept"'#10#10'#: t'
  +'formconfigtrayslate.labelcolorrecent.caption'#10'msgid "Recent Color"'#10'm'
  +'sgstr "Recente kleur"'#10#10'#: tformconfigtrayslate.labelcontenttype.capti'
  +'on'#10'msgid "Content Type"'#10'msgstr "Content Type"'#10#10'#: tformconfig'
  +'trayslate.labelfilllanguages.caption'#10'msgctxt "tformconfigtrayslate.labe'
  +'lfilllanguages.caption"'#10'msgid "Fill with default"'#10'msgstr "Vullen me'
  +'t standaardwaarden"'#10#10'#: tformconfigtrayslate.labelfilltargetlanguages'
  +'.caption'#10'msgctxt "tformconfigtrayslate.labelfilltargetlanguages.caption'
  +'"'#10'msgid "Fill with default"'#10'msgstr "Vullen met standaardwaarden"'#10
  +#10'#: tformconfigtrayslate.labelheaders.caption'#10'msgid "Additional reque'
  +'st headers in key=value format, key: value is also supported"'#10'msgstr "E'
  +'xtra verzoekheaders in key=value-indeling, ook key: value wordt ondersteund'
  +'"'#10#10'#: tformconfigtrayslate.labelinitheaders.caption'#10'msgid "Additi'
  +'onal initial request headers in key=value format, key: value is also suppor'
  +'ted"'#10'msgstr "Extra initi'#195#171'le verzoekheaders in key=value-indeli'
  +'ng, ook key: value wordt ondersteund"'#10#10'#: tformconfigtrayslate.labeli'
  +'nitheaders2.caption'#10'msgctxt "tformconfigtrayslate.labelinitheaders2.cap'
  +'tion"'#10'msgid "Headers"'#10'msgstr "Headers"'#10#10'#: tformconfigtraysla'
  +'te.labelinitlivetime.caption'#10'msgid "Live time"'#10'msgstr "Levensduur"'
  +#10#10'#: tformconfigtrayslate.labelinitparameters.caption'#10'msgid "Parame'
  +'ters name=regexp are extracted from the response and used by name in reques'
  +'ts"'#10'msgstr "Parameters name=regexp worden uit de reactie gehaald en op '
  +'naam gebruikt in verzoeken"'#10#10'#: tformconfigtrayslate.labelinitparamet'
  +'ers1.caption'#10'msgid "Time in seconds to refresh parameters with a new re'
  +'quest (0 = every request)"'#10'msgstr "Tijd in seconden om parameters te ve'
  +'rnieuwen met een nieuw verzoek (0 = elk verzoek)"'#10#10'#: tformconfigtray'
  +'slate.labelinitparameters2.caption'#10'msgctxt "tformconfigtrayslate.labeli'
  +'nitparameters2.caption"'#10'msgid "Parameters"'#10'msgstr "Parameters"'#10
  ,#10'#: tformconfigtrayslate.labelinitparameters4.caption'#10'msgid "Paramete'
  +'rs in the form key=value used by {key} in requests. If the value is omitted'
  +' (key=), it will be requested from the user."'#10'msgstr "Parameters in de '
  +'vorm key=value die door {key} in verzoeken worden gebruikt. Als de waarde o'
  +'ntbreekt (key=), wordt deze aan de gebruiker gevraagd."'#10#10'#: tformconf'
  +'igtrayslate.labelinitparemeters.caption'#10'msgid "Initial GET request to o'
  +'btain required parameters."'#10'msgstr "Initieel GET-verzoek om benodigde p'
  +'arameters te verkrijgen."'#10#10'#: tformconfigtrayslate.labeliniturl.capti'
  +'on'#10'msgctxt "tformconfigtrayslate.labeliniturl.caption"'#10'msgid "URL"'
  +#10'msgstr "URL"'#10#10'#: tformconfigtrayslate.labelinituseragent.caption'
  +#10'msgctxt "tformconfigtrayslate.labelinituseragent.caption"'#10'msgid "Use'
  +'r Agent"'#10'msgstr "User Agent"'#10#10'#: tformconfigtrayslate.labellangua'
  +'ges.caption'#10'msgid "Supported languages e.g. en=en-US (en - internal, en'
  +'-US - service). \"empty\" - do not send."'#10'msgstr "Ondersteunde talen bi'
  +'jv. en=en-US (en - intern, en-US - service). \"empty\" - niet verzenden."'
  +#10#10'#: tformconfigtrayslate.labellanguages1.caption'#10'msgid "Value type'
  +' for populating names. None keeps originals; None and Unit are case-sensiti'
  +'ve."'#10'msgstr "Waardetype voor het invullen van namen. None behoudt origi'
  +'nelen; None en Unit zijn hoofdlettergevoelig."'#10#10'#: tformconfigtraysla'
  +'te.labellanguagestarget.caption'#10'msgid ""'#10'"Target languages e.g. en='
  +'en-US, en - internal, en-US - service code.\n"'#10'"If not specified, both '
  +'source and target languages are taken from the languages section."'#10'msgs'
  +'tr ""'#10'"Doeltalen bijv. en=en-US, en - intern, en-US - servicecode.\n"'
  +#10'"Als niet gespecificeerd, worden zowel bron- als doeltalen uit het talen'
  +'gedeelte gehaald."'#10#10'#: tformconfigtrayslate.labelmaxlength.caption'#10
  +'msgid "Max Length, bytes"'#10'msgstr "Maksymalna d'#197#130'ugo'#197#155#196
  +#135', bajty"'#10#10'#: tformconfigtrayslate.labelmethod.caption'#10'msgid "'
  +'Method"'#10'msgstr "Methode"'#10#10'#: tformconfigtrayslate.labelparemeters'
  +'.caption'#10'msgid "Use parameters: {text} '#226#128#147' input text, {sour'
  +'ce} '#226#128#147' source language, {target} '#226#128#147' target language'
  +'. Prefix the name with ! for lowercase or ^ for uppercase value. Also suppo'
  +'rted {timestamp}, {rand}. Use {parameter} from the parameters page."'#10'ms'
  +'gstr "Gebruik parameters: {text} '#226#128#147' invoertekst, {source} '#226
  +#128#147' brontaal, {target} '#226#128#147' doeltaal. Voorvoegsel ! voor kle'
  +'ine letters of ^ voor hoofdletters. Ook ondersteund {timestamp}, {rand}. Ge'
  +'bruik {parameter} van de parameterpagina."'#10#10'#: tformconfigtrayslate.l'
  +'abelpostdata.caption'#10'msgid "Post Data"'#10'msgstr "Post Data"'#10#10'#:'
  +' tformconfigtrayslate.labelpostdata1.caption'#10'msgctxt "tformconfigtraysl'
  +'ate.labelpostdata1.caption"'#10'msgid "Headers"'#10'msgstr "Headers"'#10#10
  +'#: tformconfigtrayslate.labelservicedescription.caption'#10'msgid "Descript'
  +'ion"'#10'msgstr "Beschrijving"'#10#10'#: tformconfigtrayslate.labelservicen'
  +'ame.caption'#10'msgid "Name"'#10'msgstr "Naam"'#10#10'#: tformconfigtraysla'
  +'te.labelserviceorder.caption'#10'msgid "Order"'#10'msgstr "Volgorde"'#10#10
  +'#: tformconfigtrayslate.labelsort.caption'#10'msgctxt "tformconfigtrayslate'
  +'.labelsort.caption"'#10'msgid "Sort"'#10'msgstr "Sorteren"'#10#10'#: tformc'
  +'onfigtrayslate.labeltargetsort.caption'#10'msgctxt "tformconfigtrayslate.la'
  +'beltargetsort.caption"'#10'msgid "Sort"'#10'msgstr "Sorteren"'#10#10'#: tfo'
  +'rmconfigtrayslate.labelurl.caption'#10'msgctxt "tformconfigtrayslate.labelu'
  +'rl.caption"'#10'msgid "URL"'#10'msgstr "URL"'#10#10'#: tformconfigtrayslate'
  +'.labeluseragent.caption'#10'msgctxt "tformconfigtrayslate.labeluseragent.ca'
  +'ption"'#10'msgid "User Agent"'#10'msgstr "User Agent"'#10#10'#: tformconfig'
  +'trayslate.labelvaluetype.caption'#10'msgid "Value Type"'#10'msgstr "Waardet'
  +'ype"'#10#10'#: tformconfigtrayslate.pageinitialrequest.caption'#10'msgctxt '
  +'"tformconfigtrayslate.pageinitialrequest.caption"'#10'msgid "Initial Reques'
  +'t"'#10'msgstr "Initieel verzoek"'#10#10'#: tformconfigtrayslate.pagelanguag'
  +'es.caption'#10'msgctxt "tformconfigtrayslate.pagelanguages.caption"'#10'msg'
  +'id "Languages"'#10'msgstr "Talen"'#10#10'#: tformconfigtrayslate.pagelangua'
  +'gestarget.caption'#10'msgctxt "tformconfigtrayslate.pagelanguagestarget.cap'
  +'tion"'#10'msgid "Target Languages"'#10'msgstr "Doeltalen"'#10#10'#: tformco'
  +'nfigtrayslate.pageparameters.caption'#10'msgctxt "tformconfigtrayslate.page'
  +'parameters.caption"'#10'msgid "Parameters"'#10'msgstr "Parameters"'#10#10'#'
  +': tformconfigtrayslate.pagerequest.caption'#10'msgctxt "tformconfigtrayslat'
  +'e.pagerequest.caption"'#10'msgid "Request"'#10'msgstr "Verzoek"'#10#10'#: t'
  +'formconfigtrayslate.pageresponse.caption'#10'msgid "Response"'#10'msgstr "R'
  ,'eactie"'#10#10'#: tformconfigtrayslate.pageservice.caption'#10'msgctxt "tfo'
  +'rmconfigtrayslate.pageservice.caption"'#10'msgid "Service"'#10'msgstr "Serv'
  +'ice"'#10#10'#: tformconfigtrayslate.reloadconfigs.hint'#10'msgid "Reload co'
  +'nfigurations from disk"'#10'msgstr "Configuraties opnieuw laden vanaf schij'
  +'f"'#10#10'#: tformconfigtrayslate.sbcopyconfig.hint'#10'msgid "Copy configu'
  +'ration"'#10'msgstr "Configuratie kopi'#195#171'ren"'#10#10'#: tformconfigtr'
  +'ayslate.sbnewconfig.hint'#10'msgid "New configuration"'#10'msgstr "Nieuwe c'
  +'onfiguratie"'#10#10
]);
LazarusResources.Add('formconfig.pl','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: plaintool <astverskoy@'
  +'gmail.com>\n"'#10'"Language-Team: \n"'#10'"Language: pl\n"'#10'"MIME-Versio'
  +'n: 1.0\n"'#10'"Content-Type: text/plain; charset=UTF-8\n"'#10'"Content-Tran'
  +'sfer-Encoding: 8bit\n"'#10'"X-Generator: PoBatch 1.0.0"'#10#10'#: formconfi'
  +'g.rcaption'#10'msgctxt "formconfig.rcaption"'#10'msgid "Config Editor"'#10
  +'msgstr "Edytor konfiguracji"'#10#10'#: formconfig.rclearlanguages'#10'msgid'
  +' "The list is already filled. Do you want to clear it?"'#10'msgstr "Lista j'
  +'est ju'#197#188' wype'#197#130'niona. Czy chcesz j'#196#133' wyczy'#197#155
  +'ci'#196#135'?"'#10#10'#: formconfig.rdeleteconfig'#10'msgid "Are you sure y'
  +'ou want to delete config"'#10'msgstr "Czy na pewno chcesz usun'#196#133#196
  +#135' konfiguracj'#196#153'"'#10#10'#: formconfig.rdeleteconfigcaption'#10'm'
  +'sgid "Delete config"'#10'msgstr "Usu'#197#132' konfiguracj'#196#153'"'#10#10
  +'#: formconfig.rnamequestion'#10'msgid "Enter new config file name:"'#10'msg'
  +'str "Wprowad'#197#186' nazw'#196#153' nowego pliku konfiguracyjnego:"'#10#10
  +'#: formconfig.rneedsave'#10'msgid "The configuration was modified. Save cha'
  +'nges?"'#10'msgstr "Konfiguracja zosta'#197#130'a zmodyfikowana. Zapisa'#196
  +#135' zmiany?"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Poi'
  +'nter: Use / for levels, keys for objects, and numbers for indexes.\n"'#10'"'
  +'Use * for all items, *#10 to join items by newline. Use ~ at the end of the'
  +' path to return the raw JSON branch.\n"'#10'"Separate multiple segments wit'
  +'h semicolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag'
  +' #10 for newlines. Use {{regex}} inside to extract data directly into the t'
  +'ext.\n"'#10'"Logic: If a Pointer in a segment is empty, the whole segment i'
  +'s skipped. If a segment has no Pointer, only literal text blocks with embed'
  +'ded regular expressions are processed.\n"'#10'"Regex: {prefix {regex[index]'
  +'} suffix} inside a text block. If no [index] is specified, the first match '
  +'is used.\n"'#10'"Index can be a number, [*] (join by space), or [*#10] (joi'
  +'n by newline). If the regex finds no match, the entire {'#226#128#166'} blo'
  +'ck is removed.\n"'#10'"Using ~ inside a regex returns the entire text.\n"'
  +#10'"Inversion: Start a segment with ! (e.g. !/path{Error}) to show its text'
  +' only if the Pointer data is missing or the JSON is invalid.\n"'#10'"Commen'
  +'ting: /* text */ comments are stripped from the entire expression before an'
  +'y processing.\n"'#10'"Examples:\n"'#10'"responseData/translatedText; matche'
  +'s/*#10/translation; /texts/text; {literal text#10}; /result/text; /text{ ({'
  +'(\\w+)})}; !/translations{Error: No data!#10}; /translations/0/text"'#10'ms'
  +'gstr ""'#10'"Wska'#197#186'nik JSON: U'#197#188'yj / dla poziom'#195#179'w,'
  +' kluczy dla obiekt'#195#179'w i liczb dla indeks'#195#179'w. U'#197#188'yj '
  +'* dla wszystkich element'#195#179'w oraz *#10 do '#197#130#196#133'czenia e'
  +'lement'#195#179'w za pomoc'#196#133' nowej linii. U'#197#188'yj ~ na ko'#197
  +#132'cu '#197#155'cie'#197#188'ki, aby zwr'#195#179'ci'#196#135' surow'#196
  +#133' ga'#197#130#196#133#197#186' JSON. Oddziel wiele segment'#195#179'w '
  +#197#155'rednikiem ;.\n"'#10'"Litera'#197#130': Blok tekstu w {'#226#128#166
  +'}. Specjalny znacznik #10 dla nowych linii. U'#197#188'yj {{regex}} wewn'
  +#196#133'trz, aby wyodr'#196#153'bni'#196#135' dane bezpo'#197#155'rednio do'
  +' tekstu.\n"'#10'"Logika: Je'#197#155'li wska'#197#186'nik w segmencie jest '
  +'pusty, ca'#197#130'y segment jest pomijany. Je'#197#155'li segment nie zawi'
  +'era wska'#197#186'nika, przetwarzane s'#196#133' tylko litera'#197#130'y te'
  +'kstowe z osadzonymi wyra'#197#188'eniami regularnymi.\n"'#10'"Regex: {prefi'
  +'ks {regex[index]} sufiks} wewn'#196#133'trz bloku tekstowego. Je'#197#155'l'
  +'i [index] nie zostanie okre'#197#155'lony, u'#197#188'ywane jest pierwsze d'
  +'opasowanie. Indeks mo'#197#188'e by'#196#135' liczb'#196#133', [*] ('#197
  +#130#196#133'czenie spacj'#196#133') lub [*#10] ('#197#130#196#133'czenie no'
  +'w'#196#133' lini'#196#133'). Je'#197#155'li wyra'#197#188'enie regularne ni'
  +'e znajdzie dopasowania, ca'#197#130'y blok {'#226#128#166'} zostaje usuni'
  +#196#153'ty. U'#197#188'ycie ~ wewn'#196#133'trz wyra'#197#188'enia regularn'
  +'ego zwraca ca'#197#130'y tekst.\n"'#10'"Odwr'#195#179'cenie: Rozpocznij seg'
  +'ment od ! (np. !/path{Error}), aby wy'#197#155'wietli'#196#135' jego tekst '
  +'tylko wtedy, gdy brakuje danych wska'#197#186'nika lub JSON jest nieprawid'
  +#197#130'owy.\n"'#10'"Komentarze: Komentarze /* tekst */ s'#196#133' usuwane'
  +' z ca'#197#130'ego wyra'#197#188'enia przed rozpocz'#196#153'ciem jakiegoko'
  +'lwiek przetwarzania.\n"'#10'"Przyk'#197#130'ady:\n"'#10'"responseData/trans'
  +'latedText; matches/*#10/translation; /texts/text; {literal text#10}; /resul'
  +'t/text; /text{ ({(\\w+)})}; !/translations{Error: No data!#10}; /translatio'
  ,'ns"'#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a stan'
  +'dard Pascal program: optional var section, then a main begin ... end. block'
  +'.\n"'#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10
  +'"    s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', '
  +'False);\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10
  +'"You can also use standard Pascal constructs (if, for, while, repeat, etc.)'
  +'. You can define your own functions and procedures before the main begin ..'
  +'. end. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''na'
  +'me'') : string\n"'#10'"    Retrieve an input parameter value.\n"'#10'"  Set'
  +'Output(''name'', ''value'')\n"'#10'"    Store an output value for the host.'
  +'\n"'#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timestamp in mil'
  +'liseconds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random int'
  +'eger with exactly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10
  +'"    Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : '
  +'string\n"'#10'"    Convert integer to hexadecimal string with at least Digi'
  +'ts characters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string'
  +' to an integer. Raises an exception on invalid input.\n"'#10'"  IntToStr(Va'
  +'lue) : string\n"'#10'"    Convert an integer to its string representation.\'
  +'n"'#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailing whitespa'
  +'ce from S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whites'
  +'pace from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing wh'
  +'itespace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode specia'
  +'l HTML characters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'
  +#10'"    Decode HTML entities in S back to characters.\n"'#10'"  UrlEncode(S'
  +') : string\n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"  U'
  +'rlDecode(S) : string\n"'#10'"    Decode a percent-encoded string S.\n"'#10
  +'"  ReplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10
  +'"    Replace all occurrences of OldPattern with NewPattern in S.\n"'#10'"  '
  +'RegexReplace(Input, Pattern, Replacement) : string\n"'#10'"    Replace all '
  +'regex matches of Pattern with Replacement in Input. Case-insensitive.\n"'#10
  +'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if Input matches '
  +'the regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarke'
  +'r, EndMarker) : string\n"'#10'"    Extract the substring of S between Start'
  +'Marker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle returne'
  +'d by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON '
  +'string and return a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(H'
  +'andle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSONGetString(Ha'
  +'ndle, Path) : string\n"'#10'"    Get a string value at the specified Path.\'
  +'n"'#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an integer val'
  +'ue at the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n'
  +'"'#10'"    Get a floating-point value at the specified Path.\n"'#10'"  JSON'
  +'GetBool(Handle, Path) : Boolean\n"'#10'"    Get a boolean value at the spec'
  +'ified Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"   '
  +' Get the number of elements in an array at the specified Path.\n"'#10'"  JS'
  +'ONGetArrayString(Handle, Path, Index) : string\n"'#10'"    Get the string v'
  +'alue of an array element at the given Index.\n"'#10'"  JSONGetArrayInt(Hand'
  +'le, Path, Index) : Integer\n"'#10'"    Get the integer value of an array el'
  +'ement at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'
  +#10'"    Return the type of the value at Path: \"object\", \"array\", \"stri'
  +'ng\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Hand'
  +'le, Path) : Boolean\n"'#10'"    Check if the specified Path exists.\n"'#10
  +'"  JSONResultInit\n"'#10'"    Initialize an empty JSON array for building a'
  +' standard error result.\n"'#10'"  JSONResultAddError(Offset, Length, Messag'
  +'e, Replacements)\n"'#10'"    Add an error object to the result array. Repla'
  +'cements is a string of values separated by \"|\".\n"'#10'"  JSONResultGet :'
  +' string\n"'#10'"    Return the current result array as a JSON string.\n"'#10
  +'"  JSONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always cal'
  +'l JSONFree to release the handle after you are done.\n"'#10'"\n"'#10'"Examp'
  +'le of working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;'
  +'\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"'
  +'    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, '''
  +'some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree('
  +'h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters ('
  +'retrieved with GetParam):\n"'#10'"  text - the input text to process (possi'
  ,'bly truncated to MaxLength)\n"'#10'"  source - source language code (may be'
  +' empty)\n"'#10'"  target - target language code\n"'#10'"  timestamp - curre'
  +'nt Unix timestamp in milliseconds (string)\n"'#10'"  random  - 9-digit rand'
  +'om number (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 -'
  +' first 1..9 digits of the random number\n"'#10'"\n"'#10'"Additional initial'
  +' and custom parameters are also available."'#10'msgstr ""'#10'"Skrypt jest '
  +'standardowym programem Pascal: opcjonalna sekcja var, a nast'#196#153'pnie '
  +'g'#197#130#195#179'wny blok begin ... end.\n"'#10'"\n"'#10'"Przyk'#197#130
  +'ad:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''te'
  +'xt'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    Set'
  +'Output(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Mo'#197#188'esz r'#195
  +#179'wnie'#197#188' u'#197#188'ywa'#196#135' standardowych konstrukcji Pasca'
  +'la (if, for, while, repeat itd.). Mo'#197#188'esz definiowa'#196#135' w'#197
  +#130'asne funkcje i procedury przed g'#197#130#195#179'wnym blokiem begin ..'
  +'. end.\n"'#10'"\n"'#10'"Dost'#196#153'pne funkcje:\n"'#10'"  GetParam(''nam'
  +'e'') : string\n"'#10'"    Pobiera warto'#197#155#196#135' parametru wej'#197
  +#155'ciowego.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Zapisuje '
  +'warto'#197#155#196#135' wyj'#197#155'ciow'#196#133' dla hosta.\n"'#10'"  Ge'
  +'tTimestamp() : Int64\n"'#10'"    Bie'#197#188#196#133'cy znacznik czasu Uni'
  +'x w milisekundach (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Lo'
  +'sowa liczba ca'#197#130'kowita zawieraj'#196#133'ca dok'#197#130'adnie Leng'
  +'th cyfr dziesi'#196#153'tnych.\n"'#10'"  Random : Extended\n"'#10'"    Loso'
  +'wa liczba zmiennoprzecinkowa z zakresu [0, 1).\n"'#10'"  IntToHex(Value, Di'
  +'gits) : string\n"'#10'"    Konwertuje liczb'#196#153' ca'#197#130'kowit'#196
  +#133' na ci'#196#133'g szesnastkowy zawieraj'#196#133'cy co najmniej Digits '
  +'znak'#195#179'w.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Konwertuje ci'
  +#196#133'g znak'#195#179'w na liczb'#196#153' ca'#197#130'kowit'#196#133'. Z'
  +'g'#197#130'asza wyj'#196#133'tek w przypadku nieprawid'#197#130'owego wej'
  +#197#155'cia.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Konwertuje licz'
  +'b'#196#153' ca'#197#130'kowit'#196#133' na jej reprezentacj'#196#153' tekst'
  +'ow'#196#133'.\n"'#10'"  Trim(S) : string\n"'#10'"    Usuwa bia'#197#130'e z'
  +'naki z pocz'#196#133'tku i ko'#197#132'ca S.\n"'#10'"  TrimLeft(S) : string'
  +'\n"'#10'"    Usuwa bia'#197#130'e znaki z pocz'#196#133'tku S.\n"'#10'"  Tr'
  +'imRight(S) : string\n"'#10'"    Usuwa bia'#197#130'e znaki z ko'#197#132'ca'
  +' S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Koduje specjalne znaki HTM'
  +'L w S jako encje.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Dekoduje enc'
  +'je HTML w S z powrotem do znak'#195#179'w.\n"'#10'"  UrlEncode(S) : string\'
  +'n"'#10'"    Koduje S za pomoc'#196#133' kodowania procentowego, aby mo'#197
  +#188'na by'#197#130'o bezpiecznie umie'#197#155'ci'#196#135' je w adresie UR'
  +'L.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Dekoduje ci'#196#133'g S zak'
  +'odowany za pomoc'#196#133' kodowania procentowego.\n"'#10'"  ReplaceAll(S, '
  +'OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"    Zast'#196#153
  +'puje wszystkie wyst'#196#133'pienia OldPattern w S ci'#196#133'giem NewPatt'
  +'ern.\n"'#10'"  RegexReplace(Input, Pattern, Replacement) : string\n"'#10'" '
  +'   Zast'#196#153'puje wszystkie dopasowania wyra'#197#188'enia regularnego '
  +'Pattern ci'#196#133'giem Replacement w Input. Nie rozr'#195#179#197#188'nia'
  +' wielko'#197#155'ci liter.\n"'#10'"  RegexMatch(Input, Pattern) : Boolean\n'
  +'"'#10'"    Sprawdza, czy Input pasuje do wyra'#197#188'enia regularnego Pat'
  +'tern. Nie rozr'#195#179#197#188'nia wielko'#197#155'ci liter.\n"'#10'"  Ext'
  +'ractBetween(S, StartMarker, EndMarker) : string\n"'#10'"    Wyodr'#196#153
  +'bnia podci'#196#133'g S znajduj'#196#133'cy si'#196#153' mi'#196#153'dzy St'
  +'artMarker i EndMarker.\n"'#10'"\n"'#10'"Funkcje JSON (u'#197#188'yj uchwytu'
  +' zwr'#195#179'conego przez JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'
  +#10'"    Analizuje ci'#196#133'g JSON i zwraca uchwyt (>=0). Zwraca -1 w prz'
  +'ypadku b'#197#130#196#153'du.\n"'#10'"  JSONFree(Handle)\n"'#10'"    Zwalni'
  +'a uchwyt po zako'#197#132'czeniu u'#197#188'ycia.\n"'#10'"  JSONGetString(H'
  +'andle, Path) : string\n"'#10'"    Pobiera warto'#197#155#196#135' tekstow'
  +#196#133' ze wskazanej '#197#155'cie'#197#188'ki Path.\n"'#10'"  JSONGetInt('
  +'Handle, Path) : Integer\n"'#10'"    Pobiera warto'#197#155#196#135' ca'#197
  +#130'kowit'#196#133' ze wskazanej '#197#155'cie'#197#188'ki Path.\n"'#10'"  '
  +'JSONGetFloat(Handle, Path) : Extended\n"'#10'"    Pobiera warto'#197#155#196
  +#135' zmiennoprzecinkow'#196#133' ze wskazanej '#197#155'cie'#197#188'ki Pat'
  +'h.\n"'#10'"  JSONGetBool(Handle, Path) : Boolean\n"'#10'"    Pobiera warto'
  +#197#155#196#135' logiczn'#196#133' ze wskazanej '#197#155'cie'#197#188'ki P'
  ,'ath.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Pobier'
  +'a liczb'#196#153' element'#195#179'w tablicy ze wskazanej '#197#155'cie'#197
  +#188'ki Path.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'
  +#10'"    Pobiera warto'#197#155#196#135' tekstow'#196#133' elementu tablicy '
  +'o podanym indeksie Index.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : '
  +'Integer\n"'#10'"    Pobiera warto'#197#155#196#135' ca'#197#130'kowit'#196
  +#133' elementu tablicy o podanym indeksie Index.\n"'#10'"  JSONGetType(Handl'
  +'e, Path) : string\n"'#10'"    Zwraca typ warto'#197#155'ci w Path: \"object'
  +'\", \"array\", \"string\", \"int\", \"float\", \"bool\", \"null\".\n"'#10'"'
  +'  JSONPathExists(Handle, Path) : Boolean\n"'#10'"    Sprawdza, czy okre'#197
  +#155'lona '#197#155'cie'#197#188'ka Path istnieje.\n"'#10'"  JSONResultInit\'
  +'n"'#10'"    Inicjalizuje pust'#196#133' tablic'#196#153' JSON do tworzenia '
  +'standardowego wyniku b'#197#130#196#153'du.\n"'#10'"  JSONResultAddError(Of'
  +'fset, Length, Message, Replacements)\n"'#10'"    Dodaje obiekt b'#197#130
  +#196#153'du do tablicy wynik'#195#179'w. Replacements to ci'#196#133'g warto'
  +#197#155'ci rozdzielonych znakiem \"|\".\n"'#10'"  JSONResultGet : string\n"'
  +#10'"    Zwraca bie'#197#188#196#133'c'#196#133' tablic'#196#153' wynik'#195
  +#179'w jako ci'#196#133'g JSON.\n"'#10'"  JSONResultClear\n"'#10'"    Czy'
  +#197#155'ci tablic'#196#153' wynik'#195#179'w.\n"'#10'"  Zawsze wywo'#197#130
  +'uj JSONFree, aby zwolni'#196#135' uchwyt po zako'#197#132'czeniu jego u'#197
  +#188'ywania.\n"'#10'"\n"'#10'"Przyk'#197#130'ad pracy z JSON:\n"'#10'"  var '
  +'h: Integer;\n"'#10'"      s: string;\n"'#10'"  begin\n"'#10'"    h := JSONP'
  +'arse(GetParam(''result''));\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'
  +#10'"      s := JSONGetString(h, ''some.path'');\n"'#10'"      SetOutput(''t'
  +'ext'', s);\n"'#10'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10
  +'"\n"'#10'"Dost'#196#153'pne parametry (pobierane za pomoc'#196#133' GetPara'
  +'m):\n"'#10'"  text - tekst wej'#197#155'ciowy do przetworzenia (mo'#197#188
  +'e zosta'#196#135' obci'#196#153'ty do MaxLength)\n"'#10'"  source - kod j'
  +#196#153'zyka '#197#186'r'#195#179'd'#197#130'owego (mo'#197#188'e by'#196
  +#135' pusty)\n"'#10'"  target - kod j'#196#153'zyka docelowego\n"'#10'"  tim'
  +'estamp - bie'#197#188#196#133'cy znacznik czasu Unix w milisekundach (ci'
  +#196#133'g znak'#195#179'w)\n"'#10'"  random  - losowa liczba 9-cyfrowa (ci'
  +#196#133'g znak'#195#179'w)\n"'#10'"  rand - to samo co random\n"'#10'"  ran'
  +'d1..rand9 - pierwsze 1..9 cyfr liczby losowej\n"'#10'"\n"'#10'"Dost'#196#153
  +'pne s'#196#133' r'#195#179'wnie'#197#188' dodatkowe parametry pocz'#196#133
  +'tkowe i niestandardowe."'#10#10'#: formconfig.rscriptresponsehint'#10'msgid'
  +' ""'#10'"This script processes the response data. All functions and paramet'
  +'ers described in the script hint are available here as well.\n"'#10'"Use Ge'
  +'tParam(''result'') to obtain the received text.\n"'#10'"\n"'#10'"Example:\n'
  +'"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''result'
  +''');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"'
  +'You can define custom parameters in the parameters script using SetParam('''
  +'name'', ''value''),\n"'#10'"and then retrieve them here with GetParam(''nam'
  +'e'')."'#10'msgstr ""'#10'"Ten skrypt przetwarza dane odpowiedzi. Wszystkie '
  +'funkcje i parametry opisane w podpowiedzi skryptu s'#196#133' r'#195#179'wn'
  +'ie'#197#188' dost'#196#153'pne tutaj.\n"'#10'"U'#197#188'yj GetParam(''resu'
  +'lt''), aby uzyska'#196#135' otrzymany tekst.\n"'#10'"\n"'#10'"Przyk'#197#130
  +'ad:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''re'
  +'sult'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'
  +#10'"Mo'#197#188'esz zdefiniowa'#196#135' w'#197#130'asne parametry w skrypc'
  +'ie parametr'#195#179'w za pomoc'#196#133' SetParam(''name'', ''value''),\n"'
  +#10'"a nast'#196#153'pnie pobra'#196#135' je tutaj za pomoc'#196#133' GetPar'
  +'am(''name'')."'#10#10'#: formconfig.rvaluetype1'#10'msgctxt "formconfig.rva'
  +'luetype1"'#10'msgid "None"'#10'msgstr "Brak"'#10#10'#: formconfig.rvaluetyp'
  +'e2'#10'msgid "Language"'#10'msgstr "J'#196#153'zyk"'#10#10'#: formconfig.rv'
  +'aluetype3'#10'msgid "Currency All"'#10'msgstr "Wszystkie waluty"'#10#10'#: '
  +'formconfig.rvaluetype4'#10'msgid "Currency Fiat Only"'#10'msgstr "Tylko wal'
  +'uty fiat"'#10#10'#: formconfig.rvaluetype5'#10'msgid "Currency Crypto Only"'
  +#10'msgstr "Tylko kryptowaluty"'#10#10'#: formconfig.rvaluetype6'#10'msgid "'
  +'Measurement Units"'#10'msgstr "Jednostki miary"'#10#10'#: tformconfigtraysl'
