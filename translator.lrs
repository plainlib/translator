  +#195#167#195#181'es do disco"'#10#10'#: tformconfigtrayslate.sbcopyconfig.hi'
  +'nt'#10'msgid "Copy configuration"'#10'msgstr "Copiar configura'#195#167#195
  +#163'o"'#10#10'#: tformconfigtrayslate.sbnewconfig.hint'#10'msgid "New confi'
  +'guration"'#10'msgstr "Nova configura'#195#167#195#163'o"'#10#10
]);
LazarusResources.Add('formconfig.pt-BR','PO',[
  'msgid ""'#10'msgstr ""'#10'"Project-Id-Version: \n"'#10'"POT-Creation-Date: '
  +'\n"'#10'"PO-Revision-Date: \n"'#10'"Last-Translator: Havokdan\n"'#10'"Langu'
  +'age-Team: \n"'#10'"Language: pt-br\n"'#10'"MIME-Version: 1.0\n"'#10'"Conten'
  +'t-Type: text/plain; charset=UTF-8\n"'#10'"Content-Transfer-Encoding: 8bit\n'
  +'"'#10'"X-Generator: Poedit 3.5"'#10#10'#: formconfig.rcaption'#10'msgctxt "'
  +'formconfig.rcaption"'#10'msgid "Config Editor"'#10'msgstr "Editor de Config'
  +'ura'#195#167#195#181'es"'#10#10'#: formconfig.rclearlanguages'#10'msgid "Th'
  +'e list is already filled. Do you want to clear it?"'#10'msgstr "A lista j'
  +#195#161' est'#195#161' preenchida. Voc'#195#170' quer limpar isso?"'#10#10
  +'#: formconfig.rdeleteconfig'#10'msgid "Are you sure you want to delete conf'
  +'ig"'#10'msgstr "Tem certeza de que deseja excluir a configura'#195#167#195
  +#163'o"'#10#10'#: formconfig.rdeleteconfigcaption'#10'msgid "Delete config"'
  +#10'msgstr "Excluir configura'#195#167#195#163'o"'#10#10'#: formconfig.rname'
  +'question'#10'msgid "Enter new config file name:"'#10'msgstr "Digite o nome '
  +'do novo arquivo de configura'#195#167#195#163'o:"'#10#10'#: formconfig.rnee'
  +'dsave'#10'msgid "The configuration was modified. Save changes?"'#10'msgstr '
  +'"A configura'#195#167#195#163'o foi modificada. Salvar altera'#195#167#195
  +#181'es?"'#10#10'#: formconfig.rresponsehint'#10'msgid ""'#10'"Json Pointer:'
  +' Use / for levels, keys for objects, and numbers for indexes.\n"'#10'"Use *'
  +' for all items, *#10 to join items by newline. Use ~ at the end of the path'
  +' to return the raw JSON branch.\n"'#10'"Separate multiple segments with sem'
  +'icolon ;.\n"'#10'"Literal: Text block in {'#226#128#166'}. Special tag #10 '
  +'for newlines. Use {{regex}} inside to extract data directly into the text.\'
  +'n"'#10'"Logic: If a Pointer in a segment is empty, the whole segment is ski'
  +'pped. If a segment has no Pointer, only literal text blocks with embedded r'
  +'egular expressions are processed.\n"'#10'"Regex: {prefix {regex[index]} suf'
  +'fix} inside a text block. If no [index] is specified, the first match is us'
  +'ed.\n"'#10'"Index can be a number, [*] (join by space), or [*#10] (join by '
  +'newline). If the regex finds no match, the entire {'#226#128#166'} block is'
  +' removed.\n"'#10'"Using ~ inside a regex returns the entire text.\n"'#10'"I'
  +'nversion: Start a segment with ! (e.g. !/path{Error}) to show its text only'
  +' if the Pointer data is missing or the JSON is invalid.\n"'#10'"Commenting:'
  +' /* text */ comments are stripped from the entire expression before any pro'
  +'cessing.\n"'#10'"Examples:\n"'#10'"responseData/translatedText; matches/*#1'
  +'0/translation; /texts/text; {literal text#10}; /result/text; /text{ ({(\\w+'
  +')})}; !/translations{Error: No data!#10}; /translations/0/text"'#10'msgstr '
  +'""'#10'"Ponteiro Json: Use / para n'#195#173'veis, chaves para objetos e n'
  +#195#186'meros para '#195#173'ndices.\n"'#10'"Use * para todos os itens, *#1'
  +'0 para unir itens por quebra de linha. Use ~ no final do caminho para retor'
  +'nar o branch JSON bruto.\n"'#10'"Separe v'#195#161'rios segmentos com ponto'
  +' e v'#195#173'rgula ;.\n"'#10'"Literal: Bloco de texto em {'#226#128#166'}.'
  +' Etiqueta especial #10 para quebras de linha. Use {{regex}} dentro para ext'
  +'rair dados diretamente no texto.\n"'#10'"L'#195#179'gica: Se um Ponteiro em'
  +' um segmento estiver vazio, o segmento inteiro '#195#169' ignorado. Se um s'
  +'egmento n'#195#163'o tiver Ponteiro, apenas blocos de texto literal com exp'
  +'ress'#195#181'es regulares incorporadas s'#195#163'o processados.\n"'#10'"R'
  +'egex: {prefixo {regex['#195#173'ndice]} sufixo} dentro de um bloco de texto'
  +'. Se nenhum ['#195#173'ndice] for especificado, a primeira correspond'#195
  +#170'ncia ser'#195#161' usada.\n"'#10'"O '#195#173'ndice pode ser um n'#195
  +#186'mero, [*] (jun'#195#167#195#163'o por espa'#195#167'o) ou [*#10] (jun'
  +#195#167#195#163'o por nova linha). Se a regex n'#195#163'o encontrar nenhum'
  +'a correspond'#195#170'ncia, todo o bloco {'#226#128#166'} ser'#195#161' rem'
  +'ovido.\n"'#10'"Usar ~ dentro de uma regex retorna o texto inteiro.\n"'#10'"'
  +'Invers'#195#163'o: Comece um segmento com ! (por exemplo, !/caminho{Erro}) '
  +'para mostrar seu texto somente se os dados do Pointer estiverem ausentes ou'
  +' o JSON for inv'#195#161'lido.\n"'#10'"Comentando: Coment'#195#161'rios /* '
  +'texto */ s'#195#163'o removidos de toda a express'#195#163'o antes de qualq'
  +'uer processamento.\n"'#10'"Exemplos:\n"'#10'"responseData/translatedText; m'
  +'atches/*#10/translation; /texts/text; {texto literal#10}; /result/text; /te'
  +'xt{ ({(\\w+)})}; !/translations{Erro: Sem dados!#10}; /translations/0/text"'
  +#10#10'#: formconfig.rscripthint'#10'msgid ""'#10'"The script is a standard '
  +'Pascal program: optional var section, then a main begin ... end. block.\n"'
  +#10'"\n"'#10'"Example:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    '
  +'s := GetParam(''text'');\n"'#10'"    s := ReplaceAll(s, ''-'', ''_'', False'
  ,');\n"'#10'"    SetOutput(''text'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"You '
  +'can also use standard Pascal constructs (if, for, while, repeat, etc.). You'
  +' can define your own functions and procedures before the main begin ... end'
  +'. block.\n"'#10'"\n"'#10'"Available functions:\n"'#10'"  GetParam(''name'')'
  +' : string\n"'#10'"    Retrieve an input parameter value.\n"'#10'"  SetOutpu'
  +'t(''name'', ''value'')\n"'#10'"    Store an output value for the host.\n"'
  +#10'"  GetTimestamp() : Int64\n"'#10'"    Current Unix timestamp in millisec'
  +'onds (UTC).\n"'#10'"  GetRandom(Length) : Int64\n"'#10'"    Random integer '
  +'with exactly Length decimal digits.\n"'#10'"  Random : Extended\n"'#10'"   '
  +' Random float in the range [0, 1).\n"'#10'"  IntToHex(Value, Digits) : stri'
  +'ng\n"'#10'"    Convert integer to hexadecimal string with at least Digits c'
  +'haracters.\n"'#10'"  StrToInt(S) : Integer\n"'#10'"    Convert a string to '
  +'an integer. Raises an exception on invalid input.\n"'#10'"  IntToStr(Value)'
  +' : string\n"'#10'"    Convert an integer to its string representation.\n"'
  +#10'"  Trim(S) : string\n"'#10'"    Remove leading and trailing whitespace f'
  +'rom S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove leading whitespace'
  +' from S.\n"'#10'"  TrimRight(S) : string\n"'#10'"    Remove trailing whites'
  +'pace from S.\n"'#10'"  HtmlEncode(S) : string\n"'#10'"    Encode special HT'
  +'ML characters in S into entities.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"'
  +'    Decode HTML entities in S back to characters.\n"'#10'"  UrlEncode(S) : '
  +'string\n"'#10'"    Percent-encode S for safe URL inclusion.\n"'#10'"  UrlDe'
  +'code(S) : string\n"'#10'"    Decode a percent-encoded string S.\n"'#10'"  R'
  +'eplaceAll(S, OldPattern, NewPattern, IgnoreCase=False) : string\n"'#10'"   '
  +' Replace all occurrences of OldPattern with NewPattern in S.\n"'#10'"  Rege'
  +'xReplace(Input, Pattern, Replacement) : string\n"'#10'"    Replace all rege'
  +'x matches of Pattern with Replacement in Input. Case-insensitive.\n"'#10'" '
  +' RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Check if Input matches th'
  +'e regex Pattern. Case-insensitive.\n"'#10'"  ExtractBetween(S, StartMarker,'
  +' EndMarker) : string\n"'#10'"    Extract the substring of S between StartMa'
  +'rker and EndMarker.\n"'#10'"\n"'#10'"JSON functions (use a handle returned '
  +'by JSONParse):\n"'#10'"  JSONParse(S) : Integer\n"'#10'"    Parse a JSON st'
  +'ring and return a handle (>=0). Returns -1 on error.\n"'#10'"  JSONFree(Han'
  +'dle)\n"'#10'"    Release the handle after use.\n"'#10'"  JSONGetString(Hand'
  +'le, Path) : string\n"'#10'"    Get a string value at the specified Path.\n"'
  +#10'"  JSONGetInt(Handle, Path) : Integer\n"'#10'"    Get an integer value a'
  +'t the specified Path.\n"'#10'"  JSONGetFloat(Handle, Path) : Extended\n"'#10
  +'"    Get a floating-point value at the specified Path.\n"'#10'"  JSONGetBoo'
  +'l(Handle, Path) : Boolean\n"'#10'"    Get a boolean value at the specified '
  +'Path.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Integer\n"'#10'"    Get t'
  +'he number of elements in an array at the specified Path.\n"'#10'"  JSONGetA'
  +'rrayString(Handle, Path, Index) : string\n"'#10'"    Get the string value o'
  +'f an array element at the given Index.\n"'#10'"  JSONGetArrayInt(Handle, Pa'
  +'th, Index) : Integer\n"'#10'"    Get the integer value of an array element '
  +'at the given Index.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"  '
  +'  Return the type of the value at Path: \"object\", \"array\", \"string\", '
  +'\"int\", \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Pa'
  +'th) : Boolean\n"'#10'"    Check if the specified Path exists.\n"'#10'"  JSO'
  +'NResultInit\n"'#10'"    Initialize an empty JSON array for building a stand'
  +'ard error result.\n"'#10'"  JSONResultAddError(Offset, Length, Message, Rep'
  +'lacements)\n"'#10'"    Add an error object to the result array. Replacement'
  +'s is a string of values separated by \"|\".\n"'#10'"  JSONResultGet : strin'
  +'g\n"'#10'"    Return the current result array as a JSON string.\n"'#10'"  J'
  +'SONResultClear\n"'#10'"    Clear the result array.\n"'#10'"  Always call JS'
  +'ONFree to release the handle after you are done.\n"'#10'"\n"'#10'"Example o'
  +'f working with JSON:\n"'#10'"  var h: Integer;\n"'#10'"      s: string;\n"'
  +#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''result''));\n"'#10'"    i'
  +'f h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JSONGetString(h, ''some.'
  +'path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10'"      JSONFree(h);\n'
  +'"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Available parameters (retri'
  +'eved with GetParam):\n"'#10'"  text - the input text to process (possibly t'
  +'runcated to MaxLength)\n"'#10'"  source - source language code (may be empt'
  +'y)\n"'#10'"  target - target language code\n"'#10'"  timestamp - current Un'
  +'ix timestamp in milliseconds (string)\n"'#10'"  random  - 9-digit random nu'
  +'mber (string)\n"'#10'"  rand - same as random\n"'#10'"  rand1..rand9 - firs'
  ,'t 1..9 digits of the random number\n"'#10'"\n"'#10'"Additional initial and '
  +'custom parameters are also available."'#10'msgstr ""'#10'"O script '#195#169
  +' um programa Pascal padr'#195#163'o: se'#195#167#195#163'o var opcional, de'
  +'pois um bloco main begin ... end.\n"'#10'"\n"'#10'"Exemplo:\n"'#10'"  var s'
  +': string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''text'');\n"'#10'"    '
  +'s :=\n"'#10'"ReplaceAll(s, ''-'', ''_'', False);\n"'#10'"    SetOutput(''te'
  +'xt'', s);\n"'#10'"  end.\n"'#10'"\n"'#10'"Voc'#195#170' tamb'#195#169'm pod'
  +'e usar constru'#195#167#195#181'es Pascal padr'#195#163'o (if, for, while, '
  +'repeat, etc.). Voc'#195#170' pode definir suas pr'#195#179'prias fun'#195
  +#167#195#181'es e procedimentos antes do bloco principal begin ... end.\n"'
  +#10'"\n"'#10'"Fun'#195#167#195#181'es dispon'#195#173'veis:\n"'#10'"  GetPar'
  +'am(''name'') : string\n"'#10'"    Recupera um valor de par'#195#162'metro d'
  +'e entrada.\n"'#10'"  SetOutput(''name'', ''value'')\n"'#10'"    Armazena um'
  +' valor de sa'#195#173'da para o host.\n"'#10'"  GetTimestamp() : Int64\n"'
  +#10'"    Timestamp Unix atual em milissegundos (UTC).\n"'#10'"  GetRandom(Le'
  +'ngth) : Int64\n"'#10'"    N'#195#186'mero inteiro aleat'#195#179'rio com ex'
  +'atamente Length d'#195#173'gitos decimais.\n"'#10'"  Random : Extended\n"'
  +#10'"    Float aleat'#195#179'rio no intervalo [0, 1).\n"'#10'"  IntToHex(Va'
  +'lue, Digits) : string\n"'#10'"    Converte um n'#195#186'mero inteiro em um'
  +'a string hexadecimal com no m'#195#173'nimo Digits caracteres.\n"'#10'"  St'
  +'rToInt(S) : Integer\n"'#10'"    Converte uma string em um n'#195#186'mero i'
  +'nteiro. Levanta uma exce'#195#167#195#163'o em caso de entrada inv'#195#161
  +'lida.\n"'#10'"  IntToStr(Value) : string\n"'#10'"    Converte um n'#195#186
  +'mero inteiro em sua representa'#195#167#195#163'o em string.\n"'#10'"  Trim'
  +'(S) : string\n"'#10'"    Remove espa'#195#167'os em branco no in'#195#173'c'
  +'io e no fim de S.\n"'#10'"  TrimLeft(S) : string\n"'#10'"    Remove espa'
  +#195#167'os em branco no in'#195#173'cio de S.\n"'#10'"  TrimRight(S) : stri'
  +'ng\n"'#10'"    Remove espa'#195#167'os em branco no fim de S.\n"'#10'"  Htm'
  +'lEncode(S) : string\n"'#10'"    Codifica caracteres especiais de HTML em S '
  +'para entidades.\n"'#10'"  HtmlDecode(S) : string\n"'#10'"    Decodifica ent'
  +'idades HTML em S de volta para caracteres.\n"'#10'"  UrlEncode(S) : string\'
  +'n"'#10'"    Codifica S em percent-encoding para inclus'#195#163'o segura em'
  +' URLs.\n"'#10'"  UrlDecode(S) : string\n"'#10'"    Decodifica uma string S '
  +'codificada em percent-encoding.\n"'#10'"  ReplaceAll(S, OldPattern, NewPatt'
  +'ern, IgnoreCase=False) : string\n"'#10'"    Substitui todas as ocorr'#195
  +#170'ncias de OldPattern por NewPattern em S.\n"'#10'"  RegexReplace(Input, '
  +'Pattern, Replacement) : string\n"'#10'"    Substitui todas as correspond'
  +#195#170'ncias da express'#195#163'o regular Pattern por Replacement em Inpu'
  +'t. N'#195#163'o diferencia mai'#195#186'sculas de min'#195#186'sculas.\n"'
  +#10'"  RegexMatch(Input, Pattern) : Boolean\n"'#10'"    Verifica se Input co'
  +'rresponde ao padr'#195#163'o de express'#195#163'o regular Pattern. Sem dis'
  +'tin'#195#167#195#163'o entre mai'#195#186'sculas e min'#195#186'sculas.\n"'
  +#10'"  ExtractBetween(S, StartMarker, EndMarker) : string\n"'#10'"    Extrai'
  +' a subcadeia de S entre StartMarker e EndMarker.\n"'#10'"\n"'#10'"Fun'#195
  +#167#195#181'es JSON (use um identificador retornado por JSONParse):\n"'#10
  +'"  JSONParse(S) : Inteiro\n"'#10'"    Analisa uma string JSON e retorna um '
  +'identificador (>=0). Retorna -1 em caso de erro.\n"'#10'"  JSONFree(Handle)'
  +'\n"'#10'"    Libere o identificador ap'#195#179's o uso.\n"'#10'"  JSONGetS'
  +'tring(Handle, Path) : string\n"'#10'"    Obt'#195#169'm um valor de string '
  +'no caminho especificado.\n"'#10'"  JSONGetInt(Handle, Path) : Inteiro\n"'#10
  +'"    Obt'#195#169'm um valor inteiro no caminho especificado.\n"'#10'"  JSO'
  +'NGetFloat(Handle, Path) : Estendido\n"'#10'"    Obt'#195#169'm um valor de '
  +'ponto flutuante no caminho especificado.\n"'#10'"  JSONGetBool(Handle, Path'
  +') : Booleano\n"'#10'"    Obt'#195#169'm um valor booleano no caminho especi'
  +'ficado.\n"'#10'"  JSONGetArrayCount(Handle, Path) : Inteiro\n"'#10'"    Obt'
  +#195#169'm o n'#195#186'mero de elementos em uma matriz no Caminho especific'
  +'ado.\n"'#10'"  JSONGetArrayString(Handle, Path, Index) : string\n"'#10'"   '
  +' Obt'#195#169'm o valor da string de um elemento da matriz no '#195#141'ndi'
  +'ce fornecido.\n"'#10'"  JSONGetArrayInt(Handle, Path, Index) : Inteiro\n"'
  +#10'"    Obt'#195#169'm o valor inteiro de um elemento da matriz no '#195#141
  +'ndice fornecido.\n"'#10'"  JSONGetType(Handle, Path) : string\n"'#10'"    R'
  +'etorna o tipo do valor em Path: \"object\", \"array\", \"string\", \"int\",'
  +' \"float\", \"bool\", \"null\".\n"'#10'"  JSONPathExists(Handle, Path) : Bo'
  +'olean\n"'#10'"    Verifica se o caminho especificado existe.\n"'#10'"  JSON'
  ,'ResultInit\n"'#10'"    Inicializa uma matriz JSON vazia para criar um resul'
  +'tado de erro padr'#195#163'o.\n"'#10'"  JSONResultAddError(Offset, Length, '
  +'Message, Replacements)\n"'#10'"    Adiciona um objeto de erro '#195#160' ma'
  +'triz de resultados. Replacements '#195#169' uma sequ'#195#170'ncia de valor'
  +'es separados por \"|\".\n"'#10'"  JSONResultGet : string\n"'#10'"\n"'#10'" '
  +'   Retorna a matriz de resultados atual como uma sequ'#195#170'ncia JSON.\n'
  +'"'#10'"  JSONResultClear\n"'#10'"    Limpa a matriz de resultados.\n"'#10'"'
  +'  Sempre chame JSONFree para liberar o identificador depois de terminar.\n"'
  +#10'"\n"'#10'"Exemplo de trabalho com JSON:\n"'#10'"  var h: Integer;\n"'#10
  +'"      s: string;\n"'#10'"  begin\n"'#10'"    h := JSONParse(GetParam(''res'
  +'ult''));\n"'#10'"    if h >= 0 then\n"'#10'"    begin\n"'#10'"      s := JS'
  +'ONGetString(h, ''some.path'');\n"'#10'"      SetOutput(''text'', s);\n"'#10
  +'"      JSONFree(h);\n"'#10'"    end;\n"'#10'"  end.\n"'#10'"\n"'#10'"Par'
  +#195#162'metros dispon'#195#173'veis (recuperados com GetParam):\n"'#10'"  t'
  +'ext - o texto de entrada a ser processado (possivelmente truncado para MaxL'
  +'ength)\n"'#10'"  source - c'#195#179'digo do idioma de origem (pode estar v'
  +'azio)\n"'#10'"  target - c'#195#179'digo do idioma de destino\n"'#10'"  tim'
  +'estamp - carimbo de data/hora Unix atual em milissegundos (string)\n"'#10'"'
  +'  random  - n'#195#186'mero aleat'#195#179'rio de 9 d'#195#173'gitos (strin'
  +'g)\n"'#10'"  rand - igual a random\n"'#10'"  rand1..rand9 - primeiros 1 a 9'
  +' d'#195#173'gitos do n'#195#186'mero aleat'#195#179'rio\n"'#10'"\n"'#10'"Pa'
  +'r'#195#162'metros iniciais e personalizados adicionais tamb'#195#169'm est'
  +#195#163'o dispon'#195#173'veis."'#10#10'#: formconfig.rscriptresponsehint'
  +#10'msgid ""'#10'"This script processes the response data. All functions and'
  +' parameters described in the script hint are available here as well.\n"'#10
  +'"Use GetParam(''result'') to obtain the received text.\n"'#10'"\n"'#10'"Exa'
  +'mple:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam('''
  +'result'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'
  +#10'"You can define custom parameters in the parameters script using SetPara'
  +'m(''name'', ''value''),\n"'#10'"and then retrieve them here with GetParam('
  +'''name'')."'#10'msgstr ""'#10'"Este script processa os dados da resposta. T'
  +'odas as fun'#195#167#195#181'es e par'#195#162'metros descritos na dica do '
  +'script tamb'#195#169'm est'#195#163'o dispon'#195#173'veis aqui.\n"'#10'"Us'
  +'e GetParam(''result'') para obter o texto recebido.\n"'#10'"\n"'#10'"Exempl'
  +'o:\n"'#10'"  var s: string;\n"'#10'"  begin\n"'#10'"    s := GetParam(''res'
  +'ult'');\n"'#10'"    SetOutput(''result'', s);\n"'#10'"  end.\n"'#10'"\n"'#10
  +'"Voc'#195#170' pode definir par'#195#162'metros personalizados no script de'
  +' par'#195#162'metros usando SetParam(''name'', ''value''),\n"'#10'"e depois'
  +' recuper'#195#161'-los aqui com GetParam(''name'')."'#10#10'#: formconfig.r'
  +'valuetype1'#10'msgctxt "formconfig.rvaluetype1"'#10'msgid "None"'#10'msgstr'
  +' "Vazio"'#10#10'#: formconfig.rvaluetype2'#10'msgid "Language"'#10'msgstr "'
  +'Idioma"'#10#10'#: formconfig.rvaluetype3'#10'msgid "Currency All"'#10'msgst'
  +'r "Todas as Moedas"'#10#10'#: formconfig.rvaluetype4'#10'msgid "Currency Fi'
  +'at Only"'#10'msgstr "Somente Moeda Fiduci'#195#161'ria"'#10#10'#: formconfi'
  +'g.rvaluetype5'#10'msgid "Currency Crypto Only"'#10'msgstr "Somente Criptomo'
  +'eda"'#10#10'#: formconfig.rvaluetype6'#10'msgid "Measurement Units"'#10'msg'
  +'str "Unidades de Medida"'#10#10'#: tformconfigtrayslate.aclearicon.caption'
  +#10'msgid "Clear Icon"'#10'msgstr "Limpar '#195#141'cone"'#10#10'#: tformcon'
  +'figtrayslate.asave.caption'#10'msgid "Save"'#10'msgstr "Salvar"'#10#10'#: t'
  +'formconfigtrayslate.asaveiconas.caption'#10'msgid "Save Icon As..."'#10'msg'
  +'str "Salvar '#195#141'cone Como..."'#10#10'#: tformconfigtrayslate.btnclose'
  +'.caption'#10'msgid "Close"'#10'msgstr "Fechar"'#10#10'#: tformconfigtraysla'
  +'te.btninitparameterstest.hint'#10'msgid "Execute request and view the param'
  +'eters"'#10'msgstr "Executar requisi'#195#167#195#163'o e visualizar os par'
  +#195#162'metros"'#10#10'#: tformconfigtrayslate.btniniturltest.hint'#10'msgi'
  +'d "Execute request and view the result"'#10'msgstr "Executar requisi'#195
  +#167#195#163'o e visualizar o resultado"'#10#10'#: tformconfigtrayslate.btnp'
  +'ostdatatest.hint'#10'msgid "Execute post request and view the result"'#10'm'
  +'sgstr "Executar requisi'#195#167#195#163'o POST e visualizar o resultado"'
  +#10#10'#: tformconfigtrayslate.btnresponsehelp.hint'#10'msgctxt "tformconfig'
  +'trayslate.btnresponsehelp.hint"'#10'msgid "Help"'#10'msgstr "Ajuda"'#10#10
  +'#: tformconfigtrayslate.btnresponsetest.hint'#10'msgid "Converts the curren'
  +'t response"'#10'msgstr "Converte a resposta atual"'#10#10'#: tformconfigtra'
  +'yslate.btnscripthelp.hint'#10'msgctxt "tformconfigtrayslate.btnscripthelp.h'
  ,'int"'#10'msgid "Help"'#10'msgstr "Ajuda"'#10#10'#: tformconfigtrayslate.btn'
  +'scriptresponsehelp.hint'#10'msgctxt "tformconfigtrayslate.btnscriptresponse'
  +'help.hint"'#10'msgid "Help"'#10'msgstr "Ajuda"'#10#10'#: tformconfigtraysla'
  +'te.btnscriptresponsetest.hint'#10'msgctxt "tformconfigtrayslate.btnscriptre'
  +'sponsetest.hint"'#10'msgid "Execute script and view the result"'#10'msgstr '
  +'"Execute o script e veja o resultado"'#10#10'#: tformconfigtrayslate.btnscr'
  +'ipttest.hint'#10'msgctxt "tformconfigtrayslate.btnscripttest.hint"'#10'msgi'
  +'d "Execute script and view the result"'#10'msgstr "Execute o script e veja '
  +'o resultado"'#10#10'#: tformconfigtrayslate.btnurltest.hint'#10'msgid "Exec'
  +'ute get request and view the result"'#10'msgstr "Executar requisi'#195#167
  +#195#163'o GET e visualizar o resultado"'#10#10'#: tformconfigtrayslate.capt'
  +'ion'#10'msgctxt "tformconfigtrayslate.caption"'#10'msgid "Config Editor"'#10
  +'msgstr "Editor de Configura'#195#167#195#181'es"'#10#10'#: tformconfigtrays'
  +'late.checkencodecustomparameters.caption'#10'msgid "Encode parameters"'#10
  +'msgstr "Codificar par'#195#162'metros"'#10#10'#: tformconfigtrayslate.check'
